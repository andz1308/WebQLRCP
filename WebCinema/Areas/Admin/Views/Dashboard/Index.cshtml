<!-- Chi Tiết Bán Vé Theo Rạp/Ngày/Phim -->
<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-calendar-alt"></i> Chi Tiết Bán Vé Theo Rạp - Ngày - Phim</h2>
        <span class="badge badge-primary">Hiển thị 50 mục gần nhất</span>
    </div>

    @if (ViewBag.CinemaTicketDetails != null && ((System.Collections.IList)ViewBag.CinemaTicketDetails).Count > 0)
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 20%;">Rạp Chiếu</th>
                        <th style="width: 15%;">Ngày Chiếu</th>
                        <th style="width: 35%;">Phim</th>
                        <th style="width: 10%;">Số Vé</th>
                        <th style="width: 20%;">Doanh Thu</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var cinemaDetails = ViewBag.CinemaTicketDetails as System.Collections.IEnumerable;
                        if (cinemaDetails != null)
                        {
                            foreach (var item in cinemaDetails)
                            {
                                var rapProp = item.GetType().GetProperty("Rap");
                                var ngayChieuProp = item.GetType().GetProperty("NgayChieu");
                                var phimProp = item.GetType().GetProperty("Phim");
                                var soVeProp = item.GetType().GetProperty("SoVe");
                                var doanhThuProp = item.GetType().GetProperty("DoanhThu");

                                var rap = rapProp != null ? (WebCinema.Models.Rap)rapProp.GetValue(item, null) : null;
                                var ngayChieu = ngayChieuProp != null ? (DateTime)ngayChieuProp.GetValue(item, null) : DateTime.Now;
                                var phim = phimProp != null ? (WebCinema.Models.Phim)phimProp.GetValue(item, null) : null;
                                int soVe = soVeProp != null ? Convert.ToInt32(soVeProp.GetValue(item, null)) : 0;
                                decimal doanhThu = doanhThuProp != null ? Convert.ToDecimal(doanhThuProp.GetValue(item, null)) : 0m;

                                <tr style="border-left: 4px solid @(soVe > 100 ? "#27ae60" : soVe > 50 ? "#f39c12" : "#e74c3c");">
                                    <td>
                                        <strong style="color: #2c3e50;">@(rap != null ? rap.ten_rap : "N/A")</strong>
                                    </td>
                                    <td>
                                        <span style="background: #ecf0f1; padding: 0.4rem 0.8rem; border-radius: 4px;">
                                            @ngayChieu.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <span style="color: #3498db; font-weight: 600;">@(phim != null ? phim.ten_phim : "N/A")</span>
                                    </td>
                                    <td>
                                        <span style="background: #e8f4f8; padding: 0.4rem 0.8rem; border-radius: 4px; color: #0066cc; font-weight: 600; display: inline-block;">
                                            @soVe vé
                                        </span>
                                    </td>
                                    <td>
                                        <strong style="color: #27ae60; font-size: 1.05rem;">@(doanhThu.ToString("N0")) VNĐ</strong>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 3rem; background: #f8f9fa; border-radius: 8px;">
            <i class="fas fa-inbox" style="font-size: 3rem; color: #bdc3c7; margin-bottom: 1rem;"></i>
            <p style="color: #999; font-size: 1.1rem;">Chưa có dữ liệu bán vé</p>
        </div>
    }

    <!-- Legend -->
    <div style="display: flex; gap: 2rem; margin-top: 2rem; padding: 1.5rem; background: #f9f9f9; border-radius: 8px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 4px; height: 20px; background: #27ae60;"></span>
            <span style="font-size: 0.9rem; color: #666;">Bán chạy (> 100 vé)</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 4px; height: 20px; background: #f39c12;"></span>
            <span style="font-size: 0.9rem; color: #666;">Bán vừa phải (50-100 vé)</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 4px; height: 20px; background: #e74c3c;"></span>
            <span style="font-size: 0.9rem; color: #666;">Bán chậm (< 50 vé)</span>
        </div>
    </div>
</div>

<!-- Quick Actions -->
