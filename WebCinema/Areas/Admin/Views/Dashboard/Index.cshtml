@model WebCinema.Models.CSDLDataContext

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}



<!-- Stats Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <h3>@ViewBag.TotalMovies</h3>
            <p>Tổng Số Phim</p>
        </div>
        <div class="stat-icon orange">
            <i class="fas fa-film"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h3>@ViewBag.TotalUsers</h3>
            <p>Tổng Người Dùng</p>
        </div>
        <div class="stat-icon blue">
            <i class="fas fa-users"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h3>@ViewBag.TotalBookings</h3>
            <p>Tổng Đơn Đặt</p>
        </div>
        <div class="stat-icon green">
            <i class="fas fa-ticket-alt"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h3>@((ViewBag.TotalRevenue ?? 0m).ToString("N0")) VNĐ</h3>
            <p>Tổng Doanh Thu</p>
        </div>
        <div class="stat-icon purple">
            <i class="fas fa-money-bill-wave"></i>
        </div>
    </div>
</div>

<!-- Monthly Stats -->
<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-calendar-alt"></i> Thống Kê Tháng Này</h2>
    </div>
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-info">
                <h3>@((ViewBag.MonthlyRevenue ?? 0m).ToString("N0")) VNĐ</h3>
                <p>Doanh Thu Trong Tháng</p>
            </div>
            <div class="stat-icon orange">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <h3>@(ViewBag.MonthlyBookings ?? 0)</h3>
                <p>Đơn Đặt Trong Tháng</p>
            </div>
            <div class="stat-icon blue">
                <i class="fas fa-shopping-cart"></i>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<div class="content-card" style="margin-bottom: 2rem;">
    <div style="padding: 1.5rem;">
        @using (Html.BeginForm("Index", "Dashboard", FormMethod.Get))
        {
            <div style="display: flex; gap: 1rem; align-items: end;">
                <div class="form-group" style="margin: 0; flex: 1;">
                    <label class="form-label">Chọn Tháng</label>
                    <select name="month" class="form-control">
                        <option value="">-- Tất cả tháng --</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" @(ViewBag.SelectedMonth == i ? "selected" : "")>Tháng @i</option>
                        }
                    </select>
                </div>
                <div class="form-group" style="margin: 0; flex: 1;">
                    <label class="form-label">Chọn Năm</label>
                    <select name="year" class="form-control">
                        @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                        {
                            <option value="@i" @(ViewBag.SelectedYear == i ? "selected" : "")>Năm @i</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> Lọc
                </button>
            </div>
        }
    </div>
</div>
<!-- Revenue Chart -->
<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-chart-bar"></i> Doanh Thu </h2>
    </div>
    <canvas id="revenueChart" height="80"></canvas>
</div>

<!-- Top Movies by Revenue -->
<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-trophy"></i> Top 5 Phim Có Doanh Thu Cao Nhất</h2>
    </div>

    @if (ViewBag.TopMovies != null && ((System.Collections.IList)ViewBag.TopMovies).Count > 0)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tên Phim</th>
                    <th>Số Vé Bán</th>
                    <th>Doanh Thu</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                    var db = new WebCinema.Models.CSDLDataContext();
                    // Use non-dynamic iteration and reflection to safely read anonymous projection properties
                    var topMoviesObj = ViewBag.TopMovies as System.Collections.IEnumerable;
                    if (topMoviesObj != null)
                    {
                        foreach (var item in topMoviesObj)
                        {
                            // safe reflection access (works for anonymous types across assemblies)
                            object movieProp = item != null ? (item.GetType().GetProperty("Movie") != null ? item.GetType().GetProperty("Movie").GetValue(item, null) : null) : null;
                            object soVeObj = item != null ? (item.GetType().GetProperty("TotalTickets") != null ? item.GetType().GetProperty("TotalTickets").GetValue(item, null) : null) : null;
                            object tongDoanhThuObj = item != null ? (item.GetType().GetProperty("Revenue") != null ? item.GetType().GetProperty("Revenue").GetValue(item, null) : null) : null;

                            var phim = movieProp as WebCinema.Models.Phim;
                            int soVe = soVeObj != null ? Convert.ToInt32(soVeObj) : 0;
                            decimal tongDoanhThu = tongDoanhThuObj != null ? Convert.ToDecimal(tongDoanhThuObj) : 0m;

                            <tr>
                                <td><strong>@index</strong></td>
                                <td>@(phim != null ? phim.ten_phim : "N/A")</td>
                                <td>@soVe</td>
                                <td><strong style="color: #27ae60;">@(tongDoanhThu.ToString("N0")) VNĐ</strong></td>
                            </tr>
                            index++;
                        }
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="text-align: center; color: #999; padding: 2rem;">Chưa có dữ liệu thống kê.</p>
    }
</div>

<!-- Top Movies by Booking Count -->
<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-fire"></i> Top 5 Phim Được Đặt Vé Nhiều Nhất</h2>
    </div>

    @if (ViewBag.TopBookingMovies != null && ((System.Collections.IList)ViewBag.TopBookingMovies).Count > 0)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tên Phim</th>
                    <th>Số Vé Đã Đặt</th>
                    <th>Doanh Thu Từ Vé Này</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int bookingIndex = 1;
                    var topBookingMoviesObj = ViewBag.TopBookingMovies as System.Collections.IEnumerable;
                    if (topBookingMoviesObj != null)
                    {
                        foreach (var item in topBookingMoviesObj)
                        {
                            // Reflection để lấy dữ liệu từ anonymous object
                            var soVeDatProp = item.GetType().GetProperty("SoVeDat");
                            var tongDoanhThuProp = item.GetType().GetProperty("TongDoanhThu");
                            var phimProp = item.GetType().GetProperty("Phim");

                            int soVeDat = soVeDatProp != null ? Convert.ToInt32(soVeDatProp.GetValue(item, null)) : 0;
                            decimal tongDoanhThu = tongDoanhThuProp != null ? Convert.ToDecimal(tongDoanhThuProp.GetValue(item, null)) : 0m;
                            var phim = phimProp != null ? (WebCinema.Models.Phim)phimProp.GetValue(item, null) : null;

                            <tr style="background: #f9f9f9;">
                                <td><strong>@bookingIndex</strong></td>
                                <td>
                                    <strong style="color: #ff6b35;">@(phim != null ? phim.ten_phim : "N/A")</strong>
                                </td>
                                <td>
                                    <span style="background: #e8f4f8; padding: 0.4rem 0.8rem; border-radius: 6px; color: #0066cc; font-weight: 600;">
                                        @soVeDat vé
                                    </span>
                                </td>
                                <td>
                                    <strong style="color: #27ae60;">@(tongDoanhThu.ToString("N0")) VNĐ</strong>
                                </td>
                            </tr>
                            bookingIndex++;
                        }
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="text-align: center; color: #999; padding: 2rem;">Chưa có dữ liệu thống kê.</p>
    }
</div>

