@model IEnumerable<WebCinema.Areas.Admin.Controllers.DetailImportViewModel>

@{
    ViewBag.Title = "Chi Tiết Phiếu Nhập";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";
    var phieu = ViewBag.PhieuInfo as WebCinema.Models.Phieu_Nhap;
}

<style>
    /* Orange Theme Styles */
    .page-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 2px solid #ff9966;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .page-header h1 {
            color: #ff6b35;
            font-weight: 700;
            margin: 0;
        }

            .page-header h1 i {
                margin-right: 0.5rem;
            }

    .header-actions {
        display: flex;
        gap: 1rem;
    }

    .back-btn {
        background: white;
        color: #ff6b35;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: 2px solid #ffe8dc;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .back-btn:hover {
            background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
            color: white;
            border-color: #ff6b35;
            text-decoration: none;
            transform: translateX(-5px);
        }

    .btn-export-pdf {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

        .btn-export-pdf:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.4);
            color: white;
            text-decoration: none;
        }

    .detail-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.5rem;
        border-bottom: none;
    }

        .card-header h3 {
            color: white;
            margin: 0;
            font-weight: 700;
            font-size: 1.3rem;
        }

            .card-header h3 i {
                margin-right: 0.5rem;
            }

    .card-body {
        padding: 2rem;
    }

    .info-group {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: #fff5f0;
        border-radius: 8px;
        border-left: 4px solid #ff6b35;
    }

        .info-group label {
            color: #666;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
        }

        .info-group .value {
            color: #333;
            font-size: 1.1rem;
            font-weight: 600;
        }

    .status-badge {
        padding: 0.6rem 1.2rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
        display: inline-block;
        margin-top: 0.5rem;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-completed {
        background: #d1ecf1;
        color: #0c5460;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    .table thead th {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        color: #ff6b35;
        font-weight: 700;
        border-bottom: 2px solid #ff9966;
        padding: 1rem;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table tbody td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #ffe5dc;
    }

    .table tbody tr {
        transition: all 0.2s ease;
    }

        .table tbody tr:hover {
            background: #fffaf8;
            box-shadow: 0 2px 8px rgba(255, 107, 53, 0.1);
        }

    .badge-info {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-weight: 600;
        box-shadow: 0 2px 4px rgba(255, 107, 53, 0.2);
    }

    .quantity-cell {
        text-align: center;
        font-size: 1.3rem;
        font-weight: 700;
        color: #ff6b35;
    }

    .timeline-section {
        margin-top: 2rem;
        padding: 1.5rem;
        background: #fff5f0;
        border-radius: 10px;
        border-left: 4px solid #ff6b35;
    }

        .timeline-section h4 {
            color: #ff6b35;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .timeline-section .timeline-item {
            padding: 0.75rem 0;
            border-bottom: 1px solid #ffe8dc;
        }

            .timeline-section .timeline-item:last-child {
                border-bottom: none;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            gap: 1rem;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
        }

        .info-grid {
            grid-template-columns: 1fr !important;
        }
    }
</style>

<div class="page-header">
    <h1><i class="fas fa-file-invoice"></i> Chi Tiết Phiếu Nhập #PN-@phieu.phieu_nhap_id</h1>
    <div class="header-actions">
        <a href="@Url.Action("ExportPdf", new { id = phieu.phieu_nhap_id })" class="btn-export-pdf">
            <i class="fas fa-file-pdf"></i> Xuất PDF
        </a>
        <a href="@Url.Action("Index")" class="back-btn">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>
<div id="print-area">
    <!-- TẤT CẢ NỘI DUNG CHI TIẾT PHIẾU NHẬP -->
    <div class="row">
        <div class="col-md-4">
            <div class="detail-card">
                <div class="card-header">
                    <h3><i class="fas fa-info-circle"></i> Thông Tin Chung</h3>
                </div>
                <div class="card-body">
                    <div class="info-group">
                        <label><i class="fas fa-calendar"></i> Ngày tạo</label>
                        <div class="value">@phieu.ngay_nhap.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="info-group">
                        <label><i class="fas fa-user"></i> Nhân viên yêu cầu</label>
                        <div class="value">@(phieu.Nhan_Vien != null ? phieu.Nhan_Vien.ho_ten : "N/A")</div>
                    </div>

                    <div class="info-group">
                        <label><i class="fas fa-warehouse"></i> Rạp</label>
                        <div class="value">@(phieu.Rap != null ? phieu.Rap.ten_rap : "N/A")</div>
                    </div>

                    @if (phieu.Nha_Cung_Cap != null)
                    {
                        <div class="info-group">
                            <label><i class="fas fa-truck"></i> Nhà cung cấp</label>
                            <div class="value">@phieu.Nha_Cung_Cap.ten_nha_cung_cap</div>
                        </div>
                    }

                    <div class="info-group">
                        <label><i class="fas fa-flag"></i> Trạng thái</label>
                        @if (phieu.trang_thai == "Chờ duyệt")
                        {
                            <span class="status-badge status-pending">⏳ Chờ duyệt</span>
                        }
                        else if (phieu.trang_thai == "Đã duyệt")
                        {
                            <span class="status-badge status-approved">✅ Đã duyệt</span>
                        }
                        else if (phieu.trang_thai == "Đã nhập")
                        {
                            <span class="status-badge status-completed">📦 Đã nhập kho</span>
                        }
                        else
                        {
                            <span class="status-badge status-cancelled">❌ @phieu.trang_thai</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(phieu.ghi_chu))
                    {
                        <div class="info-group">
                            <label><i class="fas fa-comment"></i> Ghi chú</label>
                            <div class="value" style="font-size: 1rem;">@phieu.ghi_chu</div>
                        </div>
                    }
                </div>
            </div>

            @if (phieu.trang_thai != "Chờ duyệt")
            {
                <div class="detail-card">
                    <div class="card-header">
                        <h3><i class="fas fa-history"></i> Lịch Sử Xử Lý</h3>
                    </div>
                    <div class="card-body">
                        <div class="timeline-section" style="border: none; padding: 0; background: transparent;">
                            <div class="timeline-item">
                                <strong style="color: #ff6b35;">Ngày tạo:</strong>
                                <span>@phieu.ngay_nhap.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @if (phieu.trang_thai == "Đã duyệt" || phieu.trang_thai == "Đã nhập")
                            {
                                <div class="timeline-item">
                                    <strong style="color: #ff6b35;">Đã duyệt:</strong>
                                    <span style="color: #27ae60;">✅ Đã được duyệt</span>
                                </div>
                            }
                            @if (phieu.trang_thai == "Đã nhập")
                            {
                                <div class="timeline-item">
                                    <strong style="color: #ff6b35;">Đã nhập kho:</strong>
                                    <span style="color: #27ae60;">✅ Hoàn tất</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-8">
            <div class="detail-card">
                <div class="card-header">
                    <h3><i class="fas fa-box"></i> Danh Sách Hàng Hóa</h3>
                </div>
                <div style="overflow-x: auto;">
                    <table class="table table-hover" style="width: 100%">
                        <thead>
                            <tr>
                                <th style="width: 10%;">STT</th>
                                <th style="width: 45%;"><i class="fas fa-tag"></i> Tên Món</th>
                                <th style="width: 25%;"><i class="fas fa-layer-group"></i> Loại</th>
                                <th class="text-center" style="width: 20%;"><i class="fas fa-sort-numeric-up"></i> Số Lượng</th>
                            </tr>
                        </thead>
                        <tbody style="text-align: left;">
                            @if (Model != null && Model.Any())
                            {
                                int stt = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="text-align: center; font-weight: 600;">@stt</td>
                                        <td><strong>@item.TenMon</strong></td>
                                        <td><span class="badge-info">@item.Loai</span></td>
                                        <td class="quantity-cell">@item.SoLuong</td>
                                    </tr>
                                    stt++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 3rem; color: #999;">
                                        <i class="fas fa-inbox" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; display: block;"></i>
                                        <p>Không có dữ liệu chi tiết</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>


<script>
                    // Selection highlight
                    ::selection {
            background: #ff6b35;
            color: white;
        }

                    :: -moz - selection {
            background: #ff6b35;
            color: white;
        }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.querySelector(".btn-export-pdf");

        if (btn) {
            btn.addEventListener("click", function (e) {
                e.preventDefault();

                // Lấy đúng phần nội dung cần in
                const element = document.querySelector("#print-area");

                const opt = {
                    margin: 0.5,
                    filename: "phieu-nhap.pdf",
                    image: { type: "jpeg", quality: 1 },
                    html2canvas: { scale: 2 },
                    jsPDF: { unit: "cm", format: "a4", orientation: "portrait" }
                };

                html2pdf().set(opt).from(element).save();
            });
        }
    });
</script>
