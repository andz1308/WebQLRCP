@{
    ViewBag.Title = "Tạo Yêu Cầu Nhập Hàng";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";
    var listFood = ViewBag.ListFood as List<WebCinema.Models.Do_An>;
    var suppliers = ViewBag.Suppliers as List<WebCinema.Models.Nha_Cung_Cap>;
}

<div class="content-header">
    <h1><i class="fas fa-cart-plus"></i> Tạo Phiếu Nhập Hàng</h1>
</div>

<div class="content-card" style="padding: 20px;">

    <div class="form-group">
        <label>Ghi chú nhập hàng:</label>
        <textarea id="txtNote" class="form-control" rows="2" placeholder="Ví dụ: Nhập hàng bổ sung cho cuối tuần..."></textarea>
    </div>

    <div class="row" style="background: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
        <div class="col-md-6">
            <div class="form-group">
                <label>Nhà Cung Cấp (*):</label>
                <select id="ddlSupplier" class="form-control">
                    <option value="">-- Chọn nhà cung cấp --</option>
                    @if (suppliers != null)
                    {
                        foreach (var ncc in suppliers)
                        {
                            <option value="@ncc.id">@ncc.ten_nha_cung_cap</option>
}
                    }
                </select>
            </div>
        </div>
        <div class="col-md-5">
            <label>Chọn món ăn:</label>
            <select id="ddlFood" class="form-control">
                @foreach (var item in listFood)
                {
                    <option value="@item.Do_An_id" data-name="@item.ten_san_pham" data-unit="@item.loai">
                        @item.ten_san_pham (@item.loai)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>Số lượng:</label>
            <input type="number" id="numQuantity" class="form-control" value="10" min="1" />
        </div>
        <div class="col-md-4" style="display: flex; align-items: flex-end;">
            <button class="btn btn-success" onclick="addItem()">
                <i class="fas fa-plus"></i> Thêm vào danh sách
            </button>
        </div>
    </div>

    <table class="table table-bordered" id="tblImport">
        <thead>
            <tr>
                <th>Tên món</th>
                <th>Loại</th>
                <th>Số lượng nhập</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    <div style="text-align: right; margin-top: 20px;">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
        <button class="btn btn-primary" onclick="submitOrder()">
            <i class="fas fa-paper-plane"></i> Gửi Yêu Cầu
        </button>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var importList = [];

    function addItem() {
        var foodId = $('#ddlFood').val();
        var foodName = $('#ddlFood option:selected').data('name');
        var foodUnit = $('#ddlFood option:selected').data('unit');
        var quantity = parseInt($('#numQuantity').val());

        if (quantity <= 0) {
            alert("Số lượng phải lớn hơn 0");
            return;
        }

        // Kiểm tra xem món đã có trong list chưa
        var exists = false;
        for (var i = 0; i < importList.length; i++) {
            if (importList[i].Id == foodId) {
                importList[i].SoLuong += quantity;
                exists = true;
                break;
            }
        }

        if (!exists) {
            importList.push({ Id: foodId, Name: foodName, Unit: foodUnit, SoLuong: quantity });
        }

        renderTable();
    }

    function removeItem(index) {
        importList.splice(index, 1);
        renderTable();
    }

    function renderTable() {
        var html = '';
        if (importList.length === 0) {
            html = '<tr><td colspan="4" class="text-center">Chưa có món nào được chọn</td></tr>';
        } else {
            for (var i = 0; i < importList.length; i++) {
                html += `<tr>
                            <td>${importList[i].Name}</td>
                            <td>${importList[i].Unit}</td>
                            <td><input type="number" min="1" value="${importList[i].SoLuong}" onchange="updateQty(${i}, this.value)" style="width: 80px;" /></td>
                            <td><button class="btn btn-danger btn-sm" onclick="removeItem(${i})"><i class="fas fa-trash"></i></button></td>
                         </tr>`;
            }
        }
        $('#tblImport tbody').html(html);
    }

    function updateQty(index, newVal) {
        importList[index].SoLuong = parseInt(newVal);
    }

    function submitOrder() {
        if (importList.length === 0) {
            alert("Vui lòng chọn ít nhất 1 món ăn.");
            return;
        }

        if (!confirm("Bạn có chắc chắn muốn gửi yêu cầu nhập hàng này?")) return;

        var note = $('#txtNote').val();

        $.ajax({
            url: '@Url.Action("Create")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ items: importList, ghiChu: note }),
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    window.location.href = '@Url.Action("Index")';
                } else {
                    alert(res.message);
                }
            }
        });
    }
    function submitOrder() {
        if (importList.length === 0) {
            alert("Vui lòng chọn ít nhất 1 món ăn.");
            return;
        }

        // 🆕 Validate Nhà Cung Cấp
        var supplierId = $('#ddlSupplier').val();
        if (!supplierId) {
            alert("Vui lòng chọn Nhà cung cấp.");
            return;
        }

        if (!confirm("Bạn có chắc chắn muốn gửi yêu cầu nhập hàng này?")) return;

        var note = $('#txtNote').val();

        $.ajax({
            url: '@Url.Action("Create")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                items: importList,
                ghiChu: note,
                supplierId: supplierId // Gửi ID nhà cung cấp về Server
            }),
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    window.location.href = '@Url.Action("Index")';
                } else {
                    alert(res.message);
                }
            }
        });
    }
    // Thêm vào cuối phần <script> trong Create.cshtml

// Thêm vào cuối thẻ <script> trong file StaffPurchaseOrder/Create.cshtml

$(document).ready(function() {
    // 1. Lấy dữ liệu tự động từ Controller (nếu có)

    var autoData = @Html.Raw(ViewBag.AutoImportList ?? "[]");

    // 2. Nếu có dữ liệu -> Đổ vào bảng ngay
    if (autoData && autoData.length > 0) {

        // Xóa danh sách cũ (nếu có)
        importList = [];

        // Duyệt qua từng món và thêm vào mảng quản lý
        autoData.forEach(function(item) {
            importList.push({
                Id: item.Id,
                Name: item.Name,
                Unit: item.Unit,
                SoLuong: item.SoLuong // Mặc định 50 (hoặc số bạn set trong Controller)
            });
        });

        // 3. Vẽ lại bảng HTML
        renderTable();

        // 4. Thông báo nhẹ
        var msg = '@Html.Raw(ViewBag.AutoMessage)';
        if(msg) alert(msg);
    }
});
    // Init
    renderTable();
</script>