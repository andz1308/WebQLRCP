@{
    ViewBag.Title = "Tạo Yêu Cầu Nhập Hàng";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";
    var listFood = ViewBag.ListFood as List<WebCinema.Models.Do_An>;
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

<div class="content-header">
    <h1><i class="fas fa-cart-plus"></i> Tạo Phiếu Nhập Hàng</h1>
</div>

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-plus-circle"></i> Thông Tin Phiếu Nhập</h2>
    </div>

    <div style="padding: 1.5rem;">
        <div class="form-group">
            <label class="form-label">Ghi chú nhập hàng:</label>
            <textarea id="txtNote" class="form-control" rows="3" placeholder="Ví dụ: Nhập hàng bổ sung cho cuối tuần..."></textarea>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-list"></i> Chọn Món Ăn Cần Nhập</h2>
    </div>

    <div style="padding: 1.5rem;">
        <div class="row" style="background: #f8f9fa; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
            <div class="col-md-5">
                <div class="form-group">
                    <label class="form-label">Chọn món ăn:</label>
                    <select id="ddlFood" class="form-control">
                        @foreach (var item in listFood)
                        {
                            <option value="@item.Do_An_id" data-name="@item.ten_san_pham" data-unit="@item.loai">
                                @item.ten_san_pham (@item.loai)
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="form-label">Số lượng:</label>
                    <input type="number" id="numQuantity" class="form-control" value="10" min="1" />
                </div>
            </div>
            <div class="col-md-4" style="display: flex; align-items: flex-end;">
                <button class="btn btn-success" onclick="addItem()">
                    <i class="fas fa-plus"></i> Thêm vào danh sách
                </button>
            </div>
        </div>

        <table class="data-table" id="tblImport">
            <thead>
                <tr>
                    <th>Tên món</th>
                    <th>Loại</th>
                    <th>Số lượng nhập</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

        <div style="text-align: right; margin-top: 2rem;">
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Hủy
            </a>
            <button class="btn btn-primary" onclick="submitOrder()">
                <i class="fas fa-paper-plane"></i> Gửi Yêu Cầu
            </button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var importList = [];

    function addItem() {
        var foodId = $('#ddlFood').val();
        var foodName = $('#ddlFood option:selected').data('name');
        var foodUnit = $('#ddlFood option:selected').data('unit');
        var quantity = parseInt($('#numQuantity').val());

        if (quantity <= 0) {
            alert("Số lượng phải lớn hơn 0");
            return;
        }

        // Kiểm tra xem món đã có trong list chưa
        var exists = false;
        for (var i = 0; i < importList.length; i++) {
            if (importList[i].Id == foodId) {
                importList[i].SoLuong += quantity;
                exists = true;
                break;
            }
        }

        if (!exists) {
            importList.push({ Id: foodId, Name: foodName, Unit: foodUnit, SoLuong: quantity });
        }

        renderTable();
    }

    function removeItem(index) {
        importList.splice(index, 1);
        renderTable();
    }

    function renderTable() {
        var html = '';
        if (importList.length === 0) {
            html = '<tr><td colspan="4" class="text-center" style="padding: 2rem; color: #999;">Chưa có món nào được chọn</td></tr>';
        } else {
            for (var i = 0; i < importList.length; i++) {
                html += `<tr>
                            <td>${importList[i].Name}</td>
                            <td>${importList[i].Unit}</td>
                            <td><input type="number" min="1" value="${importList[i].SoLuong}" onchange="updateQty(${i}, this.value)" class="form-control" style="width: 80px; display: inline-block;" /></td>
                            <td><button class="btn btn-danger btn-sm" onclick="removeItem(${i})"><i class="fas fa-trash"></i></button></td>
                         </tr>`;
            }
        }
        $('#tblImport tbody').html(html);
    }

    function updateQty(index, newVal) {
        importList[index].SoLuong = parseInt(newVal);
    }

    function submitOrder() {
        if (importList.length === 0) {
            alert("Vui lòng chọn ít nhất 1 món ăn.");
            return;
        }

        if (!confirm("Bạn có chắc chắn muốn gửi yêu cầu nhập hàng này?")) return;

        var note = $('#txtNote').val();

        $.ajax({
            url: '@Url.Action("Create")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ items: importList, ghiChu: note }),
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    window.location.href = '@Url.Action("Index")';
                } else {
                    alert(res.message);
                }
            }
        });
    }

    // Init
    renderTable();
</script>

<style>
    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 1rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #666;
    }

    .btn-success {
        background: #28a745;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background: #218838;
            transform: translateY(-2px);
        }

    .btn-danger {
        background: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background: #c82333;
        }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.875rem;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .col-md-5, .col-md-3, .col-md-4 {
        flex: 1;
    }

    .col-md-5 {
        flex-basis: 40%;
    }

    .col-md-3 {
        flex-basis: 25%;
    }

    .col-md-4 {
        flex-basis: 30%;
    }

    @@media (max-width: 768px) {
        .row {
            flex-direction: column;
        }

        .col-md-5, .col-md-3, .col-md-4 {
            flex-basis: 100%;
        }
    }
</style>