@model WebCinema.Models.Phong_Chieu

@{
    ViewBag.Title = "Tạo Phòng Chiếu Mới";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";

    // Lấy trạng thái từ ViewBag
    bool hasSpecificRap = ViewBag.HasSpecificRap ?? false;
}

<style>
    /* Container chính với nền cam */
    .form-container {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        margin-bottom: 30px;
    }

    .page-header-custom {
        background: white;
        padding: 25px;
        border-radius: 10px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .page-header-custom h2 {
        color: #ff6b35;
        margin: 0 0 10px 0;
        font-weight: 700;
        font-size: 28px;
    }

    .page-header-custom h2 i {
        color: #ff9966;
        margin-right: 10px;
    }

    .form-horizontal .form-group {
        margin-left: 0;
        margin-right: 0;
        background: white;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        transition: all 0.3s ease;
    }

    .form-horizontal .form-group:hover {
        box-shadow: 0 4px 12px rgba(255, 107, 53, 0.15);
        transform: translateY(-2px);
    }

    .form-horizontal .control-label {
        font-weight: 600;
        color: #555;
        text-align: left;
        padding-top: 7px;
        margin-bottom: 5px;
    }

    .form-control {
        border-radius: 6px;
        border: 2px solid #ffe0d5;
        padding: 10px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
        width: 100%;
    }

    .form-control:focus {
        border-color: #ff9966;
        box-shadow: 0 0 0 3px rgba(255, 153, 102, 0.2);
        outline: none;
    }
    
    .form-control-static strong {
        font-size: 16px;
        color: #ff6b35;
        font-weight: 600;
    }

    .btn-custom {
        padding: 12px 30px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
        border: none;
        margin: 5px;
    }

    .btn-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.2);
    }

    .btn-primary {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #ff6b35 0%, #ff5722 100%);
    }

    .btn-default {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
    }

    .btn-default:hover {
        background: linear-gradient(135deg, #5a6268 0%, #495057 100%);
    }

    .button-group {
        text-align: right;
        margin-top: 20px;
        padding: 20px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .text-danger {
        width: 100%;
        margin-top: 5px;
        color: #dc3545;
        font-size: 14px;
    }

    /* Hiệu ứng cho icon */
    .glyphicon {
        transition: all 0.3s ease;
    }

    .btn-custom:hover .glyphicon {
        transform: scale(1.1);
    }

    /* Placeholder styling */
    .form-control::placeholder {
        color: #aaa;
        font-style: italic;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .form-container {
            padding: 20px;
        }

        .page-header-custom h2 {
            font-size: 24px;
        }

        .btn-custom {
            width: 100%;
            margin: 5px 0;
        }

        .button-group {
            text-align: center;
        }
    }
</style>

<div class="form-container">
    <div class="page-header-custom">
        <h2><i class="glyphicon glyphicon-plus-sign"></i> Tạo Phòng Chiếu Mới</h2>
    </div>

    @using (Html.BeginForm("Create", "Auditori", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        if (hasSpecificRap)
        {
        <div class="form-group">
            <label class="control-label col-md-3">🎭 Thuộc Rạp : </label>&nbsp;
            <div class="col-md-9">
                <p class="form-control-static">
                    <strong>@ViewBag.RapName</strong>
                </p>
                @Html.HiddenFor(model => model.rap_id)
            </div>
        </div>
        }
        else
        {
            <div class="form-group">
                @Html.LabelFor(model => model.rap_id, "🎭 Chọn rạp", new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.DropDownList("rap_id", (SelectList)ViewBag.RapList, "--- Chọn rạp ---", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.rap_id, "", new { @class = "text-danger" })
                </div>
            </div>
        }

        <div class="form-group">
            @Html.LabelFor(model => model.ten_phong, "🎬 Tên phòng :", new { @class = "control-label col-md-3" })
            &nbsp;
            <div class="col-md-9">
                @Html.EditorFor(model => model.ten_phong, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Phòng 1, IMAX..." } })
                @Html.ValidationMessageFor(model => model.ten_phong, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.so_hang, "📊 Số hàng:", new { @class = "control-label col-md-3" })
            &nbsp;
            <div class="col-md-9">
                @Html.EditorFor(model => model.so_hang, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "26", placeholder = "Tối đa 26 hàng (A-Z)" } })
                @Html.ValidationMessageFor(model => model.so_hang, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.so_cot, "📐 Số cột:", new { @class = "control-label col-md-3" })
            &nbsp;
            <div class="col-md-9">
                @Html.EditorFor(model => model.so_cot, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "30", placeholder = "Tối đa 30 ghế mỗi hàng" } })
                @Html.ValidationMessageFor(model => model.so_cot, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="button-group">
            @Html.ActionLink("← Quay lại", "Index", new { rapId = Model.rap_id }, new { @class = "btn btn-custom btn-default" })
            <button type="submit" class="btn btn-custom btn-primary">
                <i class="glyphicon glyphicon-floppy-disk"></i> Tạo và tiếp tục
            </button>
        </div>
    }
</div>