@using WebCinema.Models
@model IEnumerable<ManagerInventoryViewModel>

@{
    ViewBag.Title = "Quản Lý Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

<div class="content-header">
    <h1><i class="fas fa-warehouse"></i> Quản Lý Sản Phẩm (Menu)</h1>
    <div class="header-actions">
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Sản Phẩm
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="content-card" style="margin-bottom: 2rem;">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-filter"></i> Bộ Lọc</h2>
    </div>
    <div style="padding: 1.5rem;">
        @using (Html.BeginForm("Index", "InventoryManagement", FormMethod.Get))
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: end;">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tên sản phẩm..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Loại sản phẩm</label>
                    <select name="category" class="form-control">
                        <option value="">-- Tất cả --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat" @(ViewBag.SelectedCategory == cat ? "selected" : "")>@cat</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Lọc
                </button>
            </div>
        }
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-list"></i> Danh Sách Menu</h2>
        <span class="badge badge-primary">Tổng: @Model.Count() món</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Loại</th>
                    <th>Giá Bán</th>
                    <th>Trạng Thái</th>
                    <th style="width: 150px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.DoAn.Do_An_id</strong></td>
                        <td>
                            <strong style="color: var(--color-dark-blue);">@item.DoAn.ten_san_pham</strong>
                            @if (!string.IsNullOrEmpty(item.DoAn.mo_ta))
                            {
                                <div style="color: var(--color-text-light); font-size: 0.85rem; margin-top: 4px;">
                                    @(item.DoAn.mo_ta.Length > 40 ? item.DoAn.mo_ta.Substring(0, 40) + "..." : item.DoAn.mo_ta)
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge badge-category">@(item.DoAn.loai ?? "N/A")</span>
                        </td>



                        <td>
                            @if (item.DoAn.gia.HasValue)
                            {
                                <strong style="color: var(--color-success);">@item.DoAn.gia.Value.ToString("N0") đ</strong>
                            }
                            else
                            {
                                <span style="color: var(--color-text-light);">Chưa định giá</span>
                            }
                        </td>

                        <td>
                            @if (item.DoAn.trang_thai == "Ngừng kinh doanh")
                            {
                                <span style="color: var(--color-danger); font-size: 0.9rem;"><i class="fas fa-ban"></i> Ngừng bán</span>
                            }
                            else
                            {
                                <span style="color: var(--color-success); font-size: 0.9rem;"><i class="fas fa-check-circle"></i> Đang bán</span>
                            }
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a href="@Url.Action("Details", new { id = item.DoAn.Do_An_id })" class="btn btn-sm" style="background: #17a2b8; color: white;" title="Chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.DoAn.Do_An_id })" class="btn btn-sm btn-warning" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button onclick="deleteItem(@item.DoAn.Do_An_id)" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 3rem; color: var(--color-text-light);">
            <i class="fas fa-box-open" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5;"></i>
            <p style="font-size: 1.1rem;">Không có sản phẩm nào trong kho.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary" style="margin-top: 1rem;">
                <i class="fas fa-plus"></i> Thêm Sản Phẩm Đầu Tiên
            </a>
        </div>
    }
</div>

<style>
    .header-actions {
        display: flex;
        gap: 1rem;
    }

    .badge-category {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: capitalize;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .btn-sm {
        padding: 0.5rem 0.9rem;
        font-size: 0.875rem;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-sm:hover {
            transform: translateY(-2px);
        }

    .badge-primary {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.2);
    }
</style>

@section scripts {
    <script>
        function deleteItem(id) {
            if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này? Việc xóa sẽ ảnh hưởng đến lịch sử nhập xuất!')) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
}