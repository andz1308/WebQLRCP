@using WebCinema.Models
@model IEnumerable<ManagerInventoryViewModel>

@{
    ViewBag.Title = "Quản Lý Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

<div class="content-header">
    <h1><i class="fas fa-warehouse"></i> Quản Lý Sản Phẩm (Menu & Kho)</h1>
    <div class="header-actions">
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Sản Phẩm
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="content-header mt-4 mb-4">
    <h2><i class="fas fa-boxes"></i> Tồn Kho Chi Tiết Theo Rạp</h2>
</div>

<div class="cinema-grid">
    @if (ViewBag.CinemaStocks != null)
    {
        foreach (var rap in (List<WebCinema.Areas.Admin.Controllers.CinemaStockViewModel>)ViewBag.CinemaStocks)
        {
            <div class="cinema-card">
                <div class="cinema-card-header">
                    <div class="cinema-info">
                        <i class="fas fa-building cinema-icon"></i>
                        <h3 class="cinema-name">@rap.TenRap</h3>
                    </div>
                    <span class="total-badge">@rap.TongSoLuong món</span>
                </div>

                <div class="cinema-card-body">
                    @if (rap.DanhSachMon.Count > 0)
                    {
                        <div class="product-list">
                            @foreach (var item in rap.DanhSachMon)
                            {
                                <div class="product-item">
                                    <div class="product-name">@item.TenMon</div>
                                    <div class="product-info">
                                        <span class="product-quantity
                                            @(item.SoLuong <= 0 ? "quantity-danger" :
                                              item.SoLuong < 20 ? "quantity-warning" : "quantity-success")">
                                            @item.SoLuong
                                        </span>
                                        @if (item.TrangThai == "Hết hàng")
                                        {
                                            <span class="status-badge status-danger">Hết</span>
                                        }
                                        else if (item.TrangThai == "Sắp hết")
                                        {
                                            <span class="status-badge status-warning">Thiếu</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-success">Ok</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-box-open"></i>
                            <p>Kho rạp này đang trống</p>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<div class="content-card" style="margin-top: 3rem; margin-bottom: 2rem;">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-filter"></i> Bộ Lọc</h2>
    </div>
    <div style="padding: 1.5rem;">
        @using (Html.BeginForm("Index", "InventoryManagement", FormMethod.Get))
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: end;">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tên sản phẩm..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Loại sản phẩm</label>
                    <select name="category" class="form-control">
                        <option value="">-- Tất cả --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat" @(ViewBag.SelectedCategory == cat ? "selected" : "")>@cat</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Lọc
                </button>
            </div>
        }
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-list"></i> Danh Sách Menu</h2>
        <span class="badge badge-primary">Tổng: @Model.Count() món</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Loại</th>
                    <th>Giá Bán</th>
                    <th>Trạng Thái</th>
                    <th style="width: 150px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.DoAn.Do_An_id</strong></td>
                        <td>
                            <strong style="color: #333;">@item.DoAn.ten_san_pham</strong>
                            @if (!string.IsNullOrEmpty(item.DoAn.mo_ta))
                            {
                                <div style="color: #666; font-size: 0.85rem; margin-top: 4px;">
                                    @(item.DoAn.mo_ta.Length > 40 ? item.DoAn.mo_ta.Substring(0, 40) + "..." : item.DoAn.mo_ta)
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge badge-category">@(item.DoAn.loai ?? "N/A")</span>
                        </td>



                        <td>
                            @if (item.DoAn.gia.HasValue)
                            {
                                <strong style="color: #27ae60;">@item.DoAn.gia.Value.ToString("N0") đ</strong>
                            }
                            else
                            {
                                <span style="color: #999;">Chưa định giá</span>
                            }
                        </td>

                        <td>
                            @if (item.DoAn.trang_thai == "Ngừng kinh doanh")
                            {
                                <span style="color: red; font-size: 0.9rem;"><i class="fas fa-ban"></i> Ngừng bán</span>
                            }
                            else
                            {
                                <span style="color: green; font-size: 0.9rem;"><i class="fas fa-check-circle"></i> Đang bán</span>
                            }
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a href="@Url.Action("Details", new { id = item.DoAn.Do_An_id })" class="btn btn-sm btn-info" title="Chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.DoAn.Do_An_id })" class="btn btn-sm btn-warning" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button onclick="deleteItem(@item.DoAn.Do_An_id)" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 3rem; color: #999;">
            <i class="fas fa-box-open" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5;"></i>
            <p style="font-size: 1.1rem;">Không có sản phẩm nào trong kho.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary" style="margin-top: 1rem;">
                <i class="fas fa-plus"></i> Thêm Sản Phẩm Đầu Tiên
            </a>
        </div>
    }
</div>

<style>
    /* Cinema Grid Layout */
    .cinema-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    /* Cinema Card */
    .cinema-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .cinema-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

    /* Cinema Card Header */
    .cinema-card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .cinema-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .cinema-icon {
        font-size: 1.5rem;
        color: white;
    }

    .cinema-name {
        margin: 0;
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .total-badge {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        color: white;
        padding: 0.4rem 0.9rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Cinema Card Body */
    .cinema-card-body {
        padding: 1.25rem;
        max-height: 350px;
        overflow-y: auto;
    }

        .cinema-card-body::-webkit-scrollbar {
            width: 6px;
        }

        .cinema-card-body::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .cinema-card-body::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 10px;
        }

            .cinema-card-body::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

    /* Product List */
    .product-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .product-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 8px;
        transition: background 0.2s ease;
    }

        .product-item:hover {
            background: #e9ecef;
        }

    .product-name {
        font-weight: 500;
        color: #333;
        font-size: 0.95rem;
    }

    .product-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .product-quantity {
        font-weight: 700;
        font-size: 1rem;
        min-width: 35px;
        text-align: center;
    }

    .quantity-success {
        color: #28a745;
    }

    .quantity-warning {
        color: #ffc107;
    }

    .quantity-danger {
        color: #dc3545;
    }

    .status-badge {
        padding: 0.25rem 0.6rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-success {
        background: #d4edda;
        color: #155724;
    }

    .status-warning {
        background: #fff3cd;
        color: #856404;
    }

    .status-danger {
        background: #f8d7da;
        color: #721c24;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #999;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 0.5rem;
            opacity: 0.3;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.95rem;
        }

    /* Original Styles */
    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .content-header h1 {
            font-size: 2rem;
            color: #333;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .content-header h2 {
            font-size: 1.5rem;
            color: #333;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
        }

    .header-actions {
        display: flex;
        gap: 1rem;
    }

    .badge-category {
        background: #3498db;
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: capitalize;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.875rem;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .badge-primary {
        background: #ff6b35;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
    }

    .badge-success {
        background-color: #28a745;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .badge-warning {
        background-color: #ffc107;
        color: #212529;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .badge-danger {
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .cinema-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@section scripts {
    <script>
        function deleteItem(id) {
            if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này? Việc xóa sẽ ảnh hưởng đến lịch sử nhập xuất!')) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
}