@model WebCinema.Models.Do_An

@{
    ViewBag.Title = "Chi Tiết Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

}

<div class="content-header">
    <h1><i class="fas fa-info-circle"></i> Chi Tiết Sản Phẩm</h1>
    <div class="header-actions">
        <a href="@Url.Action("Edit", new { id = Model.Do_An_id })" class="btn btn-warning">
            <i class="fas fa-edit"></i> Chỉnh Sửa
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay Lại
        </a>
    </div>
</div>

<!-- Product Information -->
<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-box"></i> Thông Tin Sản Phẩm</h2>
    </div>
    <div class="detail-body">
        <div class="detail-grid">
            <div class="detail-item">
                <label>ID:</label>
                <span><strong>@Model.Do_An_id</strong></span>
            </div>
            <div class="detail-item">
                <label>Tên Sản Phẩm:</label>
                <span><strong style="color: var(--color-primary); font-size: 1.1rem;">@Model.ten_san_pham</strong></span>
            </div>
            <div class="detail-item">
                <label>Loại:</label>
                <span>
                    <span class="badge badge-category">@(Model.loai ?? "Chưa phân loại")</span>
                </span>
            </div>
            <div class="detail-item">
                <label>Giá:</label>
                <span>
                    @if (Model.gia.HasValue)
                    {
                        <strong style="color: var(--color-success); font-size: 1.2rem;">@Model.gia.Value.ToString("N0") VNĐ</strong>
                    }
                    else
                    {
                        <span style="color: var(--color-text-light);">Chưa định giá</span>
                    }
                </span>
            </div>
            <div class="detail-item full-width">
                <label>Mô Tả:</label>
                <span>
                    @if (!string.IsNullOrEmpty(Model.mo_ta))
                    {
                        <p style="white-space: pre-wrap; color: var(--color-text-light); line-height: 1.6;">@Model.mo_ta</p>
                    }
                    else
                    {
                        <span style="color: var(--color-text-light);">Không có mô tả</span>
                    }
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Sales Statistics -->
<div class="content-card" style="margin-top: 2rem;">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-chart-bar"></i> Thống Kê Bán Hàng</h2>
    </div>
    <div class="detail-body">
        <div class="stats-grid">
            <div class="stat-card blue">
                <div class="stat-icon blue">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stat-content">
                    <h3>@ViewBag.TotalSold</h3>
                    <p>Tổng Số Lượng Đã Bán</p>
                </div>
            </div>
            <div class="stat-card green">
                <div class="stat-icon green">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div class="stat-content">
                    <h3>@((ViewBag.TotalRevenue ?? 0m).ToString("N0")) VNĐ</h3>
                    <p>Tổng Doanh Thu</p>
                </div>
            </div>
            <div class="stat-card purple">
                <div class="stat-icon purple">
                    <i class="fas fa-receipt"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.DonHang_DoAns.Count()</h3>
                    <p>Số Đơn Hàng</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="content-card" style="margin-top: 2rem;">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-history"></i> Đơn Hàng Gần Đây</h2>
    </div>
    @if (ViewBag.RecentOrders != null && ((System.Collections.Generic.List<WebCinema.Models.DonHang_DoAn>)ViewBag.RecentOrders).Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Ngày Đặt</th>
                    <th>Số Lượng</th>
                    <th>Thành Tiền</th>
                    <th>Khách Hàng</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in (System.Collections.Generic.List<WebCinema.Models.DonHang_DoAn>)ViewBag.RecentOrders)
                {
                    <tr>
                        <td><strong>@order.Dat_Ve_id</strong></td>
                        <td>
                            @{
                                var ngayTao = order.Dat_Ve != null && order.Dat_Ve.ngay_tao.HasValue
                                    ? order.Dat_Ve.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "N/A";
                            }
                            @ngayTao
                        </td>
                        <td>
                            <span class="badge" style="background: #17a2b8; color: white; padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 600;">@order.so_luong</span>
                        </td>
                        <td>
                            @if (Model.gia.HasValue)
                            {
                                <strong style="color: var(--color-success);">@((order.so_luong * Model.gia.Value).ToString("N0")) VNĐ</strong>
                            }
                            else
                            {
                                <span style="color: var(--color-text-light);">N/A</span>
                            }
                        </td>
                        <td>@(order.Dat_Ve != null && order.Dat_Ve.Khach_Hang != null ? order.Dat_Ve.Khach_Hang.ho_ten : "N/A")</td>
                        <td>
                            @{
                                var trangThai = order.Dat_Ve != null ? order.Dat_Ve.trang_thai_Dat_Ve : "";
                            }
                            @if (trangThai == "Đã Thanh toán")
                            {
                                <span class="badge badge-success">@trangThai</span>
                            }
                            else if (trangThai == "Đã Hủy")
                            {
                                <span class="badge badge-danger">@trangThai</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">@trangThai</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 2rem; color: var(--color-text-light);">
            <i class="fas fa-inbox" style="font-size: 3rem; opacity: 0.5; margin-bottom: 1rem;"></i>
            <p>Chưa có đơn hàng nào cho sản phẩm này.</p>
        </div>
    }
</div>

<style>
    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .content-header h1 {
            font-size: 1.8rem;
            color: var(--color-dark-blue);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 700;
        }

    .header-actions {
        display: flex;
        gap: 1rem;
    }

    .detail-body {
        padding: 2rem;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

        .detail-item.full-width {
            grid-column: 1 / -1;
        }

        .detail-item label {
            font-weight: 600;
            color: var(--color-text-light);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-item span {
            font-size: 1rem;
            color: var(--color-text);
        }

    .badge-category {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-block;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .stat-card {
        background: var(--color-white);
        border-radius: var(--border-radius);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border-left: 5px solid transparent;
    }

        .stat-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-5px);
        }

    .stat-card.blue { border-left-color: #007bff; }
    .stat-card.green { border-left-color: #28a745; }
    .stat-card.purple { border-left-color: #6f42c1; }

    .stat-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-white);
        font-size: 2rem;
    }

    .stat-icon.blue { background: linear-gradient(135deg, #007bff 0%, #3498db 100%); }
    .stat-icon.green { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); }
    .stat-icon.purple { background: linear-gradient(135deg, #6f42c1 0%, #8e44ad 100%); }

    .stat-content h3 {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--color-dark-blue);
        margin-bottom: 0.5rem;
    }

    .stat-content p {
        color: var(--color-text-light);
        font-size: 0.9rem;
        margin: 0;
        font-weight: 500;
    }

    .badge-success {
        background: var(--color-success);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-warning {
        background: var(--color-warning);
        color: #333;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-danger {
        background: var(--color-danger);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
