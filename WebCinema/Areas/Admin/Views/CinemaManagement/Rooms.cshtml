@model List<WebCinema.Models.Phong_Chieu>

@{
    ViewBag.Title = "Qu?n Lý Phòng Chi?u - " + ViewBag.CinemaName;
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    var cinemaId = ViewBag.CinemaId;
}

<div class="content-header">
    <h1><i class="fas fa-person-booth"></i> Qu?n Lý Phòng Chi?u: <span class="text-primary">@ViewBag.CinemaName</span></h1>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay L?i Danh Sách R?p
        </a>
        <a href="@Url.Action("CreateRoom", new { cinemaId = cinemaId })" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Phòng Chi?u M?i
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-list"></i> Danh Sách Phòng Chi?u</h2>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên Phòng</th>
                    <th>S? L??ng Gh?</th>
                    <th class="text-center">Hành ??ng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model)
                {
                    <tr>
                        <td>@room.phongchieu_id</td>
                        <td>@room.ten_phong</td>
                        <td>@room.so_luong_ghe</td>
                        <td class="text-center">
                            <a href="@Url.Action("EditRoom", new { id = room.phongchieu_id })" class="btn btn-sm btn-info" title="S?a">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button class="btn btn-sm btn-danger btn-delete" data-id="@room.phongchieu_id" title="Xóa">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function () {
                var roomId = $(this).data('id');
                if (confirm("B?n có ch?c ch?n mu?n xóa phòng chi?u này không?")) {
                    $.ajax({
                        url: '@Url.Action("DeleteRoom")',
                        type: 'POST',
                        data: { id: roomId },
                        success: function (response) {
                            if (response.success) {
                                alert(response.message);
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function () {
                            alert("?ã x?y ra l?i khi c? g?ng xóa phòng chi?u.");
                        }
                    });
                }
            });
        });
    </script>
}
