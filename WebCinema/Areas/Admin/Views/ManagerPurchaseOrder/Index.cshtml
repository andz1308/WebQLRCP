@using WebCinema.Areas.Admin.Controllers
@model ManagerDashboardViewModel

@{
    ViewBag.Title = "Quản Lý Nhập Kho & Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<style>

    .header-actions {
        display: flex;
        gap: 1rem;
    }

    /* Tab Navigation */
    .tab-navigation {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 2rem;
        border-bottom: 3px solid #ffe8dc;
        padding-bottom: 0;
    }

    .tab-link {
        padding: 1rem 2rem;
        background: white;
        border: 2px solid #ffe8dc;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
        text-decoration: none;
        color: #666;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .tab-link:hover {
            background: #fff5f0;
            color: #ff6b35;
            border-color: #ff9966;
        }

        .tab-link.active {
            background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
            color: white;
            border-color: #ff6b35;
            transform: translateY(3px);
        }

    /* Filter and Content Cards */
    .filter-card, .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
    }

    .filter-card {
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .content-card {
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-header h2, .card-header h3 {
            color: white;
            margin: 0;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .badge-primary {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Form Styling */
    .form-group {
        margin-bottom: 1rem;
    }

    .form-label {
        color: #ff6b35;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .form-control {
        border: 2px solid #ffe8dc;
        border-radius: 8px;
        padding: 0.6rem;
    }

        .form-control:focus {
            border-color: #ff9966;
            box-shadow: 0 0 0 3px rgba(255, 153, 102, 0.1);
            outline: none;
        }

    /* Button Styling */
    .btn-primary {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #ff6b35 0%, #ff5722 100%);
            transform: translateY(-2px);
        }

    .btn-warning {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-warning:hover {
            background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
            transform: translateY(-2px);
        }

    .btn-sm {
        padding: 0.5rem 0.9rem;
        font-size: 0.875rem;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }

        .btn-sm:hover {
            transform: translateY(-2px);
        }

    .btn-success {
        background: #28a745;
    }

        .btn-success:hover {
            background: #218838;
        }

    .btn-danger {
        background: #dc3545;
    }

        .btn-danger:hover {
            background: #c82333;
        }

    .btn-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #5a6268 0%, #495057 100%);
            transform: translateY(-2px);
        }

    /* Table Styling */
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead th {
            background: #fff5f0;
            color: #ff6b35;
            font-weight: 600;
            padding: 1rem;
            text-align: left;
            border-bottom: 2px solid #ff9966;
        }

        .data-table tbody td {
            padding: 1rem;
            border-bottom: 1px solid #ffe8dc;
        }

        .data-table tbody tr:hover {
            background: #fff5f0;
        }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-start;
    }

    /* Pagination */
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem;
    }

        .pagination-container .btn {
            padding: 0.5rem 1rem;
            border: 2px solid #ffe8dc;
            border-radius: 6px;
        }

        .pagination-container span {
            color: #ff6b35;
            font-weight: 600;
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #999;
    }

        .empty-state i {
            font-size: 4rem;
            color: #ffe8dc;
            margin-bottom: 1rem;
        }

        .empty-state p {
            font-size: 1.1rem;
        }
</style>

<div class="content-header">
    <h1><i class="fas fa-clipboard-list"></i> Quản Lý Nhập Kho & Khuyến Mãi</h1>
</div>

<!-- Tab Navigation -->
<div class="tab-navigation">
    <a href="@Url.Action("Index", "ManagerPurchaseOrder")" class="tab-link active">
        <i class="fas fa-box-open"></i> Yêu Cầu Nhập Kho
    </a>
    <a href="@Url.Action("Promotions", "ManagerPurchaseOrder")" class="tab-link">
        <i class="fas fa-tags"></i> Đề Xuất Khuyến Mãi
    </a>
</div>

<!-- Tồn Kho Chi Tiết Theo Rạp -->
@Html.Partial("_CinemaStockPartial")

<!-- Filter Section -->
<div class="filter-card">
    @using (Html.BeginForm("Index", "ManagerPurchaseOrder", FormMethod.Get, new { area = "Admin" }))
    {
        <div class="row">
            <div class="col-md-3">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">
                        <i class="fas fa-filter"></i> Trạng thái
                    </label>
                    <select name="status" class="form-control">
                        <option value="">-- Tất cả --</option>
                        <option value="Chờ duyệt" @(ViewBag.SelectedStatus == "Chờ duyệt" ? "selected" : "")>Chờ duyệt</option>
                        <option value="Đã duyệt" @(ViewBag.SelectedStatus == "Đã duyệt" ? "selected" : "")>Đã duyệt</option>
                        <option value="Đã nhập" @(ViewBag.SelectedStatus == "Đã nhập" ? "selected" : "")>Đã nhập</option>
                        <option value="Đã hủy" @(ViewBag.SelectedStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">
                        <i class="fas fa-calendar"></i> Từ ngày
                    </label>
                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">
                        <i class="fas fa-calendar-check"></i> Đến ngày
                    </label>
                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
                </div>
            </div>
            <div class="col-md-3" style="display: flex; align-items: flex-end;">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
            </div>
        </div>
    }
</div>

<!-- Phiếu Nhập Kho -->
<div class="content-card">
    <div class="card-header">
        <h2><i class="fas fa-file-invoice"></i> Phiếu Nhập Kho</h2>
        <span class="badge-primary">@ViewBag.TotalItems phiếu</span>
    </div>

    @if (Model.DSNhapKho != null && Model.DSNhapKho.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã Phiếu</th>
                        <th>Rạp</th>
                        <th>Nhà Cung Cấp</th>
                        <th>Ngày Nhập</th>
                        <th>Trạng Thái</th>
                        <th style="width: 180px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.DSNhapKho)
                    {
                        <tr>
                            <td><strong>#@p.phieu_nhap_id</strong></td>
                            <td>@(p.Rap != null ? p.Rap.ten_rap : "N/A")</td>
                            <td>@(p.Nha_Cung_Cap != null ? p.Nha_Cung_Cap.ten_nha_cung_cap : "")</td>
                            <td>
                                @(p.ngay_nhap.HasValue ? p.ngay_nhap.Value.ToString("dd/MM/yyyy") : "Chưa nhập")
                            </td>
                            <td>
                                @if (p.trang_thai == "Chờ duyệt")
                                {
                                    <span style="color: #ffc107; font-weight: 600;"><i class="fas fa-clock"></i> Chờ duyệt</span>
                                }
                                else if (p.trang_thai == "Đã duyệt")
                                {
                                    <span style="color: #17a2b8; font-weight: 600;"><i class="fas fa-check"></i> Đã duyệt</span>
                                }
                                else if (p.trang_thai == "Đã nhập")
                                {
                                    <span style="color: #28a745; font-weight: 600;"><i class="fas fa-check-circle"></i> Đã nhập</span>
                                }
                                else if (p.trang_thai == "Đã hủy")
                                {
                                    <span style="color: #dc3545; font-weight: 600;"><i class="fas fa-ban"></i> Đã hủy</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("Details", new { id = p.phieu_nhap_id })" class="btn btn-sm" style="background: #17a2b8; color: white;" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (p.trang_thai == "Chờ duyệt")
                                    {
                                        <button onclick="approveImport(@p.phieu_nhap_id)" class="btn btn-sm btn-success" title="Duyệt">
                                            <i class="fas fa-check"></i>
                                        </button>
                                        <button onclick="rejectImport(@p.phieu_nhap_id)" class="btn btn-sm btn-danger" title="Từ chối">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        if (ViewBag.TotalPages > 1)
        {
            <div class="pagination-container">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = ViewBag.CurrentPage - 1 })"
                       class="btn btn-secondary">
                        <i class="fas fa-chevron-left"></i> Trước
                    </a>
                }

                <span>
                    Trang @ViewBag.CurrentPage / @ViewBag.TotalPages
                </span>

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = ViewBag.CurrentPage + 1 })"
                       class="btn btn-secondary">
                        Sau <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <p>Chưa có phiếu nhập kho nào.</p>
        </div>
    }
</div>

@section scripts {
    <script>
        function approveImport(id) {
            if (confirm('Xác nhận duyệt phiếu nhập kho này?')) {
                $.post('@Url.Action("Approve")', { id: id }, function (res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                });
            }
        }

        function rejectImport(id) {
            var reason = prompt('Nhập lý do từ chối:');
            if (reason) {
                $.post('@Url.Action("Reject")', { id: id, reason: reason }, function (res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                });
            }
        }
    </script>
}