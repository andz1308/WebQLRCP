@model WebCinema.Models.Phieu_De_Xuat_Khuyen_Mai
@using WebCinema.Areas.Admin.Controllers

@{
    ViewBag.Title = "Chi Tiết Đề Xuất Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    var details = ViewBag.Details as IEnumerable<PromotionDetailViewModel>;
}

<div class="content-header">
    <h1><i class="fas fa-file-contract"></i> Chi Tiết Phiếu #DX-@Model.de_xuat_id</h1>
    <a href="@Url.Action("Promotions")" class="btn btn-secondary">Quay lại</a>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="content-card mb-3">
            <div class="card-header bg-info text-white">
                <h3 class="card-title m-0">Thông Tin Đề Xuất</h3>
            </div>
            <div class="p-3">
                <div class="d-flex justify-content-between mb-2">
                    <strong>Ngày tạo:</strong>
                    <span>@Model.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <strong>Người tạo:</strong>
                    <span>@(Model.Nhan_Vien != null ? Model.Nhan_Vien.ho_ten : "N/A")</span>
                </div>

                <div class="alert alert-warning mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong style="font-size:1.1rem;">Mức Giảm Đề Xuất:</strong>
                        <span class="badge badge-danger p-2" style="font-size:1.2rem;">-@Model.muc_giam_gia%</span>
                    </div>
                    @if ((Model.so_luong_ton ?? 0) > 0)
                    {
                        <hr class="my-2" />
                        <small><em>Điều kiện: Áp dụng cho các món tồn kho > @Model.so_luong_ton</em></small>
                    }
                </div>

                <div class="form-group">
                    <label><strong>Lý do:</strong></label>
                    <div class="bg-light p-2 rounded border">@Model.ly_do</div>
                </div>

                <div class="d-flex justify-content-between mt-3 mb-3">
                    <strong>Trạng thái:</strong>
                    @if (Model.trang_thai == "Chờ duyệt")
                    {<span class="badge badge-warning">Chờ duyệt</span> }
                    else if (Model.trang_thai == "Đã duyệt")
                    { <span class="badge badge-success">Đã duyệt</span> }
                    else
                    { <span class="badge badge-danger">Từ chối</span>}
                </div>

                @if (Model.trang_thai == "Chờ duyệt")
                {
                    <hr />
                    <div class="d-flex gap-2">
                        <button onclick="approvePromo(@Model.de_xuat_id)" class="btn btn-success flex-fill">
                            <i class="fas fa-check"></i> Duyệt & Tạo Mã
                        </button>
                        <button onclick="rejectPromo(@Model.de_xuat_id)" class="btn btn-danger flex-fill">
                            <i class="fas fa-times"></i> Từ Chối
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="content-card">
            <div class="card-header">
                <h3 class="card-title m-0">Danh Sách Sản Phẩm Áp Dụng</h3>
            </div>
            <table class="data-table table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th>Tên Món Ăn</th>
                        <th>Loại</th>
                    </tr>
                </thead>
                <tbody>
                    @if (details != null)
                    {
                        int i = 1;
                        foreach (var item in details)
                        {
                            <tr>
                                <td class="text-center text-muted">@(i++)</td>
                                <td><strong>@item.da.ten_san_pham</strong></td>
                                <td><span class="badge badge-secondary">@item.da.loai</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="text-center">Không có dữ liệu.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function approvePromo(id) {
        if (confirm('Duyệt đề xuất này và chuyển sang trang tạo mã khuyến mãi?')) {
            $.post('@Url.Action("ApprovePromotion")', { id: id }, function (res) {
                if (res.success) {
                    alert(res.message);
                    if (res.isRedirect) window.location.href = res.redirectUrl;
                    else location.href='@Url.Action("Promotions")';
                } else {
                    alert(res.message);
                }
            });
        }
    }

    function rejectPromo(id) {
        var r = prompt("Nhập lý do từ chối:");
        if (r) {
            $.post('@Url.Action("RejectPromotion")', { id: id, reason: r }, function (res) {
                if (res.success) { alert(res.message); location.href='@Url.Action("Promotions")'; }
                else alert(res.message);
            });
        }
    }
</script>

<style>
    .badge-warning {
        background-color: #ffc107;
        color: #212529;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .badge-success {
        background-color: #28a745;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .badge-danger {
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .badge-secondary {
        background-color: #6c757d;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
    }
</style>