@{
    var cinemaStocks = ViewBag.CinemaStocks as List<WebCinema.Areas.Admin.Controllers.CinemaStockViewModel>;
}

@if (cinemaStocks != null && cinemaStocks.Any())
{
    <div style="margin-bottom: 3rem;">
        <div class="section-header">
            <h2>
                <i class="fas fa-boxes"></i> Tồn Kho Chi Tiết Theo Rạp
            </h2>
        </div>

        <div class="cinema-grid">
            @foreach (var rap in cinemaStocks)
            {
                <div class="cinema-card">
                    <div class="cinema-card-header">
                        <div class="cinema-info">
                            <i class="fas fa-building cinema-icon"></i>
                            <h3 class="cinema-name">@rap.TenRap</h3>
                        </div>
                        <span class="total-badge">@rap.TongSoLuong món</span>
                    </div>

                    <div class="cinema-card-body">
                        @if (rap.DanhSachMon.Count > 0)
                        {
                            <div class="product-list">
                                @foreach (var item in rap.DanhSachMon)
                                {
                                    <div class="product-item">
                                        <div class="product-name">@item.TenMon</div>
                                        <div class="product-info">
                                            <span class="product-quantity
                                                @(item.SoLuong <= 0 ? "quantity-danger" :
                                                  item.SoLuong < 20 ? "quantity-warning" : "quantity-success")">
                                                @item.SoLuong
                                            </span>
                                            @if (item.TrangThai == "Hết hàng")
                                            {
                                                <span class="status-badge status-danger">Hết</span>
                                            }
                                            else if (item.TrangThai == "Sắp hết")
                                            {
                                                <span class="status-badge status-warning">Thiếu</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-success">Ok</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state-small">
                                <i class="fas fa-box-open"></i>
                                <p>Kho rạp này đang trống</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    /* Section Header */
    .section-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        border: 2px solid #ff9966;
    }

        .section-header h2 {
            font-size: 1.5rem;
            color: #ff6b35;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            font-weight: 700;
        }

    /* Cinema Grid Layout */
    .cinema-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    /* Cinema Card */
    .cinema-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .cinema-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(255, 107, 53, 0.15);
        }

    /* Cinema Card Header */
    .cinema-card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .cinema-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .cinema-icon {
        font-size: 1.5rem;
        color: white;
    }

    .cinema-name {
        margin: 0;
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .total-badge {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        color: white;
        padding: 0.4rem 0.9rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Cinema Card Body */
    .cinema-card-body {
        padding: 1.25rem;
        max-height: 350px;
        overflow-y: auto;
    }

        .cinema-card-body::-webkit-scrollbar {
            width: 6px;
        }

        .cinema-card-body::-webkit-scrollbar-track {
            background: #ffe8dc;
            border-radius: 10px;
        }

        .cinema-card-body::-webkit-scrollbar-thumb {
            background: #ff9966;
            border-radius: 10px;
        }

            .cinema-card-body::-webkit-scrollbar-thumb:hover {
                background: #ff6b35;
            }

    /* Product List */
    .product-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .product-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        background: #fff5f0;
        border-radius: 8px;
        transition: background 0.2s ease;
        border: 1px solid #ffe8dc;
    }

        .product-item:hover {
            background: #ffe8dc;
        }

    .product-name {
        font-weight: 500;
        color: #333;
        font-size: 0.95rem;
    }

    .product-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .product-quantity {
        font-weight: 700;
        font-size: 1rem;
        min-width: 35px;
        text-align: center;
    }

    .quantity-success {
        color: #28a745;
    }

    .quantity-warning {
        color: #ffc107;
    }

    .quantity-danger {
        color: #dc3545;
    }

    .status-badge {
        padding: 0.25rem 0.6rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-success {
        background: #d4edda;
        color: #155724;
    }

    .status-warning {
        background: #fff3cd;
        color: #856404;
    }

    .status-danger {
        background: #f8d7da;
        color: #721c24;
    }

    /* Empty State */
    .empty-state-small {
        text-align: center;
        padding: 2rem;
        color: #999;
    }

        .empty-state-small i {
            font-size: 3rem;
            margin-bottom: 0.5rem;
            opacity: 0.3;
            color: #ff9966;
        }

        .empty-state-small p {
            margin: 0;
            font-size: 0.95rem;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .cinema-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
