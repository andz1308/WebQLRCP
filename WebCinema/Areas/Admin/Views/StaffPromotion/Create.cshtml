@{
    ViewBag.Title = "Tạo Phiếu Đề Xuất Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";

    // Lấy danh sách tất cả món ăn để chọn thủ công nếu cần
    var allFoods = ViewBag.AllFoods as List<WebCinema.Models.Do_An>;
}

<div class="content-header">
    <h1><i class="fas fa-bullhorn"></i> Đề Xuất Khuyến Mãi (Xả Kho)</h1>
    <div class="header-actions">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<input type="hidden" id="hdStockThreshold" value="@ViewBag.StockLimit" />

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-file-alt"></i> Thông Tin Đề Xuất</h2>
    </div>
    <div style="padding: 1.5rem;">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label class="form-label">Mức giảm giá đề xuất (%):</label>
                    <div class="input-group">
                        <input type="number" id="txtPercent" class="form-control form-control-lg"
                               style="font-weight: bold; color: #ff6b35;"
                               placeholder="VD: 20" min="1" max="100" value="20" />
                        <div class="input-group-append">
                            <span class="input-group-text" style="font-weight: bold; background: #fff5f0; color: #ff6b35; border: 2px solid #ffe5dc;">%</span>
                        </div>
                    </div>
                    <small class="text-muted">Áp dụng chung cho toàn bộ danh sách bên dưới.</small>
                </div>
            </div>

            <div class="col-md-8">
                <div class="form-group">
                    <label class="form-label">Lý do / Ghi chú:</label>
                    <textarea id="txtReason" class="form-control" rows="3" placeholder="VD: Xả hàng tồn kho cao, kích cầu doanh số..."></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content-card" style="margin-top: 1.5rem;">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-plus-circle"></i> Thêm Sản Phẩm</h2>
    </div>
    <div style="padding: 1.5rem;">
        <div style="display: grid; grid-template-columns: 3fr auto; gap: 1rem; align-items: end;">
            <div class="form-group" style="margin: 0;">
                <label class="form-label">Thêm món thủ công (nếu cần):</label>
                <select id="ddlFood" class="form-control">
                    <option value="">-- Chọn món ăn --</option>
                    @if (allFoods != null)
                    {
                        foreach (var item in allFoods)
                        {
                            <option value="@item.Do_An_id" data-name="@item.ten_san_pham">@item.ten_san_pham</option>
                        }
                    }
                </select>
            </div>
            <button class="btn btn-success" onclick="addManual()">
                <i class="fas fa-plus-circle"></i> Thêm vào phiếu
            </button>
        </div>
    </div>
</div>

<div class="content-card" style="margin-top: 1.5rem;">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-list"></i> Danh Sách Sản Phẩm Trong Phiếu</h2>
        <span class="badge badge-info" id="itemCount">0 món</span>
    </div>
    <table class="data-table" id="tblProposal">
        <thead>
            <tr>
                <th style="width: 50px;">STT</th>
                <th>Tên Món Ăn</th>
                <th style="width: 120px;">Hành Động</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="3" style="text-align: center; padding: 3rem; color: #999;">
                    <i class="fas fa-box-open" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; display: block;"></i>
                    <p>Chưa có món nào. Vui lòng thêm món hoặc dùng chức năng tự động.</p>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div style="text-align: right; margin-top: 2rem; display: flex; gap: 1rem; justify-content: flex-end;">
    <a href="@Url.Action("Index", "StaffPromotion")" class="btn btn-secondary">
        <i class="fas fa-times"></i> Hủy
    </a>
    <button class="btn btn-primary" onclick="submitProposal()">
        <i class="fas fa-paper-plane"></i> Gửi Đề Xuất Duyệt
    </button>
</div>

@section scripts {
    <script>
        // Mảng chứa danh sách các món ăn đang chọn
        var list = [];

        // --- KHỞI TẠO ---
        $(document).ready(function() {
            // 1. Lấy dữ liệu tự động từ Controller (nếu bấm từ trang Quản lý kho)
            var autoData = @Html.Raw(ViewBag.AutoPromoList ?? "[]");
            var autoMsg = '@Html.Raw(ViewBag.AutoMessage)';

            // 2. Nếu có dữ liệu -> Đổ vào bảng ngay
            if (autoData && autoData.length > 0) {
                list = [];
                autoData.forEach(function(item) {
                    // Chỉ cần ID và Tên (Percent đã chuyển ra ngoài)
                    list.push({ Id: item.Id, Name: item.Name });
                });

                // Vẽ lại bảng
                render();

                // Điền sẵn lý do nếu chưa có
                $('#txtReason').val('Đề xuất xả hàng tồn kho (Số lượng > ' + $('#hdStockThreshold').val() + ').');

                // Thông báo
                if(autoMsg) alert(autoMsg);
            }
        });

        // --- HÀM THÊM THỦ CÔNG ---
        function addManual() {
            var id = $('#ddlFood').val();
            var name = $('#ddlFood option:selected').data('name');

            if(!id) { alert("Vui lòng chọn món ăn!"); return; }

            // Kiểm tra trùng
            if(list.find(x => x.Id == id)) {
                alert("Món này đã có trong danh sách!");
                return;
            }

            list.push({ Id: id, Name: name });
            render();
        }

        // --- HÀM XÓA DÒNG ---
        function remove(index) {
            list.splice(index, 1);
            render();
        }

        // --- HÀM VẼ BẢNG ---
        function render() {
            var html = '';
            if (list.length === 0) {
                html = '<tr><td colspan="3" style="text-align: center; padding: 3rem; color: #999;"><i class="fas fa-box-open" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; display: block;"></i><p>Chưa có món nào. Vui lòng thêm món hoặc dùng chức năng tự động.</p></td></tr>';
            } else {
                list.forEach((item, i) => {
                    html += `<tr>
                                <td style="text-align: center;"><strong>${i + 1}</strong></td>
                                <td><strong style="color: #333; font-size: 1.05rem;">${item.Name}</strong></td>
                                <td style="text-align: center;">
                                    <button class="btn btn-danger btn-sm" onclick="remove(${i})" title="Xóa món này">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                             </tr>`;
                });
            }
            $('#tblProposal tbody').html(html);
            $('#itemCount').text(list.length + ' món');
        }

        // --- HÀM GỬI ĐỀ XUẤT ---
        function submitProposal() {
            // Validate
            if (list.length === 0) {
                alert("Danh sách trống! Vui lòng thêm ít nhất 1 món ăn.");
                return;
            }

            var percent = $('#txtPercent').val();
            var reason = $('#txtReason').val();
            var stockThreshold = $('#hdStockThreshold').val() || 0; // Lấy giá trị tồn kho điều kiện

            if (!percent || percent <= 0 || percent > 100) {
                alert("Vui lòng nhập mức giảm giá hợp lệ (1-100%).");
                $('#txtPercent').focus();
                return;
            }

            if (!reason.trim()) {
                alert("Vui lòng nhập lý do đề xuất.");
                $('#txtReason').focus();
                return;
            }

            // Confirm & Ajax
            if (confirm("Xác nhận gửi phiếu đề xuất cho " + list.length + " món ăn này?")) {
                $.ajax({
                    url: '@Url.Action("Create", "StaffPromotion")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        items: list,        // Danh sách món (chỉ ID)
                        reason: reason,     // Lý do
                        percent: percent,   // Mức giảm chung
                        stockThreshold: stockThreshold // Ngưỡng tồn kho
                    }),
                    success: function(res) {
                        if (res.success) {
                            alert('✅ ' + res.message);
                            window.location.href = '@Url.Action("Index", "StaffPromotion")';
                        } else {
                            alert('❌ Lỗi: ' + res.message);
                        }
                    },
                    error: function() {
                        alert('❌ Lỗi kết nối Server.');
                    }
                });
            }
        }

        // Init
        render();
    </script>
}

<style>
    /* ============================
       HEADER & LAYOUT
       ============================ */
    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .content-header h1 {
            font-size: 2rem;
            color: black;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 700;
        }

            .content-header h1 i {
                color: black;
            }

    .header-actions {
        display: flex;
        gap: 1rem;
    }

    /* ============================
       CARDS
       ============================ */
    .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(255, 107, 53, 0.15);
        overflow: hidden;
        border: 1px solid rgba(255, 107, 53, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.2);
    }

    .card-title {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    /* ============================
       FORMS
       ============================ */
    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #ff6b35;
        font-size: 0.95rem;
    }

    .form-control {
        width: 100%;
        padding: 0.6rem 1rem;
        border: 2px solid #ffe5dc;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background-color: #fff;
    }

        .form-control:focus {
            outline: none;
            border-color: #ff6b35;
            box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.15);
            background-color: #fffaf8;
        }

        .form-control:hover {
            border-color: #ff8555;
        }

    .input-group {
        display: flex;
    }

        .input-group .form-control {
            border-radius: 8px 0 0 8px;
        }

    .input-group-append {
        display: flex;
    }

        .input-group-append .input-group-text {
            border-radius: 0 8px 8px 0;
            padding: 0.6rem 1rem;
            display: flex;
            align-items: center;
        }

    /* ============================
       BUTTONS
       ============================ */
    .btn {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
            background: linear-gradient(135deg, #ff5722 0%, #ff7043 100%);
        }

    .btn-success {
        background: linear-gradient(135deg, #ff9f55 0%, #ffb366 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(255, 159, 85, 0.3);
    }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 159, 85, 0.4);
            background: linear-gradient(135deg, #ff8c3d 0%, #ffa354 100%);
        }

    .btn-secondary {
        background: #95a5a6;
        color: white;
    }

        .btn-secondary:hover {
            background: #7f8c8d;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(149, 165, 166, 0.3);
        }

    .btn-danger {
        background: linear-gradient(135deg, #e74c3c 0%, #ec7063 100%);
        color: white;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
        }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.875rem;
    }

    /* ============================
       TABLE
       ============================ */
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead {
            background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        }

        .data-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: #ff6b35;
            border-bottom: 2px solid #ff6b35;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .data-table td {
            padding: 1rem;
            border-bottom: 1px solid #ffe5dc;
            color: #333;
        }

        .data-table tbody tr {
            transition: all 0.2s ease;
        }

        .data-table tbody tr:hover {
            background: #fffaf8;
            box-shadow: 0 2px 8px rgba(255, 107, 53, 0.1);
        }

    /* ============================
       BADGES
       ============================ */
    .badge {
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-info {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
    }

    /* ============================
       UTILITIES
       ============================ */
    .text-muted {
        color: #999 !important;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-left: -15px;
        margin-right: -15px;
    }

    .col-md-4 {
        flex: 0 0 33.333333%;
        max-width: 33.333333%;
        padding-left: 15px;
        padding-right: 15px;
    }

    .col-md-8 {
        flex: 0 0 66.666667%;
        max-width: 66.666667%;
        padding-left: 15px;
        padding-right: 15px;
    }

    /* ============================
       RESPONSIVE
       ============================ */
    @@media (max-width: 768px) {
        .content-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .content-header h1 {
            font-size: 1.5rem;
        }

        .col-md-4,
        .col-md-8 {
            flex: 0 0 100%;
            max-width: 100%;
        }

        div[style*="grid-template-columns"] {
            grid-template-columns: 1fr !important;
        }

        .data-table {
            font-size: 0.85rem;
        }

        .data-table th,
        .data-table td {
            padding: 0.75rem 0.5rem;
        }
    }

    /* ============================
       ACCENT & HIGHLIGHTS
       ============================ */
    ::selection {
        background: #ff6b35;
        color: white;
    }

    ::-moz-selection {
        background: #ff6b35;
        color: white;
    }

    /* Scrollbar styling */
    ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    ::-webkit-scrollbar-track {
        background: #fff5f0;
    }

    ::-webkit-scrollbar-thumb {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        border-radius: 5px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(135deg, #ff5722 0%, #ff7043 100%);
        }
</style>