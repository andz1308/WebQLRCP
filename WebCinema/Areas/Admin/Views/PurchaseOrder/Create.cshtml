@model WebCinema.Models.Phieu_Nhap_Hang
@{
    ViewBag.Title = "Tạo Phiếu Nhập Hàng";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

}

<div class="container-fluid">
    <div class="content-card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-plus-circle"></i> Tạo Phiếu Nhập Hàng Mới
            </h2>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </a>
        </div>

        @using (Html.BeginForm("Create", "PurchaseOrder", FormMethod.Post, new { id = "formCreate" }))
        {
            @Html.AntiForgeryToken()

            <div style="background: white; border-radius: 8px; padding: 2rem; margin-bottom: 1.5rem;">
                <h5 style="margin-bottom: 1.5rem; color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 0.5rem;">
                    <i class="fas fa-info-circle"></i> Thông Tin Phiếu Nhập
                </h5>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                    <div class="form-group">
                        <label class="form-label">Nhà Cung Cấp <span class="text-danger">*</span></label>
                        @Html.DropDownList("nha_cung_cap_id", (SelectList)ViewBag.Suppliers, 
                            "-- Chọn nhà cung cấp --", new { @class = "form-control", required = "required" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ngày Nhập <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="ngay_nhap" class="form-control" 
                               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Ghi Chú</label>
                    <textarea name="ghi_chu" class="form-control" rows="2" placeholder="Ghi chú về phiếu nhập..."></textarea>
                </div>
            </div>

            <div style="background: white; border-radius: 8px; padding: 2rem;">
                <h5 style="margin-bottom: 1.5rem; color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 0.5rem;">
                    <i class="fas fa-box"></i> Chi Tiết Sản Phẩm
                </h5>
                <table class="table" id="tblProducts" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                            <th style="padding: 1rem; width: 35%;">Sản Phẩm</th>
                            <th style="padding: 1rem; width: 15%;">Số Lượng</th>
                            <th style="padding: 1rem; width: 20%;">Đơn Giá (VNĐ)</th>
                            <th style="padding: 1rem; width: 20%;">Thành Tiền</th>
                            <th style="padding: 1rem; width: 10%;">
                                <button type="button" class="btn btn-success" onclick="addProductRow()" style="padding: 0.5rem 1rem;">
                                    <i class="fas fa-plus"></i> Thêm
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="productRows">
                        <!-- Rows will be added dynamically -->
                    </tbody>
                    <tfoot>
                        <tr style="background: #f8f9fa; font-weight: bold; border-top: 2px solid #dee2e6;">
                            <td colspan="3" style="padding: 1rem; text-align: right;">TỔNG TIỀN:</td>
                            <td id="totalAmount" style="padding: 1rem; color: #e74c3c; font-size: 1.2rem;">0 VNĐ</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <input type="hidden" name="chiTietJson" id="chiTietJson" />

            <div style="margin-top: 2rem; text-align: right;">
                <button type="submit" class="btn btn-primary" style="padding: 1rem 3rem;">
                    <i class="fas fa-save"></i> Lưu Phiếu Nhập
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        var products = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Products));
        var rowIndex = 0;

        function addProductRow() {
            var html = `
                <tr id="row_${rowIndex}" style="border-bottom: 1px solid #dee2e6;">
                    <td style="padding: 1rem;">
                        <select class="form-control product-select" onchange="calculateRow(${rowIndex})" required>
                            <option value="">-- Chọn sản phẩm --</option>
                            ${products.map(p => `<option value="${p.Do_An_id}" data-name="${p.ten_san_pham}">${p.ten_san_pham} (Tồn: ${p.so_luong || 0})</option>`).join('')}
                        </select>
                    </td>
                    <td style="padding: 1rem;">
                        <input type="number" class="form-control quantity-input" min="1" value="1" 
                               onchange="calculateRow(${rowIndex})" required />
                    </td>
                    <td style="padding: 1rem;">
                        <input type="number" class="form-control price-input" min="0" step="1000" value="0" 
                               onchange="calculateRow(${rowIndex})" required placeholder="Giá nhập" />
                    </td>
                    <td class="row-total" style="padding: 1rem; font-weight: 600;">0 VNĐ</td>
                    <td style="padding: 1rem; text-align: center;">
                        <button type="button" class="btn btn-danger" onclick="removeRow(${rowIndex})" style="padding: 0.5rem 1rem;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
            $('#productRows').append(html);
            rowIndex++;
        }

        function removeRow(index) {
            $(`#row_${index}`).remove();
            calculateTotal();
        }

        function calculateRow(index) {
            var row = $(`#row_${index}`);
            var quantity = parseInt(row.find('.quantity-input').val()) || 0;
            var price = parseFloat(row.find('.price-input').val()) || 0;
            var total = quantity * price;
            row.find('.row-total').text(total.toLocaleString('vi-VN') + ' VNĐ');
            calculateTotal();
        }

        function calculateTotal() {
            var total = 0;
            $('#productRows tr').each(function() {
                var rowTotal = parseFloat($(this).find('.price-input').val() || 0) * 
                               parseInt($(this).find('.quantity-input').val() || 0);
                total += rowTotal;
            });
            $('#totalAmount').text(total.toLocaleString('vi-VN') + ' VNĐ');
        }

        $('#formCreate').on('submit', function(e) {
            var chiTiet = [];
            $('#productRows tr').each(function() {
                var productId = $(this).find('.product-select').val();
                var quantity = $(this).find('.quantity-input').val();
                var price = $(this).find('.price-input').val();
                
                if (productId && quantity && price) {
                    chiTiet.push({
                        do_an_id: parseInt(productId),
                        so_luong: parseInt(quantity),
                        don_gia: parseFloat(price),
                        ghi_chu: ""
                    });
                }
            });

            if (chiTiet.length === 0) {
                alert('Vui lòng thêm ít nhất 1 sản phẩm!');
                e.preventDefault();
                return false;
            }

            $('#chiTietJson').val(JSON.stringify(chiTiet));
        });

        // Add first row on page load
        $(document).ready(function() {
            addProductRow();
        });
    </script>
}
