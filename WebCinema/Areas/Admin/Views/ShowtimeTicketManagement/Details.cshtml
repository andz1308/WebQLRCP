@model WebCinema.Models.Suat_Chieu

@{
    ViewBag.Title = "Chi Tiết Vé Suất Chiếu";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
    
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as System.Collections.Generic.List<WebCinema.Models.Ve>;
}

<div class="content-card">
    <!-- Header -->
    <div class="card-header">
        <h2 class="card-title">
            <i class="fas fa-ticket-alt"></i> Chi Tiết Vé Suất Chiếu
        </h2>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay Lại
        </a>
    </div>

    <!-- Showtime Info -->
    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 12px; margin-bottom: 2rem;">
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
            <div>
                <h3 style="margin: 0 0 1.5rem 0; font-size: 1.8rem;">
                    <i class="fas fa-film"></i> @showtime.Phim.ten_phim
                </h3>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; font-size: 1.05rem;">
                    <div><i class="fas fa-building"></i> <strong>Rạp:</strong> @showtime.Phong_Chieu.Rap.ten_rap</div>
                    <div><i class="fas fa-door-open"></i> <strong>Phòng:</strong> @showtime.Phong_Chieu.ten_phong</div>
                    <div><i class="fas fa-calendar-alt"></i> <strong>Ngày:</strong> @showtime.ngay_chieu.ToString("dd/MM/yyyy (dddd)", new System.Globalization.CultureInfo("vi-VN"))</div>
                    <div><i class="fas fa-clock"></i> <strong>Giờ:</strong> @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm") - @showtime.Ca_Chieu.gio_ket_thuc.ToString(@"hh\:mm")</div>
                    <div><i class="fas fa-money-bill-wave"></i> <strong>Giá vé:</strong> @showtime.gia_ve.ToString("N0") đ</div>
                    <div><i class="fas fa-language"></i> <strong>Ngôn ngữ:</strong> @(showtime.ngon_ngu ?? "N/A")</div>
                </div>
            </div>
            
            <!-- Stats -->
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                <div style="background: rgba(255,255,255,0.2); padding: 1rem; border-radius: 8px; text-align: center;">
                    <div style="font-size: 2.5rem; font-weight: bold;">@ViewBag.TotalTickets</div>
                    <div style="font-size: 0.9rem;">Tổng vé</div>
                </div>
                <div style="background: rgba(255,255,255,0.2); padding: 1rem; border-radius: 8px; text-align: center;">
                    <div style="font-size: 2.5rem; font-weight: bold;">@ViewBag.AvailableTickets</div>
                    <div style="font-size: 0.9rem;">Còn trống</div>
                </div>
                <div style="background: rgba(255,255,255,0.2); padding: 1rem; border-radius: 8px; text-align: center;">
                    <div style="font-size: 2.5rem; font-weight: bold;">@ViewBag.BookedTickets</div>
                    <div style="font-size: 0.9rem;">Đã thanh toán</div>
                </div>
                <div style="background: rgba(255,255,255,0.2); padding: 1rem; border-radius: 8px; text-align: center;">
                    <div style="font-size: 2.5rem; font-weight: bold;">@ViewBag.UsedTickets</div>
                    <div style="font-size: 0.9rem;">Đã sử dụng</div>
                </div>
            </div>
            
            @if (ViewBag.PendingTickets > 0)
            {
                <div style="background: rgba(255,193,7,0.2); padding: 1rem; border-radius: 8px; margin-top: 1rem; text-align: center; border: 2px solid rgba(255,193,7,0.5);">
                    <div style="font-size: 0.9rem; color: rgba(255,255,255,0.9); margin-bottom: 0.3rem;">
                        <i class="fas fa-info-circle"></i> Lưu ý
                    </div>
                    <div style="font-size: 1.2rem; font-weight: bold; color: white;">
                        @ViewBag.PendingTickets vé đang chờ thanh toán (hiển thị là "Chưa đặt")
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Delete Button -->
    <div style="margin-bottom: 2rem; text-align: center;">
        <button onclick="deleteAllTickets(@showtime.suat_chieu_id, '@showtime.Phim.ten_phim')" 
                class="btn btn-danger" 
                style="padding: 1rem 3rem; font-size: 1.1rem;">
            <i class="fas fa-trash"></i> Xóa Toàn Bộ Suất Chiếu Và Vé
        </button>
        <p style="color: #999; margin-top: 0.5rem; font-size: 0.9rem;">
            <i class="fas fa-exclamation-triangle"></i> Lưu ý: Hành động này sẽ xóa suất chiếu và tất cả @ViewBag.TotalTickets vé
        </p>
    </div>

    <!-- Tickets Table -->
    <h3 style="margin-bottom: 1.5rem; color: #2c3e50;">
        <i class="fas fa-list"></i> Danh Sách Vé (@tickets.Count vé)
    </h3>

    @if (tickets != null && tickets.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã Vé</th>
                        <th>Ghế</th>
                        <th>Loại Ghế</th>
                        <th>Giá Vé</th>
                        <th>Trạng Thái Vé</th>
                        <th>Đơn Đặt</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Đặt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in tickets)
                    {
                        @* ✅ CHECK: Nếu vé chưa thanh toán → hiển thị như "Chưa đặt" *@
                        var isPendingPayment = ticket.Dat_Ve_id != null && 
                                             ticket.Dat_Ve != null && 
                                             ticket.Dat_Ve.trang_thai_Dat_Ve == "Chưa thanh toán";
                        
                        var isBooked = ticket.Dat_Ve_id != null && 
                                      ticket.Dat_Ve != null && 
                                      ticket.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán";
                        
                        <tr>
                            <td><strong>#@ticket.ve_id</strong></td>
                            <td>
                                <span style="display: inline-block; padding: 0.5rem 1rem; background: #667eea; color: white; border-radius: 6px; font-weight: bold;">
                                    @ticket.Ghe.so_ghe
                                </span>
                            </td>
                            <td>@ticket.Ghe.Loai_Ghe.ten_loai</td>
                            <td><strong>@ticket.gia_ve.ToString("N0") đ</strong></td>
                            <td>
                                @{
                                    var statusClass = "";
                                    var statusIcon = "";
                                    switch (ticket.trang_thai_ve)
                                    {
                                        case "Chưa sử dụng":
                                            statusClass = "badge-success";
                                            statusIcon = "check-circle";
                                            break;
                                        case "Đã sử dụng":
                                            statusClass = "badge-info";
                                            statusIcon = "check-double";
                                            break;
                                        case "Đã Hủy":
                                            statusClass = "badge-danger";
                                            statusIcon = "times-circle";
                                            break;
                                        case "Đã hết hạn":
                                            statusClass = "badge-warning";
                                            statusIcon = "clock";
                                            break;
                                        default:
                                            statusClass = "badge-secondary";
                                            statusIcon = "question-circle";
                                            break;
                                    }
                                }
                                <span class="badge @statusClass">
                                    <i class="fas fa-@statusIcon"></i> @ticket.trang_thai_ve
                                </span>
                            </td>
                            <td>
                                @if (isPendingPayment)
                                {
                                    @* ✅ VÉ CHƯA THANH TOÁN → HIỂN THỊ "Chưa đặt" *@
                                    <span style="color: #999; font-style: italic;">Chưa đặt</span>
                                }
                                else if (isBooked)
                                {
                                    @* ✅ VÉ ĐÃ THANH TOÁN *@
                                    <a href="@Url.Action("Details", "BookingManagement", new { id = ticket.Dat_Ve_id })" 
                                       style="color: #3498db; text-decoration: none; font-weight: 600;">
                                        <i class="fas fa-receipt"></i> #@ticket.Dat_Ve_id
                                    </a>
                                }
                                else
                                {
                                    @* ✅ VÉ CHƯA ĐẶT THẬT *@
                                    <span style="color: #999; font-style: italic;">Chưa đặt</span>
                                }
                            </td>
                            <td>
                                @if (isBooked && ticket.Dat_Ve.Khach_Hang != null)
                                {
                                    @* ✅ VÉ ĐÃ THANH TOÁN → HIỂN THỊ KHÁCH HÀNG *@
                                    <div style="font-weight: 600;">@ticket.Dat_Ve.Khach_Hang.ho_ten</div>
                                    <div style="font-size: 0.85rem; color: #666;">@ticket.Dat_Ve.Khach_Hang.email</div>
                                }
                                else
                                {
                                    @* ✅ VÉ CHƯA THANH TOÁN HOẶC CHƯA ĐẶT → HIỂN THỊ "--" *@
                                    <span style="color: #999;">--</span>
                                }
                            </td>
                            <td>
                                @if (isBooked && ticket.Dat_Ve.ngay_tao.HasValue)
                                {
                                    @* ✅ VÉ ĐÃ THANH TOÁN → HIỂN THỊ NGÀY *@
                                    @ticket.Dat_Ve.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    @* ✅ VÉ CHƯA THANH TOÁN HOẶC CHƯA ĐẶT → HIỂN THỊ "--" *@
                                    <span style="color: #999;">--</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 2rem; color: #999;">
            <i class="fas fa-inbox" style="font-size: 3rem; opacity: 0.5; margin-bottom: 1rem;"></i>
            <p>Chưa có vé nào cho suất chiếu này.</p>
        </div>
    }
</div>

<style>
    .badge {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-block;
    }

    .badge-success {
        background: #27ae60;
        color: white;
    }

    .badge-info {
        background: #3498db;
        color: white;
    }

    .badge-warning {
        background: #f39c12;
        color: white;
    }

    .badge-danger {
        background: #e74c3c;
        color: white;
    }

    .badge-secondary {
        background: #95a5a6;
        color: white;
    }
</style>

@section scripts {
    <script>
        function deleteAllTickets(id, movieName) {
            var totalTickets = @ViewBag.TotalTickets;
            var usedTickets = @ViewBag.UsedTickets;
            
            if (usedTickets > 0) {
                alert('❌ KHÔNG THỂ XÓA!\n\n' +
                      'Suất chiếu này có ' + usedTickets + ' vé đã được sử dụng.\n' +
                      'Không thể xóa suất chiếu có vé đã sử dụng!');
                return;
            }
            
            if (confirm('⚠️⚠️⚠️ XÁC NHẬN XÓA SUẤT CHIẾU ⚠️⚠️⚠️\n\n' +
                        '📽️ Phim: ' + movieName + '\n' +
                        '🎫 Tổng số vé: ' + totalTickets + '\n\n' +
                        '🚨 CẢNH BÁO NGHIÊM TRỌNG:\n' +
                        '━━━━━━━━━━━━━━━━━━━━\n' +
                        '• Xóa SUẤT CHIẾU này\n' +
                        '• Xóa TẤT CẢ ' + totalTickets + ' VÉ\n' +
                        '• Không thể HOÀN TÁC!\n' +
                        '• Dữ liệu sẽ MẤT VĨNH VIỄN!\n\n' +
                        '❓ Bạn có HOÀN TOÀN CHẮC CHẮN muốn tiếp tục?')) {
                
                // Double confirmation
                if (confirm('🛑 XÁC NHẬN LẦN CUỐI!\n\n' +
                            'Đây là lần xác nhận cuối cùng.\n' +
                            'Sau khi nhấn OK, suất chiếu và TẤT CẢ VÉ sẽ bị xóa!\n\n' +
                            'Bạn có chắc chắn 100%?')) {
                    
                    $.ajax({
                        url: '@Url.Action("DeleteAllTickets")',
                        type: 'POST',
                        data: { id: id },
                        beforeSend: function() {
                            $('button').prop('disabled', true);
                            alert('⏳ Đang xóa... Vui lòng đợi!');
                        },
                        success: function (response) {
                            if (response.success) {
                                alert('✅ ' + response.message + '\n\nBạn sẽ được chuyển về danh sách suất chiếu.');
                                window.location.href = '@Url.Action("Index")';
                            } else {
                                alert('❌ LỖI!\n\n' + response.message);
                                $('button').prop('disabled', false);
                            }
                        },
                        error: function () {
                            alert('❌ Có lỗi xảy ra khi xóa suất chiếu!');
                            $('button').prop('disabled', false);
                        }
                    });
                }
            }
        }
    </script>
}
