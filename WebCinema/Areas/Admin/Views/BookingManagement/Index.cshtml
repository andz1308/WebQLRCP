@model IEnumerable<WebCinema.Models.Dat_Ve>
@using System.Linq;

@{
    ViewBag.Title = "Quản Lý Đơn Đặt Vé";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-ticket-alt"></i> Danh Sách Đơn Đặt Vé</h2>
    </div>

    <!-- Filter Form -->
    <div style="margin-bottom: 2rem; padding: 1.5rem; background: #f8f9fa; border-radius: 8px;">
        @using (Html.BeginForm("Index", "BookingManagement", FormMethod.Get))
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Ngày Đặt</label>
                    <input type="date" name="searchDate" value="@ViewBag.SearchDate" class="form-control" />
                </div>

                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Trạng Thái Vé</label>
                    <select name="ticketStatus" class="form-control">
                        <option value="">-- Tất cả --</option>
                        <option value="Chưa sử dụng" @(ViewBag.TicketStatus == "Chưa sử dụng" ? "selected" : "")>Chưa sử dụng</option>
                        <option value="Đã sử dụng" @(ViewBag.TicketStatus == "Đã sử dụng" ? "selected" : "")>Đã sử dụng</option>
                        <option value="Đã Hủy" @(ViewBag.TicketStatus == "Đã Hủy" ? "selected" : "")>Đã Hủy</option>
                        <option value="Đã hết hạn" @(ViewBag.TicketStatus == "Đã hết hạn" ? "selected" : "")>Đã hết hạn</option>
                    </select>
                </div>

                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Trạng Thái Thanh Toán</label>
                    <select name="bookingPaymentStatus" class="form-control">
                        <option value="">-- Tất cả --</option>
                        <option value="Chưa thanh toán" @(ViewBag.BookingPaymentStatus == "Chưa thanh toán" ? "selected" : "")>Chưa thanh toán</option>
                        <option value="Đã Thanh toán" @(ViewBag.BookingPaymentStatus == "Đã Thanh toán" ? "selected" : "")>Đã Thanh toán</option>
                        <option value="Đã Hủy" @(ViewBag.BookingPaymentStatus == "Đã Hủy" ? "selected" : "")>Đã Hủy</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Tìm Kiếm
                </button>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div style="margin-bottom: 1rem; color: #666;">
            Hiển thị @Model.Count() / @ViewBag.TotalItems đơn đặt (Trang @ViewBag.CurrentPage / @ViewBag.TotalPages)
        </div>

        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái Vé</th>
                        <th>Trạng Thái Thanh Toán</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        // Get first ticket status to show
                        var firstTicket = booking.Ves.FirstOrDefault();
                        var ticketStatus = firstTicket != null ? firstTicket.trang_thai_ve : "Chưa sử dụng";
                        if (string.IsNullOrEmpty(ticketStatus))
                        {
                            ticketStatus = "Chưa sử dụng";
                        }
                        
                        var ticketStatusColor = ticketStatus == "Chưa sử dụng" ? "#3498db" :
                                              ticketStatus == "Đã sử dụng" ? "#27ae60" :
                                              ticketStatus == "Đã hết hạn" ? "#f39c12" :
                                              ticketStatus == "Đã Hủy" ? "#e74c3c" : "#95a5a6";
                        
                        // Trạng thái thanh toán từ booking (Chưa thanh toán, Đã Thanh toán, Đã Hủy)
                        var bookingStatus = booking.trang_thai_Dat_Ve;
                        if (string.IsNullOrEmpty(bookingStatus))
                        {
                            bookingStatus = "Chưa thanh toán";
                        }
                        
                        var bookingStatusColor = bookingStatus == "Chưa thanh toán" ? "#f39c12" :
                                               bookingStatus == "Đã Thanh toán" ? "#27ae60" :
                                               bookingStatus == "Đã Hủy" ? "#e74c3c" : "#95a5a6";
                        
                        <tr>
                            <td><strong>#@booking.Dat_Ve_id</strong></td>
                            <td>@(booking.Khach_Hang != null ? booking.Khach_Hang.ho_ten : "N/A")</td>
                            <td>@(booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                            <td><strong>@booking.tong_tien.ToString("N0") VNĐ</strong></td>
                            <td>
                                <span style="padding: 0.3rem 0.8rem; background: @ticketStatusColor; color: white; border-radius: 4px; font-size: 0.85rem;">
                                    @ticketStatus
                                </span>
                            </td>
                            <td>
                                <span style="padding: 0.3rem 0.8rem; background: @bookingStatusColor; color: white; border-radius: 4px; font-size: 0.85rem;">
                                    @bookingStatus
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = booking.Dat_Ve_id })" class="btn btn-secondary" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                                    <i class="fas fa-eye"></i> Chi Tiết
                                </a>
                                @if (booking.trang_thai_Dat_Ve != "Đã Hủy")
                                {
                                    <button onclick="cancelBooking(@booking.Dat_Ve_id)" class="btn btn-danger" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                                        <i class="fas fa-times"></i> Hủy
                                    </button>
                                }
                                <button onclick="deleteBooking(@booking.Dat_Ve_id)" class="btn btn-danger" style="padding: 0.5rem 1rem;">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ✅ PHÂN TRANG -->
        if (ViewBag.TotalPages > 1)
        {
            <div style="margin-top: 2rem; display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { 
                        page = ViewBag.CurrentPage - 1, 
                        searchDate = ViewBag.SearchDate,
                        ticketStatus = ViewBag.TicketStatus,
                        bookingPaymentStatus = ViewBag.BookingPaymentStatus
                    })" class="btn btn-secondary">
                        <i class="fas fa-chevron-left"></i> Trước
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="btn btn-primary">@i</span>
                    }
                    else if (i == 1 || i == ViewBag.TotalPages || (i >= ViewBag.CurrentPage - 2 && i <= ViewBag.CurrentPage + 2))
                    {
                        <a href="@Url.Action("Index", new { 
                            page = i,
                            searchDate = ViewBag.SearchDate,
                            ticketStatus = ViewBag.TicketStatus,
                            bookingPaymentStatus = ViewBag.BookingPaymentStatus
                        })" class="btn btn-secondary">@i</a>
                    }
                    else if (i == ViewBag.CurrentPage - 3 || i == ViewBag.CurrentPage + 3)
                    {
                        <span style="padding: 0.6rem;">...</span>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { 
                        page = ViewBag.CurrentPage + 1,
                        searchDate = ViewBag.SearchDate,
                        ticketStatus = ViewBag.TicketStatus,
                        bookingPaymentStatus = ViewBag.BookingPaymentStatus
                    })" class="btn btn-secondary">
                        Sau <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <p style="text-align: center; color: #999; padding: 2rem;">Không có đơn đặt nào.</p>
    }
</div>

@section scripts {
    <script>
        function cancelBooking(id) {
            if (confirm('Bạn có chắc chắn muốn hủy đơn đặt này?\n\nGhế sẽ được giải phóng và trạng thái sẽ chuyển về "Đã Hủy".')) {
                $.ajax({
                    url: '@Url.Action("Cancel")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra.');
                    }
                });
            }
        }

        function deleteBooking(id) {
            if (confirm('⚠️ BẠN CÓ CHẮC CHẮN MUỐN XÓA HOÀN TOÀN ĐƠN ĐẶT NÀY?\n\nThao tác này sẽ:\n- Xóa vĩnh viễn đơn đặt\n- Xóa tất cả vé\n- Xóa tất cả đồ ăn\n- Xóa đánh giá liên quan\n\nKHÔNG THỂ KHÔI PHỤC!')) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Lỗi: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi xóa đơn đặt.');
                    }
                });
            }
        }
    </script>
}


