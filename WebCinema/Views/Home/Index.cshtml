@model IEnumerable<WebCinema.Models.MovieViewModel>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

@{
    ViewBag.Title = "Home Page";
}

<section class="movies-section" id="movies">
    <h2 class="section-title">Phim Đang Chiếu</h2>
    
    @if (ViewBag.TotalMovies > 0)
    {
        <p style="color: #666; margin-bottom: 1.5rem;">
            Hiển thị @Model.Count() phim (Tổng: @ViewBag.TotalMovies phim)
        </p>
    }
    
    <div class="movies-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var movie = item.Movie;
                var genres = item.Genres;
                var avgRating = item.AverageRating;
                var ratingCount = item.RatingCount;
                // Use reflection to get ImagePath if the viewmodel doesn't have the property at compile time
                var imgPathProp = item.GetType().GetProperty("ImagePath");
                var imgPath = imgPathProp != null ? imgPathProp.GetValue(item, null) as string : null;
                
                string genreText = genres != null && genres.Any() ? string.Join(", ", genres) : "Chưa phân loại";
                string durationText = movie.thoi_luong.HasValue ? movie.thoi_luong.Value + " phút" : "N/A";
                
                // Tính số sao đầy và sao rỗng
                int fullStars = (int)Math.Round(avgRating);
                int emptyStars = 5 - fullStars;
                
                <div class="movie-card" onclick="location.href='@Url.Action("Detail", "Home", new { id = movie.phim_id })'">
                    <div class="movie-poster">
                        @if (!string.IsNullOrEmpty(imgPath))
                        {
                            <img src="@imgPath" alt="@movie.ten_phim"
                                 style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else if (!string.IsNullOrEmpty(movie.hinh_anh))
                        {
                            string imgSrc = movie.hinh_anh;

                            // Nếu là đường dẫn tương đối (bắt đầu bằng "~") thì chuyển thành tuyệt đối
                            if (imgSrc.StartsWith("~"))
                            {
                                imgSrc = Url.Content(imgSrc);
                            }
                            // Nếu là đường dẫn tương đối mà không có "~", thêm "/Content/images/"
                            else if (!imgSrc.StartsWith("http", StringComparison.OrdinalIgnoreCase) &&
                                     !imgSrc.StartsWith("/"))
                            {
                                imgSrc = Url.Content("~/Content/images/movies/" + imgSrc);
                            }

                            <img src="@imgSrc" alt="@movie.ten_phim"
                                 style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;
                background:#ff6b35;color:white;font-size:3rem;">
                                🎬
                            </div>
                        }


                    </div>
                    <div class="movie-info">
                        <h3 class="movie-title">@movie.ten_phim</h3>
                        <p class="movie-genre">@genreText | @durationText</p>
                        <div class="movie-rating">
                            <span class="stars">
                                @for (int i = 0; i < fullStars; i++)
                                {
                                    <text>★</text>
                                }
                                @for (int i = 0; i < emptyStars; i++)
                                {
                                    <text>☆</text>
                                }
                            </span>
                            <span class="rating-text">@avgRating.ToString("0.0")/5 (@ratingCount)</span>
                        </div>
                        <button class="movie-btn" onclick="event.stopPropagation(); location.href='@Url.Action("Detail", "Home", new { id = movie.phim_id })'">Đặt Vé</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: #999;">
                <h3>Hiện chưa có phim nào đang chiếu</h3>
                <p>Vui lòng quay lại sau!</p>
            </div>
        }
    </div>
    
    @* PHÂN TRANG *@
    @if (ViewBag.TotalPages > 1)
    {
        <div style="margin-top: 3rem; display: flex; justify-content: center; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            @if (ViewBag.CurrentPage > 1)
            {
                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, cinemaId = ViewBag.SelectedCinemaId, genreId = ViewBag.SelectedGenreId, language = ViewBag.SelectedLanguage })" 
                   style="padding: 0.6rem 1.2rem; background: #fff; border: 2px solid #ff6b35; color: #ff6b35; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 0.3rem;">
                    <i class="fas fa-chevron-left"></i> Trước
                </a>
            }
            
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                if (i == ViewBag.CurrentPage)
                {
                    <span style="padding: 0.6rem 1.2rem; background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%); color: white; border-radius: 8px; font-weight: 600; border: 2px solid #ff6b35; box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);">
                        @i
                    </span>
                }
                else if (Math.Abs(i - ViewBag.CurrentPage) <= 2 || i == 1 || i == ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { page = i, cinemaId = ViewBag.SelectedCinemaId, genreId = ViewBag.SelectedGenreId, language = ViewBag.SelectedLanguage })" 
                       style="padding: 0.6rem 1.2rem; background: #fff; border: 2px solid #e0e0e0; color: #333; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;">
                        @i
                    </a>
                }
                else if (Math.Abs(i - ViewBag.CurrentPage) == 3)
                {
                    <span style="padding: 0.6rem 1.2rem; color: #999;">...</span>
                }
            }
            
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, cinemaId = ViewBag.SelectedCinemaId, genreId = ViewBag.SelectedGenreId, language = ViewBag.SelectedLanguage })" 
                   style="padding: 0.6rem 1.2rem; background: #fff; border: 2px solid #ff6b35; color: #ff6b35; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 0.3rem;">
                    Sau <i class="fas fa-chevron-right"></i>
                </a>
            }
        </div>
    }
</section>

<!-- PROMOTIONS SECTION -->
<section class="promotions-section" id="promotions">
    <div class="promotions-container">
        <h2 class="section-title">Sự Kiện & Khuyến Mãi Nổi Bật</h2>
        
        <div class="promo-carousel-wrapper">
            <div class="promo-carousel">
                <div class="promo-slide">
                    <img src="~/Content/km/km1.png" alt="Khuyến mãi 1" class="promo-image" onerror="this.src='~/Content/km/km1.png'">
                </div>
                <div class="promo-slide">
                    <img src="~/Content/km/km2.png" alt="Khuyến mãi 2" class="promo-image" onerror="this.src='~/Content/km/km2.png'">
                </div>
                <div class="promo-slide">
                    <img src="~/Content/km/km3.png" alt="Khuyến mãi 3" class="promo-image" onerror="this.src='~/Content/km/km3.png">
                </div>
                <div class="promo-slide">
                    <img src="~/Content/km/km4.png" alt="Khuyến mãi 4" class="promo-image" onerror="this.src='~/Content/km/km4.png'">
                </div>
            </div>

            <!-- Navigation Buttons -->
            <button class="promo-nav promo-nav-prev" onclick="promoPrev()">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="promo-nav promo-nav-next" onclick="promoNext()">
                <i class="fas fa-chevron-right"></i>
            </button>

            <!-- Dots -->
            <div class="promo-dots">
                <span class="promo-dot active" onclick="promoGoTo(0)"></span>
                <span class="promo-dot" onclick="promoGoTo(1)"></span>
                <span class="promo-dot" onclick="promoGoTo(2)"></span>
                <span class="promo-dot" onclick="promoGoTo(3)"></span>
            </div>
        </div>
    </div>
</section>

<style>
    /* ✅ PROMOTIONS CAROUSEL - Modern Design */
    .promo-carousel-wrapper {
        position: relative;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        background: #000;
    }

    .promo-carousel {
        position: relative;
        width: 100%;
        height: 900px;
        display: flex;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .promo-slide {
        min-width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .promo-image {
        width: 100%;
        height: 100%;
        object-fit: fill;
        transition: transform 0.5s ease;
        cursor: pointer;
        background: #000;
    }

    .promo-slide:hover .promo-image {
        transform: scale(1.05);
    }

    /* Navigation Buttons */
    .promo-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 107, 53, 0.8);
        color: white;
        border: none;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        z-index: 10;
        backdrop-filter: blur(5px);
    }

    .promo-nav:hover {
        background: rgba(255, 107, 53, 1);
        transform: translateY(-50%) scale(1.1);
        box-shadow: 0 8px 25px rgba(255, 107, 53, 0.4);
    }

    .promo-nav-prev {
        left: 20px;
    }

    .promo-nav-next {
        right: 20px;
    }

    /* Dots Navigation */
    .promo-dots {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        z-index: 10;
    }

    .promo-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid rgba(255, 255, 255, 0.7);
    }

    .promo-dot:hover {
        background: rgba(255, 255, 255, 0.8);
        transform: scale(1.2);
    }

    .promo-dot.active {
        background: #ff6b35;
        border-color: #ff8555;
        width: 30px;
        border-radius: 6px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.4);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .promo-carousel {
            height: 250px;
        }

        .promo-nav {
            width: 40px;
            height: 40px;
            font-size: 1.2rem;
        }

        .promo-nav-prev {
            left: 10px;
        }

        .promo-nav-next {
            right: 10px;
        }

        .promo-dots {
            bottom: 15px;
            gap: 8px;
        }

        .promo-dot {
            width: 10px;
            height: 10px;
        }

        .promo-dot.active {
            width: 24px;
        }
    }

    @@media (max-width: 480px) {
        .promo-carousel {
            height: 180px;
        }

        .promo-nav {
            width: 35px;
            height: 35px;
            font-size: 1rem;
        }
    }
</style>

<script>
    let promoIndex = 0;
    const promoSlides = document.querySelectorAll('.promo-slide');
    const promoDots = document.querySelectorAll('.promo-dot');
    const promoCarousel = document.querySelector('.promo-carousel');
    let promoAutoPlayTimer;

    function showPromoSlide(index) {
        if (promoSlides.length === 0) return;

        // Loop around
        if (index >= promoSlides.length) {
            promoIndex = 0;
        } else if (index < 0) {
            promoIndex = promoSlides.length - 1;
        } else {
            promoIndex = index;
        }

        // Update carousel position
        const offset = -promoIndex * 100;
        promoCarousel.style.transform = `translateX(${offset}%)`;

        // Update dots
        promoDots.forEach((dot, i) => {
            dot.classList.toggle('active', i === promoIndex);
        });

        // Reset auto-play timer
        resetPromoAutoPlay();
    }

    function promoNext() {
        showPromoSlide(promoIndex + 1);
    }

    function promoPrev() {
        showPromoSlide(promoIndex - 1);
    }

    function promoGoTo(index) {
        showPromoSlide(index);
    }

    function autoPlayPromo() {
        promoAutoPlayTimer = setInterval(() => {
            promoNext();
        }, 5000); // Change slide every 5 seconds
    }

    function resetPromoAutoPlay() {
        clearInterval(promoAutoPlayTimer);
        autoPlayPromo();
    }

    // Start auto-play when page loads
    document.addEventListener('DOMContentLoaded', () => {
        autoPlayPromo();
    });

    // Pause auto-play on hover
    document.querySelector('.promo-carousel-wrapper')?.addEventListener('mouseenter', () => {
        clearInterval(promoAutoPlayTimer);
    });

    document.querySelector('.promo-carousel-wrapper')?.addEventListener('mouseleave', () => {
        autoPlayPromo();
    });
</script>

<!-- CINEMAS SECTION -->
<section class="cinemas-section" id="cinemas">
    <h2 class="section-title">Hệ Thống Rạp DAV</h2>
    <div class="cinemas-grid">
        @{
            var cinemasData = ViewBag.Cinemas as IEnumerable<object>;
        }
        @if (cinemasData != null && cinemasData.Any())
        {
            foreach (var cinemaObj in cinemasData)
            {
                var cinemaType = cinemaObj.GetType();
                var rapId = cinemaType.GetProperty("rap_id").GetValue(cinemaObj, null);
                var tenRap = cinemaType.GetProperty("ten_rap").GetValue(cinemaObj, null) as string;
                var diaChi = cinemaType.GetProperty("dia_chi").GetValue(cinemaObj, null) as string;
                var moTa = cinemaType.GetProperty("mo_ta").GetValue(cinemaObj, null) as string;
                var email = cinemaType.GetProperty("email").GetValue(cinemaObj, null) as string;
                
                <div class="cinema-card">
                    <div class="cinema-image">
                        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;
                            background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);color:white;font-size:3rem;">
                            🎬
                        </div>
                    </div>
                    <div class="cinema-info">
                        <h3 class="cinema-name">@tenRap</h3>
                        <p class="cinema-location">📍 @(diaChi ?? "Đang cập nhật")</p>
                        @if (!string.IsNullOrEmpty(moTa))
                        {
                            <p class="cinema-details">@moTa</p>
                        }
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <p class="cinema-details" style="font-size: 0.9rem; color: #666;">
                                ✉️ @email
                            </p>
                        }
                        <button class="cinema-btn" onclick="location.href='@Url.Action("CinemaMovies", "Home", new { cinemaId = rapId })'">
                            Xem Phim Đang Chiếu
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: #999;">
                <h3>Hiện chưa có rạp chiếu nào</h3>
                <p>Vui lòng quay lại sau!</p>
            </div>
        }
    </div>
</section>

