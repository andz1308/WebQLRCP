@{
    ViewBag.Title = "Ch?n ?? ?n & Th?c U?ng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    var foods = ViewBag.Foods as List<WebCinema.Models.Do_An>;
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
}

<style>
    .booking-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 2rem;
    }

    .booking-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px 12px 0 0;
        margin-bottom: 0;
    }

    .progress-steps {
        background: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: center;
        gap: 2rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #999;
        font-weight: 600;
    }

    .step-number {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .step.active {
        color: #ff6b35;
    }

    .step.active .step-number {
        background: #ff6b35;
        color: white;
    }

    .step.completed .step-number {
        background: #27ae60;
        color: white;
    }

    .food-selection {
        background: white;
        padding: 2rem;
    }

    .section-title {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 2rem;
        color: #333;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .food-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .food-card {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .food-card:hover {
        border-color: #ff6b35;
        box-shadow: 0 8px 20px rgba(255, 107, 53, 0.2);
        transform: translateY(-5px);
    }

    .food-image {
        width: 100%;
        height: 180px;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: white;
    }

    .food-info {
        padding: 1.5rem;
    }

    .food-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .food-description {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .food-price {
        font-size: 1.3rem;
        font-weight: bold;
        color: #ff6b35;
        margin-bottom: 1rem;
    }

    .quantity-control {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8f9fa;
        padding: 0.5rem;
        border-radius: 8px;
    }

    .qty-btn {
        width: 35px;
        height: 35px;
        border: none;
        background: #ff6b35;
        color: white;
        border-radius: 6px;
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .qty-btn:hover {
        background: #ff8555;
        transform: scale(1.1);
    }

    .qty-btn:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }

    .qty-display {
        font-size: 1.2rem;
        font-weight: bold;
        color: #333;
        min-width: 30px;
        text-align: center;
    }

    .skip-section {
        text-align: center;
        padding: 2rem;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .skip-btn {
        padding: 0.8rem 2rem;
        background: transparent;
        color: #666;
        border: 2px solid #ccc;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .skip-btn:hover {
        border-color: #ff6b35;
        color: #ff6b35;
    }

    .booking-summary {
        background: white;
        padding: 2rem;
        border-top: 2px solid #e0e0e0;
        position: sticky;
        bottom: 0;
        box-shadow: 0 -4px 15px rgba(0, 0, 0, 0.1);
    }

    .summary-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .summary-info {
        display: flex;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-size: 1.1rem;
        font-weight: bold;
        color: #333;
    }

    .total-price {
        font-size: 1.8rem;
        font-weight: bold;
        color: #ff6b35;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
    }

    .btn-back {
        padding: 1rem 2rem;
        background: #6c757d;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: #5a6268;
    }

    .btn-continue {
        padding: 1rem 3rem;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-continue:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
    }

    @@media (max-width: 768px) {
        .food-grid {
            grid-template-columns: 1fr;
        }

        .summary-content {
            flex-direction: column;
            gap: 1rem;
        }

        .action-buttons {
            width: 100%;
            flex-direction: column;
        }
    }
</style>

<div class="booking-container">
    <div class="booking-header">
        <h2 style="margin: 0;"> Chọn Đồ Ăn & Thức Uống</h2>
        <p style="margin: 0.5rem 0 0 0; opacity: 0.9;">Tận hưởng trải nghiệm xem phim tuyệt vời những combo đồ ăn hấp dẫn</p>
    </div>

    <div class="progress-steps">
        <div class="step completed">
            <span class="step-number"><i class="fas fa-check"></i></span>
            <span>Chọn Ghế</span>
        </div>
        <div class="step active">
            <span class="step-number">2</span>
            <span>Chọn Đồ Ăn</span>
        </div>
        <div class="step">
            <span class="step-number">3</span>
            <span>Thanh Toán</span>
        </div>
    </div>

    <div class="food-selection">
        @if (foods != null && foods.Any())
        {
            <h3 class="section-title">
                <i class="fas fa-utensils"></i>
                Đò Ăn & Thức Uống
            </h3>

            <div class="food-grid">
                @foreach (var food in foods)
                {
                    <div class="food-card">
                        <div class="food-image">
                            <span>🍔</span>
                        </div>
                        <div class="food-info">
                            <div class="food-name">@food.ten_san_pham</div>
                            <div class="food-description">@(food.mo_ta ?? "Combo đồ ăn ngon tuyệt vời")</div>
                            <div class="food-price">@((food.gia ?? 0).ToString("N0")) ₫</div>
                            <div class="quantity-control">
                                <button class="qty-btn" onclick="decreaseQty(@food.Do_An_id)">
                                    <i class="fas fa-minus">-</i>
                                </button>
                                <span class="qty-display" id="qty-@food.Do_An_id">0</span>
                                <button class="qty-btn" onclick="increaseQty(@food.Do_An_id, @food.gia)">
                                    <i class="fas fa-plus">+</i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="skip-section">
                <p style="font-size: 1.2rem; color: #666; margin-bottom: 1rem;">
                    <i class="fas fa-info-circle"></i> Không có đồ ăn & thức uống
                </p>
            </div>
        }

        <div class="skip-section">
            <p style="font-size: 1rem; color: #666; margin-bottom: 1rem;">
                Bạn có thể bỏ qua bước này nếu không muốn thêm đồ ăn
            </p>
            <button class="skip-btn" onclick="skipToPayment()">
                <i class="fas fa-forward"></i> Bỏ Qua
            </button>
        </div>
    </div>
</div>

<div class="booking-summary">
    <div class="summary-content">
        <div class="summary-info">
            <div class="info-item">
                <span class="info-label">Số lượng món</span>
                <span class="info-value" id="totalItems">0</span>
            </div>
            <div class="info-item">
                <span class="info-label">Tổng tiền đồ ăn</span>
                <span class="total-price" id="foodTotal">0 đ</span>
            </div>
        </div>
        <div class="action-buttons">
            <button class="btn-back" onclick="goBack()">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </button>
            <button class="btn-continue" onclick="continueToPayment()">
                Tiếp Theo <i class="fas fa-shopping-cart"></i>
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var selectedFoods = {};

        function increaseQty(foodId, price) {
            if (!selectedFoods[foodId]) {
                selectedFoods[foodId] = { quantity: 0, price: price };
            }
            selectedFoods[foodId].quantity++;
            updateDisplay(foodId);
            updateSummary();
        }

        function decreaseQty(foodId) {
            if (selectedFoods[foodId] && selectedFoods[foodId].quantity > 0) {
                selectedFoods[foodId].quantity--;
                if (selectedFoods[foodId].quantity === 0) {
                    delete selectedFoods[foodId];
                }
                updateDisplay(foodId);
                updateSummary();
            }
        }

        function updateDisplay(foodId) {
            var qty = selectedFoods[foodId] ? selectedFoods[foodId].quantity : 0;
            $('#qty-' + foodId).text(qty);
        }

        function updateSummary() {
            var totalItems = 0;
            var totalPrice = 0;

            for (var foodId in selectedFoods) {
                totalItems += selectedFoods[foodId].quantity;
                totalPrice += selectedFoods[foodId].quantity * selectedFoods[foodId].price;
            }

            $('#totalItems').text(totalItems);
            $('#foodTotal').text(totalPrice.toLocaleString('vi-VN') + ' đ');
        }

        // **ĐI THẲNG ĐẾN CHECKOUT - KHÔNG QUA GIỎ HÀNG**
        function continueToPayment() {
            var foodData = [];
            for (var foodId in selectedFoods) {
                if (selectedFoods[foodId].quantity > 0) {
                    foodData.push(foodId + ':' + selectedFoods[foodId].quantity);
                }
            }

            $.ajax({
                url: '@Url.Action("Payment", "Booking")',
                type: 'POST',
                data: { selectedFoods: foodData.join(';') },
                success: function(response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra. Vui lòng thử lại!');
                }
            });
        }

        // **BỎ QUA ĐỒ ĂN - ĐI THẲNG ĐẾN CHECKOUT**
        function skipToPayment() {
            $.ajax({
                url: '@Url.Action("Payment", "Booking")',
                type: 'POST',
                data: { selectedFoods: '' },
                success: function(response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra. Vui lòng thử lại!');
                }
            });
        }

        function goBack() {
            window.history.back();
        }
    </script>
}
