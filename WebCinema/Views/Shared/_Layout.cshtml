    <script>
        let currentSlideIndex = 0;
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.dot');
        let cart = [];

        function showSlide(index) {
            slides.forEach(slide => slide.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));

            slides[index].classList.add('active');
            dots[index].classList.add('active');
        }

        function nextSlide() {
            currentSlideIndex = (currentSlideIndex + 1) % slides.length;
            showSlide(currentSlideIndex);
        }

        function currentSlide(index) {
            currentSlideIndex = index;
            showSlide(currentSlideIndex);
        }

        // Scroll to movies section when click "Đặt Vé Ngay"
        function scrollToMovies() {
            const moviesSection = document.getElementById('movies');
            if (moviesSection) {
                const headerHeight = 100;
                const targetPosition = moviesSection.getBoundingClientRect().top + window.pageYOffset - headerHeight;
                
                window.scrollTo({
                    top: targetPosition,
                    behavior: 'smooth'
                });
            }
        }

        // ✅ Load Rạp và Thể Loại vào Filter (chỉ trên trang chủ)
        $(document).ready(function() {
            if (window.location.pathname === '/' || window.location.pathname === '/Home' || window.location.pathname === '/Home/Index') {
                // Load danh sách rạp
                var cinemas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Cinemas ?? new List<object>()));
                var genres = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Genres ?? new List<object>()));
                var languages = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Languages ?? new List<string>()));
                var selectedCinemaId = '@(ViewBag.SelectedCinemaId ?? "")';
                var selectedGenreId = '@(ViewBag.SelectedGenreId ?? "")';
                var selectedLanguage = '@(ViewBag.SelectedLanguage ?? "")';

                // Populate rạp dropdown
                if (cinemas && cinemas.length > 0) {
                    cinemas.forEach(function(cinema) {
                        var selected = cinema.rap_id == selectedCinemaId ? ' selected' : '';
                        $('#cinemaFilter').append('<option value="' + cinema.rap_id + '"' + selected + '>' + cinema.ten_rap + '</option>');
                    });
                }

                // Populate thể loại dropdown
                if (genres && genres.length > 0) {
                    genres.forEach(function(genre) {
                        var selected = genre.loaiphim_id == selectedGenreId ? ' selected' : '';
                        $('#genreFilter').append('<option value="' + genre.loaiphim_id + '"' + selected + '>' + genre.ten_loai + '</option>');
                    });
                }

                // Populate ngôn ngữ dropdown
                if (languages && languages.length > 0) {
                    languages.forEach(function(lang) {
                        var selected = lang === selectedLanguage ? ' selected' : '';
                        $('#languageFilter').append('<option value="' + lang + '"' + selected + '>' + lang + '</option>');
                    });
                }
            }

            // Filter form submit
            $('#filterForm').submit(function(e) {
                // Let form submit naturally
                return true;
            });

            // Set min date to today
            var today = new Date().toISOString().split('T')[0];
            $('#dateFilter').attr('min', today);
        });

        //  Shopping cart functions
        function toggleCart() {
            const cartModal = document.getElementById('cartModal');
            const cartOverlay = document.getElementById('cartOverlay');
            cartModal.classList.toggle('active');
            cartOverlay.classList.toggle('active');
        }

        function addToCart(name, price) {
            const existingItem = cart.find(item => item.name === name);
            if (existingItem) {
                existingItem.quantity++;
            } else {
                cart.push({ name, price, quantity: 1 });
            }
            updateCart();
        }

        function updateCart() {
            const cartCount = document.getElementById('cartCount');
            const cartItems = document.getElementById('cartItems');
            const cartTotal = document.getElementById('cartTotal');

            cartCount.textContent = cart.reduce((sum, item) => sum + item.quantity, 0);

            if (cart.length === 0) {
                cartItems.innerHTML = '<div class="cart-empty">Giỏ hàng trống</div>';
                cartTotal.textContent = '0 đ';
                return;
            }

            cartItems.innerHTML = cart.map((item, index) => `
                                                <div class="cart-item">
                                                    <div class="cart-item-name">${item.name}</div>
                                                    <div class="cart-item-price">${item.price.toLocaleString('vi-VN')} VND</div>
                                                    <div class="cart-item-qty">
                                                        <button class="qty-btn" onclick="changeQty(${index}, -1)">−</button>
                                                        <span>${item.quantity}</span>
                                                        <button class="qty-btn" onclick="changeQty(${index}, 1)">+</button>
                                                        <button class="qty-btn" style="margin-left: auto; background: #e74c3c;" onclick="removeFromCart(${index})">🗑️</button>
                                                    </div>
                                                </div>
                                            `).join('');

            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            cartTotal.textContent = total.toLocaleString('vi-VN') + ' VND';
        }

        function changeQty(index, change) {
            cart[index].quantity += change;
            if (cart[index].quantity <= 0) {
                removeFromCart(index);
            } else {
                updateCart();
            }
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCart();
        }

        // Toggle user dropdown menu
        function toggleUserMenu() {
            const userMenu = document.getElementById('userMenu');
            userMenu.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (event) {
            const userDropdown = document.querySelector('.user-dropdown');
            if (userDropdown && !userDropdown.contains(event.target)) {
                const userMenu = document.getElementById('userMenu');
                if (userMenu) {
                    userMenu.classList.remove('show');
                }
            }
        });

        // Close cart when clicking overlay
        document.getElementById('cartOverlay')?.addEventListener('click', toggleCart);

        // Auto-play banner slider every 5 seconds
        setInterval(nextSlide, 5000);

        // Add smooth scroll behavior with offset for header
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const target = document.querySelector(targetId);
                if (target) {
                    const headerHeight = 100; // Height of sticky header
                    const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - headerHeight;

                    window.scrollTo({
                        top: targetPosition,
                        behavior: 'smooth'
                    });
                }
            });
        });

        // Search suggestions (added)
        (function(){
            var $input = $('#movieSearch');
            var $box = $('#searchSuggest');
            var timer;
            function render(list){
                if(!list || !list.length){ $box.hide(); return; }
                var html = list.map(function(x){
                    var img = x.image || ''; var name = x.name || ''; var id = x.id;
                    return '<div class="search-item" data-id="'+id+'">'
                         + (img ? '<img src="'+img+'" alt=""/>' : '<div style="width:40px;height:56px;border-radius:6px;background:#eee"></div>')
                         + '<div>'+name+'</div>'
                         + '</div>';
                }).join('');
                $box.html(html).show();
            }
            $(document).on('input', '#movieSearch', function(){
                clearTimeout(timer);
                var q = this.value.trim();
                if(!q){ $box.hide(); return; }
                timer = setTimeout(function(){
                    $.getJSON('@Url.Action("Search","Home")', { q: q })
                     .done(render)
                     .fail(function(){ $box.hide(); });
                }, 250);
            });
            $(document).on('click', '.search-item', function(){
                var id = $(this).data('id');
                if(id){ window.location.href='@Url.Action("Detail","Home")/'+id; }
            });
            $(document).on('click', function(e){ if(!$(e.target).closest('.search-box').length){ $box.hide(); } });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

