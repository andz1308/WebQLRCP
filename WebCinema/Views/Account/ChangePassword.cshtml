@{
    ViewBag.Title = "Đổi Mật Khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .change-password-wrapper {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 2rem 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .change-password-card {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        max-width: 450px;
        width: 100%;
    }

    .change-password-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .change-password-header h1 {
        font-size: 2rem;
        color: #333;
        margin: 0 0 0.5rem 0;
        font-weight: 700;
    }

    .change-password-header p {
        color: #666;
        margin: 0;
        font-size: 0.95rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control {
        width: 100%;
        padding: 0.8rem;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: #ff6b35;
        box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
    }

    .password-strength {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .strength-bar {
        flex: 1;
        height: 6px;
        background: #e0e0e0;
        border-radius: 3px;
        overflow: hidden;
    }

    .strength-fill {
        height: 100%;
        width: 0;
        background: #e74c3c;
        transition: all 0.3s ease;
    }

    .strength-fill.fair {
        width: 33%;
        background: #f39c12;
    }

    .strength-fill.good {
        width: 66%;
        background: #f1c40f;
    }

    .strength-fill.strong {
        width: 100%;
        background: #27ae60;
    }

    .strength-text {
        font-size: 0.75rem;
        color: #999;
        margin-top: 0.3rem;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: none;
    }

    .alert.success {
        display: block;
        background: #d4edda;
        border: 2px solid #28a745;
        color: #155724;
    }

    .alert.error {
        display: block;
        background: #f8d7da;
        border: 2px solid #dc3545;
        color: #721c24;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn {
        flex: 1;
        padding: 0.9rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-save {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 53, 0.3);
    }

    .btn-cancel {
        background: #e0e0e0;
        color: #333;
    }

    .btn-cancel:hover {
        background: #d0d0d0;
    }

    .password-requirements {
        background: #f0f8f5;
        border-left: 4px solid #27ae60;
        padding: 1rem;
        border-radius: 8px;
        margin-top: 1.5rem;
        font-size: 0.9rem;
        color: #555;
    }

    .password-requirements h4 {
        margin-top: 0;
        color: #27ae60;
        font-size: 0.95rem;
    }

    .password-requirements ul {
        margin: 0.5rem 0 0 1.5rem;
        padding: 0;
    }

    .password-requirements li {
        margin-bottom: 0.3rem;
    }

    .show-password {
        position: relative;
    }

    .toggle-password {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #999;
        font-size: 1.2rem;
        transition: color 0.3s ease;
    }

    .toggle-password:hover {
        color: #ff6b35;
    }

    @@media (max-width: 768px) {
        .change-password-card {
            padding: 1.5rem;
        }

        .change-password-header h1 {
            font-size: 1.5rem;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>

<div class="change-password-wrapper">
    <div class="change-password-card">
        <div class="change-password-header">
            <h1><i class="fas fa-lock"></i> Đổi Mật Khẩu</h1>
            <p>Cập nhật mật khẩu của bạn để bảo vệ tài khoản</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert error">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Mật Khẩu Hiện Tại *</label>
                <div class="show-password">
                    <input type="password" name="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại" required>
                    <span class="toggle-password" onclick="togglePassword(this, 'CurrentPassword')">👁️</span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Mật Khẩu Mới *</label>
                <div class="show-password">
                    <input type="password" name="NewPassword" id="NewPassword" class="form-control" placeholder="Nhập mật khẩu mới" required onkeyup="checkPasswordStrength()">
                    <span class="toggle-password" onclick="togglePassword(this, 'NewPassword')">👁️</span>
                </div>
                <div class="password-strength">
                    <div class="strength-bar">
                        <div class="strength-fill" id="strengthFill"></div>
                    </div>
                </div>
                <div class="strength-text" id="strengthText"></div>
            </div>

            <div class="form-group">
                <label class="form-label">Xác Nhận Mật Khẩu *</label>
                <div class="show-password">
                    <input type="password" name="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" required>
                    <span class="toggle-password" onclick="togglePassword(this, 'ConfirmPassword')">👁️</span>
                </div>
            </div>

            <div class="password-requirements">
                <h4>Yêu Cầu Mật Khẩu:</h4>
                <ul>
                    <li>✓ Tối thiểu 8 ký tự</li>
                    <li>✓ Chứa ít nhất 1 chữ hoa (A-Z)</li>
                    <li>✓ Chứa ít nhất 1 chữ thường (a-z)</li>
                    <li>✓ Chứa ít nhất 1 số (0-9)</li>
                    <li>✓ Chứa ít nhất 1 ký tự đặc biệt (!#$%^&*)</li>
                </ul>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">
                    <i class="fas fa-save"></i> Lưu Mật Khẩu
                </button>
                <a href="@Url.Action("Profile", "Account")" class="btn btn-cancel" style="text-decoration: none;">
                    <i class="fas fa-times"></i> Hủy
                </a>
            </div>
        }
    </div>
</div>

<script>
    function togglePassword(btn, inputId) {
        const input = document.querySelector('input[name="' + inputId + '"]');
        if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = '🙈';
        } else {
            input.type = 'password';
            btn.textContent = '👁️';
        }
    }

    function checkPasswordStrength() {
        const password = document.getElementById('NewPassword').value;
        const strengthFill = document.getElementById('strengthFill');
        const strengthText = document.getElementById('strengthText');

        let strength = 0;

        // Kiểm tra độ dài
        if (password.length >= 8) strength++;
        if (password.length >= 12) strength++;

        // Kiểm tra chữ hoa
        if (/[A-Z]/.test(password)) strength++;

        // Kiểm tra chữ thường
        if (/[a-z]/.test(password)) strength++;

        // Kiểm tra số
        if (/[0-9]/.test(password)) strength++;

        // Kiểm tra ký tự đặc biệt
        if (/[!#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)) strength++;

        // Cập nhật UI
        strengthFill.className = 'strength-fill';

        if (strength < 2) {
            strengthFill.style.width = '0';
            strengthText.textContent = 'Mật khẩu quá yếu';
            strengthText.style.color = '#e74c3c';
        } else if (strength < 4) {
            strengthFill.classList.add('fair');
            strengthText.textContent = 'Mật khẩu tạm được';
            strengthText.style.color = '#f39c12';
        } else if (strength < 6) {
            strengthFill.classList.add('good');
            strengthText.textContent = 'Mật khẩu tốt';
            strengthText.style.color = '#f1c40f';
        } else {
            strengthFill.classList.add('strong');
            strengthText.textContent = 'Mật khẩu rất mạnh';
            strengthText.style.color = '#27ae60';
        }
    }
</script>
