@model WebCinema.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "Quên Mật Khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên Mật Khẩu - DAV Cinema</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    body::before {
        content: '';
        position: absolute;
        width: 500px;
        height: 500px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        top: -250px;
        right: -250px;
        animation: float 6s ease-in-out infinite;
    }

    body::after {
        content: '';
        position: absolute;
        width: 400px;
        height: 400px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        bottom: -200px;
        left: -200px;
        animation: float 8s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(20px); }
    }

    .home-button {
        position: fixed;
        top: 2rem;
        left: 2rem;
        z-index: 1000;
    }

    .btn-home {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 1.5rem;
        background: rgba(255, 255, 255, 0.95);
        color: #ff6b35;
        border: 2px solid rgba(255, 107, 53, 0.3);
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .btn-home:hover {
        background: white;
        border-color: #ff6b35;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 107, 53, 0.3);
    }

    .btn-home i {
        font-size: 1.1rem;
    }

    .auth-container {
        max-width: 450px;
        width: 100%;
        padding: 0 2rem;
        position: relative;
        z-index: 1;
    }

    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 3rem 2.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.2);
        animation: slideIn 0.5s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .auth-logo {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        box-shadow: 0 10px 30px rgba(255, 107, 53, 0.3);
    }

    .auth-logo i {
        font-size: 2.5rem;
        color: white;
    }

    .auth-title {
        font-size: 2.2rem;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
        font-weight: 700;
    }

    .auth-subtitle {
        color: #666;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-label i {
        color: #ff6b35;
    }

    .form-input {
        padding: 1rem 1.2rem;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #f9f9f9;
        width: 100%;
    }

    .form-input:focus {
        outline: none;
        border-color: #ff6b35;
        background: white;
        box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.1);
        transform: translateY(-2px);
    }

    .error-message {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 0.3rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .error-message::before {
        content: '⚠';
    }

    .btn-submit {
        padding: 1.1rem;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 0.5rem;
        position: relative;
        overflow: hidden;
    }

    .btn-submit::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s;
    }

    .btn-submit:hover::before {
        left: 100%;
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(255, 107, 53, 0.4);
    }

    .btn-submit:active {
        transform: translateY(-1px);
    }

    .auth-footer {
        text-align: center;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid #e0e0e0;
        color: #666;
    }

    .auth-footer a {
        color: #ff6b35;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .auth-footer a:hover {
        color: #ff8555;
        text-decoration: underline;
    }

    .success-message {
        padding: 1rem 1.2rem;
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        border: 2px solid #28a745;
        border-radius: 12px;
        color: #155724;
        margin-bottom: 1.5rem;
        text-align: center;
        animation: slideIn 0.5s ease-out;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .success-message::before {
        content: '✓';
        font-size: 1.5rem;
        font-weight: bold;
    }

    .alert-error {
        padding: 1rem 1.2rem;
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        border: 2px solid #dc3545;
        border-radius: 12px;
        color: #721c24;
        margin-bottom: 1.5rem;
        text-align: center;
        animation: shake 0.5s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .alert-error::before {
        content: '✕';
        font-size: 1.5rem;
        font-weight: bold;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-10px); }
        75% { transform: translateX(10px); }
    }

    .info-box {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .info-box p {
        color: #856404;
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
    }

    .info-box i {
        color: #ffc107;
        margin-right: 0.5rem;
    }

    @@media (max-width: 576px) {
        .home-button {
            top: 1rem;
            left: 1rem;
        }

        .btn-home {
            padding: 0.6rem 1rem;
            font-size: 0.85rem;
        }

        .auth-card {
            padding: 2rem 1.5rem;
        }

        .auth-title {
            font-size: 1.8rem;
        }

        body::before,
        body::after {
            display: none;
        }
    }
</style>

<body>
    <div class="home-button">
        <a href="@Url.Action("Index", "Home")" class="btn-home">
            <i class="fas fa-home"></i>
            <span>Trang chủ</span>
        </a>
    </div>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">
                    <i class="fas fa-key"></i>
                </div>
                <h1 class="auth-title">Quên Mật Khẩu</h1>
                <p class="auth-subtitle">Nhập email đăng ký để nhận lại mật khẩu</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-error">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="info-box">
                <p>
                    <i class="fas fa-info-circle"></i>
                    Chúng tôi sẽ gửi mật khẩu hiện tại của bạn về email đã đăng ký. Vui lòng kiểm tra hộp thư đến và thư spam.
                </p>
            </div>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "auth-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-envelope"></i>
                        Email
                    </label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-input", placeholder = "example@gmail.com", type = "email" })
                    @*@Html.ValidationMessageFor(m => m.Email, "", new { @class = "error-message" })*@
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-paper-plane"></i> Gửi Mật Khẩu
                </button>
            }

            <div class="auth-footer">
                Nhớ mật khẩu? <a href="@Url.Action("Login", "Account")">Đăng nhập</a><br />
                Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
            </div>
        </div>
    </div>

    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.3/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
