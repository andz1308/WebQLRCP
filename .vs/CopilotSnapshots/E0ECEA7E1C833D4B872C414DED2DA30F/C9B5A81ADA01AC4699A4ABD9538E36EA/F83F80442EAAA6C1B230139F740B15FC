using System;
using System.Linq;
using System.Timers;
using WebCinema.Models;
using WebCinema.Infrastructure;

namespace WebCinema.Services
{
    /// <summary>
    /// Service t? ??ng h?y ??n ??t vé ch?a thanh toán sau 10 phút
    /// </summary>
    public class BookingExpirationService
    {
        private static Timer _expirationTimer;
        private CSDLDataContext db;
        private const int EXPIRATION_MINUTES = 30;  // ? 10 phút

        public BookingExpirationService()
        {
            db = new CSDLDataContext();
        }

        /// <summary>
        /// B?t ??u d?ch v? ki?m tra t? ??ng
        /// </summary>
        public static void StartExpirationCheck()
        {
            try
            {
                _expirationTimer = new Timer();
                _expirationTimer.Interval = 60000;  // Ki?m tra m?i 1 phút
                _expirationTimer.Elapsed += OnTimerElapsed;
                _expirationTimer.AutoReset = true;
                _expirationTimer.Start();

                LoggingHelper.LogInfo("? BookingExpirationService started");
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
            }
        }

        /// <summary>
        /// D?ng d?ch v?
        /// </summary>
        public static void StopExpirationCheck()
        {
            if (_expirationTimer != null)
            {
                _expirationTimer.Stop();
                _expirationTimer.Dispose();
                LoggingHelper.LogInfo("? BookingExpirationService stopped");
            }
        }

        /// <summary>
        /// S? ki?n Timer elapsed
        /// </summary>
        private static void OnTimerElapsed(object sender, ElapsedEventArgs e)
        {
            try
            {
                DeleteExpiredBookings();
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
            }
        }

        /// <summary>
        /// H?y các ??n ??t vé quá h?n (ch?a thanh toán sau 10 phút)
        /// </summary>
        private static void DeleteExpiredBookings()
        {
            try
            {
                using (var db = new CSDLDataContext())
                {
                    var now = DateTime.Now;
                    var expirationTime = now.AddMinutes(-EXPIRATION_MINUTES);

                    // ?? Tìm các ??n "Ch?a thanh toán" ???c t?o tr??c 10 phút
                    var expiredBookings = db.Dat_Ves
                        .Where(b => b.trang_thai_Dat_Ve == "Ch?a thanh toán" &&
                                    b.ngay_tao.HasValue &&
                                    b.ngay_tao.Value <= expirationTime)
                        .ToList();

                    if (expiredBookings.Count == 0)
                    {
                        return;  // Không có ??n nào h?t h?n
                    }

                    LoggingHelper.LogInfo($"? Found {expiredBookings.Count} expired bookings to cancel");

                    int totalDeleted = 0;
                    int totalSeatsReleased = 0;

                    foreach (var booking in expiredBookings)
                    {
                        try
                        {
                            var bookingId = booking.Dat_Ve_id;
                            var customerId = booking.khach_hang_id;

                            // Xóa tất cả vé của đơn đặt
                            var bookingVes = db.Ves.Where(v => v.Dat_Ve_id == bookingId).ToList();
                            
                            // Xóa đánh giá liên quan đến vé (nếu có)
                            foreach (var ticket in bookingVes)
                            {
                                var reviews = db.Danh_Gias.Where(dg => dg.ve_id == ticket.ve_id).ToList();
                                db.Danh_Gias.DeleteAllOnSubmit(reviews);
                            }
                            
                            db.Ves.DeleteAllOnSubmit(bookingVes);
                            totalSeatsReleased += bookingVes.Count;

                            // Xóa tất cả đơn hàng đồ ăn liên quan
                            var foodOrders = db.DonHang_DoAns.Where(f => f.Dat_Ve_id == bookingId).ToList();
                            db.DonHang_DoAns.DeleteAllOnSubmit(foodOrders);

                            // Xóa đơn đặt vé
                            db.Dat_Ves.DeleteOnSubmit(booking);
                            
                            totalDeleted++;

                            LoggingHelper.LogInfo($"🗑️ Deleted expired booking ID={bookingId}, Customer={customerId}, Released {bookingVes.Count} seats");
                        }
                        catch (Exception ex)
                        {
                            LoggingHelper.LogError(ex, $"Error deleting booking {booking.Dat_Ve_id}");
                        }
                    }

                    // Lưu tất cả thay đổi vào cơ sở dữ liệu
                    db.SubmitChanges();

                    LoggingHelper.LogInfo($"✅ Successfully DELETED {totalDeleted} expired bookings and released {totalSeatsReleased} seats");
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error in DeleteExpiredBookings");
            }
        }

        /// <summary>
        /// Phương thức public để gọi thủ công (dùng cho testing)
        /// </summary>
        public static void ManualCleanup()
        {
            LoggingHelper.LogInfo("🧹 Manual cleanup triggered");
            DeleteExpiredBookings();
        }
    }
}
