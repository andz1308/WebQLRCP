@{
    ViewBag.Title = "Soát Vé";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";
}

<style>
    .verification-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem;
    }

    .verification-card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .verification-title {
        font-size: 1.8rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .verification-subtitle {
        color: #666;
        text-align: center;
        margin-bottom: 2rem;
    }

    .input-section {
        margin-bottom: 2rem;
    }

    .input-label {
        display: block;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.8rem;
    }

    .qr-input {
        width: 100%;
        padding: 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1.1rem;
        transition: all 0.3s ease;
    }

    .qr-input:focus {
        outline: none;
        border-color: #ff6b35;
        box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
    }

    .verify-btn {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .verify-btn:hover {
        background: linear-gradient(135deg, #ff8555 0%, #ff6b35 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 107, 53, 0.3);
    }

    .verify-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .result-box {
        display: none;
        margin-top: 2rem;
        padding: 1.5rem;
        border-radius: 8px;
        text-align: center;
    }

    .result-box.success {
        background: #d4edda;
        border: 2px solid #28a745;
        color: #155724;
        display: block;
    }

    .result-box.error {
        background: #f8d7da;
        border: 2px solid #dc3545;
        color: #721c24;
        display: block;
    }

    .result-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .ticket-details {
        background: #f9f9f9;
        border-radius: 8px;
        padding: 1.5rem;
        margin-top: 1.5rem;
        text-align: left;
    }

    .ticket-detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem 0;
        border-bottom: 1px solid #e0e0e0;
    }

    .ticket-detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: #666;
    }

    .detail-value {
        color: #333;
        font-weight: 600;
    }

    .status-badge {
        display: inline-block;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        margin-top: 1rem;
    }

    .status-badge.valid {
        background: #28a745;
        color: white;
    }

    .status-badge.used {
        background: #ffc107;
        color: #333;
    }

    .info-box {
        background: #e3f2fd;
        border-left: 4px solid #2196F3;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 2rem;
        color: #1565c0;
    }

    .info-box i {
        margin-right: 0.5rem;
    }

    .clear-btn {
        width: 100%;
        padding: 0.8rem;
        background: #e0e0e0;
        color: #333;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 1rem;
        transition: all 0.3s ease;
    }

    .clear-btn:hover {
        background: #d0d0d0;
    }

    /* ✅ Camera QR Scanner Styles */
    .camera-section {
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .camera-tabs {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .tab-btn {
        flex: 1;
        padding: 0.8rem;
        border: 2px solid #e0e0e0;
        background: white;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .tab-btn.active {
        background: #ff6b35;
        color: white;
        border-color: #ff6b35;
    }

    .camera-container {
        display: none;
        background: #000;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .camera-container.active {
        display: block;
    }

    #videoElement {
        width: 100%;
        height: auto;
        display: block;
    }

    .camera-controls {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    .camera-btn {
        flex: 1;
        padding: 0.8rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .camera-btn.start {
        background: #27ae60;
        color: white;
    }

    .camera-btn.start:hover {
        background: #229954;
    }

    .camera-btn.stop {
        background: #dc3545;
        color: white;
    }

    .camera-btn.stop:hover {
        background: #c82333;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }
</style>

<div class="verification-container">
    <div class="verification-card">
        <h1 class="verification-title">
            <i class="fas fa-ticket-alt"></i> Soát Vé
        </h1>
        <p class="verification-subtitle">Nhập mã QR vé để kiểm tra</p>

        <div class="info-box">
            <i class="fas fa-info-circle"></i>
            <span>Nhập mã QR (hoặc mã dự phòng) để xác minh vé. Vé sẽ tự động được đánh dấu là "Đã sử dụng".</span>
        </div>

        <!-- ✅ Tab chọn kiểu soát -->
        <div class="camera-section">
            <div class="camera-tabs">
                <button class="tab-btn active" onclick="switchTab('manual')">
                    <i class="fas fa-keyboard"></i> Nhập Tay
                </button>
                <button class="tab-btn" onclick="switchTab('camera')">
                    <i class="fas fa-camera"></i> Quét Camera
                </button>
            </div>

            <!-- ✅ Tab nhập tay -->
            <div id="manualTab" class="tab-content active">
                <div class="input-section">
                    <label class="input-label">
                        <i class="fas fa-qrcode"></i> Mã QR Vé
                    </label>
                    <input type="text" 
                           id="qrCodeInput" 
                           class="qr-input" 
                           placeholder="Nhập hoặc quét mã QR tại đây..."
                           autocomplete="off">
                </div>

                <button class="verify-btn" id="verifyBtn" onclick="verifyTicket()">
                    <i class="fas fa-check-circle"></i> Xác Minh Vé
                </button>
            </div>

            <!-- ✅ Tab quét camera -->
            <div id="cameraTab" class="tab-content">
                <div class="camera-container" id="cameraContainer">
                    <video id="videoElement" playsinline></video>
                </div>

                <div class="camera-controls">
                    <button class="camera-btn start" id="startCameraBtn" onclick="startCamera()">
                        <i class="fas fa-play"></i> Bật Camera
                    </button>
                    <button class="camera-btn stop" id="stopCameraBtn" onclick="stopCamera()" style="display: none;">
                        <i class="fas fa-stop"></i> Tắt Camera
                    </button>
                </div>

                <div style="text-align: center; margin-top: 1rem; color: #666; font-size: 0.9rem;">
                    <p><i class="fas fa-lightbulb"></i> Camera sẽ tự động quét mã QR khi phát hiện</p>
                </div>
            </div>
        </div>

        <div id="resultBox" class="result-box"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<script>
    // ✅ Camera QR Scanner
    let stream = null;
    let isScanning = false;

    function switchTab(tab) {
        // Ẩn tất cả tab
        document.getElementById('manualTab').classList.remove('active');
        document.getElementById('cameraTab').classList.remove('active');

        // Ẩn tất cả nút tab
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

        // Hiện tab được chọn
        document.getElementById(tab + 'Tab').classList.add('active');
        event.target.classList.add('active');

        // Nếu chuyển sang camera, tắt camera khi rời đi
        if (tab === 'manual') {
            stopCamera();
        }
    }

    async function startCamera() {
        try {
            stream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'environment' }
            });

            const video = document.getElementById('videoElement');
            video.srcObject = stream;
            video.play();

            document.getElementById('startCameraBtn').style.display = 'none';
            document.getElementById('stopCameraBtn').style.display = 'block';
            document.getElementById('cameraContainer').classList.add('active');

            isScanning = true;
            scanQRCode();
        } catch (err) {
            alert('Không thể truy cập camera. Vui lòng kiểm tra quyền truy cập.');
            console.error(err);
        }
    }

    function stopCamera() {
        isScanning = false;
        
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
        }

        document.getElementById('videoElement').srcObject = null;
        document.getElementById('startCameraBtn').style.display = 'block';
        document.getElementById('stopCameraBtn').style.display = 'none';
        document.getElementById('cameraContainer').classList.remove('active');
    }

    // ✅ Quét QR code từ video
    function scanQRCode() {
        if (!isScanning) return;

        const video = document.getElementById('videoElement');
        const canvas = document.createElement('canvas');
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;

        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0);

        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const code = jsQR(imageData.data, imageData.width, imageData.height);

        if (code) {
            // ✅ Phát hiện mã QR - soát vé
            document.getElementById('qrCodeInput').value = code.data;
            verifyTicket();
            stopCamera();
        }

        requestAnimationFrame(scanQRCode);
    }

    // ✅ Kiểu soát tay (giữ nguyên)
    const qrInput = document.getElementById('qrCodeInput');
    const verifyBtn = document.getElementById('verifyBtn');

    // Auto focus on input
    qrInput.focus();

    // Verify on Enter
    qrInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            verifyTicket();
        }
    });

    function verifyTicket() {
        const qrCode = qrInput.value.trim();

        if (!qrCode) {
            alert('Vui lòng nhập mã QR hoặc quét camera');
            return;
        }

        verifyBtn.disabled = true;
        verifyBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang kiểm tra...';

        $.ajax({
            url: '@Url.Action("VerifyTicket", "StaffOfflineBooking")',
            type: 'POST',
            data: { qrCode: qrCode },
            success: function(response) {
                const resultBox = document.getElementById('resultBox');
                resultBox.className = 'result-box ' + (response.success ? 'success' : 'error');

                if (response.success) {
                    const data = response.data;
                    const statusClass = data.ticketStatus === 'Đã sử dụng' ? 'used' : 'valid';
                    const statusText = data.ticketStatus === 'Đã sử dụng' ? 'Vé đã sử dụng' : 'Vé hợp lệ';

                    resultBox.innerHTML = `
                        <div class="result-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h2 style="margin: 0 0 1rem 0; font-size: 1.3rem;">Vé Hợp Lệ</h2>
                        <div class="ticket-details">
                            <div class="ticket-detail-row">
                                <span class="detail-label">Phim:</span>
                                <span class="detail-value">${data.movieName}</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Khách hàng:</span>
                                <span class="detail-value">${data.customerName}</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Điện thoại:</span>
                                <span class="detail-value">${data.customerPhone || 'N/A'}</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Ngày chiếu:</span>
                                <span class="detail-value">${data.showDate}</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Giờ chiếu:</span>
                                <span class="detail-value">${data.showTime}</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Phòng:</span>
                                <span class="detail-value">${data.roomName}</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Ghế:</span>
                                <span class="detail-value" style="color: #ff6b35; font-size: 1.1rem;">${data.seatNumber}</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Giá vé:</span>
                                <span class="detail-value" style="color: #27ae60;">${(data.ticketPrice).toLocaleString('vi-VN')} ₫</span>
                            </div>
                            <div class="ticket-detail-row">
                                <span class="detail-label">Trạng thái:</span>
                                <span class="status-badge ${statusClass}">${statusText}</span>
                            </div>
                        </div>
                    `;

                    qrInput.value = '';
                    qrInput.focus();
                } else {
                    resultBox.innerHTML = `
                        <div class="result-icon">
                            <i class="fas fa-times-circle"></i>
                        </div>
                        <h2 style="margin: 0;">${response.message}</h2>
                    `;
                }

                verifyBtn.disabled = false;
                verifyBtn.innerHTML = '<i class="fas fa-check-circle"></i> Xác Minh Vé';
            },
            error: function() {
                const resultBox = document.getElementById('resultBox');
                resultBox.className = 'result-box error';
                resultBox.innerHTML = `
                    <div class="result-icon">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <h2 style="margin: 0;">Có lỗi xảy ra</h2>
                `;

                verifyBtn.disabled = false;
                verifyBtn.innerHTML = '<i class="fas fa-check-circle"></i> Xác Minh Vé';
            }
        });
    }
</script>
