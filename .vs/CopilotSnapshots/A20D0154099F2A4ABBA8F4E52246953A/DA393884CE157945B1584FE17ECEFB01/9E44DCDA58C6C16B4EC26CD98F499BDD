        // ✅ API: Lấy danh sách CA CHIẾU còn trống theo Phòng + Ngày
        [HttpGet]
        public JsonResult GetAvailableShifts(int roomId, string date)
        {
            try
            {
                DateTime selectedDate = DateTime.Parse(date);
                
                // Lấy tất cả ca chiếu
                var allShifts = db.Ca_Chieus.ToList();
                
                // Lấy các ca đã có suất chiếu trong phòng này vào ngày đó
                var bookedShiftIds = db.Suat_Chieus
                    .Where(sc => sc.phong_chieu_id == roomId && sc.ngay_chieu == selectedDate)
                    .Select(sc => sc.ca_chieu_id)
                    .ToList();
                
                // Lọc ra ca còn trống
                var availableShifts = allShifts
                    .Where(ca => !bookedShiftIds.Contains(ca.ca_chieu_id))
                    .Select(ca => new
                    {
                        value = ca.ca_chieu_id,
                        text = $"{ca.gio_bat_dau.ToString(@"hh\:mm")} - {ca.gio_ket_thuc.ToString(@"hh\:mm")}"
                    })
                    .ToList();
                
                return Json(new { success = true, shifts = availableShifts }, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = ex.Message }, JsonRequestBehavior.AllowGet);
            }
        }

        // ✅ API: Lấy danh sách PHIM chưa có suất chiếu tại Ca + Phòng + Ngày đó
        [HttpGet]
        public JsonResult GetAvailableMovies(int roomId, int shiftId, string date)
        {
            try
            {
                DateTime selectedDate = DateTime.Parse(date);
                
                // Lấy tất cả phim
                var allMovies = db.Phims.ToList();
                
                // ✅ ĐIỀU KIỆN MỚI: Lấy các phim đã có suất chiếu BẤT KỲ CA NÀO trong ngày đó
                // (không quan tâm ca chiếu cụ thể, chỉ cần cùng phòng + cùng ngày)
                var bookedMovieIds = db.Suat_Chieus
                    .Where(sc => sc.phong_chieu_id == roomId 
                              && sc.ngay_chieu == selectedDate)
                    .Select(sc => sc.phim_id)
                    .Distinct()
                    .ToList();
                
                // Lọc ra phim chưa có suất chiếu trong ngày đó
                var availableMovies = allMovies
                    .Where(p => !bookedMovieIds.Contains(p.phim_id))
                    .Select(p => new
                    {
                        value = p.phim_id,
                        text = p.ten_phim + " (" + (p.thoi_luong ?? 0) + " phút)"
                    })
                    .ToList();
                
                return Json(new { success = true, movies = availableMovies }, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = ex.Message }, JsonRequestBehavior.AllowGet);
            }
        }

        private void SetShiftViewBag(int? selected = null)
        {
            try
            {
                var shifts = db.Ca_Chieus
                    .AsEnumerable()
                    .Select(ca => new
                    {
                        ca.ca_chieu_id,
                        ten_ca = $"{ca.gio_bat_dau.ToString(@"hh\:mm")} - {ca.gio_ket_thuc.ToString(@"hh\:mm")}"
                    })
                    .ToList();

                if (shifts.Any())
                {
                    ViewBag.Shifts = new SelectList(shifts, "ca_chieu_id", "ten_ca", selected);
                }
                else
                {
                    // If no shifts exist, create an empty SelectList with a placeholder
                    ViewBag.Shifts = new SelectList(new List<SelectListItem> 
                    { 
                        new SelectListItem { Text = "-- Chưa có ca chiếu --", Value = "" } 
                    }, "Value", "Text");
                    ViewBag.NoShifts = true;
                }
            }
            catch
            {
                ViewBag.Shifts = new SelectList(new List<SelectListItem>(), "Value", "Text");
                ViewBag.NoShifts = true;
            }
        }

        private void SetCreateViewBag(int? cinemaId, int? roomId)
        {
            ViewBag.Movies = new SelectList(db.Phims, "phim_id", "ten_phim");
            ViewBag.Cinemas = new SelectList(db.Raps, "rap_id", "ten_rap", cinemaId);
            ViewBag.Rooms = new SelectList(db.Phong_Chieus.Where(pc => pc.rap_id == cinemaId),
                "phong_chieu_id", "ten_phong", roomId);

            SetShiftViewBag();
        }

