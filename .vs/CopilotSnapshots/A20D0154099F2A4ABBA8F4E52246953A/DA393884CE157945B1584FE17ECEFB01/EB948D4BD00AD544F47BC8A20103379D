@model IEnumerable<WebCinema.Models.Suat_Chieu>

@{
    ViewBag.Title = "Quản Lý Suất Chiếu";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
    
    // Phân trang
    int pageSize = 10;
    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalItems = Model != null ? Model.Count() : 0;
    int totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
    var pagedModel = Model != null ? Model.Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList() : new List<WebCinema.Models.Suat_Chieu>();
}

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-clock"></i> Danh Sách Suất Chiếu</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Suất Chiếu
        </a>
    </div>

    <!-- Filter Form -->
    <div style="margin-bottom: 2rem; padding: 1.5rem; background: #f8f9fa; border-radius: 8px;">
        @using (Html.BeginForm("Index", "ShowtimeManagement", FormMethod.Get))
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: 1rem; align-items: end;">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Phim</label>
                    @Html.DropDownList("movieId", (SelectList)ViewBag.Movies, "-- Tất cả phim --", new { @class = "form-control" })
                </div>
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Rạp</label>
                    @Html.DropDownList("cinemaId", (SelectList)ViewBag.Cinemas, "-- Tất cả rạp --", new { @class = "form-control" })
                </div>
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Ngày Chiếu</label>
                    <input type="date" name="date" value="@ViewBag.Date" class="form-control" />
                </div>
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">Trạng Thái</label>
                    <select name="status" class="form-control">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Sắp Diễn Ra" @(ViewBag.Status == "Sắp Diễn Ra" ? "selected" : "")>Sắp Diễn Ra</option>
                        <option value="Đang Chiếu" @(ViewBag.Status == "Đang Chiếu" ? "selected" : "")>Đang Chiếu</option>
                        <option value="Đã Chiếu" @(ViewBag.Status == "Đã Chiếu" ? "selected" : "")>Đã Chiếu</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Lọc
                </button>
            </div>
        }
    </div>

    @if (pagedModel != null && pagedModel.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã SC</th>
                        <th>Phim</th>
                        <th>Rạp</th>
                        <th>Phòng</th>
                        <th>Ngày Chiếu</th>
                        <th>Ca Chiếu</th>
                        <th>Giá Vé</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var showtime in pagedModel)
                    {
                        // ✅ Tính trạng thái suất chiếu
                        DateTime now = DateTime.Now;
                        DateTime showtimeStart = showtime.ngay_chieu.Add(showtime.Ca_Chieu.gio_bat_dau);
                        DateTime showtimeEnd = showtime.ngay_chieu.Add(showtime.Ca_Chieu.gio_ket_thuc);
                        
                        string status = "";
                        string statusColor = "";
                        string statusIcon = "";
                        
                        if (now > showtimeEnd)
                        {
                            status = "Đã Chiếu";
                            statusColor = "#6c757d";
                            statusIcon = "fas fa-check-circle";
                        }
                        else if (now >= showtimeStart && now <= showtimeEnd)
                        {
                            status = "Đang Chiếu";
                            statusColor = "#ffc107";
                            statusIcon = "fas fa-play-circle";
                        }
                        else
                        {
                            status = "Sắp Diễn Ra";
                            statusColor = "#28a745";
                            statusIcon = "fas fa-hourglass-start";
                        }

                        <tr>
                            <td><strong>#@showtime.suat_chieu_id</strong></td>
                            <td>@(showtime.Phim != null ? showtime.Phim.ten_phim : "N/A")</td>
                            <td>@(showtime.Phong_Chieu != null && showtime.Phong_Chieu.Rap != null ? showtime.Phong_Chieu.Rap.ten_rap : "N/A")</td>
                            <td>@(showtime.Phong_Chieu != null ? showtime.Phong_Chieu.ten_phong : "N/A")</td>
                            <td>@showtime.ngay_chieu.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (showtime.Ca_Chieu != null)
                                {
                                    var ca = showtime.Ca_Chieu;
                                    var gioBatDau = ca.gio_bat_dau.ToString(@"hh\:mm");
                                    var gioKetThuc = ca.gio_ket_thuc.ToString(@"hh\:mm");
                                    var caName = gioBatDau + " - " + gioKetThuc;

                                    <span style="padding: 0.3rem 0.8rem; background: #3498db; color: white; border-radius: 4px; font-size: 0.85rem;">
                                        @caName
                                    </span>
                                }
                                else
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: gray; color: white; border-radius: 4px; font-size: 0.85rem;">
                                        (Chưa có ca)
                                    </span>
                                }
                            </td>
                            <td>@showtime.gia_ve.ToString("N0") đ</td>
                            <td>
                                <span style="padding: 0.4rem 0.8rem; background: @statusColor; color: white; border-radius: 4px; font-weight: 600; font-size: 0.85rem;">
                                    <i class="@statusIcon"></i> @status
                                </span>
                            </td>
                            <td>
                                @{
                                    bool canEdit = (status == "Sắp Diễn Ra" || status == "Đang Chiếu");
                                    bool canDelete = (status == "Đã Chiếu");
                                }
                                
                                @if (canEdit)
                                {
                                    <a href="@Url.Action("Edit", new { id = showtime.suat_chieu_id })" class="btn btn-secondary" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                }
                                else
                                {
                                    <span class="btn btn-secondary" style="padding: 0.5rem 1rem; margin-right: 0.5rem; opacity: 0.5; cursor: not-allowed;" title="Không thể sửa suất chiếu đã chiếu">
                                        <i class="fas fa-edit"></i> Sửa
                                    </span>
                                }
                                
                                @if (canDelete)
                                {
                                    <button onclick="deleteShowtime(@showtime.suat_chieu_id)" class="btn btn-danger" style="padding: 0.5rem 1rem;">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                }
                                else
                                {
                                    <span class="btn btn-danger" style="padding: 0.5rem 1rem; opacity: 0.5; cursor: not-allowed;" title="Chỉ có thể xóa suất chiếu đã chiếu">
                                        <i class="fas fa-trash"></i> Xóa
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        if (totalPages > 1)
        {
            <div style="margin-top: 2rem; display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
                @if (pageNumber > 1)
                {
                    <a href="@Url.Action("Index", new { pageNumber = pageNumber - 1, movieId = ViewBag.MovieId, cinemaId = ViewBag.CinemaId, date = ViewBag.Date, status = ViewBag.Status })" class="btn btn-secondary">
                        <i class="fas fa-chevron-left"></i> Trước
                    </a>
                }

                @{
                    for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == pageNumber)
                        {
                            <span class="btn btn-primary">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", new { pageNumber = i, movieId = ViewBag.MovieId, cinemaId = ViewBag.CinemaId, date = ViewBag.Date, status = ViewBag.Status })" class="btn btn-secondary">@i</a>
                        }
                    }
                }

                @if (pageNumber < totalPages)
                {
                    <a href="@Url.Action("Index", new { pageNumber = pageNumber + 1, movieId = ViewBag.MovieId, cinemaId = ViewBag.CinemaId, date = ViewBag.Date, status = ViewBag.Status })" class="btn btn-secondary">
                        Sau <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <p style="text-align: center; color: #999; padding: 2rem;">Không có suất chiếu nào.</p>
    }
</div>

@section scripts {
    <script>
        function deleteShowtime(id) {
            if (confirm('Bạn có chắc chắn muốn xóa suất chiếu này?')) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert('Xóa suất chiếu thành công!');
                            location.reload();
                        } else {
                            alert('Lỗi: ' + (response.message || 'Không thể xóa suất chiếu'));
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi xóa suất chiếu.');
                    }
                });
            }
        }
    </script>
}
