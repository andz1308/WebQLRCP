@{
    ViewBag.Title = "Hóa Đơn Đặt Vé";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    var booking = ViewBag.Booking as WebCinema.Models.Dat_Ve;
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    var foodItems = ViewBag.FoodItems as List<dynamic>;
    var ticketTotal = (decimal)ViewBag.TicketTotal;
    var foodTotal = (decimal)ViewBag.FoodTotal;
    var grandTotal = (decimal)ViewBag.GrandTotal;
    var qrCodeUrl = ViewBag.QRCodeUrl as string;
}

<style>
    .invoice-container {
        max-width: 900px;
        margin: 3rem auto;
        padding: 0 2rem;
    }

    .invoice-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px 12px 0 0;
        text-align: center;
    }

    .invoice-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2rem;
    }

    .invoice-content {
        background: white;
        padding: 2rem;
        border: 1px solid #e0e0e0;
    }

    .invoice-section {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #f0f0f0;
    }

    .invoice-section h3 {
        color: #333;
        font-size: 1.2rem;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
    }

    .info-label {
        color: #666;
        font-weight: 500;
    }

    .info-value {
        color: #333;
        font-weight: 600;
    }

    .ticket-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .ticket-item {
        background: #f9f9f9;
        border: 2px solid #667eea;
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
        color: #667eea;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .food-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    .food-table th {
        background: #f0f0f0;
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        border-bottom: 2px solid #e0e0e0;
    }

    .food-table td {
        padding: 0.8rem 1rem;
        border-bottom: 1px solid #e0e0e0;
    }

    /* ✅ Sửa: Total section chiếm toàn bộ chiều rộng */
    .total-section {
        margin-top: 2rem;
        margin-bottom: 0;
    }

    .total-box {
        background: white;
        color: black;
        border-radius: 8px;
        padding: 2rem;
        width: 100%;
    }

    .total-item {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem 0;
        font-size: 1.05rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .total-item:last-of-type {
        border-bottom: none;
    }

    .total-amount {
        color: black;
        font-weight: 600;
    }

    .total-final {
        display: flex;
        justify-content: space-between;
        font-size: 1.4rem;
        font-weight: bold;
        color: black;
        border-top: 2px solid rgba(255, 255, 255, 0.3);
        padding-top: 1.2rem;
        margin-top: 1.2rem;
    }

    /* ✅ QR Code Section */
    .qr-payment-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
        margin: 2rem 0;
    }

    .qr-code-container {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        display: inline-block;
        margin: 1rem 0;
    }

    .qr-code-container img {
        max-width: 300px;
        height: auto;
        border-radius: 8px;
    }

    .qr-instructions {
        margin-top: 1.5rem;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .qr-instructions li {
        margin: 0.5rem 0;
        text-align: left;
        display: inline-block;
        width: 100%;
    }

    .invoice-footer {
        background: #f9f9f9;
        padding: 2rem;
        border-radius: 0 0 12px 12px;
        border: 1px solid #e0e0e0;
        border-top: none;
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .action-btn {
        padding: 0.8rem 1.5rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-qr-confirm {
        background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
        color: white;
    }

    .btn-qr-confirm:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(39, 174, 96, 0.4);
    }

    .btn-print {
        background: #e0e0e0;
        color: #333;
    }

    .btn-print:hover {
        background: #d0d0d0;
    }

    .btn-back {
        background: #ecf0f1;
        color: #333;
    }

    .btn-back:hover {
        background: #bdc3c7;
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: #fff3cd;
        color: #856404;
        border-radius: 6px;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    @@media print {
        .invoice-footer {
            display: none;
        }
        .qr-payment-section {
            display: none;
        }
        body {
            background: white;
        }
        .invoice-container {
            margin: 0;
            padding: 0;
        }
    }
</style>

<div class="invoice-container">
    @if (booking != null)
    {
        <div class="invoice-header">
            <h1><i class="fas fa-receipt"></i> HÓA ĐƠN ĐẶT VÉ</h1>
            <p>DAV Cinema - Hệ Thống Đặt Vé Trực Tuyến</p>
        </div>

        <div class="invoice-content">
            @if (booking.trang_thai_Dat_Ve == "Chưa thanh toán")
            {
                <div class="status-badge">
                    <i class="fas fa-hourglass-half"></i> Trạng Thái: Chưa Thanh Toán
                </div>
            }
            else if (booking.trang_thai_Dat_Ve == "Đã Thanh toán")
            {
                <div class="status-badge" style="background: #d4edda; color: #155724;">
                    <i class="fas fa-check-circle"></i> Trạng Thái: Đã Thanh Toán
                </div>
            }

            <!-- Thông Tin Hóa Đơn -->
            <div class="invoice-section">
                <h3><i class="fas fa-info-circle"></i> Thông Tin Hóa Đơn</h3>
                <div class="info-grid">
                    <div>
                        <div class="info-item">
                            <span class="info-label">Mã Đơn Hàng:</span>
                            <span class="info-value">#@booking.Dat_Ve_id</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Ngày Tạo:</span>
                            <span class="info-value">@(booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Khách Hàng:</span>
                            <span class="info-value">@booking.Khach_Hang.ho_ten</span>
                        </div>
                    </div>
                    <div>
                        <div class="info-item">
                            <span class="info-label">Email:</span>
                            <span class="info-value">@booking.Khach_Hang.email</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Số Điện Thoại:</span>
                            <span class="info-value">@(booking.Khach_Hang.so_dien_thoai ?? "N/A")</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (showtime != null)
            {
                <!-- Thông Tin Phim & Suất Chiếu -->
                <div class="invoice-section">
                    <h3><i class="fas fa-film"></i> Thông Tin Phim & Suất Chiếu</h3>
                    <div class="info-grid">
                        <div>
                            <div class="info-item">
                                <span class="info-label">Tên Phim:</span>
                                <span class="info-value">@showtime.Phim.ten_phim</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Rạp:</span>
                                <span class="info-value">@showtime.Phong_Chieu.Rap.ten_rap</span>
                            </div>
                        </div>
                        <div>
                            <div class="info-item">
                                <span class="info-label">Phòng:</span>
                                <span class="info-value">@showtime.Phong_Chieu.ten_phong</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Ngày & Giờ Chiếu:</span>
                                <span class="info-value">@showtime.ngay_chieu.ToString("dd/MM/yyyy") lúc @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Danh Sách Vé -->
                <div class="invoice-section">
                    <h3><i class="fas fa-ticket-alt"></i> Danh Sách Vé (@tickets.Count vé)</h3>
                    <div class="ticket-list">
                        @foreach (var ticket in tickets)
                        {
                            <div class="ticket-item">@ticket.Ghe.so_ghe</div>
                        }
                    </div>
                </div>
            }

            <!-- Danh Sách Đồ Ăn (nếu có) -->
            @if (foodItems != null && foodItems.Count > 0)
            {
                <div class="invoice-section">
                    <div class="section-header">
                        <i class="fas fa-utensils"></i>
                        <h3>Đồ Ăn & Thức Uống</h3>
                    </div>
                    <div class="food-section">
                        <table class="food-table">
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Tên Sản Phẩm</th>
                                    <th style="width: 15%;">Số Lượng</th>
                                    <th style="width: 18%;">Đơn Giá</th>
                                    <th style="width: 17%;">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in foodItems)
                                {
                                    string foodName = "N/A";
                                    int quantity = 0;
                                    decimal price = 0m;
                                    decimal totalPrice = 0m;

                                    try
                                    {
                                        var t = item.GetType();
                                        var nameProp = t.GetProperty("FoodName");
                                        var qtyProp = t.GetProperty("Quantity");
                                        var priceProp = t.GetProperty("Price");
                                        var totalProp = t.GetProperty("TotalPrice");

                                        if (nameProp != null) { foodName = (nameProp.GetValue(item, null) ?? "N/A").ToString(); }
                                        if (qtyProp != null) { int.TryParse((qtyProp.GetValue(item, null) ?? 0).ToString(), out quantity); }
                                        if (priceProp != null) { decimal.TryParse((priceProp.GetValue(item, null) ?? 0).ToString(), out price); }
                                        if (totalProp != null) { decimal.TryParse((totalProp.GetValue(item, null) ?? 0).ToString(), out totalPrice); }
                                    }
                                    catch { }

                                    <tr>
                                        <td>@foodName</td>
                                        <td style="text-align: center; font-weight: 600;">@quantity</td>
                                        <td style="text-align: right; color: #7f8c8d;">@price.ToString("N0") ₫</td>
                                        <td style="text-align: right; color: #667eea; font-weight: 700;">@totalPrice.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Tóm Tắt Chi Phí -->
            <div class="total-section">
                <div class="total-box">
                    <div class="total-item">
                        <span>Tiền Vé (@tickets.Count vé):</span>
                        <span class="total-amount">@ticketTotal.ToString("N0") ₫</span>
                    </div>
                    @if (foodTotal > 0)
                    {
                        <div class="total-item">
                            <span>Đồ Ăn & Thức Uống:</span>
                            <span class="total-amount">@foodTotal.ToString("N0") ₫</span>
                        </div>
                    }
                    <div class="total-final">
                        <span>TỔNG CỘNG</span>
                        <span>@grandTotal.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>

            <!-- ✅ QR CODE Payment Section -->
            @if (booking.trang_thai_Dat_Ve == "Chưa thanh toán" && !string.IsNullOrEmpty(qrCodeUrl))
            {
                <div class="qr-payment-section">
                    <h3 style="margin-top: 0;">
                        <i class="fas fa-qrcode"></i> Quét Mã QR Để Thanh Toán
                    </h3>
                    <p>Sử dụng ứng dụng ngân hàng hoặc Mobile Banking để quét mã QR và chuyển tiền</p>
                    
                    <div class="qr-code-container">
                        <img src="@qrCodeUrl" alt="QR Code Payment" />
                    </div>

                    <div class="qr-instructions">
                        <strong>Hướng Dẫn:</strong>
                        <ol>
                            <li>📱 Mở ứng dụng ngân hàng hoặc Momo, VNPay, ZaloPay...</li>
                            <li>📸 Chọn "Quét mã QR" hoặc "Scan"</li>
                            <li>✅ Quét mã QR ở trên</li>
                            <li>💳 Xác nhận và hoàn tất giao dịch</li>
                            <li>✔️ Sau khi thanh toán, nhấn nút "Xác Nhận Đã Thanh Toán"</li>
                        </ol>
                    </div>

                    <button class="action-btn btn-qr-confirm" onclick="confirmQRPayment(@booking.Dat_Ve_id)" style="margin-top: 1.5rem;">
                        <i class="fas fa-check-circle"></i> Xác Nhận Đã Thanh Toán
                    </button>
                </div>
            }
        </div>

        <div class="invoice-footer">
            <button class="action-btn btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> In Hóa Đơn
            </button>
            <a href="@Url.Action("Index", "Home")" class="action-btn btn-back">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        function confirmQRPayment(bookingId) {
            if (!confirm('Bạn đã quét mã QR và chuyển tiền xong chưa?\n\nNhấn OK nếu đã thanh toán.')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("ConfirmQRPayment", "Invoice")',
                type: 'POST',
                data: { bookingId: bookingId },
                success: function (response) {
                    if (response.success) {
                        alert('✅ ' + response.message);
                        window.location.href = response.redirectUrl;
                    } else {
                        alert('❌ Lỗi: ' + response.message);
                    }
                },
                error: function () {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại!');
                }
            });
        }
    </script>
}
