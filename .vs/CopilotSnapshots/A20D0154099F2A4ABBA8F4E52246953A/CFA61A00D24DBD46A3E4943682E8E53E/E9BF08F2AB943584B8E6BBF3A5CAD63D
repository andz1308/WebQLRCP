@model IEnumerable<WebCinema.Models.Phim>

@{
    ViewBag.Title = "Quản Lý Phim";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-film"></i> Danh Sách Phim</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Phim Mới
        </a>
    </div>

    @if (ViewBag.TotalMovies > 0)
    {
        <div style="margin-bottom: 1rem; color: #666;">
            <strong>Tổng số:</strong> @ViewBag.TotalMovies phim | <strong>Trang:</strong> @ViewBag.CurrentPage / @ViewBag.TotalPages
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Poster</th>
                        <th>Tên Phim</th>
                        <th>Đạo Diễn</th>
                        <th>Thời Lượng</th>
                        <th>Ngày Khởi Chiếu</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movie in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(movie.hinh_anh))
                                {
                                    var imgSrc = movie.hinh_anh.StartsWith("~") ? Url.Content(movie.hinh_anh) : movie.hinh_anh;
                                    <img src="@imgSrc" alt="@movie.ten_phim" style="width: 60px; height: 90px; object-fit: cover; border-radius: 4px;" />
                                }
                                else
                                {
                                    <div style="width: 60px; height: 90px; background: #ddd; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-image" style="color: #999;"></i>
                                    </div>
                                }
                            </td>
                            <td><strong>@movie.ten_phim</strong></td>
                            <td>@(movie.Dao_Dien != null ? movie.Dao_Dien.ho_ten : "N/A")</td>
                            <td>@(movie.thoi_luong.HasValue ? movie.thoi_luong.Value + " phút" : "N/A")</td>
                            <td>@(movie.ngay_khoi_chieu.HasValue ? movie.ngay_khoi_chieu.Value.ToString("dd/MM/yyyy") : "N/A")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(movie.trang_thai))
                                {
                                    if (movie.trang_thai == "Đang chiếu")
                                    {
                                        <span style="background: #d4edda; color: #155724; padding: 0.4rem 0.8rem; border-radius: 4px; font-weight: 600; font-size: 0.85rem;">
                                            <i class="fas fa-play-circle"></i> Đang Chiếu
                                        </span>
                                    }
                                    else if (movie.trang_thai == "Ngừng chiếu")
                                    {
                                        <span style="background: #f8d7da; color: #721c24; padding: 0.4rem 0.8rem; border-radius: 4px; font-weight: 600; font-size: 0.85rem;">
                                            <i class="fas fa-pause-circle"></i> Ngừng Chiếu
                                        </span>
                                    }
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = movie.phim_id })" class="btn btn-secondary" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <button onclick="deleteMovie(@movie.phim_id, '@movie.ten_phim')" class="btn btn-danger" style="padding: 0.5rem 1rem;">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* PHÂN TRANG *@
        if (ViewBag.TotalPages > 1)
        {
            <div style="margin-top: 2rem; display: flex; justify-content: center; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })" 
                       class="btn btn-secondary">
                        <i class="fas fa-chevron-left"></i> Trước
                    </a>
                }
                
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="btn btn-primary" style="pointer-events: none;">
                            @i
                        </span>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) <= 2 || i == 1 || i == ViewBag.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { page = i })" class="btn btn-secondary">
                            @i
                        </a>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) == 3)
                    {
                        <span style="padding: 0.6rem; color: #999;">...</span>
                    }
                }
                
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })" 
                       class="btn btn-secondary">
                        Sau <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <p style="text-align: center; color: #999; padding: 2rem;">Chưa có phim nào trong hệ thống.</p>
    }
</div>

@section scripts {
    <script>
        function deleteMovie(id, name) {
            if (confirm('Bạn có chắc chắn muốn xóa phim "' + name + '"?')) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Lỗi: ' + (response.message || 'Không thể xóa phim'));
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi xóa phim.');
                    }
                });
            }
        }
    </script>
}


