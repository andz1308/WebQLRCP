@model WebCinema.Models.RegisterViewModel

@{
    ViewBag.Title = "Đăng Ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Ký - DAV Cinema</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 0;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            top: -250px;
            right: -250px;
            animation: float 6s ease-in-out infinite;
        }

        body::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            bottom: -200px;
            left: -200px;
            animation: float 8s ease-in-out infinite;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(20px); }
        }

        .auth-container {
            max-width: 550px;
            width: 100%;
            padding: 0 2rem;
            position: relative;
            z-index: 1;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 3rem 2.5rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            animation: slideIn 0.5s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-logo {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }

        .auth-logo i {
            font-size: 2rem;
            color: white;
        }

        .auth-title {
            font-size: 2rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .auth-subtitle {
            color: #666;
            font-size: 0.95rem;
        }

        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-label {
            font-weight: 600;
            color: #333;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-label i {
            color: #667eea;
        }

        .form-input {
            width: 100%;
            padding: 0.9rem 1rem;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f9f9f9;
            box-sizing: border-box;
        }

        .form-input:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
            transform: translateY(-2px);
        }

        .error-message {
            color: #e74c3c;
            font-size: 0.85rem;
            margin-top: 0.3rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .error-message::before {
            content: '⚠';
        }

        .password-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-wrapper .form-input {
            width: 100%;
            padding-right: 42px;
            box-sizing: border-box;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 0;
            bottom: 0;
            background: transparent;
            border: none;
            cursor: pointer;
            color: #999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            transition: all 0.3s ease;
            border-radius: 8px;
        }

        .password-toggle:hover {
            color: #667eea;
            background: rgba(102, 126, 234, 0.1);
        }

        .password-toggle i {
            font-size: 1rem;
        }

        .password-strength {
            height: 4px;
            background: #e0e0e0;
            border-radius: 2px;
            overflow: hidden;
            margin-top: 0.5rem;
        }

        .password-strength-bar {
            height: 100%;
            width: 0%;
            transition: all 0.3s ease;
            background: #e74c3c;
        }

        .password-strength-bar.weak {
            width: 33%;
            background: #e74c3c;
        }

        .password-strength-bar.medium {
            width: 66%;
            background: #f39c12;
        }

        .password-strength-bar.strong {
            width: 100%;
            background: #27ae60;
        }

        /* Email verification section */
        .email-verify-group {
            display: flex;
            gap: 0.5rem;
        }

        .email-verify-group .form-input {
            flex: 1;
        }

        .btn-verify {
            padding: 0.9rem 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .btn-verify:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-verify:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }

        .verify-status {
            font-size: 0.85rem;
            margin-top: 0.3rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .verify-status.success {
            color: #27ae60;
        }

        .verify-status.success::before {
            content: '✓';
            font-weight: bold;
        }

        .verify-status.error {
            color: #e74c3c;
        }

        .verify-status.error::before {
            content: '✕';
            font-weight: bold;
        }

        .otp-input-group {
            display: none;
            margin-top: 0.5rem;
        }

        .otp-input-group.show {
            display: flex;
            gap: 0.5rem;
        }

        .btn-submit {
            padding: 1rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 0.5rem;
            position: relative;
            overflow: hidden;
        }

        .btn-submit::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
        }

        .btn-submit:hover::before {
            left: 100%;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
        }

        .btn-submit:active {
            transform: translateY(-1px);
        }

        .btn-submit:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }

        .terms-text {
            font-size: 0.85rem;
            color: #666;
            text-align: center;
            line-height: 1.6;
        }

        .terms-text a {
            color: #667eea;
            text-decoration: none;
        }

        .terms-text a:hover {
            text-decoration: underline;
        }

        .auth-footer {
            text-align: center;
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid #e0e0e0;
            color: #666;
        }

        .auth-footer a {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
        }

        .auth-footer a:hover {
            color: #764ba2;
            text-decoration: underline;
        }

        .alert-error {
            padding: 1rem;
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
            border: 2px solid #dc3545;
            border-radius: 12px;
            color: #721c24;
            margin-bottom: 1.5rem;
            text-align: center;
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        @@media (max-width: 576px) {
            .auth-card {
                padding: 2rem 1.5rem;
            }

            .auth-title {
                font-size: 1.6rem;
            }

            .email-verify-group {
                flex-direction: column;
            }

            body::before,
            body::after {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1 class="auth-title">Đăng Ký</h1>
                <p class="auth-subtitle">Tạo tài khoản để trải nghiệm dịch vụ tốt nhất</p>
            </div>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form", id = "registerForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert-error" })

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-user"></i>
                        Họ và tên
                    </label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-input", placeholder = "Nguyễn Văn A" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-envelope"></i>
                        Email <span style="color: #e74c3c;">*</span>
                    </label>
                    <div class="email-verify-group">
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-input", placeholder = "example@gmail.com", type = "email", id = "emailInput" })
                        <button type="button" id="sendOtpBtn" class="btn-verify">
                            <i class="fas fa-paper-plane"></i> Gửi mã
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "error-message" })
                    <div id="verifyStatus" class="verify-status"></div>

                    <!-- OTP Input -->
                    <div id="otpInputGroup" class="otp-input-group">
                        <input type="text" id="otpInput" class="form-input" placeholder="Nhập mã OTP (6 số)" maxlength="6" />
                        <button type="button" id="verifyOtpBtn" class="btn-verify">
                            <i class="fas fa-check"></i> Xác thực
                        </button>
                    </div>
                    <input type="hidden" id="emailVerified" name="EmailVerified" value="false" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-phone"></i>
                        Số điện thoại
                    </label>
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-input", placeholder = "0912345678" })
                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-calendar"></i>
                        Ngày sinh
                    </label>
                    @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-input", type = "date" })
                    @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-venus-mars"></i>
                        Giới tính
                    </label>
                    @Html.DropDownListFor(m => m.GioiTinh,
                        new SelectList(new[] { "Nam", "Nữ", "Khác" }, "Nam"),
                        "-- Chọn giới tính --",
                        new { @class = "form-input" })
                    @Html.ValidationMessageFor(m => m.GioiTinh, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-map-marker-alt"></i>
                        Địa chỉ
                    </label>
                    @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-input", placeholder = "Nhập địa chỉ của bạn" })
                    @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-lock"></i>
                        Mật khẩu
                    </label>
                    <div class="password-wrapper">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-input", placeholder = "••••••••", id = "password", style = "padding-right: 45px;" })
                        <button type="button" id="togglePassword" class="password-toggle">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-strength">
                        <div class="password-strength-bar" id="strengthBar"></div>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "error-message" })
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-lock"></i>
                        Xác nhận mật khẩu
                    </label>
                    <div class="password-wrapper">
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-input", placeholder = "••••••••", id = "confirmPassword", style = "padding-right: 45px;" })
                        <button type="button" id="toggleConfirmPassword" class="password-toggle">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "error-message" })
                </div>

                <div class="terms-text">
                    Bằng việc đăng ký, bạn đồng ý với <a href="#">Điều khoản sử dụng</a> và <a href="#">Chính sách bảo mật</a> của DAV Cinema.
                </div>

                <button type="submit" class="btn-submit" id="submitBtn" disabled>
                    <i class="fas fa-user-plus"></i> Đăng Ký Ngay
                </button>
            }

            <div class="auth-footer">
                Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
            </div>
        </div>
    </div>

    <script>
        // Password visibility toggle
        function togglePasswordVisibility(fieldId, buttonId) {
            var field = document.getElementById(fieldId);
            var button = document.getElementById(buttonId);
            var icon = button.querySelector('i');
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('togglePassword').addEventListener('click', function () {
                togglePasswordVisibility('password', 'togglePassword');
            });
            document.getElementById('toggleConfirmPassword').addEventListener('click', function () {
                togglePasswordVisibility('confirmPassword', 'toggleConfirmPassword');
            });

            // Password strength meter
            document.getElementById('password').addEventListener('input', function () {
                const password = this.value;
                const strengthBar = document.getElementById('strengthBar');
                let strength = 0;
                if (password.length >= 6) strength++;
                if (password.length >= 10) strength++;
                if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
                if (/\d/.test(password)) strength++;
                if (/[^a-zA-Z0-9]/.test(password)) strength++;

                strengthBar.className = 'password-strength-bar';
                if (strength <= 2) {
                    strengthBar.classList.add('weak');
                } else if (strength <= 4) {
                    strengthBar.classList.add('medium');
                } else {
                    strengthBar.classList.add('strong');
                }
            });

            // Email verification logic
            let generatedOtp = '';
            let emailVerified = false;

            document.getElementById('sendOtpBtn').addEventListener('click', function () {
                const email = document.getElementById('emailInput').value.trim();
                const verifyStatus = document.getElementById('verifyStatus');
                
                // Validate email format
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!email || !emailRegex.test(email)) {
                    verifyStatus.className = 'verify-status error';
                    verifyStatus.textContent = 'Vui lòng nhập email hợp lệ!';
                    return;
                }

                // Check if email is Gmail
                if (!email.toLowerCase().endsWith('@gmail.com')) {
                    verifyStatus.className = 'verify-status error';
                    verifyStatus.textContent = 'Chỉ chấp nhận email Gmail (@gmail.com)!';
                    return;
                }

                // Generate 6-digit OTP
                generatedOtp = Math.floor(100000 + Math.random() * 900000).toString();
                
                // Send OTP via API
                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang gửi...';
                
                fetch('/Account/SendOTP', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email: email, otp: generatedOtp })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        verifyStatus.className = 'verify-status success';
                        verifyStatus.textContent = 'Mã OTP đã được gửi đến email của bạn!';
                        document.getElementById('otpInputGroup').classList.add('show');
                        
                        // Re-enable button after 60 seconds
                        let countdown = 60;
                        const interval = setInterval(() => {
                            this.innerHTML = `<i class="fas fa-clock"></i> ${countdown}s`;
                            countdown--;
                            if (countdown < 0) {
                                clearInterval(interval);
                                this.disabled = false;
                                this.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi lại';
                            }
                        }, 1000);
                    } else {
                        verifyStatus.className = 'verify-status error';
                        verifyStatus.textContent = data.message || 'Không thể gửi mã OTP. Vui lòng thử lại!';
                        this.disabled = false;
                        this.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi mã';
                    }
                })
                .catch(error => {
                    verifyStatus.className = 'verify-status error';
                    verifyStatus.textContent = 'Lỗi kết nối. Vui lòng thử lại!';
                    this.disabled = false;
                    this.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi mã';
                });
            });

            document.getElementById('verifyOtpBtn').addEventListener('click', function () {
                const inputOtp = document.getElementById('otpInput').value.trim();
                const verifyStatus = document.getElementById('verifyStatus');

                if (inputOtp === generatedOtp) {
                    verifyStatus.className = 'verify-status success';
                    verifyStatus.textContent = 'Email đã được xác thực thành công!';
                    document.getElementById('emailVerified').value = 'true';
                    document.getElementById('submitBtn').disabled = false;
                    document.getElementById('otpInputGroup').style.display = 'none';
                    document.getElementById('sendOtpBtn').disabled = true;
                    document.getElementById('emailInput').readOnly = true;
                    emailVerified = true;
                } else {
                    verifyStatus.className = 'verify-status error';
                    verifyStatus.textContent = 'Mã OTP không chính xác!';
                }
            });

            // Form submission validation
            document.getElementById('registerForm').addEventListener('submit', function (e) {
                if (!emailVerified) {
                    e.preventDefault();
                    alert('Vui lòng xác thực email trước khi đăng ký!');
                }
            });
        });
    </script>
</body>
</html>
