                    </html>
                ";

                SendEmail(email, subject, body);

                return Json(new { success = true, message = "Mã OTP đã được gửi đến email của bạn" });
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = "Có lỗi xảy ra: " + ex.Message });
