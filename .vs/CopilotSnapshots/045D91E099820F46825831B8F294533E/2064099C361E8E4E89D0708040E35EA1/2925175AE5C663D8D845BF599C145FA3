using System;
using System.Collections.Generic;
using System.Linq;
using System.Security.Cryptography;
using System.Text;
using System.Web;

namespace WebCinema.Infrastructure
{
    /// <summary>
    /// Tích hợp Cổng Thanh Toán VNPay - Chuẩn RFC3986 (HMAC SHA512)
    /// </summary>
    public class PaymentGateway
    {
        // ======================
        // ⚙️ CẤU HÌNH VNPAY
        // ======================
        private readonly string _vnpayUrl = "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"; // URL Sandbox
        private readonly string _tmnCode = "OOI636PL"; // Mã website (TMN Code)
        private readonly string _hashSecret = "WN5E5HSY2APFHRCL7R1U1C3MLTTLTNW2"; // Chuỗi bí mật (Hash Secret)
        private readonly string _returnUrl = "http://localhost:44300/Invoice/PaymentCallback"; // URL người dùng quay lại
        private readonly string _ipnUrl = "http://localhost:44300/Invoice/PaymentIpn"; // Server-to-Server (IPN URL)

        // ======================
        // 🚀 TẠO URL THANH TOÁN
        // ======================
        public string CreatePaymentUrl(decimal amount, string orderInfo, string customerId)
        {
            try
            {
                var vnpayData = new SortedDictionary<string, string>
                {
                    { "vnp_Version", "2.1.0" },
                    { "vnp_Command", "pay" },
                    { "vnp_TmnCode", _tmnCode },
                    { "vnp_Amount", ((long)(amount * 100)).ToString() }, // Nhân 100 theo yêu cầu VNPay
                    { "vnp_CurrCode", "VND" },
                    { "vnp_TxnRef", GenerateTransactionRef() },
                    { "vnp_OrderInfo", orderInfo },
                    { "vnp_OrderType", "billpayment" },
                    { "vnp_Locale", "vn" },
                    { "vnp_CreateDate", DateTime.Now.ToString("yyyyMMddHHmmss") },
                    { "vnp_IpAddr", GetClientIP() },
                    { "vnp_ReturnUrl", _returnUrl },
                    { "vnp_IpnUrl", _ipnUrl }
                };

                // Ghép chuỗi ký
                StringBuilder rawData = new StringBuilder();
                foreach (var kv in vnpayData)
                {
                    if (!string.IsNullOrEmpty(kv.Value))
                    {
                        rawData.Append(kv.Key + "=" + UrlEncode(kv.Value) + "&");
                    }
                }

                string dataToHash = rawData.ToString().TrimEnd('&');
                string secureHash = HmacSHA512(dataToHash, _hashSecret);

                string paymentUrl = _vnpayUrl + "?" + dataToHash + "&vnp_SecureHash=" + secureHash;

                LoggingHelper.LogInfo($"✅ URL Thanh Toán: {paymentUrl}");
                return paymentUrl;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                throw;
            }
        }

        // ======================
        // 🔍 XÁC NHẬN THANH TOÁN (Return / IPN)
        // ======================
        public PaymentResponse VerifyPayment(Dictionary<string, string> responseData)
        {
            try
            {
                var response = new PaymentResponse();

                LoggingHelper.LogInfo($"VerifyPayment: Nhận {responseData.Count} tham số");
                foreach (var kv in responseData)
                {
                    LoggingHelper.LogInfo($"   {kv.Key} = {kv.Value}");
                }

                if (!responseData.ContainsKey("vnp_SecureHash"))
                {
                    response.IsValid = false;
                    response.Message = "Thiếu chữ ký vnp_SecureHash";
                    return response;
                }

                string receivedHash = responseData["vnp_SecureHash"];
                responseData.Remove("vnp_SecureHash");
                responseData.Remove("vnp_SecureHashType");

                // Tạo lại chuỗi để kiểm tra
                StringBuilder rawData = new StringBuilder();
                foreach (var kv in responseData.OrderBy(k => k.Key))
                {
                    if (!string.IsNullOrEmpty(kv.Value))
                    {
                        rawData.Append(kv.Key + "=" + UrlEncode(kv.Value) + "&");
                    }
                }

                string dataToHash = rawData.ToString().TrimEnd('&');
                string expectedHash = HmacSHA512(dataToHash, _hashSecret);

                LoggingHelper.LogInfo($"VerifyPayment: Expected = {expectedHash}");
                LoggingHelper.LogInfo($"VerifyPayment: Actual   = {receivedHash}");

                // So sánh chữ ký
                if (expectedHash.Equals(receivedHash, StringComparison.OrdinalIgnoreCase))
                {
                    response.IsValid = true;
                    response.ResponseCode = responseData.ContainsKey("vnp_ResponseCode") ? responseData["vnp_ResponseCode"] : "";
                    response.TransactionNo = responseData.ContainsKey("vnp_TransactionNo") ? responseData["vnp_TransactionNo"] : "";
                    response.BankCode = responseData.ContainsKey("vnp_BankCode") ? responseData["vnp_BankCode"] : "";
                    response.OrderInfo = responseData.ContainsKey("vnp_OrderInfo") ? responseData["vnp_OrderInfo"] : "";

                    if (response.ResponseCode == "00")
                    {
                        response.Success = true;
                        response.Message = "Giao dịch thành công";
                        LoggingHelper.LogInfo("✅ Thanh toán thành công");
                    }
                    else
                    {
                        response.Success = false;
                        response.Message = GetResponseMessage(response.ResponseCode);
                        LoggingHelper.LogInfo($"⚠️ Lỗi thanh toán: {response.ResponseCode} - {response.Message}");
                    }
                }
                else
                {
                    response.IsValid = false;
                    response.Success = false;
                    response.Message = "Chữ ký không hợp lệ";
                    LoggingHelper.LogInfo("❌ Chữ ký sai - không khớp với hệ thống VNPay");
                }

                return response;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                throw;
            }
        }

        // ======================
        // 🧩 HÀM HỖ TRỢ
        // ======================
        private string GenerateTransactionRef()
        {
            return DateTime.Now.ToString("yyyyMMddHHmmssfff");
        }

        private string GetClientIP()
        {
            try
            {
                var context = HttpContext.Current;
                if (context != null)
                {
                    string ip = context.Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
                    if (string.IsNullOrEmpty(ip))
                        ip = context.Request.ServerVariables["REMOTE_ADDR"];
                    if (string.IsNullOrEmpty(ip) || ip == "::1")
                        ip = "127.0.0.1";
                    return ip;
                }
            }
            catch { }
            return "127.0.0.1";
        }

        // Encode theo RFC3986
        private string UrlEncode(string input)
        {
            return HttpUtility.UrlEncode(input)
                .Replace("+", "%20")
                .Replace("%21", "!")
                .Replace("%27", "'")
                .Replace("%28", "(")
                .Replace("%29", ")")
                .Replace("%7E", "~");
        }

        // Tạo HMAC SHA512
        private string HmacSHA512(string data, string key)
        {
            byte[] keyBytes = Encoding.UTF8.GetBytes(key);
            byte[] dataBytes = Encoding.UTF8.GetBytes(data);
            using (var hmac = new HMACSHA512(keyBytes))
            {
                byte[] hashValue = hmac.ComputeHash(dataBytes);
                return BitConverter.ToString(hashValue).Replace("-", "").ToLower();
            }
        }

        // Mã phản hồi VNPay
        private string GetResponseMessage(string code)
        {
            var messages = new Dictionary<string, string>
            {
                { "00", "Giao dịch thành công" },
                { "07", "Giao dịch nghi ngờ (liên hệ ngân hàng)" },
                { "09", "Tài khoản chưa đăng ký InternetBanking" },
                { "10", "Xác thực SecurePassword lần 1 sai" },
                { "11", "Hết hạn xác thực SecurePassword" },
                { "12", "Khách hàng từ chối giao dịch" },
                { "13", "Xác thực SecurePassword lần 2 sai" },
                { "24", "Khách hàng hủy giao dịch" },
                { "51", "Không đủ số dư" },
                { "65", "Vượt hạn mức giao dịch trong ngày" },
                { "75", "Ngân hàng từ chối giao dịch" },
                { "79", "Sai mật khẩu thanh toán quá số lần" },
                { "99", "Lỗi không xác định" }
            };
            return messages.ContainsKey(code) ? messages[code] : "Lỗi không xác định";
        }
    }

    // ======================
    // 🧾 MODEL KẾT QUẢ THANH TOÁN
    // ======================
    public class PaymentResponse
    {
        public bool IsValid { get; set; }
        public bool Success { get; set; }
        public string ResponseCode { get; set; }
        public string TransactionNo { get; set; }
        public string BankCode { get; set; }
        public string OrderInfo { get; set; }
        public string Message { get; set; }
    }
}
