        /// <summary>
        /// Helper: Trích xuất Booking ID từ OrderInfo
        /// ✅ Support multiple formats
        /// </summary>
        private int ExtractBookingIdFromOrderInfo(string orderInfo)
        {
            try
            {
                if (string.IsNullOrEmpty(orderInfo))
                {
                    LoggingHelper.LogInfo($"⚠️ OrderInfo rỗng");
                    return 0;
                }

                LoggingHelper.LogInfo($"🔍 Trích xuất Booking ID từ OrderInfo: '{orderInfo}'");

                // ✅ Format 1: "Thanh toán vé xem phim - Mã đơn: {bookingId}"
                int lastColonIndex = orderInfo.LastIndexOf(":");
                if (lastColonIndex != -1 && lastColonIndex < orderInfo.Length - 1)
                {
                    string bookingIdStr = orderInfo.Substring(lastColonIndex + 1).Trim();
                    if (int.TryParse(bookingIdStr, out int bookingId))
                    {
                        LoggingHelper.LogInfo($"✅ Format 1 matched: Booking ID = {bookingId}");
                        return bookingId;
                    }
                }

                // ✅ Format 2: Nếu là số thuần (ví dụ: "12345")
                if (int.TryParse(orderInfo.Trim(), out int directBookingId))
                {
                    LoggingHelper.LogInfo($"✅ Format 2 matched: Booking ID = {directBookingId}");
                    return directBookingId;
                }

                // ✅ Format 3: Tìm số đầu tiên trong chuỗi (fallback)
                System.Text.RegularExpressions.MatchCollection matches = 
                    System.Text.RegularExpressions.Regex.Matches(orderInfo, @"\d+");
                
                if (matches.Count > 0)
                {
                    string firstNumberStr = matches[matches.Count - 1].Value;  // Lấy số cuối cùng (thường là Booking ID)
                    if (int.TryParse(firstNumberStr, out int fallbackBookingId))
                    {
                        LoggingHelper.LogInfo($"✅ Format 3 (fallback) matched: Booking ID = {fallbackBookingId}");
                        return fallbackBookingId;
                    }
                }

                LoggingHelper.LogInfo($"❌ Không thể trích xuất Booking ID từ: '{orderInfo}'");
                return 0;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"ExtractBookingIdFromOrderInfo - OrderInfo: {orderInfo}");
                return 0;
            }
        }

        /// <summary>
        /// POST: VNPAY IPN (Server-to-Server) - Xử lý xác nhận thanh toán từ VNPAY
        /// </summary>
        [HttpPost]
        public ActionResult PaymentIpn()
        {
            try
            {
                LoggingHelper.LogInfo($"=== PaymentIpn (Server-to-Server) ===");
                LoggingHelper.LogInfo($"Method: {Request.HttpMethod}");
                LoggingHelper.LogInfo($"URL: {Request.Url}");

                // Lấy dữ liệu từ POST/GET
                var responseData = new Dictionary<string, string>();
                foreach (string key in Request.QueryString.Keys)
                {
                    if (!string.IsNullOrEmpty(key))
                    {
                        responseData[key] = Request.QueryString[key];
                    }
                }
                foreach (string key in Request.Form.Keys)
                {
                    if (!string.IsNullOrEmpty(key))
                    {
                        responseData[key] = Request.Form[key];
                    }
                }

                LoggingHelper.LogInfo($"Received {responseData.Count} parameters");
                foreach (var kv in responseData)
                {
                    LoggingHelper.LogInfo($"   {kv.Key} = {kv.Value}");
                }

                // Xác minh thanh toán
                var paymentGateway = new PaymentGateway();
                var paymentResponse = paymentGateway.VerifyPayment(responseData);

                // Kiểm tra chữ ký
                if (!paymentResponse.IsValid)
                {
                    LoggingHelper.LogInfo($"❌ IPN: Invalid signature");
                    return Json(new { RspCode = "97", Message = "Invalid signature" });
                }

                // Trích xuất Booking ID
                string orderInfo = paymentResponse.OrderInfo;
                int bookingId = ExtractBookingIdFromOrderInfo(orderInfo);

                if (bookingId == 0)
                {
                    LoggingHelper.LogInfo($"❌ IPN: Cannot extract booking ID from '{orderInfo}'");
                    return Json(new { RspCode = "99", Message = "Invalid order info" });
                }

                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null)
                {
                    LoggingHelper.LogInfo($"❌ IPN: Booking not found: {bookingId}");
                    return Json(new { RspCode = "01", Message = "Order not found" });
                }

                // Xử lý kết quả thanh toán
                if (paymentResponse.Success && paymentResponse.ResponseCode == "00")
                {
                    // ✅ Thanh toán thành công
                    booking.trang_thai_Dat_Ve = "Đã Thanh toán";

                    var tickets = booking.Ves.ToList();
                    foreach (var ticket in tickets)
                    {
                        ticket.trang_thai_ve = "Chưa sử dụng";
                    }

                    db.SubmitChanges();

                    LoggingHelper.LogInfo($"✅ IPN: Payment successful");
                    LoggingHelper.LogInfo($"   - Booking ID: {bookingId}");
                    LoggingHelper.LogInfo($"   - Amount: {paymentResponse.Amount}");
                    LoggingHelper.LogInfo($"   - Transaction: {paymentResponse.TransactionNo}");

                    return Json(new { RspCode = "00", Message = "Confirm success" });
                }
                else
                {
                    // ❌ Thanh toán thất bại
                    LoggingHelper.LogInfo($"❌ IPN: Payment failed");
                    LoggingHelper.LogInfo($"   - Booking ID: {bookingId}");
                    LoggingHelper.LogInfo($"   - Response Code: {paymentResponse.ResponseCode}");
                    LoggingHelper.LogInfo($"   - Message: {paymentResponse.Message}");

                    return Json(new { RspCode = "02", Message = "Payment failed" });
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "PaymentIpn");
                return Json(new { RspCode = "99", Message = "Internal error" });
            }
        }

