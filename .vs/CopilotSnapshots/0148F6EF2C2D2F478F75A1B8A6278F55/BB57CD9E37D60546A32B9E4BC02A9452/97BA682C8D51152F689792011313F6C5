@{
    ViewBag.Title = "Thanh Toán Thành Công";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    var booking = ViewBag.Booking as WebCinema.Models.Dat_Ve;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    var transactionNo = ViewBag.TransactionNo as string;
}

<style>
    .success-container {
        max-width: 800px;
        margin: 3rem auto;
        padding: 0 2rem;
    }

    .success-header {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        padding: 3rem 2rem;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 2rem;
        box-shadow: 0 8px 30px rgba(39, 174, 96, 0.3);
    }

    .success-header i {
        font-size: 4rem;
        margin-bottom: 1rem;
        animation: checkmark 0.6s ease-in-out;
    }

    @@keyframes checkmark {
        0% { transform: scale(0); opacity: 0; }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); opacity: 1; }
    }

    .success-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.5rem;
    }

    .success-content {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 1rem 0;
        border-bottom: 1px solid #e0e0e0;
    }

    .info-label {
        color: #666;
        font-weight: 500;
    }

    .info-value {
        color: #333;
        font-weight: 600;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .total-section {
        background: #f9f9f9;
        padding: 1.5rem;
        border-radius: 8px;
        margin-top: 1rem;
    }

    .total-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
        font-size: 1.1rem;
    }

    .total-amount {
        color: #27ae60;
        font-weight: bold;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 1rem 2rem;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #27ae60 0%, #52be80 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(39, 174, 96, 0.4);
    }

    .btn-secondary {
        background: #e0e0e0;
        color: #333;
    }

    .btn-secondary:hover {
        background: #d0d0d0;
    }

    .notice-box {
        background: #d4edda;
        border: 2px solid #27ae60;
        border-radius: 8px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        color: #155724;
    }

    .ticket-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1rem 0;
    }

    .ticket-badge {
        background: #27ae60;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 600;
    }
</style>

<div class="success-container">
    <div class="success-header">
        <i class="fas fa-check-circle"></i>
        <h1>Thanh Toán Thành Công!</h1>
        <p>C?m ?n b?n ?ã thanh toán. Vé c?a b?n ?ã ???c xác nh?n.</p>
    </div>

    @if (booking != null)
    {
        <div class="success-content">
            <h2 style="color: #27ae60; margin-top: 0;"><i class="fas fa-receipt"></i> Chi Ti?t Giao D?ch</h2>

            <div class="info-item">
                <span class="info-label">Mã ??n Hàng:</span>
                <span class="info-value">#@booking.Dat_Ve_id</span>
            </div>

            <div class="info-item">
                <span class="info-label">Mã Giao D?ch VNPAY:</span>
                <span class="info-value">@transactionNo</span>
            </div>

            <div class="info-item">
                <span class="info-label">Th?i Gian Thanh Toán:</span>
                <span class="info-value">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>

            <div class="info-item">
                <span class="info-label">Tr?ng Thái:</span>
                <span class="info-value"><span style="background: #27ae60; color: white; padding: 0.3rem 0.8rem; border-radius: 4px;">? ?ã Thanh Toán</span></span>
            </div>

            @if (tickets != null && tickets.Count > 0)
            {
                <div class="info-item">
                    <span class="info-label">Danh Sách Gh?:</span>
                    <div class="ticket-list">
                        @foreach (var ticket in tickets)
                        {
                            <div class="ticket-badge">@ticket.Ghe.so_ghe</div>
                        }
                    </div>
                </div>
            }

            <div class="total-section">
                <div class="total-item">
                    <span>T?ng Ti?n Thanh Toán:</span>
                    <span class="total-amount">@booking.tong_tien.ToString("N0") ?</span>
                </div>
            </div>
        </div>

        <div class="notice-box">
            <i class="fas fa-info-circle"></i>
            <strong>L?u Ý Quan Tr?ng:</strong>
            <ul style="margin: 0.5rem 0 0 1.5rem;">
                <li>Vé c?a b?n ?ã ???c g?i vào email <strong>@booking.Khach_Hang.email</strong></li>
                <li>Vui lòng ??n r?p <strong>15 phút</strong> tr??c gi? chi?u</li>
                <li>Xu?t trình mã QR ho?c email xác nh?n t?i qu?y vé</li>
                <li>Th? vé s? ???c c?p t?i qu?y, không c?n in tr??c</li>
            </ul>
        </div>

        <div class="action-buttons">
            <a href="@Url.Action("PrintInvoice", "Invoice", new { bookingId = booking.Dat_Ve_id })" class="action-btn btn-primary">
                <i class="fas fa-print"></i> In Vé
            </a>
            <a href="@Url.Action("ViewInvoice", "Invoice", new { bookingId = booking.Dat_Ve_id })" class="action-btn btn-secondary">
                <i class="fas fa-file-invoice"></i> Xem Hóa ??n
            </a>
            <a href="@Url.Action("Index", "Home")" class="action-btn btn-secondary">
                <i class="fas fa-home"></i> V? Trang Ch?
            </a>
        </div>
    }
</div>
