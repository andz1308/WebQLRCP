using System;
using System.Collections.Generic;
using System.Configuration;
using System.Linq;
using System.Security.Cryptography;
using System.Text;
using System.Web;

namespace WebCinema.Infrastructure
{
    /// <summary>
    /// Tích hợp Cổng Thanh Toán VNPay - Chuẩn RFC3986 (HMAC SHA512)
    /// </summary>
    public class PaymentGateway
    {
        // ======================
        // ⚙️ CẤU HÌNH VNPAY (từ Web.config)
        // ======================
        private readonly string _vnpayUrl;
        private readonly string _tmnCode;
        private readonly string _hashSecret;
        private readonly string _returnUrl;

        public PaymentGateway()
        {
            // ✅ Đọc cấu hình từ Web.config (dễ thay đổi mà không cần biên dịch)
            _vnpayUrl = ConfigurationManager.AppSettings["VNPay:Url"] ?? "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html";
            _tmnCode = ConfigurationManager.AppSettings["VNPay:TmnCode"] ?? "OOI636PL";
            _hashSecret = ConfigurationManager.AppSettings["VNPay:HashSecret"] ?? "WN5E5HSY2APFHRCL7R1U1C3MLTTLTNW2";
            _returnUrl = ConfigurationManager.AppSettings["VNPay:ReturnUrl"] ?? "https://localhost:44300/Invoice/PaymentCallback";

            LoggingHelper.LogInfo($"✅ PaymentGateway Initialized:");
            LoggingHelper.LogInfo($"   - VNPay URL: {_vnpayUrl}");
            LoggingHelper.LogInfo($"   - TMN Code: {_tmnCode}");
            LoggingHelper.LogInfo($"   - Hash Secret: {_hashSecret}");
            LoggingHelper.LogInfo($"   - Return URL: {_returnUrl}");
        }

        // ======================
        // 🚀 TẠO URL THANH TOÁN
        // ======================
        public string CreatePaymentUrl(decimal amount, string orderInfo, string customerId)
        {
            try
            {
                // Kiểm tra giá trị
                if (amount <= 0)
                    throw new ArgumentException("Số tiền phải lớn hơn 0");
                if (string.IsNullOrWhiteSpace(orderInfo))
                    throw new ArgumentException("Thông tin đơn hàng không được rỗng");

                var vnpayData = new SortedDictionary<string, string>
                {
                    { "vnp_Version", "2.1.0" },
                    { "vnp_Command", "pay" },
                    { "vnp_TmnCode", _tmnCode },
                    { "vnp_Amount", ((long)(amount * 100)).ToString() }, // Nhân 100 theo yêu cầu VNPay
                    { "vnp_CurrCode", "VND" },
                    { "vnp_TxnRef", GenerateTransactionRef() },
                    { "vnp_OrderInfo", orderInfo },
                    { "vnp_OrderType", "billpayment" },
                    { "vnp_Locale", "vn" },
                    { "vnp_CreateDate", DateTime.Now.ToString("yyyyMMddHHmmss") },
                    { "vnp_ExpireDate", DateTime.Now.AddMinutes(15).ToString("yyyyMMddHHmmss") },
                    { "vnp_IpAddr", GetClientIP() },
                    { "vnp_ReturnUrl", _returnUrl },
                };

                // ✅ Build query string WITH proper encoding
                StringBuilder rawData = new StringBuilder();
                foreach (var kv in vnpayData)
                {
                    if (!string.IsNullOrEmpty(kv.Value))
                    {
                        string encodedValue = UrlEncode(kv.Value);
                        rawData.Append(kv.Key + "=" + encodedValue + "&");
                    }
                }

                string dataToHash = rawData.ToString().TrimEnd('&');
                
                // ✅ Normalize hex to uppercase BEFORE hashing (CRITICAL)
                dataToHash = NormalizeHexToUppercase(dataToHash);

                string secureHash = HmacSHA512(dataToHash, _hashSecret);

                // ✅ Build final URL with normalized data
                string paymentUrl = _vnpayUrl + "?" + dataToHash + "&vnp_SecureHash=" + secureHash;

                LoggingHelper.LogInfo($"✅ Tạo URL Thanh Toán VNPay:");
                LoggingHelper.LogInfo($"   - TMN Code: {_tmnCode}");
                LoggingHelper.LogInfo($"   - Số tiền: {amount} VND");
                LoggingHelper.LogInfo($"   - Thông tin: {orderInfo}");
                LoggingHelper.LogInfo($"   - ReturnUrl: {_returnUrl}");
                LoggingHelper.LogInfo($"   - Data to hash: {dataToHash}");
                LoggingHelper.LogInfo($"   - Hash: {secureHash}");
                
                return paymentUrl;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"CreatePaymentUrl - Amount: {amount}, OrderInfo: {orderInfo}");
                throw;
            }
        }

        // ======================
        // 🔍 XÁC NHẬN THANH TOÁN (Return / IPN)
        // ======================
        public PaymentResponse VerifyPayment(Dictionary<string, string> responseData)
        {
            var response = new PaymentResponse();
            
            try
            {
                LoggingHelper.LogInfo($"VerifyPayment: Bắt đầu xác minh - Nhận {responseData.Count} tham số");
                LoggingHelper.LogInfo($"✅ FULL RESPONSE DATA:");
                foreach (var kv in responseData)
                {
                    LoggingHelper.LogInfo($"   {kv.Key} = {kv.Value}");
                }

                // ✅ Kiểm tra tham số bắt buộc
                if (!responseData.ContainsKey("vnp_SecureHash"))
                {
                    response.IsValid = false;
                    response.Message = "Thiếu chữ ký vnp_SecureHash";
                    LoggingHelper.LogInfo($"❌ {response.Message}");
                    return response;
                }

                string receivedHash = responseData["vnp_SecureHash"];
                
                // Tạo copy để không ảnh hưởng dữ liệu gốc
                var dataToVerify = new Dictionary<string, string>(responseData);
                dataToVerify.Remove("vnp_SecureHash");
                dataToVerify.Remove("vnp_SecureHashType");

                // Tạo lại chuỗi để kiểm tra theo thứ tự a-z
                var sortedData = new SortedDictionary<string, string>(dataToVerify);
                StringBuilder rawData = new StringBuilder();
                foreach (var kv in sortedData)
                {
                    if (!string.IsNullOrEmpty(kv.Value))
                    {
                        string encodedValue = UrlEncode(kv.Value);
                        rawData.Append(kv.Key + "=" + encodedValue + "&");
                    }
                }

                string dataToHash = rawData.ToString().TrimEnd('&');
                
                // ✅ Normalize hex to uppercase BEFORE hashing (CRITICAL)
                dataToHash = NormalizeHexToUppercase(dataToHash);

                string expectedHash = HmacSHA512(dataToHash, _hashSecret);

                LoggingHelper.LogInfo($"🔐 SIGNATURE VERIFICATION:");
                LoggingHelper.LogPaymentDebug(dataToHash, expectedHash, receivedHash, "VerifyPayment");

                // So sánh chữ ký (case-insensitive)
                if (!expectedHash.Equals(receivedHash, StringComparison.OrdinalIgnoreCase))
                {
                    response.IsValid = false;
                    response.Success = false;
                    response.Message = "Chữ ký không hợp lệ";
                    LoggingHelper.LogInfo($"❌ {response.Message}");
                    return response;
                }

                // ✅ Chữ ký hợp lệ
                response.IsValid = true;
                response.ResponseCode = responseData.ContainsKey("vnp_ResponseCode") ? responseData["vnp_ResponseCode"] : "";
                response.TransactionNo = responseData.ContainsKey("vnp_TransactionNo") ? responseData["vnp_TransactionNo"] : "";
                response.BankCode = responseData.ContainsKey("vnp_BankCode") ? responseData["vnp_BankCode"] : "";
                response.OrderInfo = responseData.ContainsKey("vnp_OrderInfo") ? responseData["vnp_OrderInfo"] : "";
                response.Amount = responseData.ContainsKey("vnp_Amount") ? responseData["vnp_Amount"] : "";
                response.PayDate = responseData.ContainsKey("vnp_PayDate") ? responseData["vnp_PayDate"] : "";

                LoggingHelper.LogInfo($"✅ RESPONSE EXTRACTED:");
                LoggingHelper.LogInfo($"   ResponseCode: {response.ResponseCode}");
                LoggingHelper.LogInfo($"   TransactionNo: {response.TransactionNo}");
                LoggingHelper.LogInfo($"   Amount: {response.Amount}");
                LoggingHelper.LogInfo($"   OrderInfo: {response.OrderInfo}");

                // Kiểm tra mã phản hồi
                if (response.ResponseCode == "00")
                {
                    response.Success = true;
                    response.Message = "Giao dịch thành công";
                    LoggingHelper.LogInfo($"✅ Thanh toán thành công - Giao dịch: {response.TransactionNo}");
                }
                else
                {
                    response.Success = false;
                    response.Message = GetResponseMessage(response.ResponseCode);
                    LoggingHelper.LogInfo($"⚠️ Lỗi thanh toán: Mã {response.ResponseCode} - {response.Message}");
                }

                return response;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "VerifyPayment");
                response.IsValid = false;
                response.Success = false;
                response.Message = "Lỗi xác minh thanh toán";
                return response;
            }
        }

        // ======================
        // 🧩 HÀM HỖ TRỢ
        // ======================
        private string GenerateTransactionRef()
        {
            // ✅ Tạo mã tham chiếu duy nhất (phải duy nhất cho mỗi giao dịch)
            return DateTime.Now.Ticks.ToString();
        }

        private string GetClientIP()
        {
            try
            {
                var context = HttpContext.Current;
                if (context != null)
                {
                    string ip = context.Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
                    if (string.IsNullOrEmpty(ip))
                        ip = context.Request.ServerVariables["REMOTE_ADDR"];
                    if (!string.IsNullOrEmpty(ip) && ip != "::1")
                        return ip;
                }
            }
            catch { }
            return "127.0.0.1";
        }

        // ======================
        // ✅ Encode theo RFC3986 (chuẩn VNPay)
        // ======================
        private string UrlEncode(string input)
        {
            if (string.IsNullOrEmpty(input))
                return "";

            // Sử dụng Uri.EscapeDataString cho RFC3986
            string encoded = Uri.EscapeDataString(input);
            
            // Thay thế các ký tự đặc biệt theo RFC3986 (lowercase HEX - sau đó sẽ normalize)
            // Không thay thế ở đây - để hàm NormalizeHexToUppercase() xử lý
            
            return encoded;
        }

        // ✅ Normalize HEX encoding to UPPERCASE (Critical for VNPAY signature)
        private string NormalizeHexToUppercase(string input)
        {
            if (string.IsNullOrEmpty(input))
                return input;
            
            return System.Text.RegularExpressions.Regex.Replace(
                input,
                @"%[0-9a-fA-F]{2}",
                m => m.Value.ToUpper()
            );
        }

        // ✅ Tạo HMAC SHA512
        private string HmacSHA512(string data, string key)
        {
            try
            {
                byte[] keyBytes = Encoding.UTF8.GetBytes(key);
                byte[] dataBytes = Encoding.UTF8.GetBytes(data);
                using (var hmac = new HMACSHA512(keyBytes))
                {
                    byte[] hashValue = hmac.ComputeHash(dataBytes);
                    return BitConverter.ToString(hashValue).Replace("-", "").ToLower();
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "HmacSHA512");
                throw;
            }
        }

        // ✅ Mã phản hồi VNPay (đầy đủ)
        private string GetResponseMessage(string code)
        {
            var messages = new Dictionary<string, string>
            {
                { "00", "Giao dịch thành công" },
                { "01", "Lỗi do URL không đúng" },
                { "02", "Lỗi tổng tiền không hợp lệ" },
                { "04", "Lỗi mã đơn vị không tồn tại hoặc bị khóa" },
                { "05", "Lỗi không xác thực được đơn vị" },
                { "06", "Lỗi mã giao dịch bị trùng" },
                { "07", "Giao dịch nghi ngờ (liên hệ ngân hàng)" },
                { "08", "Lỗi mã số điện thoại không hợp lệ" },
                { "09", "Tài khoản chưa đăng ký InternetBanking" },
                { "10", "Xác thực SecurePassword lần 1 sai" },
                { "11", "Hết hạn xác thực SecurePassword" },
                { "12", "Khách hàng từ chối giao dịch" },
                { "13", "Xác thực SecurePassword lần 2 sai" },
                { "21", "Số tiền vượt quá hạn mức thanh toán" },
                { "24", "Khách hàng hủy giao dịch" },
                { "51", "Không đủ số dư" },
                { "65", "Vượt hạn mức giao dịch trong ngày" },
                { "75", "Ngân hàng từ chối giao dịch" },
                { "79", "Sai mật khẩu thanh toán quá số lần" },
                { "85", "Khách hàng không đăng ký OTP" },
                { "99", "Lỗi không xác định" }
            };
            return messages.ContainsKey(code) ? messages[code] : $"Lỗi không xác định ({code})";
        }
    }

    // ======================
    // 🧾 MODEL KẾT QUẢ THANH TOÁN
    // ======================
    public class PaymentResponse
    {
        public bool IsValid { get; set; }
        public bool Success { get; set; }
        public string ResponseCode { get; set; }
        public string TransactionNo { get; set; }
        public string BankCode { get; set; }
        public string OrderInfo { get; set; }
        public string Message { get; set; }
        public string Amount { get; set; }
        public string PayDate { get; set; }
    }
}
