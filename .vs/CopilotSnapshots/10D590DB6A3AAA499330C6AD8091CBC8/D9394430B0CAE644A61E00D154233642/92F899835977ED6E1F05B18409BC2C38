@{
    ViewBag.Title = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    // Cast as IEnumerable<object> to support anonymous types passed via ViewBag
    IEnumerable<object> foodItems = ViewBag.FoodItems as IEnumerable<object>;
    var ticketTotal = (decimal)ViewBag.TicketTotal;
    var foodTotal = (decimal)ViewBag.FoodTotal;
    var grandTotal = (decimal)ViewBag.GrandTotal;
}

<style>
    .checkout-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 2rem;
    }

    .checkout-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px 12px 0 0;
    }

    .progress-steps {
        background: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: center;
        gap: 2rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #999;
        font-weight: 600;
    }

    .step-number {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .step.active {
        color: #ff6b35;
    }

    .step.active .step-number {
        background: #ff6b35;
        color: white;
    }

    .step.completed .step-number {
        background: #27ae60;
        color: white;
    }

    .checkout-content {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 2rem;
        padding: 2rem;
        background: white;
    }

    .info-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 12px;
        border-left: 4px solid #ff6b35;
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .movie-info {
        display: flex;
        gap: 1rem;
    }

    .movie-poster {
        width: 80px;
        height: 110px;
        border-radius: 8px;
        object-fit: cover;
    }

    .ticket-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .ticket-badge {
        padding: 0.5rem 1rem;
        background: white;
        border: 2px solid #ff6b35;
        border-radius: 8px;
        font-weight: 600;
        color: #ff6b35;
    }

    .food-list {
        margin-top: 1rem;
    }

    .food-item {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem;
        background: white;
        border-radius: 8px;
        margin-bottom: 0.5rem;
    }

    .payment-methods {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 12px;
        border-left: 4px solid #ff6b35;
        margin-bottom: 1.5rem;
    }

    .payment-option {
        background: white;
        padding: 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        margin-bottom: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .payment-option:hover {
        border-color: #ff6b35;
        box-shadow: 0 4px 12px rgba(255, 107, 53, 0.2);
    }

    .payment-option.selected {
        border-color: #ff6b35;
        background: #fff5f2;
    }

    .payment-option input[type="radio"] {
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .payment-icon {
        font-size: 2rem;
    }

    .payment-info {
        flex: 1;
    }

    .payment-name {
        font-weight: 700;
        color: #333;
        margin-bottom: 0.25rem;
    }

    .payment-desc {
        font-size: 0.85rem;
        color: #666;
    }

    .order-summary {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 12px;
        border: 2px solid #e0e0e0;
        position: sticky;
        top: 20px;
    }

    .summary-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem 0;
        border-bottom: 1px solid #e0e0e0;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        padding: 1rem 0;
        margin-top: 1rem;
        border-top: 2px solid #333;
        font-size: 1.3rem;
        font-weight: bold;
    }

    .total-value {
        color: #ff6b35;
    }

    .btn-confirm {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

    .btn-confirm:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
    }

    .btn-confirm:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    .btn-back {
        width: 100%;
        padding: 0.8rem;
        background: transparent;
        color: #666;
        border: 2px solid #ccc;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 0.5rem;
    }

    .btn-back:hover {
        border-color: #ff6b35;
        color: #ff6b35;
    }

    @@media (max-width: 1024px) {
        .checkout-content {
            grid-template-columns: 1fr;
        }

        .order-summary {
            position: static;
        }
    }
</style>

<div class="checkout-container">
    <div class="checkout-header">
        <h2 style="margin: 0;">💳 Thanh Toán</h2>
        <p style="margin: 0.5rem 0 0 0; opacity: 0.9;">Xác nhận thông tin và hoàn tất đặt vé</p>
    </div>

    <div class="progress-steps">
        <div class="step completed">
            <span class="step-number"><i class="fas fa-check"></i></span>
            <span>Chọn Ghế</span>
        </div>
        <div class="step completed">
            <span class="step-number"><i class="fas fa-check"></i></span>
            <span>Chọn Đồ Ăn</span>
        </div>
        <div class="step active">
            <span class="step-number">3</span>
            <span>Thanh Toán</span>
        </div>
    </div>

    <div class="checkout-content">
        <div>
            <!-- Movie Info -->
            @if (showtime != null)
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-film"></i> Thông Tin Phim
                    </h3>
                    <div class="movie-info">
                        @if (!string.IsNullOrEmpty(showtime.Phim.hinh_anh))
                        {
                            <img src="@Url.Content(showtime.Phim.hinh_anh)" alt="@showtime.Phim.ten_phim" class="movie-poster" />
                        }
                        <div>
                            <strong>@showtime.Phim.ten_phim</strong>
                            <div style="color: #666; font-size: 0.9rem; margin-top: 0.5rem;">
                                <div><i class="fas fa-building"></i> @showtime.Phong_Chieu.Rap.ten_rap</div>
                                <div><i class="fas fa-door-open"></i> @showtime.Phong_Chieu.ten_phong</div>
                                <div><i class="fas fa-calendar"></i> @showtime.ngay_chieu.ToString("dd/MM/yyyy")</div>
                                <div><i class="fas fa-clock"></i> @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Tickets -->
            @if (tickets != null && tickets.Count > 0)
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-ticket-alt"></i> Vé (@tickets.Count vé)
                    </h3>
                    <div class="ticket-list">
                        @foreach (var ticket in tickets)
                        {
                            <div class="ticket-badge">
                                <i class="fas fa-chair"></i> @ticket.Ghe.so_ghe
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Food Items -->
            @if (foodItems != null && foodItems.Any())
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-utensils"></i> Đồ Ăn & Thức Uống
                    </h3>
                    <div class="food-list">
                        @foreach (var item in foodItems)
                        {
                            if (item == null)
                            {
                                continue;
                            }

                            // Use reflection to read anonymous type properties safely
                            string foodName = "N/A";
                            int quantity = 0;
                            decimal price = 0m;
                            try
                            {
                                var t = item.GetType();
                                var nameProp = t.GetProperty("FoodName");
                                var qtyProp = t.GetProperty("Quantity");
                                var priceProp = t.GetProperty("Price");
                                if (nameProp != null)
                                {
                                    foodName = (nameProp.GetValue(item, null) ?? "N/A").ToString();
                                }
                                if (qtyProp != null)
                                {
                                    int.TryParse((qtyProp.GetValue(item, null) ?? 0).ToString(), out quantity);
                                }
                                if (priceProp != null)
                                {
                                    decimal.TryParse((priceProp.GetValue(item, null) ?? 0).ToString(), out price);
                                }
                            }
                            catch { }

                            var itemTotal = price * quantity;

                            <div class="food-item">
                                <div>
                                    <div style="font-weight: 600; color: #333;">@foodName</div>
                                    <div style="color: #666; font-size: 0.9rem;">Số lượng: @quantity</div>
                                </div>
                                <div style="font-weight: 600; color: #ff6b35;">
                                    @itemTotal.ToString("N0") ₫
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Payment Methods -->
            <div class="payment-methods">
                <h3 class="section-title">
                    <i class="fas fa-credit-card"></i> Phương Thức Thanh Toán
                </h3>

                <div class="payment-option selected" onclick="selectPayment('online', this)">
                    <input type="radio" name="payment" value="online" checked />
                    <div class="payment-icon">💳</div>
                    <div class="payment-info">
                        <div class="payment-name">Thanh Toán Online</div>
                        <div class="payment-desc">Visa, Master Card, ATM, QR Code</div>
                    </div>
                </div>

                <div class="payment-option" onclick="selectPayment('cash', this)">
                    <input type="radio" name="payment" value="cash" />
                    <div class="payment-icon">💵</div>
                    <div class="payment-info">
                        <div class="payment-name">Thanh Toán Tại Quầy</div>
                        <div class="payment-desc">Thanh toán bằng tiền mặt tại rạp</div>
                    </div>
                </div>

                <div class="payment-option" onclick="selectPayment('wallet', this)">
                    <input type="radio" name="payment" value="wallet" />
                    <div class="payment-icon">📱</div>
                    <div class="payment-info">
                        <div class="payment-name">Ví Điện Tử</div>
                        <div class="payment-desc">MoMo, ZaloPay, VNPay</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="order-summary">
            <h3 class="summary-title">Tổng Đơn Hàng</h3>
            
            <div class="summary-line">
                <span>Tiền vé (@(tickets != null ? tickets.Count : 0) vé)</span>
                <span>@ticketTotal.ToString("N0") ₫</span>
            </div>

            @if (foodTotal > 0)
            {
                <div class="summary-line">
                    <span>Đồ ăn & thức uống</span>
                    <span>@foodTotal.ToString("N0") ₫</span>
                </div>
            }

            <div class="summary-total">
                <span>Tổng Cộng</span>
                <span class="total-value">@grandTotal.ToString("N0") ₫</span>
            </div>

            <button class="btn-confirm" onclick="confirmBooking()">
                <i class="fas fa-check-circle"></i> Xác Nhận Đặt Vé
            </button>

            <button class="btn-back" onclick="goBack()">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var selectedPaymentMethod = 'online';

        function selectPayment(method, element) {
            $('.payment-option').removeClass('selected');
            $(element).addClass('selected');
            $(element).find('input[type="radio"]').prop('checked', true);
            selectedPaymentMethod = method;
        }

        function confirmBooking() {
            var total = @grandTotal;
            if (!confirm('Xác nhận đặt vé với tổng tiền ' + total.toLocaleString('vi-VN') + ' ₫?')) {
                return;
            }

            $('.btn-confirm').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

            $.ajax({
                url: '@Url.Action("Confirm", "Booking")',
                type: 'POST',
                data: { paymentMethod: selectedPaymentMethod },
                success: function(response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                    } else {
                        alert(response.message);
                        $('.btn-confirm').prop('disabled', false).html('<i class="fas fa-check-circle"></i> Xác Nhận Đặt Vé');
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra. Vui lòng thử lại!');
                    $('.btn-confirm').prop('disabled', false).html('<i class="fas fa-check-circle"></i> Xác Nhận Đặt Vé');
                }
            });
        }

        function goBack() {
            window.history.back();
        }
    </script>
}
