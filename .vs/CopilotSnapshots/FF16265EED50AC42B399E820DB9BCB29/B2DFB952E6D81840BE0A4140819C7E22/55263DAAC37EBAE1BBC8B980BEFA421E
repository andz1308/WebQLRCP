@model IEnumerable<WebCinema.Models.Phieu_Nhap_Hang>
@{
    ViewBag.Title = "Quản Lý Phiếu Nhập Hàng";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

}

<div class="container-fluid">
    <div class="content-card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-truck-loading"></i> Quản Lý Phiếu Nhập Hàng
            </h2>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Tạo Phiếu Nhập Mới
            </a>
        </div>

        <!-- Filter -->
        <div style="margin-bottom: 2rem; padding: 1.5rem; background: #f8f9fa; border-radius: 8px;">
            @using (Html.BeginForm("Index", "PurchaseOrder", FormMethod.Get))
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 1rem; align-items: end;">
                    <div class="form-group" style="margin: 0;">
                        <label class="form-label">Trạng thái</label>
                        <select name="status" class="form-control">
                            <option value="">-- Tất cả --</option>
                            <option value="Chưa duyệt" @(ViewBag.Status == "Chưa duyệt" ? "selected" : "")>Chưa duyệt</option>
                            <option value="Đã duyệt" @(ViewBag.Status == "Đã duyệt" ? "selected" : "")>Đã duyệt</option>
                            <option value="Đã hủy" @(ViewBag.Status == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label class="form-label">Từ ngày</label>
                        <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            }
        </div>

        <!-- Table -->
        @if (Model != null && Model.Any())
        {
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Mã Phiếu</th>
                            <th>Nhà Cung Cấp</th>
                            <th>Ngày Nhập</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th>Người Tạo</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.ma_phieu</strong></td>
                                <td>@(item.Nha_Cung_Cap != null ? item.Nha_Cung_Cap.ten_nha_cung_cap : "N/A")</td>
                                <td>@(item.ngay_nhap.HasValue ? item.ngay_nhap.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                                <td><strong>@item.tong_tien.ToString("N0") VNĐ</strong></td>
                                <td>
                                    @if (item.trang_thai == "Chưa duyệt")
                                    {
                                        <span style="padding: 0.3rem 0.8rem; background: #ffc107; color: white; border-radius: 4px; font-size: 0.85rem;">Chưa duyệt</span>
                                    }
                                    else if (item.trang_thai == "Đã duyệt")
                                    {
                                        <span style="padding: 0.3rem 0.8rem; background: #28a745; color: white; border-radius: 4px; font-size: 0.85rem;">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span style="padding: 0.3rem 0.8rem; background: #dc3545; color: white; border-radius: 4px; font-size: 0.85rem;">Đã hủy</span>
                                    }
                                </td>
                                <td>@(item.Nhan_Vien != null ? item.Nhan_Vien.ho_ten : "N/A")</td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = item.phieu_nhap_id })" 
                                       class="btn btn-secondary" style="padding: 0.5rem 1rem;" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="text-align: center; color: #999; padding: 2rem;">Chưa có phiếu nhập nào.</p>
        }
    </div>
</div>
