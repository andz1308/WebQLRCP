        /// <summary>
        /// Thống kê sản phẩm bán chạy (chỉ tính đơn đã thanh toán)
        /// </summary>
        public List<dynamic> GetTopSellingItems(int? month, int? year, int take = 10)
        {
            var query = _db.DonHang_DoAns
                .Where(dh => dh.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán" 
                       && dh.Dat_Ve.ngay_tao.HasValue);

            if (year.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Year == year.Value);
            }

            if (month.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Month == month.Value);
            }

            var result = query
                .GroupBy(dh => dh.Do_An_id)
                .Select(g => new
                {
                    Do_An_id = g.Key,
                    TotalQuantity = g.Sum(dh => dh.so_luong),
                    TotalRevenue = g.Sum(dh => dh.so_luong * (dh.Do_An.gia ?? 0))
                })
                .OrderByDescending(x => x.TotalQuantity)
                .Take(take)
                .ToList()
                .Select(x => new
                {
                    DoAn = _db.Do_Ans.FirstOrDefault(d => d.Do_An_id == x.Do_An_id),
                    x.TotalQuantity,
                    x.TotalRevenue
                })
                .Where(x => x.DoAn != null)
                .ToList<dynamic>();

            return result;
        }

        /// <summary>
        /// Thống kê theo loại sản phẩm
        /// </summary>
        public List<dynamic> GetSalesByCategory(int? month, int? year)
        {
            var query = _db.DonHang_DoAns
                .Where(dh => dh.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán" 
                       && dh.Dat_Ve.ngay_tao.HasValue
                       && dh.Do_An.loai != null);

            if (year.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Year == year.Value);
            }

            if (month.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Month == month.Value);
            }

            var result = query
                .GroupBy(dh => dh.Do_An.loai)
                .Select(g => new
                {
                    Category = g.Key,
                    TotalQuantity = g.Sum(dh => dh.so_luong),
                    TotalRevenue = g.Sum(dh => dh.so_luong * (dh.Do_An.gia ?? 0))
                })
                .OrderByDescending(x => x.TotalRevenue)
                .ToList<dynamic>();

            return result;
        }

