using System;
using System.Collections.Generic;
using System.Linq;
using WebCinema.Models;
using WebCinema.Infrastructure;

namespace WebCinema.Services
{
    /// <summary>
    /// Service xử lý logic nghiệp vụ cho quản lý đồ ăn & nhập hàng
    /// </summary>
    public class FoodService
    {
        private readonly CSDLDataContext _db;

        public FoodService()
        {
            _db = new CSDLDataContext();
        }

        public FoodService(CSDLDataContext db)
        {
            _db = db;
        }

        #region KIỂM TRA TỒN KHO

        /// <summary>
        /// Kiểm tra số lượng tồn kho của sản phẩm
        /// </summary>
        public int GetStockQuantity(int doAnId)
        {
            var doAn = _db.Do_Ans.FirstOrDefault(d => d.Do_An_id == doAnId);
            return doAn?.so_luong ?? 0;
        }

        /// <summary>
        /// Kiểm tra danh sách sản phẩm sắp hết hàng
        /// </summary>
        public List<Do_An> GetLowStockItems(int threshold = 10)
        {
            return _db.Do_Ans
                .Where(d => d.so_luong <= threshold && d.so_luong > 0)
                .OrderBy(d => d.so_luong)
                .ToList();
        }

        /// <summary>
        /// Kiểm tra danh sách sản phẩm hết hàng
        /// </summary>
        public List<Do_An> GetOutOfStockItems()
        {
            return _db.Do_Ans
                .Where(d => d.so_luong == 0)
                .ToList();
        }

        #endregion

        #region THỐNG KÊ

        /// <summary>
        /// Thống kê sản phẩm bán chạy (chỉ tính đơn đã thanh toán)
        /// </summary>
        public List<dynamic> GetTopSellingItems(int? month, int? year, int take = 10)
        {
            var query = _db.DonHang_DoAns
                .Where(dh => dh.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán" 
                       && dh.Dat_Ve.ngay_tao.HasValue);

            if (year.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Year == year.Value);
            }

            if (month.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Month == month.Value);
            }

            var result = query
                .GroupBy(dh => dh.Do_An_id)
                .Select(g => new
                {
                    Do_An_id = g.Key,
                    TotalQuantity = g.Sum(dh => dh.so_luong),
                    TotalRevenue = g.Sum(dh => dh.so_luong * (dh.Do_An.gia ?? 0))
                })
                .OrderByDescending(x => x.TotalQuantity)
                .Take(take)
                .ToList()
                .Select(x => new
                {
                    DoAn = _db.Do_Ans.FirstOrDefault(d => d.Do_An_id == x.Do_An_id),
                    x.TotalQuantity,
                    x.TotalRevenue
                })
                .Where(x => x.DoAn != null)
                .ToList<dynamic>();

            return result;
        }

        /// <summary>
        /// Tính giá vốn trung bình của sản phẩm
        /// </summary>
        public decimal GetAverageCost(int doAnId)
        {
            var doAn = _db.Do_Ans.FirstOrDefault(d => d.Do_An_id == doAnId);
            return doAn?.gia_von ?? 0;
        }

        /// <summary>
        /// Tính lợi nhuận gộp của sản phẩm
        /// </summary>
        public decimal GetGrossProfit(int doAnId, int? month, int? year)
        {
            var doAn = _db.Do_Ans.FirstOrDefault(d => d.Do_An_id == doAnId);
            if (doAn == null) return 0;

            var query = _db.DonHang_DoAns
                .Where(dh => dh.Do_An_id == doAnId 
                       && dh.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán"
                       && dh.Dat_Ve.ngay_tao.HasValue);

            if (year.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Year == year.Value);
            }

            if (month.HasValue)
            {
                query = query.Where(dh => dh.Dat_Ve.ngay_tao.Value.Month == month.Value);
            }

            decimal totalRevenue = query.Sum(dh => (decimal?)(dh.so_luong * (doAn.gia ?? 0))) ?? 0;
            decimal totalCost = query.Sum(dh => (decimal?)(dh.so_luong * (doAn.gia_von ?? 0))) ?? 0;

            return totalRevenue - totalCost;
        }

        #endregion

        #region CẢNH BÁO

        /// <summary>
        /// Lấy danh sách cảnh báo tồn kho
        /// </summary>
        public List<string> GetStockWarnings()
        {
            var warnings = new List<string>();

            // Sản phẩm hết hàng
            var outOfStock = GetOutOfStockItems();
            if (outOfStock.Any())
            {
                warnings.Add($"Có {outOfStock.Count} sản phẩm hết hàng!");
            }

            // Sản phẩm sắp hết
            var lowStock = GetLowStockItems();
            if (lowStock.Any())
            {
                warnings.Add($"Có {lowStock.Count} sản phẩm sắp hết hàng (dưới 10 sản phẩm)!");
            }

            return warnings;
        }

        #endregion
    }
}