@model WebCinema.Models.Phieu_Nhap_Hang
@{
    ViewBag.Title = "Chi Tiết Phiếu Nhập";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

}

<div class="container-fluid">
    <div class="content-card">
        <div class="card-header">
            <h2 class="card-title">
                <i class="fas fa-file-invoice"></i> Chi Tiết Phiếu Nhập
            </h2>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </a>
        </div>

        <!-- Thông tin phiếu -->
        <div style="background: white; border-radius: 8px; padding: 2rem; margin-bottom: 1.5rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <div>
                    <h5 style="color: #2c3e50; margin-bottom: 1rem; border-bottom: 2px solid #3498db; padding-bottom: 0.5rem;">
                        <i class="fas fa-info-circle"></i> Thông Tin Phiếu
                    </h5>
                    <div style="display: grid; gap: 0.8rem;">
                        <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                            <strong>Mã phiếu:</strong>
                            <span>@Model.ma_phieu</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                            <strong>Nhà cung cấp:</strong>
                            <span>@(Model.Nha_Cung_Cap != null ? Model.Nha_Cung_Cap.ten_nha_cung_cap : "N/A")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                            <strong>Ngày lập phiếu:</strong>
                            <span>@(Model.ngay_lap_phieu.HasValue ? Model.ngay_lap_phieu.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                            <strong>Ngày nhập:</strong>
                            <span>@(Model.ngay_nhap.HasValue ? Model.ngay_nhap.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                            <strong>Trạng thái:</strong>
                            <span>
                                @if (Model.trang_thai == "Chưa duyệt")
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #ffc107; color: white; border-radius: 4px; font-size: 0.9rem;">Chưa duyệt</span>
                                }
                                else if (Model.trang_thai == "Đã duyệt")
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #28a745; color: white; border-radius: 4px; font-size: 0.9rem;">Đã duyệt</span>
                                }
                                else
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #dc3545; color: white; border-radius: 4px; font-size: 0.9rem;">Đã hủy</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                <div>
                    <h5 style="color: #2c3e50; margin-bottom: 1rem; border-bottom: 2px solid #3498db; padding-bottom: 0.5rem;">
                        <i class="fas fa-users"></i> Người Liên Quan
                    </h5>
                    <div style="display: grid; gap: 0.8rem;">
                        <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                            <strong>Người tạo:</strong>
                            <span>@(Model.Nhan_Vien != null ? Model.Nhan_Vien.ho_ten : "N/A")</span>
                        </div>
                        @if (Model.nguoi_duyet_id.HasValue && Model.Nhan_Vien1 != null)
                        {
                            <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                                <strong>Người duyệt:</strong>
                                <span>@Model.Nhan_Vien1.ho_ten</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #f8f9fa; border-radius: 4px;">
                                <strong>Ngày duyệt:</strong>
                                <span>@(Model.ngay_duyet.HasValue ? Model.ngay_duyet.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.ghi_chu))
                        {
                            <div style="padding: 0.5rem; background: #fff3cd; border-radius: 4px; border-left: 3px solid #ffc107;">
                                <strong>Ghi chú:</strong>
                                <p style="margin: 0.5rem 0 0 0;">@Model.ghi_chu</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.ly_do_huy))
                        {
                            <div style="padding: 0.5rem; background: #f8d7da; border-radius: 4px; border-left: 3px solid #dc3545;">
                                <strong>Lý do hủy:</strong>
                                <p style="margin: 0.5rem 0 0 0;">@Model.ly_do_huy</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiết sản phẩm -->
        <div style="background: white; border-radius: 8px; padding: 2rem; margin-bottom: 1.5rem;">
            <h5 style="color: #2c3e50; margin-bottom: 1.5rem; border-bottom: 2px solid #3498db; padding-bottom: 0.5rem;">
                <i class="fas fa-box"></i> Chi Tiết Sản Phẩm
            </h5>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Sản Phẩm</th>
                            <th>Số Lượng</th>
                            <th>Đơn Giá</th>
                            <th>Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                            decimal tongTien = 0;
                        }
                        @foreach (var item in Model.Chi_Tiet_Phieu_Nhaps)
                        {
                            decimal thanhTien = item.so_luong * item.don_gia;
                            tongTien += thanhTien;
                            <tr>
                                <td>@stt</td>
                                <td><strong>@(item.Do_An != null ? item.Do_An.ten_san_pham : "N/A")</strong></td>
                                <td>@item.so_luong</td>
                                <td>@item.don_gia.ToString("N0") VNĐ</td>
                                <td><strong>@thanhTien.ToString("N0") VNĐ</strong></td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                    <tfoot>
                        <tr style="background: #f8f9fa; font-weight: bold;">
                            <td colspan="4" style="text-align: right; padding: 1rem;">TỔNG CỘNG:</td>
                            <td style="color: #e74c3c; font-size: 1.2rem; padding: 1rem;">@tongTien.ToString("N0") VNĐ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Actions -->
        @if (Model.trang_thai == "Chưa duyệt")
        {
            <div style="background: white; border-radius: 8px; padding: 2rem; display: flex; gap: 1rem; justify-content: flex-end;">
                @if (User.IsInRole("Admin"))
                {
                    <button onclick="approvePhieu(@Model.phieu_nhap_id)" class="btn btn-success" style="padding: 1rem 2rem;">
                        <i class="fas fa-check"></i> Duyệt Phiếu
                    </button>
                }
                <button onclick="cancelPhieu(@Model.phieu_nhap_id)" class="btn btn-danger" style="padding: 1rem 2rem;">
                    <i class="fas fa-times"></i> Hủy Phiếu
                </button>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function approvePhieu(id) {
            if (confirm('Bạn có chắc chắn muốn duyệt phiếu nhập này?\n\nSau khi duyệt, số lượng và giá vốn sản phẩm sẽ được tự động cập nhật.')) {
                $.ajax({
                    url: '@Url.Action("Approve")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Lỗi: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi duyệt phiếu.');
                    }
                });
            }
        }

        function cancelPhieu(id) {
            var reason = prompt('Vui lòng nhập lý do hủy phiếu:');
            if (reason && reason.trim() !== '') {
                $.ajax({
                    url: '@Url.Action("Cancel")',
                    type: 'POST',
                    data: { id: id, reason: reason },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Lỗi: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi hủy phiếu.');
                    }
                });
            }
        }
    </script>
}
