using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Mvc;
using WebCinema.Models;
using WebCinema.Infrastructure;
using Newtonsoft.Json;

namespace WebCinema.Areas.Admin.Controllers
{
    [RoleAuthorize(Roles = "Admin,Staff")]
    public class PurchaseOrderController : Controller
    {
        private CSDLDataContext db = new CSDLDataContext();

        // GET: Admin/PurchaseOrder
        public ActionResult Index(string status, DateTime? fromDate, DateTime? toDate)
        {
            var query = db.Phieu_Nhap_Hangs.AsQueryable();

            if (!string.IsNullOrEmpty(status))
            {
                query = query.Where(p => p.trang_thai == status);
            }

            if (fromDate.HasValue)
            {
                query = query.Where(p => p.ngay_nhap >= fromDate.Value);
            }

            if (toDate.HasValue)
            {
                query = query.Where(p => p.ngay_nhap <= toDate.Value);
            }

            var result = query.OrderByDescending(p => p.ngay_lap_phieu).ToList();

            ViewBag.Status = status;
            ViewBag.FromDate = fromDate;
            ViewBag.ToDate = toDate;

            return View(result);
        }

        // GET: Admin/PurchaseOrder/Create
        public ActionResult Create()
        {
            // ✅ DEBUG: Log tất cả session keys
            LoggingHelper.LogInfo("=== CREATE PURCHASE ORDER - SESSION DEBUG ===");
            LoggingHelper.LogInfo($"EmployeeId: {Session["EmployeeId"]}");
            LoggingHelper.LogInfo($"EmployeeName: {Session["EmployeeName"]}");
            LoggingHelper.LogInfo($"UserRole: {Session["UserRole"]}");
            LoggingHelper.LogInfo($"StaffId: {Session["StaffId"]}");
            
            // Kiểm tra tất cả session keys
            foreach (string key in Session.Keys)
            {
                LoggingHelper.LogInfo($"Session[{key}] = {Session[key]}");
            }
            
            ViewBag.Suppliers = new SelectList(
                db.Nha_Cung_Caps.Where(n => n.trang_thai == "Hoạt động"),
                "nha_cung_cap_id",
                "ten_nha_cung_cap"
            );

            // ✅ FIX: Chỉ lấy các thuộc tính cần thiết để tránh circular reference
            ViewBag.Products = db.Do_Ans
                .OrderBy(d => d.ten_san_pham)
                .Select(d => new {
                    Do_An_id = d.Do_An_id,
                    ten_san_pham = d.ten_san_pham,
                    so_luong = d.so_luong ?? 0
                })
                .ToList();

            return View();
        }

        // POST: Admin/PurchaseOrder/Create
        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult Create(Phieu_Nhap_Hang phieu, string chiTietJson)
        {
            try
            {
                // Parse chi tiết từ JSON
                var chiTietList = JsonConvert.DeserializeObject<List<ChiDetailNhapTemp>>(chiTietJson);

                // Tạo mã phiếu tự động
                phieu.ma_phieu = GeneratePurchaseOrderCode();
                phieu.ngay_lap_phieu = DateTime.Now;
                
                // ✅ FIX: Lấy Staff ID từ Session (Admin/Staff đăng nhập)
                // Kiểm tra cả EmployeeId (cho Admin/Staff)
                int? staffId = Session["EmployeeId"] as int?;
                
                if (!staffId.HasValue)
                {
                    TempData["ErrorMessage"] = "Bạn phải đăng nhập với tài khoản Admin hoặc Staff để tạo phiếu nhập.";
                    return RedirectToAction("Index");
                }
                
                phieu.nhan_vien_id = staffId.Value;
                phieu.trang_thai = "Chưa duyệt";

                // Tính tổng tiền
                decimal tongTien = 0;
                var chiTietPhieus = new List<Chi_Tiet_Phieu_Nhap>();

                foreach (var item in chiTietList)
                {
                    var chiTiet = new Chi_Tiet_Phieu_Nhap
                    {
                        do_an_id = item.do_an_id,
                        so_luong = item.so_luong,
                        don_gia = item.don_gia,
                        ghi_chu = item.ghi_chu
                    };

                    chiTietPhieus.Add(chiTiet);
                    tongTien += item.so_luong * item.don_gia;
                }

                phieu.tong_tien = tongTien;

                // Lưu vào DB
                db.Phieu_Nhap_Hangs.InsertOnSubmit(phieu);
                db.SubmitChanges();

                // Lưu chi tiết
                foreach (var ct in chiTietPhieus)
                {
                    ct.phieu_nhap_id = phieu.phieu_nhap_id;
                    db.Chi_Tiet_Phieu_Nhaps.InsertOnSubmit(ct);
                }

                db.SubmitChanges();

                TempData["SuccessMessage"] = "Tạo phiếu nhập thành công! Chờ Admin duyệt.";
                return RedirectToAction("Details", new { id = phieu.phieu_nhap_id });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                TempData["ErrorMessage"] = "Có lỗi: " + ex.Message;
                return RedirectToAction("Create");
            }
        }

        // Helper class for JSON deserialization
        private class ChiDetailNhapTemp
        {
            public int do_an_id { get; set; }
            public int so_luong { get; set; }
            public decimal don_gia { get; set; }
            public string ghi_chu { get; set; }
        }

        // GET: Admin/PurchaseOrder/Details/5
        public ActionResult Details(int? id)
        {
            if (!id.HasValue)
            {
                return RedirectToAction("Index");
            }

            var phieu = db.Phieu_Nhap_Hangs.FirstOrDefault(p => p.phieu_nhap_id == id.Value);
            if (phieu == null)
            {
                return HttpNotFound();
            }

            return View(phieu);
        }

        // POST: Admin/PurchaseOrder/Approve/5
        [HttpPost]
        [RoleAuthorize(Roles = "Admin")]
        public ActionResult Approve(int id)
        {
            try
            {
                var phieu = db.Phieu_Nhap_Hangs.FirstOrDefault(p => p.phieu_nhap_id == id);
                if (phieu == null)
                {
                    return Json(new { success = false, message = "Không tìm thấy phiếu nhập." });
                }

                if (phieu.trang_thai != "Chưa duyệt")
                {
                    return Json(new { success = false, message = "Phiếu đã được xử lý." });
                }

                // ✅ FIX: Lấy Employee ID (Admin)
                int? staffId = Session["EmployeeId"] as int?;
                if (!staffId.HasValue)
                {
                    return Json(new { success = false, message = "Bạn phải đăng nhập với tài khoản Admin để duyệt phiếu." });
                }

                phieu.trang_thai = "Đã duyệt";
                phieu.nguoi_duyet_id = staffId.Value;
                phieu.ngay_duyet = DateTime.Now;

                // ✅ TRIGGER sẽ tự động cập nhật tồn kho + giá vốn + lịch sử
                db.SubmitChanges();

                return Json(new { success = true, message = "Duyệt phiếu thành công!" });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        // POST: Admin/PurchaseOrder/Cancel/5
        [HttpPost]
        public ActionResult Cancel(int id, string reason)
        {
            try
            {
                var phieu = db.Phieu_Nhap_Hangs.FirstOrDefault(p => p.phieu_nhap_id == id);
                if (phieu == null)
                {
                    return Json(new { success = false, message = "Không tìm thấy phiếu nhập." });
                }

                if (phieu.trang_thai == "Đã duyệt")
                {
                    return Json(new { success = false, message = "Không thể hủy phiếu đã duyệt!" });
                }

                phieu.trang_thai = "Đã hủy";
                phieu.ly_do_huy = reason;
                db.SubmitChanges();

                return Json(new { success = true, message = "Hủy phiếu thành công!" });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        private string GeneratePurchaseOrderCode()
        {
            var today = DateTime.Now;
            var prefix = $"PN-{today:yyyyMMdd}";
            
            var lastCode = db.Phieu_Nhap_Hangs
                .Where(p => p.ma_phieu.StartsWith(prefix))
                .OrderByDescending(p => p.ma_phieu)
                .Select(p => p.ma_phieu)
                .FirstOrDefault();

            int sequence = 1;
            if (lastCode != null)
            {
                var parts = lastCode.Split('-');
                if (parts.Length == 3 && int.TryParse(parts[2], out int lastSeq))
                {
                    sequence = lastSeq + 1;
                }
            }

            return $"{prefix}-{sequence:D3}"; // PN-20240101-001
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                db.Dispose();
            }
            base.Dispose(disposing);
        }
    }
}
