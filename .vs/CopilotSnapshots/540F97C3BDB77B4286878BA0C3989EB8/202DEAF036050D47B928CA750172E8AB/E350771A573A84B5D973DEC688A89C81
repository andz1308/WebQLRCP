        // **BƯỚC 3: ĐI ĐẾN THANH TOÁN - KHÔNG LƯUL BOOKING VÀO DB**
        [HttpPost]
        public ActionResult Payment(string selectedFoods)
        {
            try
            {
                if (Session["CustomerId"] == null)
                    return Json(new { success = false, message = "Vui lòng đăng nhập trước khi thanh toán!" });

                // Lấy thông tin từ Session
                var selectedSeatsStr = Session["SelectedSeats"] as string;
                var showtimeId = Session["ShowtimeId"] as int?;

                if (string.IsNullOrEmpty(selectedSeatsStr) || !showtimeId.HasValue)
                {
                    return Json(new { success = false, message = "Dữ liệu ghế hoặc suất chiếu không hợp lệ. Vui lòng chọn lại!" });
                }

                // Parse selected seats từ session (dạng "1,2,3,...")
                List<int> seatIds = new List<int>();
                try
                {
                    seatIds = selectedSeatsStr.Split(',').Select(int.Parse).ToList();
                }
                catch
                {
                    return Json(new { success = false, message = "Ghế được chọn không hợp lệ!" });
                }

                // Kiểm tra các vé
                var tickets = db.Ves
                    .Where(v => v.Dat_Ve_id == null && v.suat_chieu_id == showtimeId.Value && seatIds.Contains(v.ghe_id))
                    .ToList();

                if (tickets.Count == 0)
                    return Json(new { success = false, message = "Không có vé nào được tạo. Vui lòng thử lại!" });

                // Kiểm tra ghế đã được đặt chưa (CHỈ KIỂM TRA VỀ ĐÃ THANH TOÁN)
                var paidBookingIds = db.Dat_Ves
                    .Where(b => b.trang_thai_Dat_Ve == "Đã Thanh toán")
                    .Select(b => b.Dat_Ve_id)
                    .ToList();

                var unavailableSeats = db.Ves
                    .Where(v => v.Dat_Ve_id != null && v.suat_chieu_id == showtimeId.Value && seatIds.Contains(v.ghe_id)
                        && paidBookingIds.Contains(v.Dat_Ve_id.Value))
                    .ToList();

                if (unavailableSeats.Any())
                {
                    return Json(new { success = false, message = "Một số ghế đã được đặt. Vui lòng chọn ghế khác!" });
                }

                // ✅ KHÔNG LƯU BOOKING NGAY - CHỈ LƯU VÀO SESSION
                // Tính toán tổng tiền trước khi thanh toán
                decimal ticketTotal = tickets.Sum(t => t.gia_ve);
                decimal foodTotal = 0;

                if (!string.IsNullOrEmpty(selectedFoods))
                {
                    var foodData = selectedFoods.Split(';');
                    foreach (var item in foodData)
                    {
                        if (string.IsNullOrEmpty(item)) continue;
                        
                        var parts = item.Split(':');
                        if (!int.TryParse(parts[0], out int foodId) || !int.TryParse(parts[1], out int quantity))
                            continue;
                        
                        var food = db.Do_Ans.FirstOrDefault(d => d.Do_An_id == foodId);
                        if (food != null)
                        {
                            foodTotal += (food.gia ?? 0m) * quantity;
                        }
                    }
                }

                decimal grandTotal = ticketTotal + foodTotal;

                // ✅ LƯU DỮ LIỆU VÀO SESSION (CHƯA LƯUI VÀO DB)
                Session["PendingBookingData"] = new
                {
                    SelectedSeats = selectedSeatsStr,
                    ShowtimeId = showtimeId.Value,
                    SelectedFoods = selectedFoods ?? "",
                    TicketTotal = ticketTotal,
                    FoodTotal = foodTotal,
                    GrandTotal = grandTotal
                };

                LoggingHelper.LogInfo($"✅ Chuẩn bị thanh toán (chưa lưu DB): {seatIds.Count} ghế, tổng: {grandTotal}");

                return Json(new
                {
                    success = true,
                    redirectUrl = Url.Action("PaymentGateway", "Booking")
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

