@model WebCinema.Models.Nha_Cung_Cap

@{
    ViewBag.Title = "Chỉnh Sửa Nhà Cung Cấp";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 2px solid #ff9966;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-header h1 {
        color: #ff6b35;
        font-weight: 700;
        margin: 0;
        font-size: 2rem;
    }

    .back-btn {
        background: white;
        color: #ff6b35;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: 2px solid #ffe8dc;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .back-btn:hover {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
        border-color: #ff6b35;
        text-decoration: none;
        transform: translateX(-5px);
    }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.5rem;
    }

    .card-header h3 {
        color: white;
        margin: 0;
        font-weight: 700;
    }

    .card-body {
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        color: #333;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-group label i {
        color: #ff6b35;
        margin-right: 0.3rem;
    }

    .form-group label .required {
        color: #dc3545;
        margin-left: 0.2rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #ffe8dc;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #ff6b35;
        box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 2px solid #ffe8dc;
    }

    .btn {
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(255, 107, 53, 0.3);
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background: #5a6268;
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(108, 117, 125, 0.3);
        color: white;
        text-decoration: none;
    }

    .alert {
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        font-weight: 600;
        border: 2px solid;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border-color: #f5c6cb;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 0.9rem;
        margin-top: 0.25rem;
        display: block;
    }

    .input-error {
        border-color: #dc3545 !important;
    }

    .form-hint {
        color: #666;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .info-badge {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }
</style>

<div class="page-header">
    <h1><i class="fas fa-edit"></i> Chỉnh Sửa Nhà Cung Cấp</h1>
    <a href="@Url.Action("Index")" class="back-btn">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="form-card">
    <div class="card-header">
        <h3><i class="fas fa-file-alt"></i> Thông Tin Nhà Cung Cấp</h3>
    </div>
    <div class="card-body">
        <div class="info-badge">
            <i class="fas fa-info-circle"></i>
            <span>ID Nhà Cung Cấp: #@Model.id</span>
        </div>

        @using (Html.BeginForm("Edit", "SupplierManagement", FormMethod.Post, new { area = "Admin" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.id)
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            <i class="fas fa-building"></i> Tên Nhà Cung Cấp<span class="required">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.ten_nha_cung_cap, new { @class = "form-control", placeholder = "Ví dụ: Công ty TNHH Thực Phẩm ABC", required = "required" })
                        @Html.ValidationMessageFor(m => m.ten_nha_cung_cap, "", new { @class = "field-validation-error" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            <i class="fas fa-phone"></i> Số Điện Thoại
                        </label>
                        @Html.TextBoxFor(m => m.so_dien_thoai, new { @class = "form-control", placeholder = "Ví dụ: 0123456789", type = "tel" })
                        @Html.ValidationMessageFor(m => m.so_dien_thoai, "", new { @class = "field-validation-error" })
                        <span class="form-hint">Định dạng: 10 chữ số</span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            <i class="fas fa-envelope"></i> Email
                        </label>
                        @Html.TextBoxFor(m => m.email, new { @class = "form-control", placeholder = "Ví dụ: contact@company.com", type = "email" })
                        @Html.ValidationMessageFor(m => m.email, "", new { @class = "field-validation-error" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            <i class="fas fa-map-marker-alt"></i> Địa Chỉ
                        </label>
                        @Html.TextBoxFor(m => m.dia_chi, new { @class = "form-control", placeholder = "Ví dụ: 123 Đường ABC, Quận XYZ, TP.HCM" })
                        @Html.ValidationMessageFor(m => m.dia_chi, "", new { @class = "field-validation-error" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>
                    <i class="fas fa-comment"></i> Trạng Thái
                </label>
                @Html.DropDownListFor(m => m.trang_thai, new SelectList(new[] { 
                    new { Value = "Hoạt động", Text = "Hoạt động" },
                    new { Value = "Tạm ngưng", Text = "Tạm ngưng" }
                }, "Value", "Text"), "-- Chọn trạng thái --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.trang_thai, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Hủy
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Cập Nhật
                </button>
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Validation for phone number
        $('input[name="so_dien_thoai"]').on('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length > 10) {
                this.value = this.value.slice(0, 10);
            }
        });

        // Form validation
        $('form').on('submit', function(e) {
            var tenNCC = $('input[name="ten_nha_cung_cap"]').val().trim();
            
            if (!tenNCC) {
                e.preventDefault();
                alert('❌ Vui lòng nhập tên nhà cung cấp!');
                $('input[name="ten_nha_cung_cap"]').focus().addClass('input-error');
                return false;
            }

            var phone = $('input[name="so_dien_thoai"]').val().trim();
            if (phone && phone.length !== 10) {
                e.preventDefault();
                alert('❌ Số điện thoại phải có đúng 10 chữ số!');
                $('input[name="so_dien_thoai"]').focus().addClass('input-error');
                return false;
            }

            return true;
        });

        // Remove error class on input
        $('.form-control').on('input', function() {
            $(this).removeClass('input-error');
        });
    </script>
}
