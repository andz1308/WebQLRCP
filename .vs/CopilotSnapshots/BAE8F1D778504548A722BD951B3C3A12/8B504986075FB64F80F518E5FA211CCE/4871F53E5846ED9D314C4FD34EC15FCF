@model IEnumerable<WebCinema.Models.Nha_Cung_Cap>

@{
    ViewBag.Title = "Quản Lý Nhà Cung Cấp";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 2px solid #ff9966;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-header h1 {
        color: #ff6b35;
        font-weight: 700;
        margin: 0;
        font-size: 2rem;
    }

    .btn-add {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-add:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(255, 107, 53, 0.3);
        color: white;
        text-decoration: none;
    }

    .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.5rem;
    }

    .card-header h3 {
        color: white;
        margin: 0;
        font-weight: 700;
    }

    .card-body {
        padding: 2rem;
    }

    .search-box {
        margin-bottom: 1.5rem;
        position: relative;
    }

    .search-box input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 2.5rem;
        border: 2px solid #ffe8dc;
        border-radius: 8px;
        font-size: 1rem;
    }

    .search-box input:focus {
        outline: none;
        border-color: #ff6b35;
        box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
    }

    .search-box i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #ff6b35;
    }

    .table {
        width: 100%;
        margin: 0;
    }

    .table thead th {
        background: #fff5f0;
        color: #ff6b35;
        font-weight: 600;
        border-bottom: 2px solid #ff9966;
        padding: 1rem;
        text-align: left;
    }

    .table tbody td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #ffe8dc;
    }

    .table tbody tr:hover {
        background: #fff5f0;
    }

    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.9rem;
    }

    .btn-edit {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
        color: white;
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        color: white;
        text-decoration: none;
    }

    .btn-delete {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
    }

    .alert {
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        font-weight: 600;
        border: 2px solid;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border-color: #c3e6cb;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border-color: #f5c6cb;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #999;
    }

    .empty-state i {
        font-size: 4rem;
        color: #ffe8dc;
        margin-bottom: 1rem;
    }

    .supplier-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .supplier-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .supplier-details h4 {
        margin: 0;
        color: #333;
        font-size: 1rem;
        font-weight: 600;
    }

    .supplier-details p {
        margin: 0;
        color: #666;
        font-size: 0.85rem;
    }
</style>

<div class="page-header">
    <h1><i class="fas fa-truck"></i> Quản Lý Nhà Cung Cấp</h1>
    <a href="@Url.Action("Create")" class="btn-add">
        <i class="fas fa-plus"></i> Thêm Nhà Cung Cấp
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="content-card">
    <div class="card-header">
        <h3><i class="fas fa-list"></i> Danh Sách Nhà Cung Cấp</h3>
    </div>
    <div class="card-body">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Tìm kiếm nhà cung cấp theo tên, địa chỉ, SĐT..." />
        </div>

        @if (Model != null && Model.Any())
        {
            <div style="overflow-x: auto;">
                <table class="table" id="supplierTable">
                    <thead>
                        <tr>
                            <th style="width: 50px; text-align: center;">#</th>
                            <th style="width: 25%;">Nhà Cung Cấp</th>
                            <th style="width: 15%;">Số Điện Thoại</th>
                            <th style="width: 15%;">Email</th>
                            <th style="width: 20%;">Địa Chỉ</th>
                            <th style="width: 10%; text-align: center;">Trạng Thái</th>
                            <th style="width: 15%; text-align: center;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int index = 1;}
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align: center; color: #999;">@index</td>
                                <td>
                                    <div class="supplier-info">
                                        <div class="supplier-icon">
                                            <i class="fas fa-building"></i>
                                        </div>
                                        <div class="supplier-details">
                                            <h4>@item.ten_nha_cung_cap</h4>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.so_dien_thoai))
                                    {
                                        <i class="fas fa-phone" style="color: #ff6b35;"></i>
                                        <span>@item.so_dien_thoai</span>
                                    }
                                    else
                                    {
                                        <span style="color: #999;">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.email))
                                    {
                                        <i class="fas fa-envelope" style="color: #ff6b35;"></i>
                                        <span style="font-size: 0.9rem;">@item.email</span>
                                    }
                                    else
                                    {
                                        <span style="color: #999;">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.dia_chi))
                                    {
                                        <i class="fas fa-map-marker-alt" style="color: #ff6b35;"></i>
                                        <span>@item.dia_chi</span>
                                    }
                                    else
                                    {
                                        <span style="color: #999;">Chưa cập nhật</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (item.trang_thai == "Hoạt động")
                                    {
                                        <span style="padding: 0.4rem 0.8rem; background: #28a745; color: white; border-radius: 6px; font-weight: 600; font-size: 0.85rem;">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span style="padding: 0.4rem 0.8rem; background: #6c757d; color: white; border-radius: 6px; font-weight: 600; font-size: 0.85rem;">Tạm ngưng</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <a href="@Url.Action("Edit", new { id = item.id })" class="btn-action btn-edit">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <button onclick="deleteSupplier(@item.id, '@item.ten_nha_cung_cap')" class="btn-action btn-delete">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-truck"></i>
                <h3>Chưa có nhà cung cấp nào</h3>
                <p>Nhấn nút "Thêm Nhà Cung Cấp" để bắt đầu</p>
            </div>
        }
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Tìm kiếm
        $(document).ready(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#supplierTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });

        // Xóa nhà cung cấp
        function deleteSupplier(id, name) {
            if (confirm('Bạn có chắc chắn muốn xóa nhà cung cấp "' + name + '"?\n\nLưu ý: Không thể xóa nhà cung cấp đã có phiếu nhập!')) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { id: id },
                    success: function (result) {
                        if (result.success) {
                            alert('✅ ' + result.message);
                            location.reload();
                        } else {
                            alert('❌ ' + result.message);
                        }
                    },
                    error: function () {
                        alert('❌ Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
}
