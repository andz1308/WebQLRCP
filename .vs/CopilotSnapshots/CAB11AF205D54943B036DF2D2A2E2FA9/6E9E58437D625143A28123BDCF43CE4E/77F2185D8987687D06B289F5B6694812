@{
    ViewBag.Title = "Chọn Ghế";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var room = ViewBag.Room as WebCinema.Models.Phong_Chieu;
    var seats = ViewBag.Seats as List<WebCinema.Models.Ghe>;
    var bookedSeats = ViewBag.BookedSeats as List<int>;
    var movie = ViewBag.Movie as WebCinema.Models.Phim;
    var cinema = ViewBag.Cinema as WebCinema.Models.Rap;
}

<style>
    .booking-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 2rem;
    }

    .booking-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px 12px 0 0;
        margin-bottom: 0;
    }

    .movie-info {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .movie-poster-small {
        width: 100px;
        height: 140px;
        border-radius: 8px;
        object-fit: cover;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .movie-details h2 {
        margin: 0 0 0.5rem 0;
        font-size: 1.8rem;
    }

    .movie-meta {
        display: flex;
        gap: 2rem;
        font-size: 0.9rem;
        opacity: 0.9;
    }

    .progress-steps {
        background: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: center;
        gap: 2rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #999;
        font-weight: 600;
    }

    .step-number {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .step.active {
        color: #ff6b35;
    }

    .step.active .step-number {
        background: #ff6b35;
        color: white;
    }

    .seat-selection {
        background: white;
        padding: 2rem;
    }

    .screen-area {
        text-align: center;
        margin-bottom: 3rem;
    }

    .screen {
        background: linear-gradient(180deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 10px 60px;
        border-radius: 0 0 50% 50%;
        display: inline-block;
        font-weight: bold;
        font-size: 1rem;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        margin-bottom: 0.5rem;
    }

    .screen-label {
        color: #666;
        font-size: 0.9rem;
    }

    .seat-legend {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 2rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .legend-seat {
        width: 30px;
        height: 30px;
        border-radius: 8px 8px 0 0;
        display: inline-block;
    }

    .legend-seat.available {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
    }

    .legend-seat.selected {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
    }

    .legend-seat.booked {
        background: #95a5a6;
    }

    .legend-seat.vip {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    }

    .legend-seat.couple {
        background: linear-gradient(135deg, #e83e8c 0%, #d6296d 100%);
    }

    .seat-map {
        display: grid;
        grid-template-columns: repeat(@room.so_cot, 45px);
        gap: 8px;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .seat {
        width: 45px;
        height: 45px;
        border-radius: 4px;  // ✅ Vuông thay vì 8px 8px 0 0
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
    }

    .seat::before {
        display: none;  // ✅ Bỏ chi tiết dưới ghế (không cần cho hình vuông)
    }

    .seat.available {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
    }

    .seat.available:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 8px 15px rgba(52, 152, 219, 0.4);
    }

    .seat.selected {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        transform: translateY(-3px);
    }

    .seat.booked {
        background: #7f8c8d !important;
        color: #bdc3c7 !important;
        cursor: not-allowed !important;
        opacity: 0.5;
        pointer-events: none;
    }

    .seat.booked:hover {
        transform: none !important;
        box-shadow: none !important;
    }

    .seat.vip {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    .seat.couple {
        background: linear-gradient(135deg, #e83e8c 0%, #d6296d 100%);
        color: white;
        width: 95px;
    }

    .seat.aisle {
        background: transparent;
        box-shadow: none;
        cursor: default;
    }

    .seat.aisle::before {
        display: none;
    }

    .booking-summary {
        background: white;
        padding: 2rem;
        border-top: 2px solid #e0e0e0;
        position: sticky;
        bottom: 0;
        box-shadow: 0 -4px 15px rgba(0, 0, 0, 0.1);
    }

    .summary-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .selected-info {
        display: flex;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-size: 1.1rem;
        font-weight: bold;
        color: #333;
    }

    .total-price {
        font-size: 1.8rem;
        font-weight: bold;
        color: #ff6b35;
    }

    .btn-continue {
        padding: 1rem 3rem;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-continue:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
    }

    .btn-continue:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
        .seat-map {
            grid-template-columns: repeat(@room.so_cot, 35px);
            gap: 5px;
        }

        .seat {
            width: 35px;
            height: 35px;
        }

        .summary-content {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>

<div class="booking-container">
    <div class="booking-header">
        <div class="movie-info">
            @if (!string.IsNullOrEmpty(movie.hinh_anh))
            {
                <img src="@Url.Content(movie.hinh_anh)" alt="@movie.ten_phim" class="movie-poster-small" />
            }
            <div class="movie-details">
                <h2>@movie.ten_phim</h2>
                <div class="movie-meta">
                    <span><i class="fas fa-building"></i> @cinema.ten_rap</span>
                    <span><i class="fas fa-door-open"></i> @room.ten_phong</span>
                    <span><i class="fas fa-calendar"></i> @showtime.ngay_chieu.ToString("dd/MM/yyyy")</span>
                    <span><i class="fas fa-clock"></i> @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="progress-steps">
        <div class="step active">
            <span class="step-number">1</span>
            <span>Chọn Ghế</span>
        </div>
        <div class="step">
            <span class="step-number">2</span>
            <span>Chọn Đồ Ăn</span>
        </div>
        <div class="step">
            <span class="step-number">3</span>
            <span>Thanh Toán</span>
        </div>
    </div>

    <div class="seat-selection">
        <div class="screen-area">
            <div class="screen">MÀN HÌNH</div>
            <div class="screen-label">Màn hình chiếu phim</div>
        </div>

        <div class="seat-legend">
            <div class="legend-item">
                <span class="legend-seat available"></span>
                <span>Ghế trống</span>
            </div>
            <div class="legend-item">
                <span class="legend-seat selected"></span>
                <span>Ghế đang chọn</span>
            </div>
            <div class="legend-item">
                <span class="legend-seat booked"></span>
                <span>Ghế đã đặt</span>
            </div>
            <div class="legend-item">
                <span class="legend-seat vip"></span>
                <span>Ghế VIP</span>
            </div>
            <div class="legend-item">
                <span class="legend-seat couple"></span>
                <span>Ghế đôi</span>
            </div>
        </div>

        <div class="seat-map">
            @foreach (var seat in seats)
            {
                var isBooked = bookedSeats.Contains(seat.ghe_id);
                var isAisle = seat.trang_thai == 0; // Lối đi
                var seatClass = "";

                if (isAisle)
                {
                    seatClass = "seat aisle";
                }
                else if (isBooked)
                {
                    seatClass = "seat booked";
                }
                else
                {
                    // Determine seat type
                    if (seat.loai_ghe_id == 1)
                    {
                        seatClass = "seat available"; // Standard
                    }
                    else if (seat.loai_ghe_id == 2)
                    {
                        seatClass = "seat available vip"; // VIP
                    }
                    else if (seat.loai_ghe_id == 3)
                    {
                        seatClass = "seat available couple"; // Couple
                    }
                }

                <div class="@seatClass" 
                     data-seat-id="@seat.ghe_id" 
                     data-seat-name="@seat.so_ghe"
                     data-seat-price="@( (ViewBag.SeatPrices as System.Collections.Generic.Dictionary<int, decimal>).ContainsKey(seat.ghe_id) ? (ViewBag.SeatPrices as System.Collections.Generic.Dictionary<int, decimal>)[seat.ghe_id] : 0 )"
                     data-booked="@(isBooked ? "true" : "false")"
                     data-aisle="@(isAisle ? "true" : "false")">
                    @if (!isAisle)
                    {
                        @seat.so_ghe
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="booking-summary">
    <div class="summary-content">
        <div class="selected-info">
            <div class="info-item">
                <span class="info-label">Ghế đã chọn</span>
                <span class="info-value" id="selectedSeatsText">Chưa chọn ghế</span>
            </div>
            <div class="info-item">
                <span class="info-label">Tổng tiền</span>
                <span class="total-price" id="totalPrice">0 VND</span>
            </div>
        </div>
        <button class="btn-continue" id="btnContinue" disabled onclick="continueToFood()">
            Tiếp Tục <i class="fas fa-arrow-right"></i>
        </button>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            var selectedSeats = [];

            // Only attach click handler to non-booked seats
            $('.seat').not('.booked').not('.aisle').click(function() {
                // Double check it's not booked
                if ($(this).hasClass('booked') || $(this).data('booked') === 'true' || $(this).data('aisle') === 'true') {
                    alert('Ghế này đã được đặt!');
                    return;
                }

                var seatId = $(this).data('seat-id');
                var seatName = $(this).data('seat-name');
                var seatPrice = parseFloat($(this).data('seat-price'));

                if ($(this).hasClass('selected')) {
                    // Deselect
                    $(this).removeClass('selected');
                    selectedSeats = selectedSeats.filter(s => s.id !== seatId);
                } else {
                    // Select
                    if (selectedSeats.length >= 10) {
                        alert('Bạn chỉ có thể chọn tối đa 10 ghế!');
                        return;
                    }
                    $(this).addClass('selected');
                    selectedSeats.push({
                        id: seatId,
                        name: seatName,
                        price: seatPrice
                    });
                }

                updateSummary();
            });

            function updateSummary() {
                if (selectedSeats.length === 0) {
                    $('#selectedSeatsText').text('Chưa chọn ghế');
                    $('#totalPrice').text('0 đ');
                    $('#btnContinue').prop('disabled', true);
                } else {
                    var seatNames = selectedSeats.map(s => s.name).join(', ');
                    var total = selectedSeats.reduce((sum, s) => sum + s.price, 0);
                    
                    $('#selectedSeatsText').text(seatNames);
                    $('#totalPrice').text(total.toLocaleString('vi-VN') + ' đ');
                    $('#btnContinue').prop('disabled', false);
                }
            }

            window.continueToFood = function() {
                if (selectedSeats.length === 0) {
                    alert('Vui lòng chọn ít nhất 1 ghế!');
                    return;
                }

                var seatIds = selectedSeats.map(s => s.id).join(',');
                
                $.ajax({
                    url: '@Url.Action("SelectFood", "Booking")',
                    type: 'POST',
                    data: {
                        selectedSeats: seatIds,
                        showtimeId: @showtime.suat_chieu_id
                    },
                    success: function(response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra. Vui lòng thử lại!');
                    }
                });
            };
        });
    </script>
}
