@model IEnumerable<WebCinema.Models.Dat_Ve>

@{
    ViewBag.Title = "Báo Cáo Vé & Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-chart-bar"></i> Báo Cáo Vé & Đơn Hàng</h2>
    </div>

    <!-- Date Filter -->
    <div style="margin-bottom: 2rem; padding: 1.5rem; background: #f8f9fa; border-radius: 8px;">
        @using (Html.BeginForm("Report", "TicketManagement", FormMethod.Get))
        {
            <div style="display: flex; gap: 1rem; align-items: flex-end;">
                <div class="form-group" style="margin: 0; flex: 1;">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                </div>

                <div class="form-group" style="margin: 0; flex: 1;">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> Lọc
                </button>

                <a href="@Url.Action("Report")" class="btn btn-secondary">
                    <i class="fas fa-redo"></i> Reset
                </a>
            </div>
        }
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #3498db;">
            <div style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
                <i class="fas fa-file-invoice"></i> Tổng Đơn Hàng
            </div>
            <div style="font-size: 2.5rem; font-weight: bold; color: #3498db;">
                @ViewBag.TotalBookings
            </div>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #27ae60;">
            <div style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
                <i class="fas fa-credit-card"></i> Đã Thanh Toán
            </div>
            <div style="font-size: 2.5rem; font-weight: bold; color: #27ae60;">
                @ViewBag.PaidBookings
            </div>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #f39c12;">
            <div style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
                <i class="fas fa-hourglass"></i> Chưa Thanh Toán
            </div>
            <div style="font-size: 2.5rem; font-weight: bold; color: #f39c12;">
                @ViewBag.UnpaidBookings
            </div>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #e74c3c;">
            <div style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
                <i class="fas fa-times-circle"></i> Đơn Hàng Hủy
            </div>
            <div style="font-size: 2.5rem; font-weight: bold; color: #e74c3c;">
                @ViewBag.CancelledBookings
            </div>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #ff6b35;">
            <div style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
                <i class="fas fa-money-bill"></i> Tổng Doanh Thu
            </div>
            <div style="font-size: 2rem; font-weight: bold; color: #ff6b35;">
                @((decimal)ViewBag.TotalRevenue).ToString("N0") ₫
            </div>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #9b59b6;">
            <div style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
                <i class="fas fa-chart-pie"></i> Trung Bình/Đơn
            </div>
            <div style="font-size: 2rem; font-weight: bold; color: #9b59b6;">
                @(ViewBag.TotalBookings > 0 ? ((decimal)ViewBag.TotalRevenue / ViewBag.TotalBookings).ToString("N0") : "0") ₫
            </div>
        </div>
    </div>

    <!-- Booking List -->
    <div style="background: white; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
        <h3 style="color: #2c3e50; margin-bottom: 1rem;">
            <i class="fas fa-list"></i> Chi Tiết Đơn Hàng
        </h3>

        @if (Model != null && Model.Any())
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #f8f9fa; border-bottom: 2px solid #e0e0e0;">
                            <th style="padding: 1rem; text-align: left; font-weight: 600;">Mã Đơn</th>
                            <th style="padding: 1rem; text-align: left; font-weight: 600;">Khách Hàng</th>
                            <th style="padding: 1rem; text-align: left; font-weight: 600;">Phim</th>
                            <th style="padding: 1rem; text-align: left; font-weight: 600;">Số Ghế</th>
                            <th style="padding: 1rem; text-align: left; font-weight: 600;">Tổng Tiền</th>
                            <th style="padding: 1rem; text-align: left; font-weight: 600;">Trạng Thái</th>
                            <th style="padding: 1rem; text-align: left; font-weight: 600;">Ngày Đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            var firstTicket = booking.Ves.FirstOrDefault();
                            var movie = firstTicket?.Suat_Chieu?.Phim;
                            var seats = string.Join(", ", booking.Ves.Select(v => v.Ghe.so_ghe));

                            var statusBadgeClass = booking.trang_thai_Dat_Ve == "Đã xác nhận" ? "success"
                                                : booking.trang_thai_Dat_Ve == "Chờ xác nhận" ? "warning"
                                                : "danger";

                            <tr style="border-bottom: 1px solid #e0e0e0;">
                                <td style="padding: 1rem;">
                                    <a href="@Url.Action("Details", new { id = booking.Dat_Ve_id })" style="color: #ff6b35; font-weight: 600; text-decoration: none;">
                                        #@booking.Dat_Ve_id
                                    </a>
                                </td>
                                <td style="padding: 1rem;">@(booking.Khach_Hang?.ho_ten ?? "N/A")</td>
                                <td style="padding: 1rem;">@(movie?.ten_phim ?? "N/A")</td>
                                <td style="padding: 1rem;">@seats</td>
                                <td style="padding: 1rem; color: #ff6b35; font-weight: 600;">@booking.tong_tien.ToString("N0") ₫</td>
                                <td style="padding: 1rem;">
                                    <span class="badge badge-@statusBadgeClass">@booking.trang_thai_Dat_Ve</span>
                                </td>
                                <td style="padding: 1rem; font-size: 0.9rem;">@booking.ngay_tao.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="text-align: center; color: #999; padding: 2rem;">Không có dữ liệu trong khoảng thời gian này.</p>
        }
    </div>

    <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay Lại
        </a>
    </div>
</div>

<style>
    .badge {
        display: inline-block;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .badge-success {
        background: #d4edda;
        color: #155724;
    }

    .badge-warning {
        background: #fff3cd;
        color: #856404;
    }

    .badge-danger {
        background: #f8d7da;
        color: #721c24;
    }

    .btn {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .btn-primary {
        background: #ff6b35;
        color: white;
    }

    .btn-primary:hover {
        background: #ff8555;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background: #5a6268;
    }

    .form-control {
        width: 100%;
        padding: 0.8rem;
        border: 2px solid #e0e0e0;
        border-radius: 6px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control:hover,
    .form-control:focus {
        border-color: #ff6b35;
        outline: none;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }
</style>
