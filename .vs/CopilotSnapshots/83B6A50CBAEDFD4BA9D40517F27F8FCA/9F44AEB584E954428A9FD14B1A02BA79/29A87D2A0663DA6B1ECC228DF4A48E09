@{
    ViewBag.Title = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    IEnumerable<object> foodItems = ViewBag.FoodItems as IEnumerable<object>;
    var ticketTotal = (decimal)ViewBag.TicketTotal;
    var foodTotal = (decimal)ViewBag.FoodTotal;
    var grandTotal = (decimal)ViewBag.GrandTotal;
    
    var booking = ViewBag.Booking as WebCinema.Models.Dat_Ve;
    var bookingIdValue = booking != null ? booking.Dat_Ve_id : 0;
    var qrCodeUrl = ViewBag.QRCodeUrl as string;
}

<style>
    .checkout-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 2rem;
    }

    .checkout-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2.5rem 2rem;
        border-radius: 12px 12px 0 0;
        text-align: center;
    }

    .checkout-header h2 {
        margin: 0 0 0.3rem 0;
        font-size: 1.8rem;
    }

    .checkout-header p {
        margin: 0;
        opacity: 0.9;
        font-size: 0.95rem;
    }

    .progress-steps {
        background: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: center;
        gap: 3rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #999;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .step-number {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .step.active { 
        color: #ff6b35; 
    }

    .step.active .step-number { 
        background: #ff6b35; 
        color: white; 
    }

    .step.completed .step-number { 
        background: #27ae60; 
        color: white; 
    }

    .checkout-content { 
        display: grid; 
        grid-template-columns: 1fr 380px; 
        gap: 2.5rem; 
        padding: 2rem; 
        background: white;
    }

    .info-section { 
        background: #f8f9fa; 
        padding: 1.5rem; 
        border-radius: 8px; 
        border-left: 4px solid #ff6b35; 
        margin-bottom: 1.5rem;
    }

    .section-title { 
        font-size: 1.1rem; 
        font-weight: 700; 
        color: #333; 
        margin: 0 0 1rem 0;
        display: flex; 
        align-items: center; 
        gap: 0.5rem;
    }

    /* Movie Info */
    .movie-info { 
        display: flex; 
        gap: 1rem;
    }

    .movie-poster { 
        width: 70px;
        height: 100px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
    }

    .movie-info > div {
        flex: 1;
    }

    .movie-info strong {
        display: block;
        font-size: 1rem;
        color: #333;
        margin-bottom: 0.6rem;
    }

    .movie-details {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: #666;
    }

    .movie-details div {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* Tickets Display */
    .ticket-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(45px, 1fr));
        gap: 0.5rem;
    }

    .ticket-badge {
        width: 100%;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #ff6b35;
        background: white;
        color: #ff6b35;
        font-weight: 700;
        font-size: 0.75rem;
        border-radius: 4px;
        min-height: 45px;
    }

    /* Food List */
    .food-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .food-item {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 0.8rem;
        background: white;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .food-item-name {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.2rem;
    }

    .food-item-qty {
        color: #666;
        font-size: 0.85rem;
    }

    .food-item-price {
        font-weight: 600;
        color: #ff6b35;
        text-align: right;
    }

    /* QR Code Section */
    .qr-payment-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 1.5rem;
        display: none;
    }

    .qr-payment-section.show {
        display: block;
        animation: slideDown 0.3s ease;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .qr-code-container {
        background: white;
        padding: 1.5rem;
        border-radius: 10px;
        display: inline-block;
        margin: 1rem 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .qr-code-container img {
        max-width: 280px;
        height: auto;
        border-radius: 6px;
    }

    .qr-instructions {
        margin-top: 1.5rem;
        font-size: 0.9rem;
        line-height: 1.6;
        text-align: left;
    }

    .qr-instructions strong {
        display: block;
        margin-bottom: 0.8rem;
    }

    .qr-instructions ol {
        margin: 0;
        padding-left: 1.5rem;
    }

    .qr-instructions li {
        margin-bottom: 0.5rem;
    }

    /* Order Summary (Right Panel) */
    .order-summary {
        background: white;
        border: 2px solid #e0e0e0;
        padding: 1.5rem;
        border-radius: 8px;
        position: sticky;
        top: 20px;
        height: fit-content;
    }

    .summary-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #333;
        margin: 0 0 1.5rem 0;
        text-align: center;
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem 0;
        border-bottom: 1px solid #e0e0e0;
        font-size: 0.95rem;
    }

    .summary-line:last-of-type {
        border-bottom: none;
    }

    .summary-line span:last-child {
        font-weight: 600;
        color: #333;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        margin-top: 1rem;
        border-top: 2px solid #ff6b35;
        border-bottom: 2px solid #ff6b35;
        font-size: 1.2rem;
        font-weight: bold;
    }

    .summary-total span:first-child {
        color: #333;
    }

    .summary-total span:last-child {
        color: #ff6b35;
        font-size: 1.4rem;
    }

    .btn-confirm {
        width: 100%;
        padding: 1.1rem;
        margin-top: 1.5rem;
        background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-confirm:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(39, 174, 96, 0.4);
    }

    .btn-confirm:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }

    .btn-back {
        width: 100%;
        padding: 0.9rem;
        margin-top: 0.8rem;
        background: transparent;
        color: #666;
        border: 2px solid #ccc;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-back:hover {
        border-color: #ff6b35;
        color: #ff6b35;
        background: #fff5f2;
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .checkout-content {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .order-summary {
            position: static;
        }

        .progress-steps {
            gap: 2rem;
        }
    }

    @@media (max-width: 768px) {
        .checkout-container {
            padding: 0 1rem;
        }

        .checkout-header {
            padding: 2rem 1rem;
        }

        .checkout-header h2 {
            font-size: 1.4rem;
        }

        .progress-steps {
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .step {
            gap: 0.3rem;
        }

        .checkout-content {
            padding: 1rem;
        }

        .qr-payment-section {
            padding: 1.5rem;
        }

        .qr-code-container {
            padding: 1rem;
        }

        .qr-code-container img {
            max-width: 200px;
        }
    }
</style>

<div class="checkout-container">
    <div class="checkout-header">
        <h2><i class="fas fa-qrcode"></i> Thanh Toán Qua QR Code</h2>
        <p>Quét mã QR để hoàn tất đặt vé</p>
    </div>

    <div class="progress-steps">
        <div class="step completed">
            <span class="step-number"><i class="fas fa-check"></i></span>
            <span>Chọn Ghế</span>
        </div>
        <div class="step completed">
            <span class="step-number"><i class="fas fa-check"></i></span>
            <span>Chọn Đồ Ăn</span>
        </div>
        <div class="step active">
            <span class="step-number">3</span>
            <span>Thanh Toán QR</span>
        </div>
    </div>

    <div class="checkout-content">
        <div>
            <!-- Movie Info -->
            @if (showtime != null)
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-film"></i> Thông Tin Phim
                    </h3>
                    <div class="movie-info">
                        @if (!string.IsNullOrEmpty(showtime.Phim.hinh_anh))
                        {
                            <img src="@Url.Content(showtime.Phim.hinh_anh)" alt="@showtime.Phim.ten_phim" class="movie-poster" />
                        }
                        <div>
                            <strong>@showtime.Phim.ten_phim</strong>
                            <div class="movie-details">
                                <div><i class="fas fa-building"></i> @showtime.Phong_Chieu.Rap.ten_rap</div>
                                <div><i class="fas fa-door-open"></i> @showtime.Phong_Chieu.ten_phong</div>
                                <div><i class="fas fa-calendar"></i> @showtime.ngay_chieu.ToString("dd/MM/yyyy")</div>
                                <div><i class="fas fa-clock"></i> @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Tickets -->
            @if (tickets != null && tickets.Count > 0)
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-ticket-alt"></i> Vé (@tickets.Count vé)
                    </h3>
                    <div class="ticket-grid">
                        @foreach (var ticket in tickets)
                        {
                            <div class="ticket-badge">@ticket.Ghe.so_ghe</div>
                        }
                    </div>
                </div>
            }

            <!-- Food Items -->
            @if (foodItems != null && foodItems.Any())
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-utensils"></i> Đồ Ăn & Thức Uống
                    </h3>
                    <div class="food-list">
                        @foreach (var item in foodItems)
                        {
                            if (item == null) { continue; }
                            string foodName = "N/A"; 
                            int quantity = 0; 
                            decimal price = 0m;
                            try
                            {
                                var t = item.GetType();
                                var nameProp = t.GetProperty("FoodName");
                                var qtyProp = t.GetProperty("Quantity");
                                var priceProp = t.GetProperty("Price");
                                if (nameProp != null) { foodName = (nameProp.GetValue(item, null) ?? "N/A").ToString(); }
                                if (qtyProp != null) { int.TryParse((qtyProp.GetValue(item, null) ?? 0).ToString(), out quantity); }
                                if (priceProp != null) { decimal.TryParse((priceProp.GetValue(item, null) ?? 0).ToString(), out price); }
                            }
                            catch { }
                            var itemTotal = price * quantity;
                            <div class="food-item">
                                <div style="flex: 1;">
                                    <div class="food-item-name">@foodName</div>
                                    <div class="food-item-qty">Số lượng: @quantity</div>
                                </div>
                                <div class="food-item-price">@itemTotal.ToString("N0") ₫</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- QR CODE Payment Section -->
            @if (!string.IsNullOrEmpty(qrCodeUrl))
            {
                <div class="qr-payment-section" id="qrPaymentSection">
                    <h3><i class="fas fa-qrcode"></i> Quét Mã QR Để Thanh Toán</h3>
                    <p>Sử dụng ứng dụng ngân hàng để quét mã QR dưới đây</p>
                    
                    <div class="qr-code-container">
                        <img src="@qrCodeUrl" alt="QR Code Payment" />
                    </div>

                    <div class="qr-instructions">
                        <strong>📱 Hướng Dẫn Quét:</strong>
                        <ol>
                            <li>Mở ứng dụng ngân hàng, Momo hoặc ZaloPay</li>
                            <li>Chọn "Quét mã QR"</li>
                            <li>Quét mã QR ở trên</li>
                            <li>Xác nhận và nhập PIN</li>
                            <li>Quay lại trang này và nhấn nút "Xác Nhận"</li>
                        </ol>
                    </div>
                </div>
            }
        </div>

        <!-- Order Summary -->
        <div class="order-summary">
            <h3 class="summary-title"><i class="fas fa-receipt"></i> Tổng Đơn Hàng</h3>
            
            <div class="summary-line">
                <span>Tiền vé (@(tickets != null ? tickets.Count : 0) vé)</span>
                <span>@ticketTotal.ToString("N0") ₫</span>
            </div>

            @if (foodTotal > 0)
            {
                <div class="summary-line">
                    <span>Đồ ăn & thức uống</span>
                    <span>@foodTotal.ToString("N0") ₫</span>
                </div>
            }

            <div class="summary-total">
                <span>Tổng Cộng</span>
                <span>@grandTotal.ToString("N0") ₫</span>
            </div>

            <button class="btn-confirm" onclick="handlePaymentClick(@bookingIdValue)" id="paymentBtn">
                <i class="fas fa-check-circle"></i> Thanh Toán
            </button>

            <button class="btn-back" onclick="goBack()">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var isQRShown = false;

        function handlePaymentClick(bookingId) {
            if (!isQRShown) {
                // First click: Show QR and change button text
                showQRAndChangeButton(bookingId);
            } else {
                // Second click: Confirm payment
                confirmQRPayment(bookingId);
            }
        }

        function showQRAndChangeButton(bookingId) {
            // Show QR section
            $('#qrPaymentSection').addClass('show');
            
            // Change button text and style
            var $btn = $('#paymentBtn');
            $btn.html('<i class="fas fa-check-circle"></i> Xác Nhận Đã Thanh Toán');
            $btn.css('background', 'linear-gradient(135deg, #27ae60 0%, #229954 100%)');
            
            // Scroll to QR section
            $('html, body').animate({
                scrollTop: $('#qrPaymentSection').offset().top - 100
            }, 500);

            isQRShown = true;
        }

        function confirmQRPayment(bookingId) {
            if (!confirm('Bạn đã quét mã QR và chuyển tiền xong chưa?\n\nNhấn OK nếu đã thanh toán.')) {
                return;
            }

            $('button').prop('disabled', true);
            var $btn = $('#paymentBtn');
            $btn.html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');
            
            $.ajax({
                url: '@Url.Action("ConfirmQRPayment", "Invoice")',
                type: 'POST',
                data: { bookingId: bookingId },
                success: function (response) {
                    if (response.success) {
                        // Hiển thị thông báo chờ duyệt
                        alert('✅ ' + response.message + '\n\nHệ thống sẽ tự động chuyển hướng khi Admin duyệt đơn của bạn.');
                        
                        // Polling: Kiểm tra trạng thái đơn hàng mỗi 3 giây
                        var checkInterval = setInterval(function() {
                            $.ajax({
                                url: '@Url.Action("CheckBookingStatus", "Invoice")',
                                type: 'POST',
                                data: { bookingId: bookingId },
                                success: function(statusResponse) {
                                    if (statusResponse.status === 'Đã Thanh toán') {
                                        clearInterval(checkInterval);
                                        // Chuyển hướng đến hóa đơn
                                        window.location.href = '@Url.Action("PaymentSuccess", "Invoice")' + '?bookingId=' + bookingId + '&transactionNo=QR_APPROVED';
                                    }
                                }
                            });
                        }, 3000); // Kiểm tra mỗi 3 giây

                        // Timeout sau 10 phút nếu Admin không duyệt
                        setTimeout(function() {
                            clearInterval(checkInterval);
                        }, 600000);
                    } else {
                        alert('❌ Lỗi: ' + response.message);
                        $('button').prop('disabled', false);
                        $btn.html('<i class="fas fa-check-circle"></i> Xác Nhận Đã Thanh Toán');
                    }
                },
                error: function () {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại!');
                    $('button').prop('disabled', false);
                    $btn.html('<i class="fas fa-check-circle"></i> Xác Nhận Đã Thanh Toán');
                }
            });
        }
        
        function goBack() { 
            window.history.back(); 
        }
    </script>
}
