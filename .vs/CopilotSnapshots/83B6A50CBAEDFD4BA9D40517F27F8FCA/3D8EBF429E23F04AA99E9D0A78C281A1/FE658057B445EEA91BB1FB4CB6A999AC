using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Http;
using WebCinema.Infrastructure;
using WebCinema.Models;

namespace WebCinema.Controllers.API
{
    /// <summary>
    /// Movies API - Danh sách phim, chi tiết phim, tìm kiếm
    /// </summary>
    [RoutePrefix("api/movies")]
    public class MoviesApiController : BaseApiController
    {
        /// <summary>
        /// GET: api/movies
        /// Lấy danh sách phim (có phân trang)
        /// </summary>
        [HttpGet]
        [Route("")]
        [AllowAnonymous]
        public IHttpActionResult GetMovies(int page = 1, int pageSize = 10, string search = "")
        {
            try
            {
                var query = db.Phims.AsQueryable();

                // Tìm kiếm theo tên
                if (!string.IsNullOrEmpty(search))
                {
                    query = query.Where(p => p.ten_phim.Contains(search));
                }

                int total = query.Count();
                int totalPages = (int)Math.Ceiling(total / (double)pageSize);

                var movies = query
                    .OrderByDescending(p => p.ngay_khoi_chieu)
                    .Skip((page - 1) * pageSize)
                    .Take(pageSize)
                    .Select(p => new
                    {
                        movie_id = p.phim_id,
                        title = p.ten_phim,
                        description = p.mo_ta,
                        duration = p.thoi_luong,
                        release_date = p.ngay_khoi_chieu,
                        image = p.hinh_anh,
                        trailer_url = p.GetType().GetProperty("trailer_url")?.GetValue(p)
                    })
                    .ToList();

                return ApiResponse(true, "Lấy danh sách phim thành công", new
                {
                    movies = movies,
                    total = total,
                    current_page = page,
                    total_pages = totalPages,
                    page_size = pageSize
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/movies/{movieId}
        /// Lấy chi tiết một phim
        /// </summary>
        [HttpGet]
        [Route("{movieId}")]
        [AllowAnonymous]
        public IHttpActionResult GetMovie(int movieId)
        {
            try
            {
                var movie = db.Phims.FirstOrDefault(p => p.phim_id == movieId);
                if (movie == null)
                {
                    return ApiResponse(false, "Phim không tồn tại");
                }

                // Lấy thông tin diễn viên
                var cast = movie.Vai_Diens?.Select(v => new
                {
                    actor_id = v.Dien_Vien?.dienvien_id,
                    name = v.Dien_Vien?.ho_ten,
                    role = v.ten_vai_dien
                }).ToList();

                // Lấy thông tin đạo diễn
                var director = movie.Dao_Dien;

                var movieData = new
                {
                    movie_id = movie.phim_id,
                    title = movie.ten_phim,
                    description = movie.mo_ta,
                    duration = movie.thoi_luong,
                    release_date = movie.ngay_khoi_chieu,
                    image = movie.hinh_anh,
                    trailer_url = movie.GetType().GetProperty("trailer_url")?.GetValue(movie),
                    director = new
                    {
                        director_id = director?.dao_dien_id,
                        name = director?.ho_ten
                    },
                    cast = cast,
                    producer = new
                    {
                        producer_id = movie.Nha_San_Xuat?.nha_san_xuat_id,
                        name = movie.Nha_San_Xuat?.ten_nha_san_xuat
                    }
                };

                return ApiResponse(true, "Lấy chi tiết phim thành công", movieData);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/movies/trending
        /// Lấy phim xu hướng (phim bán chạy nhất)
        /// </summary>
        [HttpGet]
        [Route("trending")]
        [AllowAnonymous]
        public IHttpActionResult GetTrendingMovies()
        {
            try
            {
                var trendingMovies = db.Phims
                    .Select(p => new
                    {
                        movie = p,
                        booking_count = p.Suat_Chieus.SelectMany(s => s.Ves).Count(v => v.Dat_Ve_id != null)
                    })
                    .OrderByDescending(x => x.booking_count)
                    .Take(10)
                    .Select(x => new
                    {
                        movie_id = x.movie.phim_id,
                        title = x.movie.ten_phim,
                        image = x.movie.hinh_anh,
                        booking_count = x.booking_count
                    })
                    .ToList();

                return ApiResponse(true, "Lấy phim xu hướng thành công", trendingMovies);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/movies/search?keyword=...
        /// Tìm kiếm phim
        /// </summary>
        [HttpGet]
        [Route("search")]
        [AllowAnonymous]
        public IHttpActionResult SearchMovies(string keyword = "")
        {
            try
            {
                if (string.IsNullOrEmpty(keyword))
                {
                    return ApiResponse(false, "Từ khóa không được rỗng");
                }

                var results = db.Phims
                    .Where(p => p.ten_phim.Contains(keyword) || p.mo_ta.Contains(keyword))
                    .Select(p => new
                    {
                        movie_id = p.phim_id,
                        title = p.ten_phim,
                        image = p.hinh_anh,
                        release_date = p.ngay_khoi_chieu
                    })
                    .Take(20)
                    .ToList();

                return ApiResponse(true, "Tìm kiếm thành công", results);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }
    }
}
