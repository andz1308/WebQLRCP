using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Http;
using WebCinema.Infrastructure;
using WebCinema.Models;

namespace WebCinema.Controllers.API
{
    /// <summary>
    /// Cinemas API - Danh sách rạp, phòng chiếu, suất chiếu
    /// </summary>
    [RoutePrefix("api/cinemas")]
    public class CinemasApiController : BaseApiController
    {
        /// <summary>
        /// GET: api/cinemas
        /// Lấy danh sách tất cả rạp chiếu
        /// </summary>
        [HttpGet]
        [Route("")]
        [AllowAnonymous]
        public IHttpActionResult GetCinemas()
        {
            try
            {
                var cinemas = db.Raps.Select(r => new
                {
                    cinema_id = r.rap_id,
                    name = r.ten_rap,
                    address = r.dia_chi,
                    phone = r.so_dien_thoai,
                    rooms_count = r.Phong_Chieus.Count
                }).ToList();

                return ApiResponse(true, "Lấy danh sách rạp thành công", cinemas);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/cinemas/{cinemaId}
        /// Lấy chi tiết một rạp chiếu
        /// </summary>
        [HttpGet]
        [Route("{cinemaId}")]
        [AllowAnonymous]
        public IHttpActionResult GetCinema(int cinemaId)
        {
            try
            {
                var cinema = db.Raps.FirstOrDefault(r => r.rap_id == cinemaId);
                if (cinema == null)
                {
                    return ApiResponse(false, "Rạp không tồn tại");
                }

                var rooms = cinema.Phong_Chieus.Select(p => new
                {
                    room_id = p.phong_chieu_id,
                    name = p.ten_phong,
                    rows = p.so_hang,
                    columns = p.so_cot,
                    total_seats = p.Ghes.Count
                }).ToList();

                var cinemaData = new
                {
                    cinema_id = cinema.rap_id,
                    name = cinema.ten_rap,
                    address = cinema.dia_chi,
                    phone = cinema.so_dien_thoai,
                    rooms = rooms
                };

                return ApiResponse(true, "Lấy chi tiết rạp thành công", cinemaData);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/cinemas/{cinemaId}/showtimes?movieId={movieId}&date={date}
        /// Lấy danh sách suất chiếu theo rạp, phim và ngày
        /// </summary>
        [HttpGet]
        [Route("{cinemaId}/showtimes")]
        [AllowAnonymous]
        public IHttpActionResult GetShowtimes(int cinemaId, int? movieId = null, string date = "")
        {
            try
            {
                var cinema = db.Raps.FirstOrDefault(r => r.rap_id == cinemaId);
                if (cinema == null)
                {
                    return ApiResponse(false, "Rạp không tồn tại");
                }

                var query = db.Suat_Chieus
                    .Where(s => s.Phong_Chieu.rap_id == cinemaId)
                    .AsQueryable();

                // Lọc theo phim
                if (movieId.HasValue)
                {
                    query = query.Where(s => s.phim_id == movieId.Value);
                }

                // Lọc theo ngày
                if (!string.IsNullOrEmpty(date) && DateTime.TryParse(date, out DateTime filterDate))
                {
                    query = query.Where(s => s.ngay_chieu.Date == filterDate.Date);
                }

                var showtimes = query
                    .OrderBy(s => s.ngay_chieu)
                    .ThenBy(s => s.Ca_Chieu.gio_bat_dau)
                    .Select(s => new
                    {
                        showtime_id = s.suat_chieu_id,
                        movie_id = s.phim_id,
                        movie_title = s.Phim.ten_phim,
                        room_id = s.phong_chieu_id,
                        room_name = s.Phong_Chieu.ten_phong,
                        date = s.ngay_chieu.ToString("yyyy-MM-dd"),
                        start_time = s.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm"),
                        end_time = s.Ca_Chieu.gio_ket_thuc.ToString(@"hh\:mm"),
                        language = s.ngon_ngu,
                        price = s.gia_ve,
                        available_seats = s.Phong_Chieu.Ghes.Count - s.Ves.Count(v => v.Dat_Ve_id != null)
                    })
                    .ToList();

                return ApiResponse(true, "Lấy danh sách suất chiếu thành công", showtimes);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/cinemas/{cinemaId}/rooms/{roomId}/seats
        /// Lấy danh sách ghế trong phòng chiếu
        /// </summary>
        [HttpGet]
        [Route("{cinemaId}/rooms/{roomId}/seats")]
        [AllowAnonymous]
        public IHttpActionResult GetRoomSeats(int cinemaId, int roomId, int showtimeId = 0)
        {
            try
            {
                var room = db.Phong_Chieus.FirstOrDefault(p => p.phong_chieu_id == roomId && p.rap_id == cinemaId);
                if (room == null)
                {
                    return ApiResponse(false, "Phòng chiếu không tồn tại");
                }

                // Lấy ghế đã đặt (nếu có suất chiếu)
                var bookedSeats = new List<int>();
                if (showtimeId > 0)
                {
                    bookedSeats = db.Ves
                        .Where(v => v.suat_chieu_id == showtimeId && v.Dat_Ve_id != null)
                        .Select(v => v.ghe_id)
                        .ToList();
                }

                var seats = room.Ghes
                    .OrderBy(g => g.hang)
                    .ThenBy(g => g.cot)
                    .Select(g => new
                    {
                        seat_id = g.ghe_id,
                        seat_number = g.so_ghe,
                        row = g.hang,
                        column = g.cot,
                        type = g.Loai_Ghe?.ten_loai ?? "Standard",
                        status = bookedSeats.Contains(g.ghe_id) ? "booked" : (g.trang_thai == 0 ? "aisle" : "available"),
                        price = g.Loai_Ghe?.GetType().GetProperty("gia")?.GetValue(g.Loai_Ghe) ?? room.Phong_Chieu_id
                    })
                    .ToList();

                return ApiResponse(true, "Lấy danh sách ghế thành công", new
                {
                    room_id = roomId,
                    rows = room.so_hang,
                    columns = room.so_cot,
                    seats = seats
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }
    }
}
