using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Http;
using WebCinema.Infrastructure;
using WebCinema.Models;

namespace WebCinema.Controllers.API
{
    /// <summary>
    /// Foods API - Danh sách đồ ăn, chi tiết sản phẩm
    /// </summary>
    [RoutePrefix("api/foods")]
    public class FoodsApiController : BaseApiController
    {
        /// <summary>
        /// GET: api/foods
        /// Lấy danh sách tất cả đồ ăn
        /// </summary>
        [HttpGet]
        [Route("")]
        [AllowAnonymous]
        public IHttpActionResult GetFoods(int page = 1, int pageSize = 20)
        {
            try
            {
                var total = db.Do_Ans.Count();
                var totalPages = (int)Math.Ceiling(total / (double)pageSize);

                var foods = db.Do_Ans
                    .OrderBy(d => d.ten_san_pham)
                    .Skip((page - 1) * pageSize)
                    .Take(pageSize)
                    .Select(d => new
                    {
                        food_id = d.Do_An_id,
                        name = d.ten_san_pham,
                        description = d.mo_ta,
                        price = d.gia,
                        image = d.hinh_anh,
                        category = d.GetType().GetProperty("loai_do_an")?.GetValue(d) ?? "Other"
                    })
                    .ToList();

                return ApiResponse(true, "Lấy danh sách đồ ăn thành công", new
                {
                    foods = foods,
                    total = total,
                    current_page = page,
                    total_pages = totalPages,
                    page_size = pageSize
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/foods/{foodId}
        /// Lấy chi tiết một sản phẩm đồ ăn
        /// </summary>
        [HttpGet]
        [Route("{foodId}")]
        [AllowAnonymous]
        public IHttpActionResult GetFood(int foodId)
        {
            try
            {
                var food = db.Do_Ans.FirstOrDefault(d => d.Do_An_id == foodId);
                if (food == null)
                {
                    return ApiResponse(false, "Đồ ăn không tồn tại");
                }

                var foodData = new
                {
                    food_id = food.Do_An_id,
                    name = food.ten_san_pham,
                    description = food.mo_ta,
                    price = food.gia,
                    image = food.hinh_anh,
                    category = food.GetType().GetProperty("loai_do_an")?.GetValue(food),
                    in_stock = food.GetType().GetProperty("trong_kho")?.GetValue(food) ?? true
                };

                return ApiResponse(true, "Lấy chi tiết đồ ăn thành công", foodData);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/foods/popular
        /// Lấy đồ ăn bán chạy nhất
        /// </summary>
        [HttpGet]
        [Route("popular")]
        [AllowAnonymous]
        public IHttpActionResult GetPopularFoods()
        {
            try
            {
                var popular = db.Do_Ans
                    .Select(d => new
                    {
                        food = d,
                        order_count = d.DonHang_DoAns.Count()
                    })
                    .OrderByDescending(x => x.order_count)
                    .Take(10)
                    .Select(x => new
                    {
                        food_id = x.food.Do_An_id,
                        name = x.food.ten_san_pham,
                        price = x.food.gia,
                        image = x.food.hinh_anh,
                        order_count = x.order_count
                    })
                    .ToList();

                return ApiResponse(true, "Lấy đồ ăn bán chạy thành công", popular);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/foods/search?keyword=...
        /// Tìm kiếm đồ ăn
        /// </summary>
        [HttpGet]
        [Route("search")]
        [AllowAnonymous]
        public IHttpActionResult SearchFoods(string keyword = "")
        {
            try
            {
                if (string.IsNullOrEmpty(keyword))
                {
                    return ApiResponse(false, "Từ khóa không được rỗng");
                }

                var results = db.Do_Ans
                    .Where(d => d.ten_san_pham.Contains(keyword) || d.mo_ta.Contains(keyword))
                    .Select(d => new
                    {
                        food_id = d.Do_An_id,
                        name = d.ten_san_pham,
                        price = d.gia,
                        image = d.hinh_anh
                    })
                    .Take(20)
                    .ToList();

                return ApiResponse(true, "Tìm kiếm thành công", results);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }
    }
}
