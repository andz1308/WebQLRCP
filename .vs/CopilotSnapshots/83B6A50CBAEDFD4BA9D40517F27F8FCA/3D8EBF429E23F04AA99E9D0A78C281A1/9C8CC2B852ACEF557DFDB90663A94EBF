using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Http;
using WebCinema.Infrastructure;
using WebCinema.Models;

namespace WebCinema.Controllers.API
{
    /// <summary>
    /// Bookings API - Đặt vé, lịch sử đặt, chi tiết đơn
    /// </summary>
    [RoutePrefix("api/bookings")]
    public class BookingsApiController : BaseApiController
    {
        /// <summary>
        /// POST: api/bookings/create
        /// Tạo đơn đặt vé mới
        /// </summary>
        [HttpPost]
        [Route("create")]
        public IHttpActionResult CreateBooking([FromBody] dynamic bookingData)
        {
            try
            {
                int customerId = bookingData.customer_id;
                int showtimeId = bookingData.showtime_id;
                List<int> seatIds = bookingData.seat_ids.ToObject<List<int>>();
                List<dynamic> foodOrders = bookingData.food_items?.ToObject<List<dynamic>>();

                if (seatIds == null || seatIds.Count == 0)
                {
                    return ApiResponse(false, "Vui lòng chọn ít nhất 1 ghế");
                }

                var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == showtimeId);
                if (showtime == null)
                {
                    return ApiResponse(false, "Suất chiếu không tồn tại");
                }

                // Tính tổng tiền vé
                decimal ticketTotal = seatIds.Count * (showtime.gia_ve ?? 0);
                decimal foodTotal = 0m;

                // Tạo đơn đặt
                var booking = new Dat_Ve
                {
                    khach_hang_id = customerId,
                    ngay_tao = DateTime.Now,
                    trang_thai_Dat_Ve = "Chưa thanh toán",
                    tong_tien = ticketTotal
                };

                db.Dat_Ves.InsertOnSubmit(booking);
                db.SubmitChanges();

                // Tạo vé
                foreach (var seatId in seatIds)
                {
                    var ticket = new Ve
                    {
                        suat_chieu_id = showtimeId,
                        ghe_id = seatId,
                        Dat_Ve_id = booking.Dat_Ve_id,
                        gia_ve = showtime.gia_ve ?? 0,
                        trang_thai_ve = "Chưa sử dụng",
                        ma_qr_code = Guid.NewGuid().ToString()
                    };
                    db.Ves.InsertOnSubmit(ticket);
                }

                // Thêm đồ ăn nếu có
                if (foodOrders != null && foodOrders.Count > 0)
                {
                    foreach (var foodItem in foodOrders)
                    {
                        int foodId = foodItem.food_id;
                        int quantity = foodItem.quantity;

                        var food = db.Do_Ans.FirstOrDefault(d => d.Do_An_id == foodId);
                        if (food != null)
                        {
                            var foodOrder = new DonHang_DoAn
                            {
                                Dat_Ve_id = booking.Dat_Ve_id,
                                Do_An_id = foodId,
                                so_luong = quantity
                            };
                            db.DonHang_DoAns.InsertOnSubmit(foodOrder);
                            foodTotal += (food.gia ?? 0) * quantity;
                        }
                    }
                }

                booking.tong_tien = ticketTotal + foodTotal;
                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Tạo đơn đặt: Booking ID {booking.Dat_Ve_id}");

                return ApiResponse(true, "Tạo đơn đặt thành công", new
                {
                    booking_id = booking.Dat_Ve_id,
                    total_amount = booking.tong_tien,
                    status = booking.trang_thai_Dat_Ve
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/bookings/{customerId}
        /// Lấy lịch sử đặt vé của khách hàng
        /// </summary>
        [HttpGet]
        [Route("{customerId}")]
        public IHttpActionResult GetCustomerBookings(int customerId)
        {
            try
            {
                var bookings = db.Dat_Ves
                    .Where(b => b.khach_hang_id == customerId)
                    .OrderByDescending(b => b.ngay_tao)
                    .Select(b => new
                    {
                        booking_id = b.Dat_Ve_id,
                        created_at = b.ngay_tao.HasValue ? b.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                        status = b.trang_thai_Dat_Ve,
                        total_amount = b.tong_tien,
                        tickets_count = b.Ves.Count,
                        movie_title = b.Ves.FirstOrDefault().Suat_Chieu.Phim.ten_phim
                    })
                    .ToList();

                return ApiResponse(true, "Lấy lịch sử đặt vé thành công", bookings);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// GET: api/bookings/detail/{bookingId}
        /// Lấy chi tiết một đơn đặt
        /// </summary>
        [HttpGet]
        [Route("detail/{bookingId}")]
        public IHttpActionResult GetBookingDetail(int bookingId)
        {
            try
            {
                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null)
                {
                    return ApiResponse(false, "Đơn đặt không tồn tại");
                }

                var tickets = booking.Ves.Select(v => new
                {
                    ticket_id = v.ve_id,
                    seat_number = v.Ghe.so_ghe,
                    qr_code = v.ma_qr_code,
                    price = v.gia_ve,
                    status = v.trang_thai_ve
                }).ToList();

                var firstTicket = booking.Ves.FirstOrDefault();
                var showtime = firstTicket?.Suat_Chieu;

                var bookingDetail = new
                {
                    booking_id = booking.Dat_Ve_id,
                    customer_name = booking.Khach_Hang.ho_ten,
                    customer_email = booking.Khach_Hang.email,
                    customer_phone = booking.Khach_Hang.so_dien_thoai,
                    created_at = booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                    status = booking.trang_thai_Dat_Ve,
                    total_amount = booking.tong_tien,
                    movie = new
                    {
                        movie_id = showtime?.Phim.phim_id,
                        title = showtime?.Phim.ten_phim
                    },
                    showtime = new
                    {
                        showtime_id = showtime?.suat_chieu_id,
                        cinema = showtime?.Phong_Chieu.Rap.ten_rap,
                        room = showtime?.Phong_Chieu.ten_phong,
                        date = showtime?.ngay_chieu.ToString("yyyy-MM-dd"),
                        time = showtime?.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")
                    },
                    tickets = tickets,
                    food_items = booking.DonHang_DoAns.Select(f => new
                    {
                        food_name = f.Do_An.ten_san_pham,
                        quantity = f.so_luong,
                        price = f.Do_An.gia
                    }).ToList()
                };

                return ApiResponse(true, "Lấy chi tiết đơn đặt thành công", bookingDetail);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }

        /// <summary>
        /// POST: api/bookings/{bookingId}/confirm-payment
        /// Xác nhận thanh toán QR
        /// </summary>
        [HttpPost]
        [Route("{bookingId}/confirm-payment")]
        public IHttpActionResult ConfirmPayment(int bookingId)
        {
            try
            {
                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null)
                {
                    return ApiResponse(false, "Đơn đặt không tồn tại");
                }

                booking.trang_thai_Dat_Ve = "Chờ Duyệt";
                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Xác nhận thanh toán: Booking ID {bookingId}");

                return ApiResponse(true, "Xác nhận thanh toán thành công, chờ Admin duyệt");
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return ApiResponse(false, "Lỗi: " + ex.Message);
            }
        }
    }
}
