        /// <summary>
        /// GET: api/customer/movies/{movieId}/reviews
        /// Lấy đánh giá phim
        /// </summary>
        [HttpGet]
        [Route("movies/{movieId}/reviews")]
        [AllowAnonymous]
        public IHttpActionResult GetMovieReviews(int movieId, int page = 1)
        {
            try
            {
                var reviews = db.Danh_Gias
                    .Where(d => d.phim_id == movieId)
                    .OrderByDescending(d => d.ngay_danh_gia)
                    .Skip((page - 1) * 10)
                    .Take(10)
                    .Select(d => new
                    {
                        review_id = d.danh_gia_id,
                        customer_name = d.Khach_Hang.ho_ten,
                        rating = d.so_sao,
                        comment = d.noi_dung,
                        date = d.ngay_danh_gia.ToString("yyyy-MM-dd HH:mm")
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    data = reviews
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// POST: api/customer/movies/{movieId}/reviews
        /// Thêm đánh giá phim
        /// </summary>
        [HttpPost]
        [Route("movies/{movieId}/reviews")]
        [Authorize]
        public IHttpActionResult AddReview(int movieId, [FromBody] ReviewRequest request)
        {
            try
            {
                if (movieId <= 0) return BadRequest("Movie ID không hợp lệ");
                if (request?.rating < 1 || request?.rating > 5) return BadRequest("Đánh giá phải từ 1-5 sao");

                var customerId = GetUserIdFromToken();

                var review = new Danh_Gia
                {
                    phim_id = movieId,
                    khach_hang_id = customerId,
                    so_sao = request.rating,
                    noi_dung = request.comment,
                    ngay_danh_gia = DateTime.Now
                };

                db.Danh_Gias.InsertOnSubmit(review);
                db.SubmitChanges();

                return Ok(new
                {
                    success = true,
                    message = "Thêm đánh giá thành công"
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

