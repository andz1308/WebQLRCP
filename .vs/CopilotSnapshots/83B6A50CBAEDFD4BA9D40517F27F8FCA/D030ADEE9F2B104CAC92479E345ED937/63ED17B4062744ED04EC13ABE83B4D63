        /// <summary>
        /// POST: api/customer/bookings/create
        /// Tạo đơn đặt vé
        /// </summary>
        [HttpPost]
        [Route("bookings/create")]
        [Authorize]
        public IHttpActionResult CreateBooking([FromBody] CreateBookingRequest request)
        {
            try
            {
                // ✅ Validation
                if (request?.seat_ids == null || request.seat_ids.Count == 0)
                    return BadRequest("Phải chọn ít nhất 1 ghế");

                if (request.seat_ids.Count > 100)
                    return BadRequest("Không được đặt quá 100 ghế");

                if (request.showtime_id <= 0)
                    return BadRequest("Showtime ID không hợp lệ");

                var customerId = GetUserIdFromToken();
                var showtimeId = request.showtime_id;

                // ✅ Kiểm tra ghế available
                var tickets = db.Ves
                    .Where(v => request.seat_ids.Contains(v.ghe_id) && v.suat_chieu_id == showtimeId)
                    .ToList();

                var bookedSeats = tickets.Where(t => t.Dat_Ve_id != null).ToList();
                if (bookedSeats.Any())
                {
                    return Ok(new 
                    { 
                        success = false, 
                        message = $"Ghế số {string.Join(", ", bookedSeats.Select(b => b.Ghe.so_ghe))} đã được đặt" 
                    });
                }

                decimal ticketTotal = tickets.Sum(t => t.gia_ve);
                decimal foodTotal = 0;

                // ✅ Tạo Booking
                var booking = new Dat_Ve
                {
                    khach_hang_id = customerId,
                    ngay_tao = DateTime.Now,
                    trang_thai_Dat_Ve = "Chưa thanh toán",
                    tong_tien = ticketTotal
                };

                db.Dat_Ves.InsertOnSubmit(booking);
                db.SubmitChanges();

                // ✅ Update tickets
                foreach (var ticket in tickets)
                {
                    ticket.Dat_Ve_id = booking.Dat_Ve_id;
                    ticket.ma_qr_code = Guid.NewGuid().ToString();
                    ticket.trang_thai_ve = "Chưa sử dụng";
                }

                // ✅ Add food items (nếu có)
                if (request.food_items != null && request.food_items.Count > 0)
                {
                    foreach (var foodItem in request.food_items)
                    {
                        var food = db.Do_Ans.FirstOrDefault(d => d.Do_An_id == foodItem.food_id);
                        if (food != null)
                        {
                            var foodOrder = new DonHang_DoAn
                            {
                                Dat_Ve_id = booking.Dat_Ve_id,
                                Do_An_id = food.Do_An_id,
                                so_luong = foodItem.quantity
                            };
                            db.DonHang_DoAns.InsertOnSubmit(foodOrder);
                            foodTotal += (food.gia ?? 0m) * foodItem.quantity;
                        }
                    }
                }

                booking.tong_tien = ticketTotal + foodTotal;
                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Booking created: ID={booking.Dat_Ve_id}, Customer={customerId}, Total={booking.tong_tien}");

                return Ok(new
                {
                    success = true,
                    message = "Tạo đơn đặt thành công",
                    data = new
                    {
                        booking_id = booking.Dat_Ve_id,
                        total_amount = booking.tong_tien,
                        tickets_count = tickets.Count,
                        status = booking.trang_thai_Dat_Ve
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// GET: api/customer/bookings
        /// Lấy lịch sử đặt vé của khách hàng
        /// </summary>
        [HttpGet]
        [Route("bookings")]
        [Authorize]
        public IHttpActionResult GetBookings(string status = "")
        {
            try
            {
                var customerId = GetUserIdFromToken();

                var query = db.Dat_Ves
                    .Where(b => b.khach_hang_id == customerId)
                    .AsQueryable();

                if (!string.IsNullOrEmpty(status))
                {
                    query = query.Where(b => b.trang_thai_Dat_Ve == status);
                }

                var bookings = query
                    .OrderByDescending(b => b.ngay_tao)
                    .Select(b => new
                    {
                        booking_id = b.Dat_Ve_id,
                        created_at = b.ngay_tao.HasValue ? b.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                        status = b.trang_thai_Dat_Ve,
                        total_amount = b.tong_tien,
                        tickets_count = b.Ves.Count,
                        movie_title = b.Ves.Select(v => v.Suat_Chieu.Phim.ten_phim).FirstOrDefault() ?? "N/A"
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    message = "Lấy lịch sử đặt vé thành công",
                    data = bookings
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

