        /// <summary>
        /// GET: api/customer/movies?page=1&pageSize=10&search=keyword
        /// Lấy danh sách phim (có phân trang, tìm kiếm)
        /// </summary>
        [HttpGet]
        [Route("movies")]
        [AllowAnonymous]
        public IHttpActionResult GetMovies(int page = 1, int pageSize = 10, string search = "")
        {
            try
            {
                // ✅ Validation
                if (page < 1) page = 1;
                if (pageSize < 1 || pageSize > MAX_PAGE_SIZE) pageSize = DEFAULT_PAGE_SIZE;

                var query = db.Phims.AsQueryable();

                // ✅ Search filter
                if (!string.IsNullOrWhiteSpace(search))
                {
                    query = query.Where(p => p.ten_phim.Contains(search));
                }

                int total = query.Count();
                int totalPages = (int)Math.Ceiling(total / (double)pageSize);

                var movies = query
                    .OrderByDescending(p => p.ngay_khoi_chieu)
                    .Skip((page - 1) * pageSize)
                    .Take(pageSize)
                    .Select(p => new
                    {
                        movie_id = p.phim_id,
                        title = p.ten_phim,
                        description = p.mo_ta,
                        duration = p.thoi_luong,
                        release_date = p.ngay_khoi_chieu != null ? p.ngay_khoi_chieu.Value.ToString("yyyy-MM-dd") : "N/A",
                        image = p.hinh_anh,
                        trailer_url = p.trailer_link
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    message = "Lấy danh sách phim thành công",
                    data = new
                    {
                        movies = movies,
                        total = total,
                        current_page = page,
                        total_pages = totalPages,
                        page_size = pageSize
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// GET: api/customer/movies/{movieId}
        /// Lấy chi tiết phim
        /// </summary>
        [HttpGet]
        [Route("movies/{movieId}")]
        [AllowAnonymous]
        public IHttpActionResult GetMovieDetail(int movieId)
        {
            try
            {
                if (movieId <= 0) return BadRequest("Movie ID không hợp lệ");

                var movie = db.Phims.FirstOrDefault(p => p.phim_id == movieId);
                if (movie == null) return NotFound();

                var actors = db.Dien_Viens_Phim
                    .Where(dvp => dvp.phim_id == movieId)
                    .Select(dvp => new
                    {
                        actor_id = dvp.Dien_Vien.dien_vien_id,
                        name = dvp.Dien_Vien.ten_dien_vien,
                        role = dvp.vai_dien
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    data = new
                    {
                        movie_id = movie.phim_id,
                        title = movie.ten_phim,
                        description = movie.mo_ta,
                        duration = movie.thoi_luong,
                        release_date = movie.ngay_khoi_chieu?.ToString("yyyy-MM-dd"),
                        image = movie.hinh_anh,
                        trailer_url = movie.trailer_link,
                        director = movie.Dao_Dien?.ten_dao_dien,
                        producer = movie.Nha_San_Xuat?.ten_nha_san_xuat,
                        actors = actors
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

