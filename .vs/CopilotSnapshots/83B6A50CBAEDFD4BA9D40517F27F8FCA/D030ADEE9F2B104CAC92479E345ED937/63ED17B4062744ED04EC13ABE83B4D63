        /// <summary>
        /// GET: api/customer/cinemas/{cinemaId}/showtimes?movieId=1&date=2024-01-15
        /// Lấy suất chiếu theo rạp và phim
        /// </summary>
        [HttpGet]
        [Route("cinemas/{cinemaId}/showtimes")]
        [AllowAnonymous]
        public IHttpActionResult GetShowtimes(int cinemaId, int? movieId = null, string date = "")
        {
            try
            {
                if (cinemaId <= 0) return BadRequest("Cinema ID không hợp lệ");

                var query = db.Suat_Chieus
                    .Where(s => s.Phong_Chieu.rap_id == cinemaId && s.ngay_chieu >= DateTime.Now.Date)
                    .AsQueryable();

                if (movieId.HasValue && movieId > 0)
                {
                    query = query.Where(s => s.phim_id == movieId);
                }

                if (!string.IsNullOrEmpty(date) && DateTime.TryParse(date, out DateTime filterDate))
                {
                    query = query.Where(s => s.ngay_chieu.Date == filterDate.Date);
                }

                var showtimes = query
                    .OrderBy(s => s.ngay_chieu)
                    .ThenBy(s => s.Ca_Chieu.gio_bat_dau)
                    .Select(s => new
                    {
                        showtime_id = s.suat_chieu_id,
                        movie_id = s.phim_id,
                        movie_title = s.Phim.ten_phim,
                        room_id = s.Phong_Chieu.phong_chieu_id,
                        room_name = s.Phong_Chieu.ten_phong,
                        date = s.ngay_chieu.ToString("yyyy-MM-dd"),
                        start_time = s.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm"),
                        price = s.gia_ve,
                        available_seats = s.Phong_Chieu.Ghes.Count(g => g.trang_thai == 2) 
                                        - s.Ves.Count(v => v.Dat_Ve_id != null)
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    data = showtimes
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// GET: api/customer/cinemas/{cinemaId}/rooms/{roomId}/seats?showtimeId=1
        /// Lấy danh sách ghế
        /// </summary>
        [HttpGet]
        [Route("cinemas/{cinemaId}/rooms/{roomId}/seats")]
        [AllowAnonymous]
        public IHttpActionResult GetSeats(int cinemaId, int roomId, int showtimeId)
        {
            try
            {
                if (cinemaId <= 0 || roomId <= 0 || showtimeId <= 0)
                    return BadRequest("Tham số không hợp lệ");

                var room = db.Phong_Chieus.FirstOrDefault(p => p.phong_chieu_id == roomId && p.rap_id == cinemaId);
                if (room == null) return NotFound();

                var bookedSeats = db.Ves
                    .Where(v => v.suat_chieu_id == showtimeId && v.Dat_Ve_id != null)
                    .Select(v => v.ghe_id)
                    .ToList();

                var seats = room.Ghes
                    .OrderBy(g => g.hang)
                    .ThenBy(g => g.cot)
                    .Select(g => new
                    {
                        seat_id = g.ghe_id,
                        seat_number = g.so_ghe,
                        row = g.hang,
                        column = g.cot,
                        type = g.Loai_Ghe?.ten_loai_ghe ?? "Standard",
                        status = bookedSeats.Contains(g.ghe_id) ? "booked" : (g.trang_thai == 0 ? "aisle" : "available"),
                        price = db.Ves.Where(v => v.suat_chieu_id == showtimeId && v.ghe_id == g.ghe_id)
                                     .Select(v => v.gia_ve)
                                     .FirstOrDefault()
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    data = new
                    {
                        room_id = roomId,
                        room_name = room.ten_phong,
                        rows = room.so_hang,
                        columns = room.so_cot,
                        seats = seats
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

