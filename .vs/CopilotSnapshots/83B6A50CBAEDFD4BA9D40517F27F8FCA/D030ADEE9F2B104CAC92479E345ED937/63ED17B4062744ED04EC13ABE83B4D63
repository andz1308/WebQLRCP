        [HttpGet]
        [Route("bookings/{bookingId}")]
        [Authorize]
        public IHttpActionResult GetBookingDetail(int bookingId)
        {
            try
            {
                if (bookingId <= 0) return BadRequest("Booking ID không hợp lệ");

                var customerId = GetUserIdFromToken();
                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId && b.khach_hang_id == customerId);
                
                if (booking == null) return NotFound();

                var tickets = booking.Ves.Select(v => new
                {
                    ticket_id = v.ve_id,
                    seat_number = v.Ghe.so_ghe,
                    qr_code = v.ma_qr_code,
                    price = v.gia_ve,
                    status = v.trang_thai_ve
                }).ToList();

                var showtime = booking.Ves.FirstOrDefault()?.Suat_Chieu;

                return Ok(new
                {
                    success = true,
                    message = "Lấy chi tiết đơn đặt thành công",
                    data = new
                    {
                        booking_id = booking.Dat_Ve_id,
                        customer_name = booking.Khach_Hang.ho_ten,
                        customer_email = booking.Khach_Hang.email,
                        customer_phone = booking.Khach_Hang.so_dien_thoai,
                        created_at = booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                        status = booking.trang_thai_Dat_Ve,
                        total_amount = booking.tong_tien,
                        movie = new
                        {
                            movie_id = showtime?.Phim.phim_id,
                            title = showtime?.Phim.ten_phim
                        },
                        showtime = new
                        {
                            showtime_id = showtime?.suat_chieu_id,
                            cinema = showtime?.Phong_Chieu.Rap.ten_rap,
                            room = showtime?.Phong_Chieu.ten_phong,
                            date = showtime?.ngay_chieu.ToString("yyyy-MM-dd"),
                            time = showtime?.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")
                        },
                        tickets = tickets,
                        food_items = booking.DonHang_DoAns.Select(f => new
                        {
                            food_name = f.Do_An.ten_san_pham,
                            quantity = f.so_luong,
                            price = f.Do_An.gia
                        }).ToList()
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// POST: api/customer/bookings/{bookingId}/cancel
        /// Hủy đơn đặt vé
        /// </summary>
        [HttpPost]
        [Route("bookings/{bookingId}/cancel")]
        [Authorize]
        public IHttpActionResult CancelBooking(int bookingId)
        {
            try
            {
                if (bookingId <= 0) return BadRequest("Booking ID không hợp lệ");

                var customerId = GetUserIdFromToken();
                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId && b.khach_hang_id == customerId);
                
                if (booking == null) return NotFound();

                if (booking.trang_thai_Dat_Ve == "Đã Hủy")
                    return Ok(new { success = false, message = "Đơn này đã được hủy" });

                if (booking.trang_thai_Dat_Ve == "Đã Thanh toán")
                    return Ok(new { success = false, message = "Không thể hủy đơn đã thanh toán" });

                // ✅ Cancel booking
                booking.trang_thai_Dat_Ve = "Đã Hủy";

                // ✅ Release tickets
                foreach (var ticket in booking.Ves)
                {
                    ticket.Dat_Ve_id = null;
                    ticket.ma_qr_code = null;
                }

                db.SubmitChanges();

                LoggingHelper.LogInfo($"Booking cancelled: ID={bookingId}");

                return Ok(new
                {
                    success = true,
                    message = "Hủy đơn thành công"
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

