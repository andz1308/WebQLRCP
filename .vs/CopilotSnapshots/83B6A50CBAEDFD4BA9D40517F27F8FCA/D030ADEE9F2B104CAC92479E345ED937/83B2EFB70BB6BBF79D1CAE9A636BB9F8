    /// <summary>
    /// Staff API - MEGA API với tất cả chức năng của nhân viên
    /// </summary>
    [RoutePrefix("api/staff")]
    [Authorize(Roles = "Staff,Admin")]  // ✅ Chỉ Staff và Admin
    public class StaffMegaApiController : ApiController
    {
        private CSDLDataContext db = new CSDLDataContext();
        private const int MAX_SEAT_LIMIT = 100;

        #region ==================== DASHBOARD API ====================

        /// <summary>
        /// GET: api/staff/dashboard
        /// Lấy thống kê dashboard
        /// </summary>
        [HttpGet]
        [Route("dashboard")]
        public IHttpActionResult GetDashboard()
        {
            try
            {
                int totalTickets = db.Ves
                    .Where(v => v.Dat_Ve_id != null && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán")
                    .Count();

                decimal totalRevenue = db.Dat_Ves
                    .Where(b => b.trang_thai_Dat_Ve == "Đã Thanh toán")
                    .Sum(b => (decimal?)b.tong_tien) ?? 0m;

                var currentMonth = DateTime.Now.Month;
                var currentYear = DateTime.Now.Year;

                decimal monthlyRevenue = db.Dat_Ves
                    .Where(b => b.trang_thai_Dat_Ve == "Đã Thanh toán" &&
                                b.ngay_tao.HasValue &&
                                b.ngay_tao.Value.Month == currentMonth &&
                                b.ngay_tao.Value.Year == currentYear)
                    .Sum(b => (decimal?)b.tong_tien) ?? 0m;

                int monthlyBookings = db.Dat_Ves
                    .Where(b => b.trang_thai_Dat_Ve == "Đã Thanh toán" &&
                                b.ngay_tao.HasValue &&
                                b.ngay_tao.Value.Month == currentMonth &&
                                b.ngay_tao.Value.Year == currentYear)
                    .Count();

                int ticketsVerified = db.Ves
                    .Where(v => v.trang_thai_ve == "Đã sử dụng")
                    .Count();

                int ticketsPending = db.Ves
                    .Where(v => v.trang_thai_ve == "Chưa sử dụng" && v.Dat_Ve_id != null)
                    .Count();

                return Ok(new
                {
                    success = true,
                    data = new
                    {
                        total_tickets = totalTickets,
                        total_revenue = totalRevenue,
                        monthly_revenue = monthlyRevenue,
                        monthly_bookings = monthlyBookings,
                        tickets_verified = ticketsVerified,
                        tickets_pending = ticketsPending
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        #endregion

        #region ==================== SHOWTIME API ====================

        /// <summary>
        /// GET: api/staff/showtimes?date={date}
        /// Lấy danh sách suất chiếu để đặt vé offline
        /// </summary>
        [HttpGet]
        [Route("showtimes")]
        public IHttpActionResult GetShowtimesForOfflineBooking(string date = "")
        {
            try
            {
                var query = db.Suat_Chieus
                    .Where(s => s.ngay_chieu >= DateTime.Now.Date)
                    .AsQueryable();

                if (!string.IsNullOrEmpty(date) && DateTime.TryParse(date, out DateTime filterDate))
                {
                    query = query.Where(s => s.ngay_chieu.Date == filterDate.Date);
                }

                var showtimes = query
                    .OrderBy(s => s.ngay_chieu)
                    .ThenBy(s => s.Ca_Chieu.gio_bat_dau)
                    .Select(s => new
                    {
                        showtime_id = s.suat_chieu_id,
                        movie_title = s.Phim.ten_phim,
                        cinema = s.Phong_Chieu.Rap.ten_rap,
                        room = s.Phong_Chieu.ten_phong,
                        date = s.ngay_chieu.ToString("yyyy-MM-dd"),
                        start_time = s.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm"),
                        price = s.gia_ve,
                        total_seats = s.Phong_Chieu.Ghes.Count(g => g.trang_thai == 2),
                        booked_seats = s.Ves.Count(v => v.Dat_Ve_id != null),
                        available_seats = s.Phong_Chieu.Ghes.Count(g => g.trang_thai == 2) 
                                        - s.Ves.Count(v => v.Dat_Ve_id != null)
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    data = showtimes
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// GET: api/staff/showtimes/{showtimeId}/seats
        /// Lấy danh sách ghế của suất chiếu
        /// </summary>
        [HttpGet]
        [Route("showtimes/{showtimeId}/seats")]
        public IHttpActionResult GetShowtimeSeats(int showtimeId)
        {
            try
            {
                if (showtimeId <= 0) return BadRequest("Showtime ID không hợp lệ");

                var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == showtimeId);
                if (showtime == null) return NotFound();

                var bookedSeats = db.Ves
                    .Where(v => v.suat_chieu_id == showtimeId && v.Dat_Ve_id != null)
                    .Select(v => v.ghe_id)
                    .ToList();

                var seats = showtime.Phong_Chieu.Ghes
                    .OrderBy(g => g.hang)
                    .ThenBy(g => g.cot)
                    .Select(g => new
                    {
                        seat_id = g.ghe_id,
                        seat_number = g.so_ghe,
                        row = g.hang,
                        column = g.cot,
                        type = g.Loai_Ghe?.ten_loai_ghe ?? "Standard",
                        status = bookedSeats.Contains(g.ghe_id) ? "booked" : (g.trang_thai == 0 ? "aisle" : "available"),
                        price = showtime.gia_ve
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    data = new
                    {
                        showtime_id = showtimeId,
                        rows = showtime.Phong_Chieu.so_hang,
                        columns = showtime.Phong_Chieu.so_cot,
                        seats = seats
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        #endregion

        #region ==================== OFFLINE BOOKING API ====================

        /// <summary>
        /// POST: api/staff/bookings/create-offline
        /// Tạo đơn đặt vé offline
        /// </summary>
        [HttpPost]
        [Route("bookings/create-offline")]
        public IHttpActionResult CreateOfflineBooking([FromBody] OfflineBookingRequest request)
        {
            try
            {
                // ✅ Validation
                if (request?.showtime_id <= 0) return BadRequest("Showtime ID không hợp lệ");
                if (string.IsNullOrWhiteSpace(request?.customer_name)) return BadRequest("Tên khách hàng không được rỗng");
                if (string.IsNullOrWhiteSpace(request?.customer_phone) || request.customer_phone.Length < 10)
                    return BadRequest("Số điện thoại không hợp lệ");
                if (request?.seat_ids == null || request.seat_ids.Count == 0)
                    return BadRequest("Phải chọn ít nhất 1 ghế");
                if (request.seat_ids.Count > MAX_SEAT_LIMIT)
                    return BadRequest($"Không được đặt quá {MAX_SEAT_LIMIT} ghế");

                var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == request.showtime_id);
                if (showtime == null) return NotFound();

                // ✅ Check booked seats
                var bookedSeats = db.Ves
                    .Where(v => v.suat_chieu_id == request.showtime_id && v.Dat_Ve_id != null)
                    .Select(v => v.ghe_id)
                    .ToList();

                var conflictSeats = request.seat_ids.Where(s => bookedSeats.Contains(s)).ToList();
                if (conflictSeats.Any())
                    return Ok(new { success = false, message = $"Ghế {string.Join(", ", conflictSeats)} đã được đặt" });

                decimal ticketTotal = request.seat_ids.Count * showtime.gia_ve;

                // ✅ Find or create customer
                var customer = db.Khach_Hangs.FirstOrDefault(k => k.so_dien_thoai == request.customer_phone);
                if (customer == null)
                {
                    customer = new Khach_Hang
                    {
                        ho_ten = request.customer_name,
                        so_dien_thoai = request.customer_phone
                    };
                    db.Khach_Hangs.InsertOnSubmit(customer);
                    db.SubmitChanges();
                }

                // ✅ Create booking
                var booking = new Dat_Ve
                {
                    khach_hang_id = customer.khach_hang_id,
                    ngay_tao = DateTime.Now,
                    trang_thai_Dat_Ve = "Đã Thanh toán",
                    tong_tien = ticketTotal,
                    phuong_thuc_thanh_toan = request.payment_method ?? "cash"
                };

                db.Dat_Ves.InsertOnSubmit(booking);
                db.SubmitChanges();

                // ✅ Create tickets
                foreach (var seatId in request.seat_ids)
                {
                    var ticket = new Ve
                    {
                        suat_chieu_id = request.showtime_id,
                        ghe_id = seatId,
                        Dat_Ve_id = booking.Dat_Ve_id,
                        gia_ve = showtime.gia_ve,
                        trang_thai_ve = "Chưa sử dụng",
                        ma_qr_code = Guid.NewGuid().ToString()
                    };
                    db.Ves.InsertOnSubmit(ticket);
                }

                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Offline Booking: ID={booking.Dat_Ve_id}, KH={request.customer_name}, Seats={request.seat_ids.Count}");

                return Ok(new
                {
                    success = true,
                    message = "Tạo đơn đặt thành công",
                    data = new
                    {
                        booking_id = booking.Dat_Ve_id,
                        customer_id = customer.khach_hang_id,
                        total_amount = booking.tong_tien,
                        tickets_count = request.seat_ids.Count,
                        status = booking.trang_thai_Dat_Ve
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        #endregion

        #region ==================== BOOKING MANAGEMENT API ====================

        /// <summary>
        /// GET: api/staff/bookings?status={status}
        /// Lấy danh sách đơn đặt
        /// </summary>
        [HttpGet]
        [Route("bookings")]
        public IHttpActionResult GetBookings(string status = "")
        {
            try
            {
                var query = db.Dat_Ves.AsQueryable();

                if (!string.IsNullOrEmpty(status))
                {
                    query = query.Where(b => b.trang_thai_Dat_Ve == status);
                }

                var bookings = query
                    .OrderByDescending(b => b.ngay_tao)
                    .Select(b => new
                    {
                        booking_id = b.Dat_Ve_id,
                        customer_name = b.Khach_Hang.ho_ten,
                        customer_phone = b.Khach_Hang.so_dien_thoai,
                        created_at = b.ngay_tao.HasValue ? b.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                        status = b.trang_thai_Dat_Ve,
                        total_amount = b.tong_tien,
                        tickets_count = b.Ves.Count
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    data = bookings
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// GET: api/staff/bookings/{bookingId}
        /// Lấy chi tiết đơn đặt
        /// </summary>
        [HttpGet]
        [Route("bookings/{bookingId}")]
        public IHttpActionResult GetBookingDetail(int bookingId)
        {
            try
            {
                if (bookingId <= 0) return BadRequest("Booking ID không hợp lệ");

                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null) return NotFound();

                var tickets = booking.Ves.Select(v => new
                {
                    ticket_id = v.ve_id,
                    seat_number = v.Ghe.so_ghe,
                    qr_code = v.ma_qr_code,
                    price = v.gia_ve,
                    status = v.trang_thai_ve
                }).ToList();

                var showtime = booking.Ves.FirstOrDefault()?.Suat_Chieu;

                return Ok(new
                {
                    success = true,
                    data = new
                    {
                        booking_id = booking.Dat_Ve_id,
                        customer_name = booking.Khach_Hang.ho_ten,
                        customer_email = booking.Khach_Hang.email,
                        customer_phone = booking.Khach_Hang.so_dien_thoai,
                        created_at = booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                        status = booking.trang_thai_Dat_Ve,
                        total_amount = booking.tong_tien,
                        movie = new
                        {
                            movie_id = showtime?.Phim.phim_id,
                            title = showtime?.Phim.ten_phim
                        },
                        showtime = new
                        {
                            cinema = showtime?.Phong_Chieu.Rap.ten_rap,
                            room = showtime?.Phong_Chieu.ten_phong,
                            date = showtime?.ngay_chieu.ToString("yyyy-MM-dd"),
                            time = showtime?.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")
                        },
                        tickets = tickets
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// PUT: api/staff/bookings/{bookingId}/status
        /// Cập nhật trạng thái đơn đặt
        /// </summary>
        [HttpPut]
        [Route("bookings/{bookingId}/status")]
        [Authorize(Roles = "Admin")]  // Chỉ Admin
        public IHttpActionResult UpdateBookingStatus(int bookingId, [FromBody] UpdateStatusRequest request)
        {
            try
            {
                if (bookingId <= 0) return BadRequest("Booking ID không hợp lệ");
                if (string.IsNullOrWhiteSpace(request?.status)) return BadRequest("Status không được rỗng");

                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null) return NotFound();

                booking.trang_thai_Dat_Ve = request.status;
                db.SubmitChanges();

                return Ok(new
                {
                    success = true,
                    message = "Cập nhật trạng thái thành công"
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        #endregion

        #region ==================== TICKET VERIFICATION API ====================

        /// <summary>
        /// POST: api/staff/tickets/verify
        /// Soát vé (quét QR code)
        /// </summary>
        [HttpPost]
        [Route("tickets/verify")]
        public IHttpActionResult VerifyTicket([FromBody] VerifyTicketRequest request)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(request?.qr_code)) return BadRequest("Mã QR không được rỗng");

                var ticket = db.Ves.FirstOrDefault(v => v.ma_qr_code == request.qr_code.Trim());
                if (ticket == null)
                    return Ok(new { success = false, message = "Mã QR không hợp lệ" });

                if (ticket.trang_thai_ve == "Đã sử dụng")
                    return Ok(new { success = false, message = "Vé này đã được sử dụng rồi" });

                // ✅ Mark as used
                ticket.trang_thai_ve = "Đã sử dụng";
                db.SubmitChanges();

                var showtime = ticket.Suat_Chieu;
                var booking = ticket.Dat_Ve;

                LoggingHelper.LogInfo($"✅ Ticket verified: {request.qr_code}");

                return Ok(new
                {
                    success = true,
                    message = "Vé hợp lệ",
                    data = new
                    {
                        movie_title = showtime.Phim.ten_phim,
                        customer_name = booking.Khach_Hang.ho_ten,
                        seat_number = ticket.Ghe.so_ghe,
                        date = showtime.ngay_chieu.ToString("yyyy-MM-dd"),
                        time = showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// GET: api/staff/tickets/statistics
        /// Lấy thống kê vé
        /// </summary>
        [HttpGet]
        [Route("tickets/statistics")]
        public IHttpActionResult GetTicketStatistics()
        {
            try
            {
                var stats = new
                {
                    total_sold = db.Ves.Where(v => v.Dat_Ve_id != null).Count(),
                    total_used = db.Ves.Where(v => v.trang_thai_ve == "Đã sử dụng").Count(),
                    total_unused = db.Ves.Where(v => v.trang_thai_ve == "Chưa sử dụng" && v.Dat_Ve_id != null).Count(),
                    total_revenue = db.Ves
                        .Where(v => v.Dat_Ve_id != null && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán")
                        .Sum(v => (decimal?)v.gia_ve) ?? 0m
                };

                return Ok(new
                {
                    success = true,
                    data = stats
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

