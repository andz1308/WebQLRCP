using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Http;
using WebCinema.Infrastructure;
using WebCinema.Models;
using Newtonsoft.Json.Linq;

namespace WebCinema.Controllers.API
{
    /// <summary>
    /// Customer API - Khách hàng có thể xem phim, đặt vé, xem hóa đơn
    /// </summary>
    [RoutePrefix("api/customer")]
    public class CustomerApiController : ApiController
    {
        private CSDLDataContext db = new CSDLDataContext();

        /// <summary>
        /// GET: api/customer/movies
        /// Lấy danh sách phim (có phân trang)
        /// </summary>
        [HttpGet]
        [Route("movies")]
        [AllowAnonymous]
        public IHttpActionResult GetMovies(int page = 1, int pageSize = 10)
        {
            try
            {
                int total = db.Phims.Count();
                int totalPages = (int)Math.Ceiling(total / (double)pageSize);

                var movies = db.Phims
                    .OrderByDescending(p => p.ngay_khoi_chieu)
                    .Skip((page - 1) * pageSize)
                    .Take(pageSize)
                    .Select(p => new
                    {
                        movie_id = p.phim_id,
                        title = p.ten_phim,
                        description = p.mo_ta,
                        duration = p.thoi_luong,
                        release_date = p.ngay_khoi_chieu != null ? p.ngay_khoi_chieu.Value.Date : (DateTime?)null,
                        image = p.hinh_anh
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    message = "Lấy danh sách phim thành công",
                    data = new
                    {
                        movies = movies,
                        total = total,
                        current_page = page,
                        total_pages = totalPages,
                        page_size = pageSize
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Ok(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        /// <summary>
        /// GET: api/customer/showtimes/{movieId}
        /// Lấy danh sách suất chiếu của một phim
        /// </summary>
        [HttpGet]
        [Route("showtimes/{movieId}")]
        [AllowAnonymous]
        public IHttpActionResult GetShowtimes(int movieId)
        {
            try
            {
                var showtimes = db.Suat_Chieus
                    .Where(s => s.phim_id == movieId && s.ngay_chieu >= DateTime.Now.Date)
                    .OrderBy(s => s.ngay_chieu)
                    .ThenBy(s => s.Ca_Chieu.gio_bat_dau)
                    .Select(s => new
                    {
                        showtime_id = s.suat_chieu_id,
                        cinema = s.Phong_Chieu.Rap.ten_rap,
                        room = s.Phong_Chieu.ten_phong,
                        date = s.ngay_chieu.ToString("yyyy-MM-dd"),
                        start_time = s.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm"),
                        price = s.gia_ve,
                        available_seats = s.Phong_Chieu.Ghes.Count() - s.Ves.Count(v => v.Dat_Ve_id != null)
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    message = "Lấy danh sách suất chiếu thành công",
                    data = showtimes
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Ok(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        /// <summary>
        /// GET: api/customer/bookings/{customerId}
        /// Lấy lịch sử đặt vé của khách hàng
        /// </summary>
        [HttpGet]
        [Route("bookings/{customerId}")]
        public IHttpActionResult GetBookings(int customerId)
        {
            try
            {
                var bookings = db.Dat_Ves
                    .Where(b => b.khach_hang_id == customerId)
                    .OrderByDescending(b => b.ngay_tao)
                    .Select(b => new
                    {
                        booking_id = b.Dat_Ve_id,
                        created_at = b.ngay_tao.HasValue ? b.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                        status = b.trang_thai_Dat_Ve,
                        total_amount = b.tong_tien,
                        tickets_count = b.Ves.Count,
                        movie_title = b.Ves.FirstOrDefault() != null ? b.Ves.FirstOrDefault().Suat_Chieu.Phim.ten_phim : "N/A"
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    message = "Lấy lịch sử đặt vé thành công",
                    data = bookings
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Ok(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        /// <summary>
        /// GET: api/customer/booking/{bookingId}
        /// Lấy chi tiết một đơn đặt vé
        /// </summary>
        [HttpGet]
        [Route("booking/{bookingId}")]
        public IHttpActionResult GetBookingDetail(int bookingId)
        {
            try
            {
                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null)
                {
                    return Ok(new { success = false, message = "Đơn đặt không tồn tại" });
                }

                var tickets = booking.Ves.Select(v => new
                {
                    ticket_id = v.ve_id,
                    seat_number = v.Ghe.so_ghe,
                    qr_code = v.ma_qr_code,
                    price = v.gia_ve,
                    status = v.trang_thai_ve
                }).ToList();

                var firstTicket = booking.Ves.FirstOrDefault();
                var showtime = firstTicket?.Suat_Chieu;

                var bookingDetail = new
                {
                    booking_id = booking.Dat_Ve_id,
                    customer_name = booking.Khach_Hang.ho_ten,
                    customer_email = booking.Khach_Hang.email,
                    customer_phone = booking.Khach_Hang.so_dien_thoai,
                    created_at = booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("yyyy-MM-dd HH:mm") : "N/A",
                    status = booking.trang_thai_Dat_Ve,
                    total_amount = booking.tong_tien,
                    payment_method = booking.GetType().GetProperty("phuong_thuc_thanh_toan")?.GetValue(booking),
                    movie = new
                    {
                        movie_id = showtime?.Phim.phim_id,
                        title = showtime?.Phim.ten_phim
                    },
                    showtime = new
                    {
                        showtime_id = showtime?.suat_chieu_id,
                        cinema = showtime?.Phong_Chieu.Rap.ten_rap,
                        room = showtime?.Phong_Chieu.ten_phong,
                        date = showtime?.ngay_chieu.ToString("yyyy-MM-dd"),
                        time = showtime?.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")
                    },
                    tickets = tickets,
                    food_items = booking.DonHang_DoAns.Select(f => new
                    {
                        food_name = f.Do_An.ten_san_pham,
                        quantity = f.so_luong,
                        price = f.Do_An.gia
                    }).ToList()
                };

                return Ok(new
                {
                    success = true,
                    message = "Lấy chi tiết đơn đặt thành công",
                    data = bookingDetail
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Ok(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        /// <summary>
        /// GET: api/customer/foods
        /// Lấy danh sách đồ ăn
        /// </summary>
        [HttpGet]
        [Route("foods")]
        [AllowAnonymous]
        public IHttpActionResult GetFoods()
        {
            try
            {
                var foods = db.Do_Ans
                    .OrderBy(d => d.ten_san_pham)
                    .Select(d => new
                    {
                        food_id = d.Do_An_id,
                        name = d.ten_san_pham,
                        price = d.gia,
                        image = d.hinh_anh
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    message = "Lấy danh sách đồ ăn thành công",
                    data = foods
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Ok(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        /// <summary>
        /// GET: api/customer/cinemas
        /// Lấy danh sách rạp chiếu
        /// </summary>
        [HttpGet]
        [Route("cinemas")]
        [AllowAnonymous]
        public IHttpActionResult GetCinemas()
        {
            try
            {
                var cinemas = db.Raps
                    .Select(r => new
                    {
                        cinema_id = r.rap_id,
                        name = r.ten_rap,
                        address = r.dia_chi,
                        phone = r.so_dien_thoai
                    })
                    .ToList();

                return Ok(new
                {
                    success = true,
                    message = "Lấy danh sách rạp thành công",
                    data = cinemas
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Ok(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                db?.Dispose();
            }
            base.Dispose(disposing);
        }
    }
}
