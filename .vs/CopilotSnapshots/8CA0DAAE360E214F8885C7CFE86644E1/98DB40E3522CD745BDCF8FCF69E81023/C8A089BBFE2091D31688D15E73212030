        private void SaveBookingDetails(int bookingId, int showtimeId, List<int> seatIds, string foodOrders)
        {
            // Lưu vé
            foreach (var seatId in seatIds)
            {
                var existingTicket = db.Ves.FirstOrDefault(v => v.suat_chieu_id == showtimeId && v.ghe_id == seatId);
                var qrCode = Guid.NewGuid().ToString();
                if (existingTicket != null)
                {
                    existingTicket.Dat_Ve_id = bookingId;
                    existingTicket.trang_thai_ve = "Chưa sử dụng";
                    existingTicket.ma_qr_code = qrCode;
                }
                else
                {
                    // Logic tạo vé mới nếu chưa có
                }
            }

            // Lưu đồ ăn (Parse XML)
            if (!string.IsNullOrEmpty(foodOrders))
            {
                try
                {
                    var foodItems = System.Xml.Linq.XDocument.Parse(foodOrders).Descendants("item").ToList();
                    foreach (var item in foodItems)
                    {
                        int fid = int.Parse(item.Element("id")?.Value ?? "0");
                        int qty = int.Parse(item.Element("quantity")?.Value ?? "0");
                        if (fid > 0 && qty > 0)
                        {
                            db.DonHang_DoAns.InsertOnSubmit(new DonHang_DoAn { Dat_Ve_id = bookingId, Do_An_id = fid, so_luong = qty });
                        }
                    }
                }
                catch { }
            }
            db.SubmitChanges();
        }

        private void DeductStock(int bookingId, int rapId)
        {
            // Gọi Service UpdateStock
            var foodOrders = db.DonHang_DoAns.Where(d => d.Dat_Ve_id == bookingId).ToList();
            if (foodOrders.Any())
            {
                var stockItems = foodOrders.Select(x => new WebCinema.Services.StockModel { DoAnId = x.Do_An_id, SoLuong = x.so_luong }).ToList();
                var service = new WebCinema.Services.FoodService(db);
                service.UpdateStock(rapId, stockItems, false); // False = Trừ
            }
        }

        // GET: Admin/StaffOfflineBooking/TicketVerification
        // Hiển thị danh sách suất chiếu hợp lệ để soát vé
        public ActionResult TicketVerification()
        {
            try
            {
                var now = DateTime.Now;
                
                // Lấy staff hiện tại
                int? employeeId = Session["EmployeeId"] as int?;
                var staffRapId = 0;
                
                if (employeeId.HasValue)
                {
                    var staff = db.Nhan_Viens.FirstOrDefault(nv => nv.nhanvien_id == employeeId.Value);
                    if (staff != null && staff.rap_id.HasValue)
                    {
                        staffRapId = staff.rap_id.Value;
                    }
                }
                
                // Lấy tất cả suất chiếu hôm nay
                var showtimesQuery = db.Suat_Chieus
                    .Where(sc => sc.ngay_chieu.Date == now.Date)
                    .AsQueryable();
                
                // Lọc theo rạp của staff
                if (staffRapId > 0)
                {
                    showtimesQuery = showtimesQuery.Where(sc => sc.Phong_Chieu.rap_id == staffRapId);
                }
                
                var allShowtimes = showtimesQuery.ToList();
                
                // Lọc ra các suất chiếu trong khung giờ hợp lệ (30 phút trước đến 1 giờ sau giờ bắt đầu)
                var validShowtimes = allShowtimes.Where(sc =>
                {
                    DateTime showtimeStart = sc.ngay_chieu.Date.Add(sc.Ca_Chieu.gio_bat_dau);
                    DateTime allowedStartTime = showtimeStart.AddMinutes(-30);
                    DateTime allowedEndTime = showtimeStart.AddHours(1);
                    
                    return now >= allowedStartTime && now <= allowedEndTime;
                })
                .OrderBy(sc => sc.Ca_Chieu.gio_bat_dau)
                .ToList();
                
                // Tính số vé đã soát và tổng vé cho mỗi suất
                var showtimeStats = validShowtimes.Select(sc => new
                {
                    Showtime = sc,
                    TotalTickets = db.Ves.Count(v => v.suat_chieu_id == sc.suat_chieu_id 
                                                    && v.Dat_Ve_id != null 
                                                    && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán"),
                    VerifiedTickets = db.Ves.Count(v => v.suat_chieu_id == sc.suat_chieu_id 
                                                        && v.trang_thai_ve == "Đã sử dụng")
                }).ToList();
                
                ViewBag.ShowtimeStats = showtimeStats;
                ViewBag.CurrentTime = now;
                
                return View(showtimeStats);
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                TempData["ErrorMessage"] = "Có lỗi xảy ra: " + ex.Message;
                return View(new List<object>());
            }
        }

        // GET: Admin/StaffOfflineBooking/VerifyTicketForShowtime/{showtimeId}
        // Trang soát vé cho một suất chiếu cụ thể
        public ActionResult VerifyTicketForShowtime(int id)
        {
            try
            {
                var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == id);
                if (showtime == null)
                    return HttpNotFound();
                
                // Kiểm tra quyền
                int? employeeId = Session["EmployeeId"] as int?;
                if (employeeId.HasValue)
                {
                    var staff = db.Nhan_Viens.FirstOrDefault(nv => nv.nhanvien_id == employeeId.Value);
                    if (staff != null && staff.rap_id.HasValue)
                    {
                        if (showtime.Phong_Chieu.rap_id != staff.rap_id.Value)
                        {
                            TempData["ErrorMessage"] = "Bạn không có quyền soát vé của rạp khác";
                            return RedirectToAction("TicketVerification");
                        }
                    }
                }
                
                // Kiểm tra thời gian hợp lệ
                DateTime now = DateTime.Now;
                DateTime showtimeStart = showtime.ngay_chieu.Date.Add(showtime.Ca_Chieu.gio_bat_dau);
                DateTime allowedStartTime = showtimeStart.AddMinutes(-30);
                DateTime allowedEndTime = showtimeStart.AddHours(1);
                
                if (now < allowedStartTime || now > allowedEndTime)
                {
                    TempData["ErrorMessage"] = "Suất chiếu này không trong khung giờ soát vé hợp lệ";
                    return RedirectToAction("TicketVerification");
                }
                
                // Lấy thống kê vé
                var totalTickets = db.Ves.Count(v => v.suat_chieu_id == id 
                                                    && v.Dat_Ve_id != null 
                                                    && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán");
                var verifiedTickets = db.Ves.Count(v => v.suat_chieu_id == id 
                                                        && v.trang_thai_ve == "Đã sử dụng");
                
                ViewBag.ShowtimeId = id;
                ViewBag.MovieName = showtime.Phim.ten_phim;
                ViewBag.ShowDate = showtime.ngay_chieu.ToString("dd/MM/yyyy");
                ViewBag.ShowTime = showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm");
                ViewBag.RoomName = showtime.Phong_Chieu.ten_phong;
                ViewBag.CinemaName = showtime.Phong_Chieu.Rap.ten_rap;
                ViewBag.TotalTickets = totalTickets;
                ViewBag.VerifiedTickets = verifiedTickets;
                ViewBag.AllowedStartTime = allowedStartTime;
                ViewBag.AllowedEndTime = allowedEndTime;
                
                return View();
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                TempData["ErrorMessage"] = "Có lỗi xảy ra: " + ex.Message;
                return RedirectToAction("TicketVerification");
            }
        }

        // POST: Admin/StaffOfflineBooking/VerifyTicket
        [HttpPost]
        public ActionResult VerifyTicket(string qrCode, int? showtimeId)
        {
            try
            {
                if (string.IsNullOrEmpty(qrCode))
                    return Json(new { success = false, message = "Vui lòng nhập mã QR" });

                var ticket = db.Ves.FirstOrDefault(v => v.ma_qr_code == qrCode.Trim());
                if (ticket == null)
                    return Json(new { success = false, message = "Mã QR không tồn tại" });

                var showtime = ticket.Suat_Chieu;
                var booking = ticket.Dat_Ve;
                var seat = ticket.Ghe;
                var movie = showtime.Phim;
                var room = showtime.Phong_Chieu;

                // ✅ KIỂM TRA: Nếu có showtimeId thì vé phải thuộc suất chiếu đó
                if (showtimeId.HasValue && ticket.suat_chieu_id != showtimeId.Value)
                {
                    return Json(new { success = false, message = "❌ Vé này không thuộc suất chiếu đang soát" });
                }

                // ✅ KIỂM TRA QUYỀN: Staff chỉ soát vé của rạp mình
                int? employeeId = Session["EmployeeId"] as int?;
                if (employeeId.HasValue)
                {
                    var staff = db.Nhan_Viens.FirstOrDefault(nv => nv.nhanvien_id == employeeId.Value);
                    if (staff != null && staff.rap_id.HasValue)
                    {
                        // Staff có gán rạp → chỉ soát vé của rạp đó
                        if (showtime.Phong_Chieu.rap_id != staff.rap_id.Value)
                        {
                            return Json(new { success = false, message = "❌ Bạn không có quyền soát vé này. Vé này thuộc rạp khác." });
                        }
                    }
                    // Nếu staff không có gán rạp (là Admin) → cho soát tất cả
                }

                // ✅ KIỂM TRA THỜI GIAN SUẤT CHIẾU
                DateTime now = DateTime.Now;
                DateTime showtimeDate = showtime.ngay_chieu.Date;
                TimeSpan startTime = showtime.Ca_Chieu.gio_bat_dau;
                
                // Tính thời gian bắt đầu suất chiếu
                DateTime showtimeStart = showtimeDate.Add(startTime);
                
                // Cho phép soát vé từ 30 phút trước giờ chiếu
                DateTime allowedStartTime = showtimeStart.AddMinutes(-30);
                
                // Cho phép soát vé đến 1 giờ sau giờ chiếu bắt đầu
                DateTime allowedEndTime = showtimeStart.AddHours(1);
                
                // ✅ Kiểm tra: Suất chiếu đã qua (quá 1 giờ sau giờ bắt đầu)
                if (now > allowedEndTime)
                {
                    return Json(new { 
                        success = false, 
                        message = $"❌ Đã quá thời gian soát vé. Chỉ được soát đến {allowedEndTime:dd/MM/yyyy HH:mm}." 
                    });
                }
                
                // ✅ Kiểm tra: Chưa đến giờ soát vé (trước 30 phút)
                if (now < allowedStartTime)
                {
                    return Json(new { 
                        success = false, 
                        message = $"❌ Chưa đến giờ soát vé. Vui lòng quay lại sau {allowedStartTime:dd/MM/yyyy HH:mm} (30 phút trước giờ chiếu)." 
                    });
                }

                // ✅ Kiểm tra trạng thái vé
                if (ticket.trang_thai_ve == "Đã sử dụng")
                    return Json(new { success = false, message = "⚠️ Vé này đã được sử dụng rồi" });

                // ✅ Kiểm tra đơn đặt đã thanh toán
                if (booking == null || booking.trang_thai_Dat_Ve != "Đã Thanh toán")
                    return Json(new { success = false, message = "⚠️ Vé này chưa được thanh toán" });

                // ✅ Cập nhật trạng thái vé thành "Đã sử dụng"
                ticket.trang_thai_ve = "Đã sử dụng";
                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Soát vé: {qrCode} | Rạp: {room.Rap.ten_rap} | Thời gian: {now:dd/MM/yyyy HH:mm}");

                return Json(new
                {
                    success = true,
                    message = "✅ Vé hợp lệ",
                    data = new
                    {
                        movieName = movie.ten_phim,
                        customerName = booking.Khach_Hang != null ? booking.Khach_Hang.ho_ten : "Khách lẻ",
                        customerPhone = booking.Khach_Hang != null ? booking.Khach_Hang.so_dien_thoai : "N/A",
                        showDate = showtime.ngay_chieu.ToString("dd/MM/yyyy"),
                        showTime = showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm"),
                        roomName = room.ten_phong,
                        seatNumber = seat.so_ghe,
                        ticketPrice = ticket.gia_ve,
                        ticketStatus = ticket.trang_thai_ve,
                        qrCode = qrCode,
                        verifiedAt = now.ToString("dd/MM/yyyy HH:mm:ss")
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "❌ Lỗi: " + ex.Message });
            }
        }

        // POST: Admin/StaffOfflineBooking/CheckSeatStatus
        [HttpPost]
        public ActionResult CheckSeatStatus(int showtimeId)
        {
            try
            {
                var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == showtimeId);
                if (showtime == null)
                    return Json(new { success = false, message = "Suất chiếu không tồn tại" });

                // Only report seats that are actually paid
                var bookedSeats = showtime.Ves
                    .Where(v => v.Dat_Ve_id != null && v.Dat_Ve != null && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán")
                    .Select(v => new { v.ghe_id, so_ghe = v.Ghe.so_ghe })
                    .ToList();

                var totalSeats = showtime.Phong_Chieu.Ghes.Count();
                var availableSeats = totalSeats - bookedSeats.Count();

                return Json(new
                {
                    success = true,
                    totalSeats = totalSeats,
                    bookedSeats = bookedSeats,
                    availableSeats = availableSeats,
                    occupancyRate = Math.Round((double)bookedSeats.Count() / (totalSeats == 0 ? 1 : totalSeats) * 100, 2)
                });
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

