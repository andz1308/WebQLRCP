@model IEnumerable<WebCinema.Models.StaffInventoryViewModel>

@{
    ViewBag.Title = "Quản Lý Kho Hàng";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

<div class="content-header">
    <h1><i class="fas fa-warehouse"></i> Quản Lý Kho Hàng (Tại Rạp)</h1>
    <div class="header-actions">
        <a href="@Url.Action("Create", "StaffPurchaseOrder", new { area = "Admin" })" class="btn btn-primary">
            <i class="fas fa-file-import"></i> Nhập Hàng Mới
        </a>
    </div>
</div>

<div class="content-card" style="margin-bottom: 2rem;">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-filter"></i> Bộ Lọc</h2>
    </div>
    <div style="padding: 1.5rem;">
        @using (Html.BeginForm("Index", "StaffInventoryManagement", FormMethod.Get))
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 1rem; align-items: end;">
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tên món ăn..." value="@ViewBag.SearchTerm" />
                </div>
                
                <div class="form-group" style="margin: 0;">
                    <label class="form-label">
                        <i class="fas fa-tags"></i> Loại sản phẩm
                    </label>
                    <select name="category" class="form-control">
                        <option value="">-- Tất cả loại --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat" @(ViewBag.SelectedCategory == cat ? "selected" : "")>@cat</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group" style="margin: 0;">
                    <label class="form-label">
                        <i class="fas fa-layer-group"></i> Mức tồn kho
                    </label>
                    <select name="stockLevel" class="form-control">
                        <option value="">-- Tất cả mức --</option>
                        <option value="Out" @(ViewBag.SelectedStockLevel == "Out" ? "selected" : "")>🔴 Hết hàng (0)</option>
                        <option value="Low" @(ViewBag.SelectedStockLevel == "Low" ? "selected" : "")>🟡 Sắp hết (1-19)</option>
                        <option value="Normal" @(ViewBag.SelectedStockLevel == "Normal" ? "selected" : "")>🟢 Vừa (20-49)</option>
                        <option value="High" @(ViewBag.SelectedStockLevel == "High" ? "selected" : "")>🔵 Dư thừa (≥50)</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Lọc
                </button>
            </div>
        }
    </div>
</div>

<!-- ✅ Thống Kê Tồn Kho -->
<div class="stock-summary-grid" style="margin-bottom: 2rem;">
    <div class="stock-summary-card out-stock">
        <div class="stock-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <div class="stock-info">
            <div class="stock-number">@ViewBag.OutOfStock</div>
            <div class="stock-label">Hết hàng</div>
        </div>
    </div>
    
    <div class="stock-summary-card low-stock">
        <div class="stock-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="stock-info">
            <div class="stock-number">@ViewBag.LowStock</div>
            <div class="stock-label">Sắp hết</div>
        </div>
    </div>
    
    <div class="stock-summary-card normal-stock">
        <div class="stock-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stock-info">
            <div class="stock-number">@ViewBag.NormalStock</div>
            <div class="stock-label">Vừa đủ</div>
        </div>
    </div>
    
    <div class="stock-summary-card high-stock">
        <div class="stock-icon">
            <i class="fas fa-boxes"></i>
        </div>
        <div class="stock-info">
            <div class="stock-number">@ViewBag.HighStock</div>
            <div class="stock-label">Dư thừa</div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-boxes"></i> Danh Sách Tồn Kho</h2>
        <span class="badge badge-info">Tổng: @Model.Count() mặt hàng</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Loại</th>
                    <th>Giá Bán</th>
                    <th style="text-align: center;">Tồn Kho</th>
                    <th>Trạng Thái</th>
                    <th style="width: 120px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Do_An_id</strong></td>
                        <td>
                            <strong style="color: #333; font-size: 1.1rem;">@item.TenSanPham</strong>
                            @if (!string.IsNullOrEmpty(item.MoTa))
                            {
                                <div style="color: #888; font-size: 0.85rem; margin-top: 4px;">
                                    @(item.MoTa.Length > 40 ? item.MoTa.Substring(0, 40) + "..." : item.MoTa)
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge badge-secondary">@(item.Loai ?? "Khác")</span>
                        </td>
                        <td>
                            @if (item.Gia.HasValue)
                            {
                                <strong style="color: #27ae60;">@item.Gia.Value.ToString("N0") đ</strong>
                            }
                            else
                            {
                                <span style="color: #999;">-</span>
                            }
                        </td>

                        <td style="text-align: center;">
                            @if (item.SoLuongTon <= 0)
                            {
                                <span class="badge badge-danger">Hết hàng</span>
                            }
                            else if (item.SoLuongTon < 20)
                            {
                                <span class="badge badge-warning" style="color: #000;">Sắp hết: @item.SoLuongTon</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Sẵn có: @item.SoLuongTon</span>
                            }
                        </td>

                        <td>
                            @if (item.TrangThai == "Ngừng kinh doanh")
                            {
                                <span style="color: red; font-size: 0.8rem;"><i class="fas fa-ban"></i> Ngừng bán</span>
                            }
                            else
                            {
                                <span style="color: green; font-size: 0.8rem;"><i class="fas fa-check-circle"></i> Đang bán</span>
                            }
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a href="@Url.Action("Details", new { id = item.Do_An_id })" class="btn btn-sm btn-info" title="Chi tiết">
                                    <i class="fas fa-chart-line"></i>
                                </a>
                                <a href="@Url.Action("Create", "StaffPurchaseOrder", new { area = "Admin", autoSelectId = item.Do_An_id })" class="btn btn-sm btn-primary" title="Nhập hàng này">
                                    <i class="fas fa-plus"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 3rem; color: #999;">
            <i class="fas fa-box-open" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5;"></i>
            <p style="font-size: 1.1rem;">Không có dữ liệu tồn kho nào.</p>
        </div>
    }
</div>

<script>
    function autoImport() {
        var limit = document.getElementById('txtImportLimit').value;
        if(!limit || limit < 0) { alert('Số lượng không hợp lệ'); return; }

        var url = '@Url.Action("Create", "StaffPurchaseOrder", new { area = "Admin" })' + '?autoMode=LowStock&threshold=' + limit;
        window.location.href = url;
    }

    function autoPromo() {
        var minStock = document.getElementById('txtPromoStock').value;
        var maxSold = document.getElementById('txtPromoSold').value;

        var url = '@Url.Action("Create", "StaffPromotion", new { area = "Admin" })' +
                  '?autoMode=SlowStock&minStock=' + minStock + '&maxSold=' + maxSold;
        window.location.href = url;
    }
    // 1. Tự động Nhập Hàng (Lấy món <= threshold)
    function autoImport() {
        var val = $('#txtAutoThreshold').val();
        if (!val || val < 0) { alert('Vui lòng nhập số lượng hợp lệ'); return; }

        // Gọi Controller Nhập Hàng
        var url = '@Url.Action("Create", "StaffPurchaseOrder", new { area = "Admin" })' +
                  '?autoMode=LowStock&threshold=' + val;
        window.location.href = url;
    }

    // 2. Tự động Khuyến Mãi (Lấy món >= threshold)
    function autoPromo() {
        var val = $('#txtAutoThreshold').val();
        if (!val || val < 0) { alert('Vui lòng nhập số lượng hợp lệ'); return; }

        // Gọi Controller Khuyến Mãi (Bỏ tham số maxSold, chỉ dùng minStock)
        var url = '@Url.Action("Create", "StaffPromotion", new { area = "Admin" })' +
                  '?autoMode=SlowStock&minStock=' + val;
        window.location.href = url;
    }
</script>

<style>
    /* ... (Giữ nguyên các style cũ của bạn) ... */

    /* Style cho input group */
    .input-group {
        display: flex;
        width: 100%;
    }

    .input-group-prepend .input-group-text {
        border-radius: 6px 0 0 6px;
        border: 1px solid #ced4da;
        padding: 0.6rem;
        background-color: #e9ecef;
    }

    .input-group .form-control {
        border-radius: 0;
        flex: 1;
    }

    .input-group-append .btn {
        border-radius: 0 6px 6px 0;
        padding: 0.6rem 1rem;
    }

    /* Thống kê tồn kho */
    .stock-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 1rem;
    }

    .stock-summary-card {
        background: white;
        padding: 1rem;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        transition: transform 0.3s;
    }

    .stock-summary-card:hover {
        transform: translateY(-4px);
    }

    .stock-icon {
        font-size: 2rem;
        margin-right: 1rem;
        flex-shrink: 0;
    }

    .stock-info {
        flex-grow: 1;
    }

    .stock-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
    }

    .stock-label {
        font-size: 0.875rem;
        color: #666;
    }

    /* Đỏ - Cam - Xanh lá cây cho các mức độ tồn kho */
    .stock-summary-card.out-stock {
        background-color: #f8d7da;
        color: #721c24;
    }

    .stock-summary-card.low-stock {
        background-color: #fff3cd;
        color: #856404;
    }

    .stock-summary-card.normal-stock {
        background-color: #d4edda;
        color: #155724;
    }

    .stock-summary-card.high-stock {
        background-color: #cce5ff;
        color: #004085;
    }
</style>

<style>
    .badge-danger {
        background-color: #dc3545;
        color: white;
    }

    .badge-warning {
        background-color: #ffc107;
        color: #212529;
    }

    .badge-success {
        background-color: #28a745;
        color: white;
    }

    .badge-secondary {
        background-color: #6c757d;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
    }

    .badge-info {
        background-color: #17a2b8;
        color: white;
        padding: 5px 10px;
        border-radius: 15px;
    }
</style>

