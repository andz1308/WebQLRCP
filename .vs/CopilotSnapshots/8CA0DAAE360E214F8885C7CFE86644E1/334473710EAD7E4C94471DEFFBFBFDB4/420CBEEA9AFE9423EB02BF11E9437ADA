@model WebCinema.Models.Phong_Chieu

@{
    ViewBag.Title = "Chọn Ghế";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";

    var bookedCsv = ViewBag.BookedSeats as string;
    var bookedList = !string.IsNullOrEmpty(bookedCsv) ? bookedCsv.Split(',').Select(int.Parse).ToList() : new List<int>();
    var seatPrice = ViewBag.TicketPrice != null ? (decimal)ViewBag.TicketPrice : 0m;
    var seats = Model.Ghes.OrderBy(g => g.hang).ThenBy(g => g.cot).ToList();
}

<style>
    /* CSS cũ giữ nguyên */
    .seat-selection { max-width: 1200px; margin: 2rem auto; padding: 0 2rem; }
    .screen-area { text-align:center; margin-bottom: 1.5rem; }
    .screen { background: linear-gradient(180deg,#2c3e50 0%,#34495e 100%); color:white; padding:10px 60px; border-radius:0 0 50% 50%; display:inline-block; font-weight:bold; }
    .seat-map { display: grid; grid-template-columns: repeat(@Model.so_cot, 45px); gap:8px; justify-content:center; margin-bottom:2rem; }
    .seat { width:45px; height:45px; border-radius:8px 8px 0 0; display:flex; align-items:center; justify-content:center; font-size:0.9rem; font-weight:bold; cursor:pointer; position:relative; box-shadow:0 2px 5px rgba(0,0,0,0.15); line-height:1; padding:0; border:none; overflow:hidden; text-align:center; vertical-align:middle; z-index:1; }
    .seat::before { content: ""; position:absolute; bottom:-2px; left:15%; right:15%; height:2px; background:inherit; filter:brightness(0.8); border-radius:0 0 2px 2px; pointer-events:none; z-index:0; }
    .seat-label { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); font-weight:700; line-height:1; pointer-events:none; z-index:2; }
    .seat.available { background: linear-gradient(135deg,#3498db 0%,#2980b9 100%); color:white; }
    .seat.available:hover { transform:translateY(-5px) scale(1.05); box-shadow:0 8px 15px rgba(52,152,219,0.4); }
    .seat.selected { background: linear-gradient(135deg,#ff6b35 0%,#ff8555 100%); color:white; transform:translateY(-3px); }
    .seat.booked { background:#7f8c8d !important; color:#bdc3c7 !important; cursor:not-allowed !important; opacity:0.5; pointer-events:none; }
    .seat.vip { background: linear-gradient(135deg,#e74c3c 0%,#c0392b 100%); color:white; }
    .seat.selected.vip { background: linear-gradient(135deg,#ff6b35 0%,#ff8555 100%); }
    .seat.couple { background: linear-gradient(135deg,#e83e8c 0%,#d6296d 100%); color:white; width:95px; }
    .seat.aisle { background:transparent; box-shadow:none; cursor:default; }
    .seat.aisle::before { display:none; }
    .legend { display:flex; justify-content:center; gap:2rem; margin-bottom:1rem; padding:1rem; background:#f8f9fa; border-radius:8px; }
    .legend-item { display:flex; align-items:center; gap:0.5rem; }
    .legend-seat { width:30px; height:30px; border-radius:8px 8px 0 0; display:inline-block; }
    .legend-seat.available { background: linear-gradient(135deg,#3498db 0%,#2980b9 100%); }
    .legend-seat.selected { background: linear-gradient(135deg,#ff6b35 0%,#ff8555 100%); }
    .legend-seat.booked { background:#95a5a6; }
    .summary { display:flex; justify-content:space-between; align-items:center; padding:1rem; background:white; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
    .summary .info { display:flex; gap:2rem; }
    .summary .total { font-size:1.4rem; font-weight:700; color:#ff6b35; }
    .payment-option input:checked + .option-box { border-color: #27ae60 !important; background-color: #eafaf1; color: #27ae60; box-shadow: 0 2px 8px rgba(39, 174, 96, 0.2); }
    /* Tối ưu thanh chọn khuyến mãi: làm cả cụm có thể click, căn chiều cao nút */
    #promoPicker { cursor: pointer; }
    #promoPicker .form-control[readonly] { background-color: #fff; }
    #promoPicker .btn { height: calc(1.5em + .75rem + 2px); }
    #promoDescDisplay { cursor: pointer; }

    /* ===== CSS MODAL KHUYẾN MÃI MỚI - THIẾT KẾ ĐẸP ===== */
    
    /* Modal Backdrop */
    #promoListModal.modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1050;
        display: none;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(3px);
        animation: fadeIn 0.3s ease;
    }
    
    #promoListModal.show {
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    /* Modal Dialog */
    #promoListModal .modal-dialog {
        margin: 1.5rem auto;
        max-width: 600px;
        width: 90%;
        animation: slideDown 0.4s ease;
    }

    /* Modal Content */
    #promoListModal .modal-content {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        border: none;
        background: #ffffff;
    }

    /* Modal Header - Gradient đẹp */
    #promoListModal .modal-header {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 50%, #f39c12 100%);
        color: white;
        padding: 1.5rem;
        border-bottom: none;
        position: relative;
        overflow: hidden;
    }

    #promoListModal .modal-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: shimmer 3s infinite;
    }

    #promoListModal .modal-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        position: relative;
        z-index: 1;
    }

    #promoListModal .modal-title::before {
        content: '🎫';
        font-size: 1.8rem;
    }

    #promoListModal .close {
        color: white;
        opacity: 1;
        font-size: 2rem;
        font-weight: 300;
        text-shadow: none;
        transition: transform 0.3s ease;
        position: relative;
        z-index: 1;
    }

    #promoListModal .close:hover {
        transform: rotate(90deg) scale(1.2);
        opacity: 1;
    }

    /* Modal Body */
    #promoListModal .modal-body {
        padding: 0;
        max-height: 500px;
        overflow-y: auto;
        background: #f8f9fa;
    }

    /* Custom Scrollbar */
    #promoListModal .modal-body::-webkit-scrollbar {
        width: 8px;
    }

    #promoListModal .modal-body::-webkit-scrollbar-track {
        background: #e9ecef;
    }

    #promoListModal .modal-body::-webkit-scrollbar-thumb {
        background: linear-gradient(135deg, #f39c12, #f1c40f);
        border-radius: 10px;
    }

    #promoListModal .modal-body::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(135deg, #e67e22, #f39c12);
    }

    /* Loading State */
    #promoListLoading {
        padding: 3rem 2rem !important;
        background: linear-gradient(135deg, #fff8e1 0%, #fffaf0 100%);
        animation: pulse 1.5s ease-in-out infinite;
    }

    #promoListLoading i {
        font-size: 2.5rem;
        color: #f39c12;
        margin-bottom: 0.5rem;
    }

    /* Empty State */
    #promoListEmpty {
        padding: 3rem 2rem !important;
        background: linear-gradient(135deg, #ecf0f1 0%, #f8f9fa 100%);
    }

    #promoListEmpty::before {
        content: '📭';
        display: block;
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    /* Promo Item Card */
    #promoListContainer .promo-item {
        border: none;
        border-bottom: 1px solid #e9ecef;
        padding: 1.25rem 1.5rem;
        transition: all 0.3s ease;
        background: white;
        position: relative;
        overflow: hidden;
    }

    #promoListContainer .promo-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 4px;
        background: linear-gradient(180deg, #f39c12, #f1c40f);
        transform: scaleY(0);
        transition: transform 0.3s ease;
    }

    #promoListContainer .promo-item:hover {
        background: linear-gradient(135deg, #fffbf0 0%, #fff8e1 100%);
        transform: translateX(5px);
        box-shadow: 0 4px 12px rgba(243, 156, 18, 0.15);
    }

    #promoListContainer .promo-item:hover::before {
        transform: scaleY(1);
    }

    #promoListContainer .promo-item:active {
        transform: translateX(3px) scale(0.98);
    }

    /* Promo Code Title */
    #promoListContainer .promo-item h5 {
        font-size: 1.3rem;
        font-weight: 800;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    /* Badge Discount */
    #promoListContainer .promo-item .badge-warning {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        font-size: 1.1rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 700;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
    }

    /* Promo Description */
    #promoListContainer .promo-item p {
        color: #666;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }

    /* Scope Badge */
    #promoListContainer .promo-item .badge-info {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        padding: 0.3rem 0.8rem;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    #promoListContainer .promo-item .badge-secondary {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
        padding: 0.3rem 0.8rem;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    /* Remaining Count */
    #promoListContainer .promo-item small {
        color: #e67e22;
        font-weight: 600;
    }

    /* Animations */
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shimmer {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        #promoListModal .modal-dialog {
            max-width: 95%;
            margin: 1rem auto;
        }

        #promoListModal .modal-title {
            font-size: 1.2rem;
        }

        #promoListContainer .promo-item {
            padding: 1rem;
        }

        #promoListContainer .promo-item h5 {
            font-size: 1.1rem;
        }

        #promoListContainer .promo-item .badge-warning {
            font-size: 0.95rem;
            padding: 0.4rem 0.8rem;
        }

        .seat-map { grid-template-columns: repeat(@Model.so_cot, 35px); gap:5px; }
        .seat { width:35px; height:35px; }
    }
</style>

<div class="seat-selection">
    <div class="screen-area"><div class="screen">MÀN HÌNH</div></div>
    <div class="legend">
        <div class="legend-item"><span class="legend-seat available"></span><span>Ghế trống</span></div>
        <div class="legend-item"><span class="legend-seat selected"></span><span>Ghế đang chọn</span></div>
        <div class="legend-item"><span class="legend-seat booked"></span><span>Ghế đã đặt</span></div>
    </div>

    <div class="seat-map" id="seatMap">
        @foreach (var seat in seats)
        {
            var isAisle = seat.trang_thai == 0;
            var isBooked = bookedList.Contains(seat.ghe_id);
            var classes = isAisle ? "seat aisle" : isBooked ? "seat booked" : "seat available";
            if (!isAisle && !isBooked && seat.loai_ghe_id == 2) { classes += " vip"; }

            <div class="@classes" data-seat-id="@seat.ghe_id" data-seat-name="@seat.so_ghe"
                 data-seat-price="@seatPrice" data-aisle="@(isAisle ? "true" : "false")"
                 data-booked="@(isBooked ? "true" : "false")">
                @if (!isAisle)
                {<span class="seat-label">@seat.so_ghe</span>}
            </div>
        }
    </div>

    <div style="display:grid; grid-template-columns: 1fr 400px; gap:2rem; margin-top: 2rem;">
        <!-- COLUMN 1: Form nhập liệu -->
        <div>
            <div style="background:white; padding:1rem; border-radius:8px; margin-bottom:1rem;">
                <h3 style="margin:0 0 0.5rem 0;">Thông tin khách hàng</h3>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
                    <input type="text" id="customerName" placeholder="Tên khách hàng" style="padding:0.6rem; border:1px solid #ddd; border-radius:6px;" />
                    <input type="tel" id="customerPhone" placeholder="Số điện thoại" style="padding:0.6rem; border:1px solid #ddd; border-radius:6px;" />
                </div>
            </div>

            <div style="background: white; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
                <h3 style="margin:0 0 0.5rem 0;">Đặt đồ ăn</h3>
                <div id="foodList" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:0.75rem;">
                    @if (ViewBag.Foods != null)
                    {
                        var foodList = ViewBag.Foods as List<WebCinema.Models.FoodBookingViewModel>;
                        if (foodList != null && foodList.Any())
                        {
                            foreach (var item in foodList)
                            {
                                var food = item.Food;
                                var maxQty = item.MaxStock;
                                <div style="border:1px solid #eee; padding:0.6rem; border-radius:6px; background:#fafafa;">
                                    <div style="font-weight:600;">@food.ten_san_pham</div>
                                    <div style="display:flex; justify-content:space-between; font-size:0.85rem; margin-bottom:0.5rem;">
                                        <span style="color:#27ae60; font-weight:600;">@((food.gia ?? 0).ToString("N0")) ₫</span>
                                        <span style="color:#e67e22;">(Kho: @maxQty)</span>
                                    </div>
                                    <div style="display:flex; gap:0.5rem; align-items:center;">
                                        <button type="button" class="btn-food-qty" onclick="changeFoodQty(this, -1)">-</button>
                                        <input type="number" class="food-quantity" data-food-id="@food.Do_An_id" data-food-name="@food.ten_san_pham" data-food-price="@(food.gia ?? 0)" data-max="@maxQty" value="0" min="0" readonly style="width:50px; text-align:center; padding:0.3rem; border:1px solid #ddd; border-radius:4px;" />
                                        <button type="button" class="btn-food-qty" onclick="changeFoodQty(this, 1)">+</button>
                                    </div>
                                </div>
            }
                        }
                        else
                        { <div class="text-muted font-italic">Không có đồ ăn.</div>}
                    }
                </div>
            </div>

            <div style="background: #fff8e1; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #ffe082;">
                <h3 style="margin:0 0 0.8rem 0; color: #f39c12;">
                    <i class="fas fa-ticket-alt"></i> Khuyến Mãi
                </h3>
                <div class="input-group" id="promoPicker">
                    <input type="text" id="txtPromoDisplay" class="form-control" placeholder="Chưa chọn mã nào" readonly style="background:white; font-weight:bold; color:#27ae60;"> <br />
                    <div class="input-group-append">
                        <button class="btn btn-warning text-white" type="button" id="btnOpenPromo"><i class="fas fa-list"></i> Chọn Mã</button> 
                        <button class="btn btn-outline-secondary" type="button" id="btnClearPromo" title="Bỏ chọn"><i class="fas fa-times"></i></button>
                    </div>
                </div>
                <div id="promoDescDisplay" style="font-size:0.85rem; color:#666; margin-top:5px; font-style:italic;"></div>
            </div>

            <div style="background:white; padding:1rem; border-radius:8px; margin-bottom: 1rem;">
                <h3 style="margin:0 0 0.8rem 0;">Phương thức thanh toán</h3>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1rem;">
                    <label class="payment-option active" style="cursor:pointer;">
                        <input type="radio" name="paymentMethod" value="cash" checked onchange="updatePaymentUI()" style="display:none" />
                        <div class="option-box" style="border:2px solid #ddd; padding:15px; border-radius:8px; text-align:center; transition: all 0.3s ease;">
                            <div style="font-size:2rem; margin-bottom:0.5rem;">💵</div>
                            <div style="font-weight:bold; font-size:0.95rem;">Tiền mặt</div>
                        </div>
                    </label>
                    <label class="payment-option" style="cursor:pointer;">
                        <input type="radio" name="paymentMethod" value="vnpay" onchange="updatePaymentUI()" style="display:none" />
                        <div class="option-box" style="border:2px solid #ddd; padding:15px; border-radius:8px; text-align:center; transition: all 0.3s ease;">
                            <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/6/0oxhzjmxbksr1686814746087.png" height="32" style="margin-bottom:0.5rem; display:block; margin-left:auto; margin-right:auto;" />
                            <div style="font-weight:bold; font-size:0.95rem;">VNPay QR</div>
                        </div>
                    </label>
                </div>
            </div>
        </div>

        <!-- COLUMN 2: Panel thông tin đơn hàng -->
        <div>
            <!-- ✅ Thông tin suất chiếu - Thiết kế mới -->
            <div style="background: white; border: 2px solid #e0e0e0; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">
                <h3 style="margin: 0 0 1rem 0; font-size: 1.2rem; color: #333; padding-bottom: 0.75rem; border-bottom: 2px solid #f0f0f0;">
                    <i class="fas fa-film" style="color: #ff6b35;"></i> Thông Tin Suất Chiếu
                </h3>
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <i class="fas fa-ticket-alt" style="font-size: 1.1rem; width: 20px; margin-top: 2px; color: #666;"></i>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; color: #888; margin-bottom: 2px;">Phim</div>
                            <div style="font-weight: 700; font-size: 1rem; color: #333;">@ViewBag.MovieName</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <i class="fas fa-calendar-day" style="font-size: 1.1rem; width: 20px; margin-top: 2px; color: #666;"></i>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; color: #888; margin-bottom: 2px;">Ngày chiếu</div>
                            <div style="font-weight: 600; color: #333;">@ViewBag.ShowDate</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <i class="fas fa-clock" style="font-size: 1.1rem; width: 20px; margin-top: 2px; color: #666;"></i>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; color: #888; margin-bottom: 2px;">Giờ chiếu</div>
                            <div style="font-weight: 700; font-size: 1.1rem; color: #ff6b35;">@ViewBag.ShowTime</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <i class="fas fa-door-open" style="font-size: 1.1rem; width: 20px; margin-top: 2px; color: #666;"></i>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; color: #888; margin-bottom: 2px;">Phòng chiếu</div>
                            <div style="font-weight: 600; color: #333;">@ViewBag.RoomName</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <i class="fas fa-money-bill-wave" style="font-size: 1.1rem; width: 20px; margin-top: 2px; color: #666;"></i>
                        <div style="flex: 1;">
                            <div style="font-size: 0.75rem; color: #888; margin-bottom: 2px;">Giá vé/ghế</div>
                            <div style="font-weight: 700; color: #27ae60;">@ViewBag.TicketPrice.ToString("N0") ₫</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ✅ Chi tiết đơn hàng -->
            <div style="background: white; border: 2px solid #e0e0e0; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem;">
                <h3 style="margin: 0 0 1rem 0; font-size: 1.2rem; color: #333; padding-bottom: 0.75rem; border-bottom: 2px solid #f0f0f0;">
                    <i class="fas fa-shopping-cart" style="color: #ff6b35;"></i> Chi Tiết Đơn Hàng
                </h3>
                
                <!-- Ghế đã chọn -->
                <div style="margin-bottom: 1rem; padding: 0.75rem; background: #f8f9fa; border-radius: 6px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <div style="font-weight: 600; color: #666; font-size: 0.9rem;">
                            <i class="fas fa-chair"></i> Ghế đã chọn
                        </div>
                        <div id="seatCount" style="font-weight: 700, color: #ff6b35;">0</div>
                    </div>
                    <div id="selectedSeatsText" style="font-size: 0.9rem; color: #555; font-weight: 500;">Chưa chọn ghế</div>
                    <div id="seatTotal" style="margin-top: 0.5rem; text-align: right; font-weight: 700; color: #333;">0 ₫</div>
                </div>

                <!-- Đồ ăn đã chọn -->
                <div id="foodOrderSummary" style="margin-bottom: 1rem; padding: 0.75rem; background: #f8f9fa; border-radius: 6px; display: none;">
                    <div style="font-weight: 600; color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;">
                        <i class="fas fa-hamburger"></i> Đồ ăn đã chọn
                    </div>
                    <div id="foodItemsList" style="font-size: 0.85rem; color: #555;"></div>
                    <div id="foodTotal" style="margin-top: 0.5rem; text-align: right; font-weight: 700; color: #333;">0 ₫</div>
                </div>

                <!-- Mã giảm giá -->
                <div id="promoSummary" style="margin-bottom: 1rem; padding: 0.75rem; background: #fff3cd; border-radius: 6px; border: 1px dashed #ffc107; display: none;">
                    <div style="font-weight: 600; color: #856404; font-size: 0.9rem; margin-bottom: 0.5rem;">
                        <i class="fas fa-tag"></i> Mã giảm giá
                    </div>
                    <div id="promoCodeDisplay" style="font-size: 0.9rem; color: #856404; font-weight: 600;"></div>
                    <div id="discountAmount" style="margin-top: 0.5rem; text-align: right; font-weight: 700; color: #d63031;">-0 ₫</div>
                </div>

                <!-- Tổng tiền -->
                <div style="padding-top: 1rem; border-top: 2px solid #e0e0e0;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="font-weight: 700; font-size: 1.1rem; color: #333;">Tổng cộng</div>
                        <div id="totalPrice" style="font-weight: 800; font-size: 1.5rem; color: #ff6b35;">0 ₫</div>
                    </div>
                </div>
            </div>
            
            <div style="display:grid; grid-template-columns: 1fr 2fr; gap:0.75rem;">
                <button class="btn btn-secondary" onclick="window.history.back()" style="padding: 0.9rem;">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </button>
                <button class="btn btn-primary" id="confirmBtn" onclick="confirmBooking()" disabled style="padding: 0.9rem;">
                    <i class="fas fa-check-circle"></i> Đặt và Thanh toán
                </button>
            </div>
        </div>
    </div>
</div>

<div id="promoListModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chọn Mã Khuyến Mãi</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div id="promoListLoading" class="text-center">
                    <i class="fas fa-spinner fa-spin"></i> Đang tìm mã phù hợp...
                </div>
                <div id="promoListContainer" class="list-group"></div>
                <div id="promoListEmpty" class="text-center" style="display:none;">
                    Không tìm thấy mã nào phù hợp.
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 1. BIẾN TOÀN CỤC
        var selectedSeats = [];
        var maxSeats = 10;
        var currentPromo = null;

        // === Fallback helpers cho modal (nếu $.fn.modal không tồn tại hoặc CSS Bootstrap bị override) ===
        function showPromoModalFallback() {
            $('#promoListModal').addClass('show');
            if (!$('#promoBackdrop').length) {
                $('body').append('<div id="promoBackdrop" class="modal-backdrop show" style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index=1040;"></div>');
            }
        }
        function hidePromoModalFallback() {
            $('#promoListModal').removeClass('show');
            $('#promoBackdrop').remove();
        }
        function showPromoModal() {
            if ($.fn.modal) $('#promoListModal').modal('show'); else showPromoModalFallback();
        }
        function hidePromoModal() {
            if ($.fn.modal) $('#promoListModal').modal('hide'); else hidePromoModalFallback();
        }

        // 2. CÁC HÀM XỬ LÝ

        // Cập nhật UI Thanh toán
        window.updatePaymentUI = function () {
            var method = $('input[name="paymentMethod"]:checked').val();
            var btnText = "Xác nhận Đã thu tiền";
            var btnClass = "btn-primary";
            if (method === 'vnpay') { btnText = "Thanh toán qua VNPay ➔"; btnClass = "btn-success"; }
            else if (method === 'card') { btnText = "Xác nhận Đã quẹt thẻ"; }
            $('#confirmBtn').removeClass('btn-primary btn-success').addClass(btnClass).html('<i class="fas fa-check-circle"></i> ' + btnText);
        };

        // Tăng/Giảm món ăn
        window.changeFoodQty = function (btn, amount) {
            var input = $(btn).parent().find('.food-quantity');
            var currentVal = parseInt(input.val()) || 0;
            var maxStock = parseInt(input.attr('data-max')) || 0;
            var newVal = currentVal + amount;
            if (newVal < 0) newVal = 0;
            if (newVal > maxStock) { alert("Hết hàng! Kho chỉ còn " + maxStock); return; }
            input.val(newVal);
            updateSummary();
        };

        // Mở Modal Promo
        window.openPromoModal = function() {
            // 1. Gom dữ liệu giỏ hàng
            var items = [];
            $('.food-quantity').each(function () {
                var qty = parseInt($(this).val()) || 0;
                if (qty > 0) {
                    items.push({ id: $(this).data('food-id'), quantity: qty });
                }
            });

            console.log("Gửi lên Server check Promo:", JSON.stringify(items));

            // 2. Reset UI Modal
            showPromoModal();
            $('#promoListContainer').empty();
            $('#promoListLoading').show();
            $('#promoListEmpty').hide();

            // 3. Gọi Ajax
            $.ajax({
                url: '@Url.Action("GetApplicablePromos", "StaffOfflineBooking", new { area = "Admin" })',
                type: 'POST',
                data: { foodItemsJson: JSON.stringify(items) },
                success: function(res) {
                    $('#promoListLoading').hide();

                    if (res.success && res.data && res.data.length > 0) {
                        var html = '';
                        res.data.forEach(function(p) {
                            var clientPromo = {
                                Code: p.maKhuyen,
                                Value: p.giaTriGiam,
                                Type: (p.loaiGiam === '%') ? 'PERCENT' : 'AMOUNT',
                                Scope: p.isProductScope ? 1 : 0,
                                Desc: p.moTa,
                                Remaining: p.soLuongConLai,
                                AllowedFoods: p.AllowedFoods
                            };

                            var badge = clientPromo.Type === 'PERCENT' 
                                ? clientPromo.Value + '%' 
                                : clientPromo.Value.toLocaleString('vi-VN') + '₫';
                            
                            var scopeText = clientPromo.Scope === 1
                                ? '<span class="badge badge-info">Theo món</span>'
                                : '<span class="badge badge-secondary">Toàn đơn</span>';

                            var dataAttr = encodeURIComponent(JSON.stringify(clientPromo));

                            // CẤU TRÚC HTML MỚI ĐẸP HƠN
                            html += `
                                <a href="#" class="list-group-item list-group-item-action promo-item" data-promo="${dataAttr}" style="text-align: center">
                                    <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                                        <h5 class="mb-0 text-primary font-weight-bold">${clientPromo.Code}</h5>
                                        <span class="badge badge-warning">Giảm ${badge}</span>
                                    </div>
                                </a>`;
                        });
                        $('#promoListContainer').html(html);
                    } else {
                        $('#promoListEmpty').show();
                    }
                },
                error: function() {
                    $('#promoListLoading').hide();
                    alert('Lỗi kết nối khi tải mã khuyến mãi.');
                }
            });
        }

        // Chọn mã
        window.selectPromo = function(promoObj) {
            currentPromo = promoObj;
            $('#txtPromoDisplay').val(promoObj.Code);
            $('#promoDescDisplay').text(promoObj.Desc);
            $('#btnClearPromo').prop('disabled', false);
            hidePromoModal();
            updateSummary();
        }

        // Bỏ chọn mã
        window.clearPromo = function() {
            currentPromo = null;
            $('#txtPromoDisplay').val('');
            $('#promoDescDisplay').text('');
            $('#btnClearPromo').prop('disabled', true);
            updateSummary();
        }

        // Cập nhật tổng tiền (Logic cốt lõi)
        function updateSummary() {
            if (selectedSeats.length === 0) {
                $('#selectedSeatsText').text('Chưa chọn ghế');
                $('#seatCount').text('0');
                $('#seatTotal').text('0 ₫');
                $('#totalPrice').text('0 ₫');
                $('#confirmBtn').prop('disabled', true);
                
                // Ẩn summary nếu không có gì
                if ($('.food-quantity').filter(function() { return parseInt($(this).val()) > 0; }).length === 0) {
                    $('#foodOrderSummary').hide();
                }
                return;
            }

            var names = selectedSeats.map(s => s.name).join(', ');
            var ticketTotal = selectedSeats.reduce((sum, s) => sum + s.price, 0);

            // ✅ Cập nhật ghế
            $('#selectedSeatsText').text(names);
            $('#seatCount').text(selectedSeats.length);
            $('#seatTotal').text(ticketTotal.toLocaleString('vi-VN') + ' ₫');

            // ✅ Tính đồ ăn
            var foodTotal = 0;
            var foodDetails = [];
            var foodItemsHtml = '';
            
            $('.food-quantity').each(function () {
                var id = $(this).data('food-id');
                var name = $(this).data('food-name');
                var qty = parseInt($(this).val()) || 0;
                var price = parseFloat($(this).attr('data-food-price')) || 0;
                
                if (qty > 0) {
                    var subTotal = qty * price;
                    foodTotal += subTotal;
                    foodDetails.push({ id: id, subTotal: subTotal, qty: qty });
                    
                    foodItemsHtml += '<div style="display:flex; justify-content:space-between; margin-bottom:0.3rem;">';
                    foodItemsHtml += '<span>' + qty + 'x ' + name + '</span>';
                    foodItemsHtml += '<span style="font-weight:600;">' + subTotal.toLocaleString('vi-VN') + ' ₫</span>';
                    foodItemsHtml += '</div>';
                }
            });

            // Hiển thị/ẩn đồ ăn
            if (foodDetails.length > 0) {
                $('#foodOrderSummary').show();
                $('#foodItemsList').html(foodItemsHtml);
                $('#foodTotal').text(foodTotal.toLocaleString('vi-VN') + ' ₫');
            } else {
                $('#foodOrderSummary').hide();
            }

            var totalBeforeDiscount = ticketTotal + foodTotal;
            var discountAmount = 0;

            // ✅ Tính giảm giá
            if (currentPromo) {
                if (currentPromo.Scope === 0) {
                    if (currentPromo.Type === 'PERCENT') {
                        discountAmount = (totalBeforeDiscount * currentPromo.Value) / 100;
                    } else {
                        discountAmount = currentPromo.Value;
                    }
                } else if (currentPromo.Scope === 1) {
                    foodDetails.forEach(function(f) {
                        if (currentPromo.AllowedFoods && currentPromo.AllowedFoods.includes(f.id)) {
                            if (currentPromo.Type === 'PERCENT') {
                                discountAmount += (f.subTotal * currentPromo.Value) / 100;
                            } else {
                                discountAmount += (currentPromo.Value * f.qty);
                            }
                        }
                    });
                }
            }

            discountAmount = Math.floor(discountAmount);
            if (discountAmount > totalBeforeDiscount) discountAmount = totalBeforeDiscount;
            
            // Hiển thị/ẩn mã giảm giá
            if (currentPromo && discountAmount > 0) {
                $('#promoSummary').show();
                $('#promoCodeDisplay').text(currentPromo.Code + ' - ' + currentPromo.Desc);
                $('#discountAmount').text('-' + discountAmount.toLocaleString('vi-VN') + ' ₫');
            } else {
                $('#promoSummary').hide();
            }

            var finalTotal = totalBeforeDiscount - discountAmount;

            $('#totalPrice').text(finalTotal.toLocaleString('vi-VN') + ' ₫');
            $('#confirmBtn').prop('disabled', false);
        }

        // --- SUBMIT ĐƠN HÀNG ---
        window.confirmBooking = function () {
            var name = $('#customerName').val().trim();
            var phone = $('#customerPhone').val().trim();
            var paymentMethod = $('input[name="paymentMethod"]:checked').val() || 'cash';
            var promoCodeToSend = currentPromo ? currentPromo.Code : '';

            if (!name) { alert('Vui lòng nhập tên khách hàng'); $('#customerName').focus(); return; }
            if (!phone) { alert('Vui lòng nhập số điện thoại'); $('#customerPhone').focus(); return; }
            if (selectedSeats.length === 0) { alert('Vui lòng chọn ghế'); return; }

            var seatIds = selectedSeats.map(s => s.id).join(',');
            var foodXml = '<orders>';
            $('.food-quantity').each(function(){
                var q = parseInt($(this).val())||0;
                if(q > 0){ foodXml += '<item><id>' + $(this).data('food-id') + '</id><quantity>' + q + '</quantity></item>'; }
            });
            foodXml += '</orders>';

            var btn = $('#confirmBtn');
            var originalText = btn.html();
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

            $.ajax({
                url: '@Url.Action("CreateOfflineBooking", "StaffOfflineBooking")',
                type: 'POST',
                data: {
                    showtimeId: @ViewBag.ShowtimeId,
                    selectedSeats: seatIds,
                    customerPhone: phone,
                    customerName: name,
                    foodOrders: foodXml,
                    paymentMethod: paymentMethod,
                    promoCode: promoCodeToSend
                },
                success: function(res) {
                    if (res.success) {
                        if (res.isRedirect && res.redirectUrl.includes("vnpayment")) {
                            showLoadingOverlay();
                            setTimeout(function () { window.location.href = res.redirectUrl; }, 1000);
                        } else {
                            var msg = '✅ Đặt vé thành công!\nMã đơn: ' + res.bookingId;
                            if (res.discountAmount > 0) { msg += '\n💰 Giảm: ' + res.discountAmount.toLocaleString('vi-VN') + ' ₫'; }
                            alert(msg);
                            if (res.redirectUrl) window.location.href = res.redirectUrl;
                            else location.reload();
                        }
                    } else {
                        alert('❌ Lỗi: ' + res.message);
                        btn.prop('disabled', false).html(originalText);
                    }
                },
                error: function() {
                    alert('❌ Lỗi kết nối Server');
                    btn.prop('disabled', false).html(originalText);
                }
            });
        };

        function showLoadingOverlay() {
            $('body').append('<div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);z-index:9999;display:flex;align-items:center;justify-content:center;color:white;"><i class="fas fa-spinner fa-spin fa-3x"></i></div>');
        }

        // 4. JQUERY INIT
        $(function() {
            function seatInfo(el) {
                return {
                    id: parseInt($(el).data('seat-id')),
                    name: $(el).data('seat-name'),
                    price: parseFloat($(el).data('seat-price')) || 0,
                    loai: $(el).hasClass('vip') ? 2 : $(el).hasClass('couple') ? 3 : 1
                };
            }
            $('.seat').not('.booked').not('.aisle').on('click', function () {
                if ($(this).hasClass('selected')) {
                    $(this).removeClass('selected');
                    selectedSeats = selectedSeats.filter(s => s.id !== parseInt($(this).data('seat-id')));
                } else {
                    var info = seatInfo(this);
                    if (selectedSeats.length > 0) {
                        if (info.loai !== selectedSeats[0].loai) { alert('Không được chọn loại ghế khác nhau.'); return; }
                    }
                    if (selectedSeats.length >= maxSeats) { alert('Tối đa ' + maxSeats + ' ghế'); return; }
                    $(this).addClass('selected');
                    selectedSeats.push(info);
                }
                updateSummary();
            });

            // Khi click vào toàn bộ thanh chọn khuyến mãi (trừ nút xoá), mở modal
            $('#promoPicker').on('click', function (e) {
                if ($(e.target).closest('#btnClearPromo').length) return;
                openPromoModal();
            });
            $('#btnOpenPromo').on('click', function (e) { e.preventDefault(); openPromoModal(); });
            $('#btnClearPromo').on('click', function (e) { e.preventDefault(); clearPromo(); });

            // Bắt sự kiện click item khuyến mãi bằng event delegation
            $('#promoListContainer').on('click', '.promo-item', function (e) {
                e.preventDefault();
                var data = $(this).attr('data-promo');
                try {
                    var promo = JSON.parse(decodeURIComponent(data));
                    selectPromo(promo);
                } catch (err) {
                    console.error('Parse promo error', err);
                    alert('Không thể chọn mã này, vui lòng thử mã khác.');
                }
            });

            // Close button fallback
            $('#promoListModal .close').on('click', function(){ hidePromoModal(); });

            // Khởi tạo trạng thái nút xoá
            $('#btnClearPromo').prop('disabled', !currentPromo);

            updatePaymentUI();
            updateSummary();
        });
    </script>
}