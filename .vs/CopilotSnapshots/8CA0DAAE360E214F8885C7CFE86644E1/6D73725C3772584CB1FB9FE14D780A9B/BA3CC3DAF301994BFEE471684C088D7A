@model IEnumerable<WebCinema.Models.Suat_Chieu>

@{
    ViewBag.Title = "Quản Lý Vé Theo Suất Chiếu";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-ticket-alt"></i> Quản Lý Vé Theo Suất Chiếu</h2>
    </div>

    <!-- Filter Section -->
    <div style="background: #f9f9f9; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
        @using (Html.BeginForm("Index", "TicketManagement", FormMethod.Get, new { @class = "filter-form" }))
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 1rem; align-items: end;">
                <div>
                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">
                        <i class="fas fa-film"></i> Phim
                    </label>
                    @Html.DropDownList("movieId", (SelectList)ViewBag.Movies, "-- Tất cả phim --", new { @class = "form-control" })
                </div>

                <div>
                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">
                        <i class="fas fa-building"></i> Rạp
                    </label>
                    @Html.DropDownList("cinemaId", (SelectList)ViewBag.Cinemas, "-- Tất cả rạp --", new { @class = "form-control" })
                </div>

                <div>
                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">
                        <i class="fas fa-calendar"></i> Ngày chiếu
                    </label>
                    <input type="date" name="date" value="@ViewBag.Date" class="form-control" />
                </div>

                <div>
                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        <i class="fas fa-search"></i> Lọc
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Info Summary -->
    @if (ViewBag.TotalShowtimes > 0)
    {
        <div style="margin-bottom: 1.5rem; color: #666;">
            <strong>Tổng số:</strong> @ViewBag.TotalShowtimes suất chiếu |
            <strong>Trang:</strong> @ViewBag.CurrentPage / @ViewBag.TotalPages
        </div>
    }

    <!-- Showtime List -->
    @if (Model != null && Model.Any())
    {
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            @foreach (var showtime in Model)
            {
                var totalTickets = showtime.Ves.Count;
                var bookedTickets = showtime.Ves.Count(v =>
                    v.Dat_Ve_id != null &&
                    v.Dat_Ve != null &&
                    v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán" &&
                    v.trang_thai_ve != "Đã Hủy"
                );
                var availableTickets = showtime.Ves.Count(v => v.Dat_Ve_id == null && v.trang_thai_ve == "Chưa sử dụng");
                var usedTickets = showtime.Ves.Count(v => v.trang_thai_ve == "Đã sử dụng");

                <div class="showtime-card" style="background: white; border: 2px solid #e0e0e0; border-radius: 12px; padding: 1.5rem; transition: all 0.3s ease;">
                    <div style="display: grid; grid-template-columns: 2fr 1fr auto; gap: 2rem; align-items: center;">
                        <!-- Info Column -->
                        <div>
                            <h3 style="margin: 0 0 1rem 0; color: #2c3e50; font-size: 1.3rem;">
                                <i class="fas fa-film" style="color: #ff6b35;"></i>
                                @showtime.Phim.ten_phim
                            </h3>
                            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; color: #666;">
                                <div>
                                    <i class="fas fa-building" style="color: #3498db;"></i>
                                    <strong>Rạp:</strong> @showtime.Phong_Chieu.Rap.ten_rap
                                </div>
                                <div>
                                    <i class="fas fa-door-open" style="color: #3498db;"></i>
                                    <strong>Phòng:</strong> @showtime.Phong_Chieu.ten_phong
                                </div>
                                <div>
                                    <i class="fas fa-calendar-alt" style="color: #27ae60;"></i>
                                    <strong>Ngày:</strong> @showtime.ngay_chieu.ToString("dd/MM/yyyy")
                                </div>
                                <div>
                                    <i class="fas fa-clock" style="color: #27ae60;"></i>
                                    <strong>Ca:</strong> @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm") - @showtime.Ca_Chieu.gio_ket_thuc.ToString(@"hh\:mm")
                                </div>
                            </div>
                        </div>

                        <!-- Stats Column -->
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                            <div style="text-align: center; padding: 0.8rem; background: #e8f5e9; border-radius: 8px;">
                                <div style="font-size: 1.8rem; font-weight: bold; color: #27ae60;">@totalTickets</div>
                                <div style="font-size: 0.85rem; color: #666;">Tổng vé</div>
                            </div>
                            <div style="text-align: center; padding: 0.8rem; background: #fff3e0; border-radius: 8px;">
                                <div style="font-size: 1.8rem; font-weight: bold; color: #ff9800;">@bookedTickets</div>
                                <div style="font-size: 0.85rem; color: #666;">Đã thanh toán</div>
                            </div>
                            <div style="text-align: center; padding: 0.8rem; background: #e3f2fd; border-radius: 8px;">
                                <div style="font-size: 1.8rem; font-weight: bold; color: #2196f3;">@availableTickets</div>
                                <div style="font-size: 0.85rem; color: #666;">Còn trống</div>
                            </div>
                            <div style="text-align: center; padding: 0.8rem; background: #f3e5f5; border-radius: 8px;">
                                <div style="font-size: 1.8rem; font-weight: bold; color: #9c27b0;">@usedTickets</div>
                                <div style="font-size: 0.85rem; color: #666;">Đã dùng</div>
                            </div>
                        </div>

                        <!-- Actions Column -->
                        <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                            <a href="@Url.Action("Details", new { id = showtime.suat_chieu_id })"
                               class="btn btn-primary"
                               style="padding: 0.8rem 1.5rem; white-space: nowrap;">
                                <i class="fas fa-eye"></i> Xem Chi Tiết
                            </a>
                            <button onclick="deleteShowtime(@showtime.suat_chieu_id, '@showtime.Phim.ten_phim')"
                                    class="btn btn-danger"
                                    style="padding: 0.8rem 1.5rem; white-space: nowrap;">
                                <i class="fas fa-trash"></i> Xóa Suất Chiếu
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        if (ViewBag.TotalPages > 1)
        {
            <div style="margin-top: 2rem; display: flex; justify-content: center; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new {
                        movieId = ViewBag.MovieId,
                        cinemaId = ViewBag.CinemaId,
                        date = ViewBag.Date,
                        pageNumber = ViewBag.CurrentPage - 1
                    })" class="btn btn-secondary">
                        <i class="fas fa-chevron-left"></i> Trước
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="btn btn-primary" style="pointer-events: none;">@i</span>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) <= 2 || i == 1 || i == ViewBag.TotalPages)
                    {
                        <a href="@Url.Action("Index", new {
                            movieId = ViewBag.MovieId,
                            cinemaId = ViewBag.CinemaId,
                            date = ViewBag.Date,
                            pageNumber = i
                        })" class="btn btn-secondary">@i</a>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) == 3)
                    {
                        <span style="padding: 0.6rem; color: #999;">...</span>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new {
                        movieId = ViewBag.MovieId,
                        cinemaId = ViewBag.CinemaId,
                        date = ViewBag.Date,
                        pageNumber = ViewBag.CurrentPage + 1
                    })" class="btn btn-secondary">
                        Sau <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 3rem; color: #999;">
            <i class="fas fa-inbox" style="font-size: 4rem; opacity: 0.5; margin-bottom: 1rem;"></i>
            <p style="font-size: 1.2rem;">Không tìm thấy suất chiếu nào.</p>
            <p>Hãy thử thay đổi bộ lọc hoặc thêm suất chiếu mới.</p>
        </div>
    }
</div>

<style>
    .showtime-card:hover {
        border-color: #ff6b35;
        box-shadow: 0 4px 12px rgba(255, 107, 53, 0.2);
        transform: translateY(-2px);
    }
</style>

@section scripts {
    <script>
        function deleteShowtime(id, movieName) {
            if (confirm('⚠️ XÁC NHẬN XÓA SUẤT CHIẾU\n\n' +
                        'Phim: ' + movieName + '\n' +
                        'Suất chiếu ID: ' + id + '\n\n' +
                        '🚨 CẢNH BÁO: Hành động này sẽ:\n' +
                        '• Xóa SUẤT CHIẾU\n' +
                        '• Xóa TẤT CẢ VÉ của suất chiếu này\n' +
                        '• Không thể HOÀN TÁC!\n\n' +
                        'Bạn có chắc chắn muốn tiếp tục?')) {

                $.ajax({
                    url: '@Url.Action("DeleteAllTickets")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert('✅ ' + response.message);
                            location.reload();
                        } else {
                            alert('❌ ' + response.message);
                        }
                    },
                    error: function () {
                        alert('❌ Có lỗi xảy ra khi xóa suất chiếu.');
                    }
                });
            }
        }
    </script>
}