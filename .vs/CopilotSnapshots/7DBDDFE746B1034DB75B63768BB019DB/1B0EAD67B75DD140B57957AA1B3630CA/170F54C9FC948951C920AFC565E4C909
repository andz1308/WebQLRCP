@{
    ViewBag.Title = "Hóa Đơn Đặt Vé";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var booking = ViewBag.Booking as WebCinema.Models.Dat_Ve;
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    var foodItems = ViewBag.FoodItems as List<dynamic>;
    var ticketTotal = (decimal)ViewBag.TicketTotal;
    var foodTotal = (decimal)ViewBag.FoodTotal;
    var grandTotal = (decimal)ViewBag.GrandTotal;
}

<style>
    .invoice-container {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 0 2rem;
    }

    .invoice-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2.5rem;
        border-radius: 12px 12px 0 0;
        text-align: center;
    }

    .invoice-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.2rem;
        font-weight: 700;
    }

    .invoice-header p {
        margin: 0;
        opacity: 0.95;
        font-size: 1rem;
    }

    .invoice-content {
        background: white;
        padding: 2.5rem;
        border: 1px solid #e0e0e0;
    }

    .status-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 3px solid #f0f0f0;
    }

    .status-badge {
        display: inline-block;
        padding: 0.7rem 1.5rem;
        background: #fff3cd;
        color: #856404;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
    }

    .status-badge.paid {
        background: #d4edda;
        color: #155724;
    }

    .invoice-section {
        margin-bottom: 2.5rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #667eea;
    }

    .section-header h3 {
        margin: 0;
        color: #2c3e50;
        font-size: 1.3rem;
        font-weight: 600;
    }

    .section-header i {
        color: #667eea;
        font-size: 1.5rem;
    }

    /* Info Grid Layout */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
        border-left: 4px solid #667eea;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 0.6rem 0;
    }

    .info-label {
        color: #7f8c8d;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .info-value {
        color: #2c3e50;
        font-weight: 600;
        text-align: right;
    }

    .info-value.highlight {
        color: #667eea;
        font-size: 1.1rem;
    }

    /* Showtime Info */
    .showtime-box {
        background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
        padding: 1.5rem;
        border-radius: 8px;
        border-left: 4px solid #667eea;
    }

    .showtime-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1rem;
    }

    .showtime-row:last-child {
        margin-bottom: 0;
    }

    .showtime-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .showtime-item i {
        color: #667eea;
        font-size: 1.3rem;
        width: 30px;
    }

    .showtime-item-content {
        flex: 1;
    }

    .showtime-item-label {
        color: #7f8c8d;
        font-size: 0.85rem;
        margin-bottom: 0.3rem;
    }

    .showtime-item-value {
        color: #2c3e50;
        font-weight: 600;
        font-size: 1rem;
    }

    /* Tickets Grid */
    .ticket-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
        gap: 0.8rem;
        padding: 1.5rem;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .ticket-item {
        background: white;
        border: 2px solid #667eea;
        border-radius: 6px;
        padding: 0.8rem;
        text-align: center;
        color: #667eea;
        font-weight: 700;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .ticket-item:hover {
        background: #667eea;
        color: white;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    /* Food Table */
    .food-section {
        overflow-x: auto;
    }

    .food-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    .food-table thead {
        background: #667eea;
        color: white;
    }

    .food-table th {
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .food-table td {
        padding: 1rem;
        border-bottom: 1px solid #e0e0e0;
        font-size: 0.95rem;
    }

    .food-table tbody tr:hover {
        background: #f8f9fa;
    }

    .food-table tbody tr:last-child td {
        border-bottom: none;
    }

    .text-right {
        text-align: right;
    }

    .amount {
        color: #667eea;
        font-weight: 600;
    }

    /* Summary Box */
    .summary-box {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 8px;
        margin-top: 2rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        font-size: 1rem;
    }

    .summary-row:last-child {
        border-bottom: none;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        padding: 1.2rem 0;
        margin-top: 1rem;
        border-top: 2px solid rgba(255, 255, 255, 0.4);
        font-size: 1.4rem;
        font-weight: 700;
    }

    .summary-total .total-label {
        font-size: 1.2rem;
    }

    .summary-total .total-amount {
        font-size: 1.6rem;
    }

    /* Footer */
    .invoice-footer {
        background: #f8f9fa;
        padding: 2rem;
        border-radius: 0 0 12px 12px;
        border: 1px solid #e0e0e0;
        border-top: none;
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 0.9rem 1.8rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.95rem;
    }

    .btn-payment {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-payment:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
    }

    .btn-print {
        background: #e0e0e0;
        color: #2c3e50;
    }

    .btn-print:hover {
        background: #d0d0d0;
        transform: translateY(-2px);
    }

    .btn-back {
        background: white;
        color: #2c3e50;
        border: 2px solid #e0e0e0;
    }

    .btn-back:hover {
        border-color: #667eea;
        color: #667eea;
        transform: translateY(-2px);
    }

    @@media print {
        .invoice-footer {
            display: none;
        }
        body {
            background: white;
        }
    }

    @@media (max-width: 768px) {
        .invoice-container {
            padding: 0 1rem;
        }

        .info-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .showtime-row {
            grid-template-columns: 1fr;
        }

        .invoice-footer {
            flex-direction: column;
        }

        .action-btn {
            width: 100%;
            justify-content: center;
        }

        .food-table {
            font-size: 0.85rem;
        }

        .food-table th,
        .food-table td {
            padding: 0.6rem;
        }
    }
</style>

<div class="invoice-container">
    @if (booking != null)
    {
        <div class="invoice-header">
            <h1><i class="fas fa-receipt"></i> HÓA ĐƠN ĐẶT VÉ</h1>
            <p>🎬 DAV Cinema - Hệ Thống Đặt Vé Trực Tuyến</p>
        </div>

        <div class="invoice-content">
            <!-- Status & Order ID -->
            <div class="status-section">
                <div>
                    <div style="margin-bottom: 0.5rem; color: #7f8c8d; font-size: 0.9rem;">
                        <strong>Mã Đơn Hàng:</strong> <span style="color: #2c3e50; font-size: 1.3rem; font-weight: 700;">#@booking.Dat_Ve_id</span>
                    </div>
                </div>
                <div class="status-badge @(booking.trang_thai_Dat_Ve == "Đã Thanh toán" ? "paid" : "")">
                    <i class="fas fa-@(booking.trang_thai_Dat_Ve == "Đã Thanh toán" ? "check-circle" : "hourglass-half")"></i>
                    @booking.trang_thai_Dat_Ve
                </div>
            </div>

            <!-- Customer Info -->
            <div class="invoice-section">
                <div class="section-header">
                    <i class="fas fa-user"></i>
                    <h3>Thông Tin Khách Hàng</h3>
                </div>
                <div class="info-grid">
                    <div>
                        <div class="info-row">
                            <span class="info-label">👤 Họ Tên:</span>
                            <span class="info-value">@booking.Khach_Hang.ho_ten</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">📧 Email:</span>
                            <span class="info-value">@booking.Khach_Hang.email</span>
                        </div>
                    </div>
                    <div>
                        <div class="info-row">
                            <span class="info-label">📱 Số Điện Thoại:</span>
                            <span class="info-value">@(booking.Khach_Hang.so_dien_thoai ?? "N/A")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">🕐 Ngày Đặt:</span>
                            <span class="info-value">@(booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (showtime != null)
            {
                <!-- Showtime Info -->
                <div class="invoice-section">
                    <div class="section-header">
                        <i class="fas fa-film"></i>
                        <h3>Thông Tin Phim & Suất Chiếu</h3>
                    </div>
                    <div class="showtime-box">
                        <div class="showtime-row">
                            <div class="showtime-item">
                                <i class="fas fa-video"></i>
                                <div class="showtime-item-content">
                                    <div class="showtime-item-label">Tên Phim</div>
                                    <div class="showtime-item-value">@showtime.Phim.ten_phim</div>
                                </div>
                            </div>
                            <div class="showtime-item">
                                <i class="fas fa-building"></i>
                                <div class="showtime-item-content">
                                    <div class="showtime-item-label">Rạp</div>
                                    <div class="showtime-item-value">@showtime.Phong_Chieu.Rap.ten_rap</div>
                                </div>
                            </div>
                        </div>
                        <div class="showtime-row">
                            <div class="showtime-item">
                                <i class="fas fa-door-open"></i>
                                <div class="showtime-item-content">
                                    <div class="showtime-item-label">Phòng Chiếu</div>
                                    <div class="showtime-item-value">@showtime.Phong_Chieu.ten_phong</div>
                                </div>
                            </div>
                            <div class="showtime-item">
                                <i class="fas fa-calendar"></i>
                                <div class="showtime-item-content">
                                    <div class="showtime-item-label">Ngày & Giờ</div>
                                    <div class="showtime-item-value">@showtime.ngay_chieu.ToString("dd/MM/yyyy") - @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tickets -->
                <div class="invoice-section">
                    <div class="section-header">
                        <i class="fas fa-ticket-alt"></i>
                        <h3>Danh Sách Vé (@tickets.Count vé)</h3>
                    </div>
                    <div class="ticket-grid">
                        @foreach (var ticket in tickets)
                        {
                            <div class="ticket-item" title="Ghế @ticket.Ghe.so_ghe">
                                @ticket.Ghe.so_ghe
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Food Items -->
            @if (foodItems != null && foodItems.Count > 0)
            {
                <div class="invoice-section">
                    <div class="section-header">
                        <i class="fas fa-utensils"></i>
                        <h3>Đồ Ăn & Thức Uống</h3>
                    </div>
                    <div class="food-section">
                        <table class="food-table">
                            <thead>
                                <tr>
                                    <th>Tên Sản Phẩm</th>
                                    <th style="text-align: center;">Số Lượng</th>
                                    <th class="text-right">Đơn Giá</th>
                                    <th class="text-right">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in foodItems)
                                {
                                    <tr>
                                        <td>@item.FoodName</td>
                                        <td style="text-align: center; font-weight: 600;">@item.Quantity</td>
                                        <td class="text-right amount">@item.Price.ToString("N0") ₫</td>
                                        <td class="text-right amount" style="font-weight: 700;">@item.TotalPrice.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Summary -->
            <div class="summary-box">
                <div class="summary-row">
                    <span>🎟️ Tiền Vé (@tickets.Count vé)</span>
                    <span>@ticketTotal.ToString("N0") ₫</span>
                </div>
                @if (foodTotal > 0)
                {
                    <div class="summary-row">
                        <span>🍿 Đồ Ăn & Thức Uống</span>
                        <span>@foodTotal.ToString("N0") ₫</span>
                    </div>
                }
                <div class="summary-total">
                    <span class="total-label">💰 TỔNG CỘNG</span>
                    <span class="total-amount">@grandTotal.ToString("N0") ₫</span>
                </div>
            </div>
        </div>

        <div class="invoice-footer">
            @if (booking.trang_thai_Dat_Ve == "Chưa thanh toán")
            {
                <button class="action-btn btn-payment" onclick="initiatePayment(@booking.Dat_Ve_id)">
                    <i class="fas fa-credit-card"></i> Thanh Toán VNPAY
                </button>
            }
            <button class="action-btn btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> In Hóa Đơn
            </button>
            <a href="@Url.Action("Index", "Home")" class="action-btn btn-back">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        function initiatePayment(bookingId) {
            if (!confirm('Bạn có chắc chắn muốn thanh toán đơn hàng này?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("InitiatePayment", "Invoice")',
                type: 'POST',
                data: { bookingId: bookingId },
                success: function (response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra. Vui lòng thử lại!');
                }
            });
        }
    </script>
}
