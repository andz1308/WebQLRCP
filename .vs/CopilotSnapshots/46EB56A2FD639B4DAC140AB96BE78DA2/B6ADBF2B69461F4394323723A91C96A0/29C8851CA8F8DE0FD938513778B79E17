using System;
using System.Text;

namespace WebCinema.Infrastructure
{
    /// <summary>
    /// QR Code Payment Service - VietQR Standard
    /// Tạo mã QR cho chuyển khoản ngân hàng theo chuẩn VietQR
    /// Định dạng: https://api.vietqr.io/image/{bank_id}-{account_no}-{amount}-{description}.jpg
    /// </summary>
    public class QRCodePaymentService
    {
        private const string VIETQR_API = "https://api.vietqr.io/image";
        
        // Bank code: VCB = Vietcombank (0010), TCB = Techcombank (0020), VIB = VIB (0010), etc.
        // Lấy từ cấu hình
        private string _bankId;
        private string _accountNo;
        private string _accountName;

        public QRCodePaymentService()
        {
            try
            {
                _bankId = System.Configuration.ConfigurationManager.AppSettings["QRCode:BankId"] ?? "970436"; // VIETCOMBANK (VCB)
                _accountNo = System.Configuration.ConfigurationManager.AppSettings["QRCode:AccountNo"] ?? "1031419192";
                _accountName = System.Configuration.ConfigurationManager.AppSettings["QRCode:AccountName"] ?? "NGUYEN DUY AN";
            }
            catch
            {
                _bankId = "970436";
                _accountNo = "1031419192";
                _accountName = "NGUYEN DUY AN";
            }
        }

        /// <summary>
        /// Tạo URL mã QR code cho chuyển khoản
        /// </summary>
        /// <param name="amount">Số tiền (VNĐ)</param>
        /// <param name="description">Mô tả giao dịch (tối đa 25 ký tự)</param>
        /// <returns>URL của mã QR</returns>
        public string GenerateQRCodeUrl(decimal amount, string description)
        {
            try
            {
                // Làm sạch mô tả (chỉ giữ ký tự chữ số và khoảng trắng)
                string cleanDescription = CleanDescription(description);
                
                // Tạo URL VietQR: format: {bankId}-{accountNo}-{amount}-{description}
                // Chuẩn VietQR: https://api.vietqr.io/image/{bank_id}-{account_no}-{amount}-{description}-compact.jpg
                string qrUrl = $"{VIETQR_API}/{_bankId}-{_accountNo}-{(long)amount}-{Uri.EscapeDataString(cleanDescription)}-compact.jpg";
                
                LoggingHelper.LogInfo($"✅ QR Code URL generated: {qrUrl}");
                return qrUrl;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "GenerateQRCodeUrl");
                return string.Empty;
            }
        }

        /// <summary>
        /// Tạo URL mã QR code với định dạng Base64 (cho inline display)
        /// </summary>
        public string GenerateQRCodeBase64(decimal amount, string description)
        {
            try
            {
                string qrUrl = GenerateQRCodeUrl(amount, description);
                
                using (var client = new System.Net.WebClient())
                {
                    byte[] imageData = client.DownloadData(qrUrl);
                    string base64 = Convert.ToBase64String(imageData);
                    return $"data:image/jpeg;base64,{base64}";
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "GenerateQRCodeBase64");
                return string.Empty;
            }
        }

        /// <summary>
        /// Làm sạch mô tả (chỉ giữ chữ số và khoảng trắng, tối đa 25 ký tự)
        /// </summary>
        private string CleanDescription(string description)
        {
            if (string.IsNullOrEmpty(description))
                return "THANH_TOA";

            // Loại bỏ ký tự đặc biệt, chỉ giữ chữ số, chữ cái và khoảng trắng
            StringBuilder sb = new StringBuilder();
            foreach (char c in description)
            {
                if (char.IsLetterOrDigit(c) || c == ' ' || c == '_')
                {
                    sb.Append(c);
                }
            }

            string cleaned = sb.ToString().Trim();
            
            // Cắt ngắn nếu vượt quá 25 ký tự
            if (cleaned.Length > 25)
                cleaned = cleaned.Substring(0, 25);

            return string.IsNullOrEmpty(cleaned) ? "THANH_TOA" : cleaned;
        }

        /// <summary>
        /// Tạo mô tả giao dịch từ Booking ID
        /// </summary>
        public string GenerateTransactionDescription(int bookingId)
        {
            return $"DatVe{bookingId}";
        }

        /// <summary>
        /// Kiểm tra trạng thái thanh toán (được gọi từ mobile app hoặc webhook)
        /// Lưu ý: Cần integrate với core banking API hoặc webhook từ ngân hàng
        /// Hiện tại chỉ hỗ trợ manual confirmation
        /// </summary>
        public bool VerifyPayment(int bookingId, decimal amount)
        {
            // TODO: Tích hợp với core banking API hoặc QR dynamic payment service
            // Hiện tại, verification sẽ được thực hiện manual hoặc qua webhook
            return true;
        }
    }
}
