using System;
using System.Text;
using System.Collections.Generic;

namespace WebCinema.Infrastructure
{
    /// <summary>
    /// QR Code Payment Service - VietQR Standard
    /// Tạo mã QR cho chuyển khoản ngân hàng theo chuẩn VietQR
    /// Định dạng hỗ trợ:
    /// - New: https://img.vietqr.io/image/{bankShort}-{account}-compact2.png?amount={amount}&addInfo={description}
    /// - Fallback: https://api.vietqr.io/image/{bank_id}-{account_no}-{amount}-{description}-compact.jpg
    /// </summary>
    public class QRCodePaymentService
    {
        private const string VIETQR_API_OLD = "https://api.vietqr.io/image";
        private const string VIETQR_API_NEW = "https://img.vietqr.io/image";

        // Lấy từ cấu hình
        private string _bankId; // may be numeric code or short code
        private string _accountNo;
        private string _accountName;

        // Mapping numeric bank id -> short code used by img.vietqr.io
        private static readonly Dictionary<string, string> BankIdToShort = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            { "970436", "VCB" }, // Vietcombank
            { "970407", "TCB" }, // Techcombank (example)
            { "970441", "VIB" },
            { "970418", "BIDV" },
            { "970405", "AGB" }, // Agribank example
            { "970422", "MB" },
            { "970409", "ACB" },
            { "970421", "SCB" },
            { "970423", "TPB" }
        };

        public QRCodePaymentService()
        {
            try
            {
                _bankId = System.Configuration.ConfigurationManager.AppSettings["QRCode:BankId"] ?? "970436";
                _accountNo = System.Configuration.ConfigurationManager.AppSettings["QRCode:AccountNo"] ?? "1031419192";
                _accountName = System.Configuration.ConfigurationManager.AppSettings["QRCode:AccountName"] ?? "NGUYEN DUY AN";
            }
            catch
            {
                _bankId = "970436";
                _accountNo = "1031419192";
                _accountName = "NGUYEN DUY AN";
            }
        }

        /// <summary>
        /// Tạo URL mã QR code cho chuyển khoản
        /// Sẽ ưu tiên trả về định dạng img.vietqr.io với query params amount & addInfo nếu có mapping
        /// Nếu không có mapping, trả về fallback API cũ
        /// </summary>
        /// <param name="amount">Số tiền (VNĐ)</param>
        /// <param name="description">Mô tả giao dịch (tối đa 25 ký tự)</param>
        /// <returns>URL của mã QR</returns>
        public string GenerateQRCodeUrl(decimal amount, string description)
        {
            try
            {
                string cleanDescription = CleanDescription(description);

                // Try to find short bank code
                string bankShort = null;
                if (!string.IsNullOrEmpty(_bankId))
                {
                    // if it's already alpha short code like VCB
                    if (HasLetter(_bankId))
                    {
                        bankShort = _bankId;
                    }
                    else
                    {
                        // try mapping
                        if (BankIdToShort.ContainsKey(_bankId))
                        {
                            bankShort = BankIdToShort[_bankId];
                        }
                    }
                }

                if (!string.IsNullOrEmpty(bankShort))
                {
                    // Use new img.vietqr.io format with query params
                    // Example: https://img.vietqr.io/image/VCB-1026857473-compact2.png?amount=100000&addInfo=Thanh%20toan
                    var sb = new StringBuilder();
                    sb.Append(VIETQR_API_NEW);
                    sb.Append('/');
                    sb.Append(Uri.EscapeDataString(bankShort));
                    sb.Append('-');
                    sb.Append(Uri.EscapeDataString(_accountNo));
                    sb.Append("-compact2.png");

                    var query = new List<string>();
                    query.Add("amount=" + ((long)amount).ToString());
                    query.Add("addInfo=" + Uri.EscapeDataString(cleanDescription));

                    sb.Append('?');
                    sb.Append(string.Join('&', query));

                    string url = sb.ToString();
                    LoggingHelper.LogInfo($"✅ QR Code URL (new format) generated: {url}");
                    return url;
                }

                // Fallback to old style
                string fallback = $"{VIETQR_API_OLD}/{_bankId}-{_accountNo}-{(long)amount}-{Uri.EscapeDataString(cleanDescription)}-compact.jpg";
                LoggingHelper.LogInfo($"✅ QR Code URL (fallback) generated: {fallback}");
                return fallback;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "GenerateQRCodeUrl");
                return string.Empty;
            }
        }

        /// <summary>
        /// Tạo URL mã QR code với định dạng Base64 (cho inline display)
        /// </summary>
        public string GenerateQRCodeBase64(decimal amount, string description)
        {
            try
            {
                string qrUrl = GenerateQRCodeUrl(amount, description);

                using (var client = new System.Net.WebClient())
                {
                    byte[] imageData = client.DownloadData(qrUrl);
                    string base64 = Convert.ToBase64String(imageData);
                    return $"data:image/png;base64,{base64}";
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "GenerateQRCodeBase64");
                return string.Empty;
            }
        }

        private static bool HasLetter(string s)
        {
            foreach (var c in s)
            {
                if (char.IsLetter(c)) return true;
            }
            return false;
        }

        /// <summary>
        /// Làm sạch mô tả (chỉ giữ chữ, số và khoảng trắng, tối đa 25 ký tự)
        /// </summary>
        private string CleanDescription(string description)
        {
            if (string.IsNullOrEmpty(description))
                return "Thanh toan";

            StringBuilder sb = new StringBuilder();
            foreach (char c in description)
            {
                if (char.IsLetterOrDigit(c) || c == ' ' || c == '_')
                {
                    sb.Append(c);
                }
            }

            string cleaned = sb.ToString().Trim();
            if (cleaned.Length > 25)
                cleaned = cleaned.Substring(0, 25);

            return string.IsNullOrEmpty(cleaned) ? "Thanh toan" : cleaned;
        }

        /// <summary>
        /// Tạo mô tả giao dịch từ Booking ID
        /// </summary>
        public string GenerateTransactionDescription(int bookingId)
        {
            return $"DatVe{bookingId}";
        }

        /// <summary>
        /// Kiểm tra trạng thái thanh toán (được gọi từ mobile app hoặc webhook)
        /// Lưu ý: Cần integrate với core banking API hoặc webhook từ ngân hàng
        /// Hiện tại chỉ hỗ trợ manual confirmation
        /// </summary>
        public bool VerifyPayment(int bookingId, decimal amount)
        {
            // TODO: Tích hợp với core banking API hoặc QR dynamic payment service
            // Hiện tại, verification sẽ được thực hiện manual hoặc qua webhook
            return true;
        }
    }
}
