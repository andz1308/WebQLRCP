@{
    ViewBag.Title = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    IEnumerable<object> foodItems = ViewBag.FoodItems as IEnumerable<object>;
    var ticketTotal = (decimal)ViewBag.TicketTotal;
    var foodTotal = (decimal)ViewBag.FoodTotal;
    var grandTotal = (decimal)ViewBag.GrandTotal;
    
    // ✅ Get bookingId here in C# code
    var booking = ViewBag.Booking as WebCinema.Models.Dat_Ve;
    var bookingIdValue = booking != null ? booking.Dat_Ve_id : 0;
    var qrCodeUrl = ViewBag.QRCodeUrl as string;
}

<style>
    .checkout-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 2rem;
    }

    .checkout-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px 12px 0 0;
    }

    .progress-steps {
        background: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: center;
        gap: 2rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #999;
        font-weight: 600;
    }

    .step-number {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .step.active { color: #ff6b35; }
    .step.active .step-number { background: #ff6b35; color: white; }
    .step.completed .step-number { background: #27ae60; color: white; }

    .checkout-content { display: grid; grid-template-columns: 1fr 400px; gap: 2rem; padding: 2rem; background: white; }

    .info-section { background: #f8f9fa; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #ff6b35; margin-bottom: 1.5rem; }

    .section-title { font-size: 1.3rem; font-weight: 700; color: #333; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }

    /* ✅ QR Code Payment Section */
    .qr-payment-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .qr-code-container {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        display: inline-block;
        margin: 1rem 0;
    }

    .qr-code-container img {
        max-width: 300px;
        height: auto;
        border-radius: 8px;
    }

    .qr-instructions {
        margin-top: 1.5rem;
        font-size: 0.95rem;
        line-height: 1.6;
        text-align: left;
    }

    .qr-instructions ol {
        display: inline-block;
        text-align: left;
    }

    .qr-instructions li {
        margin: 0.5rem 0;
    }

    .movie-info { display: flex; gap: 1rem; }
    .movie-poster { width: 80px, height: 110px, object-fit: cover; }

    .food-list { margin-top: 1rem; }
    .food-item { display: flex, justify-content: space-between, padding: 0.8rem, background: white, border-radius: 8px, margin-bottom: 0.5rem; }

    .order-summary { background: #f8f9fa; padding: 1.5rem; border-radius: 12px; border: 2px solid #e0e0e0; position: sticky; top: 20px; }
    .summary-title { font-size: 1.5rem; font-weight: 700; color: #333; margin-bottom: 1.5rem; text-align: center; }
    .summary-line { display: flex; justify-content: space-between; padding: 0.8rem 0; border-bottom: 1px solid #e0e0e0; }
    .summary-total { display: flex; justify-content: space-between; padding: 1rem 0; margin-top: 1rem; border-top: 2px solid #333; font-size: 1.3rem; font-weight: bold; }
    .total-value { color: #ff6b35; }

    .btn-confirm { width: 100%; padding: 1rem; background: linear-gradient(135deg, #27ae60 0%, #229954 100%); color: white; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 700; cursor: pointer; transition: all 0.3s ease; margin-top: 1rem; }
    .btn-confirm:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(39, 174, 96, 0.4); }
    .btn-confirm:disabled { background: #ccc; cursor: not-allowed; }

    .btn-back { width: 100%; padding: 0.8rem; background: transparent; color: #666; border: 2px solid #ccc; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; margin-top: 0.5rem; }
    .btn-back:hover { border-color: #ff6b35; color: #ff6b35; }

    @@media (max-width: 1024px) {
        .checkout-content { grid-template-columns: 1fr; }
        .order-summary { position: static; }
    }
</style>

<div class="checkout-container">
    <div class="checkout-header">
        <h2 style="margin: 0;">💳 Thanh Toán Qua QR Code</h2>
        <p style="margin: 0.5rem 0 0 0; opacity: 0.9;">Quét mã QR để hoàn tất đặt vé</p>
    </div>

    <div class="progress-steps">
        <div class="step completed">
            <span class="step-number"><i class="fas fa-check"></i></span>
            <span>Chọn Ghế</span>
        </div>
        <div class="step completed">
            <span class="step-number"><i class="fas fa-check"></i></span>
            <span>Chọn Đồ Ăn</span>
        </div>
        <div class="step active">
            <span class="step-number">3</span>
            <span>Thanh Toán QR</span>
        </div>
    </div>

    <div class="checkout-content">
        <div>
            <!-- Movie Info -->
            @if (showtime != null)
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-film"></i> Thông Tin Phim
                    </h3>
                    <div class="movie-info">
                        @if (!string.IsNullOrEmpty(showtime.Phim.hinh_anh))
                        {
                            <img src="@Url.Content(showtime.Phim.hinh_anh)" alt="@showtime.Phim.ten_phim" class="movie-poster" />
                        }
                        <div>
                            <strong>@showtime.Phim.ten_phim</strong>
                            <div style="color: #666; font-size: 0.9rem; margin-top: 0.5rem;">
                                <div><i class="fas fa-building"></i> @showtime.Phong_Chieu.Rap.ten_rap</div>
                                <div><i class="fas fa-door-open"></i> @showtime.Phong_Chieu.ten_phong</div>
                                <div><i class="fas fa-calendar"></i> @showtime.ngay_chieu.ToString("dd/MM/yyyy")</div>
                                <div><i class="fas fa-clock"></i> @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Tickets -->
            @if (tickets != null && tickets.Count > 0)
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-ticket-alt"></i> Vé (@tickets.Count vé)
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); gap: 0.5rem;">
                        @foreach (var ticket in tickets)
                        {
                            <div style="
                                width: 50px; 
                                height: 50px; 
                                border-radius: 4px;
                                padding: 0;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                border: 2px solid #ff6b35;
                                background: white;
                                font-weight: 700;
                                color: #ff6b35;
                                font-size: 0.9rem;
                            ">
                                @ticket.Ghe.so_ghe
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Food Items -->
            @if (foodItems != null && foodItems.Any())
            {
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-utensils"></i> Đồ Ăn & Thức Uống
                    </h3>
                    <div class="food-list">
                        @foreach (var item in foodItems)
                        {
                            if (item == null) { continue; }
                            string foodName = "N/A"; int quantity = 0; decimal price = 0m;
                            try
                            {
                                var t = item.GetType();
                                var nameProp = t.GetProperty("FoodName");
                                var qtyProp = t.GetProperty("Quantity");
                                var priceProp = t.GetProperty("Price");
                                if (nameProp != null) { foodName = (nameProp.GetValue(item, null) ?? "N/A").ToString(); }
                                if (qtyProp != null) { int.TryParse((qtyProp.GetValue(item, null) ?? 0).ToString(), out quantity); }
                                if (priceProp != null) { decimal.TryParse((priceProp.GetValue(item, null) ?? 0).ToString(), out price); }
                            }
                            catch { }
                            var itemTotal = price * quantity;
                            <div class="food-item">
                                <div>
                                    <div style="font-weight: 600; color: #333;">@foodName</div>
                                    <div style="color: #666; font-size: 0.9rem;">Số lượng: @quantity</div>
                                </div>
                                <div style="font-weight: 600; color: #ff6b35;">@itemTotal.ToString("N0") ₫</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ✅ QR CODE Payment Section - MAIN -->
            @if (!string.IsNullOrEmpty(qrCodeUrl))
            {
                <div class="qr-payment-section">
                    <h3 style="margin-top: 0;">
                        <i class="fas fa-qrcode"></i> Quét Mã QR Để Thanh Toán
                    </h3>
                    <p>Sử dụng ứng dụng ngân hàng để quét mã QR dưới đây</p>
                    
                    <div class="qr-code-container">
                        <img src="@qrCodeUrl" alt="QR Code Payment" />
                    </div>

                    <div class="qr-instructions">
                        <strong>Hướng Dẫn Quét:</strong>
                        <ol>
                            <li>📱 Mở ứng dụng ngân hàng, Momo hoặc ZaloPay</li>
                            <li>📸 Chọn "Quét mã QR"</li>
                            <li>✅ Quét mã QR ở trên</li>
                            <li>💳 Xác nhận và nhập PIN</li>
                            <li>✔️ Sau thanh toán, nhấn nút "Xác Nhận Đã Thanh Toán"</li>
                        </ol>
                    </div>
                </div>
            }
        </div>

        <!-- Order Summary -->
        <div class="order-summary">
            <h3 class="summary-title">Tổng Đơn Hàng</h3>
            
            <div class="summary-line">
                <span>Tiền vé (@(tickets != null ? tickets.Count : 0) vé)</span>
                <span>@ticketTotal.ToString("N0") ₫</span>
            </div>

            @if (foodTotal > 0)
            {
                <div class="summary-line">
                    <span>Đồ ăn & thức uống</span>
                    <span>@foodTotal.ToString("N0") ₫</span>
                </div>
            }

            <div class="summary-total">
                <span>Tổng Cộng</span>
                <span class="total-value">@grandTotal.ToString("N0") ₫</span>
            </div>

            <button class="btn-confirm" onclick="confirmQRPayment(@bookingIdValue)">
                <i class="fas fa-check-circle"></i> Xác Nhận Đã Thanh Toán
            </button>

            <button class="btn-back" onclick="goBack()">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function confirmQRPayment(bookingId) {
            if (!confirm('Bạn đã quét mã QR và chuyển tiền xong chưa?\n\nNhấn OK nếu đã thanh toán.')) {
                return;
            }

            $('button').prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("ConfirmQRPayment", "Invoice")',
                type: 'POST',
                data: { bookingId: bookingId },
                success: function (response) {
                    if (response.success) {
                        alert('✅ ' + response.message);
                        window.location.href = response.redirectUrl;
                    } else {
                        alert('❌ Lỗi: ' + response.message);
                        $('button').prop('disabled', false);
                    }
                },
                error: function () {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại!');
                    $('button').prop('disabled', false);
                }
            });
        }
        
        function goBack() { 
            window.history.back(); 
        }
    </script>
}
