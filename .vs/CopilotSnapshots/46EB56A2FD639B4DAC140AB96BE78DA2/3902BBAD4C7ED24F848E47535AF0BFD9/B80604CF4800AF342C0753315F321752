@{
    ViewBag.Title = "Thanh Toán Thành Công";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    var booking = ViewBag.Booking as WebCinema.Models.Dat_Ve;
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    var foodItems = ViewBag.FoodItems as List<dynamic>;
    var ticketTotal = (decimal)ViewBag.TicketTotal;
    var foodTotal = (decimal)ViewBag.FoodTotal;
    var grandTotal = (decimal)ViewBag.GrandTotal;
}

<style>
    /* Match screenshot invoice style */
    .invoice-card { max-width: 980px; margin: 2.5rem auto; background: transparent; }

    .invoice-top {
        background: linear-gradient(135deg,#667eea,#764ba2);
        color: #fff;
        padding: 18px 22px;
        border-radius: 8px 8px 0 0;
        display:flex;
        justify-content:space-between;
        align-items:center;
    }
    .invoice-top .brand { font-weight:700; font-size:1.05rem; }
    .invoice-top .subtitle { font-size:0.9rem; opacity:0.95; }

    .invoice-top .right { text-align:right; }
    .invoice-top .right .invo-num { font-weight:700; font-size:1rem; }
    .invoice-top .right .invo-date { font-size:0.85rem; opacity:0.9; }

    .invoice-body {
        background:#fff; padding:22px; border:1px solid #e6e9ef; border-top:none; border-radius:0 0 8px 8px;
        box-shadow: 0 6px 20px rgba(16,24,40,0.04);
    }

    .info-row { display:flex; gap:18px; align-items:flex-start; }
    .customer-card { background:#fff; border:1px solid #eef2f7; padding:14px; border-radius:6px; width:320px; }
    .customer-card h5 { margin:0 0 6px 0; font-size:0.95rem; }
    .customer-card p { margin:2px 0; color:#6b7280; font-size:0.9rem; }

    .summary-card { margin-left:auto; background:#fff; border:1px solid #eef2f7; padding:14px; border-radius:6px; width:220px; }
    .summary-card .row { display:flex; justify-content:space-between; margin:6px 0; color:#6b7280; }
    .summary-card .row strong { color:#111827; }

    table.clean-table { width:100%; border-collapse:collapse; margin-top:16px; }
    table.clean-table thead th { text-align:left; padding:12px 10px; color:#6b7280; font-weight:700; background:#fbfdff; border-bottom:1px solid #f1f5f9; }
    table.clean-table tbody td { padding:12px 10px; border-bottom:1px solid #f6f7fb; color:#111827; }

    .totals { display:flex; justify-content:flex-end; margin-top:8px; }
    .totals .box { width:280px; background:transparent; }
    .totals .line { display:flex; justify-content:space-between; padding:8px 0; color:#6b7280; }
    .totals .line.total { font-weight:800; color:#111827; border-top:1px dashed #e6e9ee; padding-top:12px; margin-top:6px; }

    .ticket-codes { margin-top:18px; display:flex; gap:10px; flex-wrap:wrap; }
    .ticket-code-pill { padding:8px 12px; border-radius:6px; border:1px solid #e6eef8; background:#fff; font-family:'Courier New',monospace; font-weight:700; color:#111827; font-size:0.85rem; }

    .invoice-actions { display:flex; justify-content:center; gap:12px; margin-top:20px; }
    .btn-primary { background:#10b981; color:#fff; border:none; padding:10px 18px; border-radius:6px; font-weight:700; }
    .btn-outline { background:#fff; color:#374151; border:1px solid #d1d5db; padding:10px 16px; border-radius:6px; font-weight:700; }

    /* responsive */
    @media (max-width:860px) {
        .info-row { flex-direction:column; }
        .customer-card, .summary-card { width:100%; }
        .summary-card { margin-left:0; }
        .totals .box { width:100%; }
    }

    /* print: only body */
    @media print {
        body * { visibility:hidden; }
        .invoice-body, .invoice-body * { visibility:visible; }
        .invoice-body { position:absolute; left:0; top:0; width:100%; }
    }
</style>

<div class="invoice-card">
    <div class="invoice-top">
        <div>
            <div class="brand">DAV Cinema</div>
            <div class="subtitle">Hóa đơn thanh toán vé</div>
        </div>
        <div class="right">
            <div class="invo-num">HÓA ĐƠN #@booking.Dat_Ve_id</div>
            <div class="invo-date">@(booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("dd-MM-yyyy HH:mm") : "N/A")</div>
        </div>
    </div>

    <div class="invoice-body">
        <div class="info-row">
            <div class="customer-card">
                <h5>Khách hàng</h5>
                <div style="font-weight:700;">@booking.Khach_Hang.ho_ten</div>
                <p>@booking.Khach_Hang.email</p>
                <p>@(booking.Khach_Hang.so_dien_thoai ?? "N/A")</p>
            </div>

            <div class="summary-card">
                <div style="font-weight:700; margin-bottom:6px;">Chi tiết đơn</div>
                <div class="row"><span>Số vé</span><strong>@(tickets != null ? tickets.Count : 0)</strong></div>
                <div class="row"><span>Tiền vé</span><strong>@ticketTotal.ToString("N0") ₫</strong></div>
                <div class="row"><span>Đồ ăn</span><strong>@foodTotal.ToString("N0") ₫</strong></div>
            </div>
        </div>

        <table class="clean-table">
            <thead>
                <tr>
                    <th>Loại</th>
                    <th>Chi tiết</th>
                    <th class="text-right">Đơn giá</th>
                </tr>
            </thead>
            <tbody>
                @if (tickets != null)
                {
                    foreach (var t in tickets)
                    {
                        <tr>
                            <td>Vé</td>
                            <td>Ghế @t.Ghe.so_ghe</td>
                            <td class="text-right">@(t.gia_ve.ToString("N0")) ₫</td>
                        </tr>
                    }
                }

                @if (foodItems != null && foodItems.Count > 0)
                {
                    foreach (var item in foodItems)
                    {
                        string name = "N/A";
                        int qty = 0;
                        decimal price = 0m;
                        decimal total = 0m;
                        try {
                            var tt = item.GetType();
                            var pName = tt.GetProperty("FoodName");
                            var pQty = tt.GetProperty("Quantity");
                            var pPrice = tt.GetProperty("Price");
                            var pTotal = tt.GetProperty("TotalPrice");
                            if (pName != null) { name = (pName.GetValue(item, null) ?? "N/A").ToString(); }
                            if (pQty != null) { int.TryParse((pQty.GetValue(item, null) ?? 0).ToString(), out qty); }
                            if (pPrice != null) { decimal.TryParse((pPrice.GetValue(item, null) ?? 0).ToString(), out price); }
                            if (pTotal != null) { decimal.TryParse((pTotal.GetValue(item, null) ?? 0).ToString(), out total); }
                        } catch { }

                        <tr>
                            <td>Đồ ăn</td>
                            <td>@name x @qty</td>
                            <td class="text-right">@(total.ToString("N0")) ₫</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="totals">
            <div class="box">
                <div class="line"><span>Tạm tính</span><span>@((ticketTotal + foodTotal).ToString("N0")) ₫</span></div>
                <div class="line"><span>Khuyến mãi</span><span>-0 ₫</span></div>
                <div class="line total"><span>Tổng</span><span>@(grandTotal.ToString("N0")) ₫</span></div>
            </div>
        </div>

        <div>
            <div style="margin-top:16px; font-weight:700;">Mã Vé</div>
            <div class="ticket-codes">
                @if (tickets != null)
                {
                    foreach (var t in tickets)
                    {
                        var code = t.ma_qr_code ?? ("CODE-" + t.ve_id);
                        <div class="ticket-code">@code</div>
                    }
                }
            </div>
        </div>

        <div class="invoice-actions">
            <button class="btn btn-primary" onclick="window.print()"><i class="fas fa-print"></i> In hóa đơn</button>
            <a href="@Url.Action("Index","Home")" class="btn btn-outline"><i class="fas fa-home"></i> Về trang chủ</a>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // no script needed
    </script>
}
