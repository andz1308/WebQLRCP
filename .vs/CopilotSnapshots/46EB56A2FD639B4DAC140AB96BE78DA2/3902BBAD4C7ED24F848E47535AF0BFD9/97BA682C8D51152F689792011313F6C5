@{
    ViewBag.Title = "Thanh Toán Thành Công";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    var booking = ViewBag.Booking as WebCinema.Models.Dat_Ve;
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    var foodItems = ViewBag.FoodItems as List<dynamic>;
    var ticketTotal = (decimal)ViewBag.TicketTotal;
    var foodTotal = (decimal)ViewBag.FoodTotal;
    var grandTotal = (decimal)ViewBag.GrandTotal;
}

<style>
    /* Invoice-style layout */
    .invoice-wrap {
        max-width: 900px;
        margin: 2.5rem auto;
        background: #fff;
        border: 1px solid #e6e9ee;
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(19, 24, 31, 0.06);
        overflow: hidden;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        color: #222;
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(90deg, #3b82f6 0%, #6366f1 100%);
        color: white;
    }

    .invoice-header .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .invoice-header .brand img { height: 44px; width: auto; border-radius: 6px; }
    .invoice-header h1 { font-size: 1.25rem; margin: 0; font-weight: 700; }

    .invoice-main { padding: 1.5rem; }

    .invoice-meta {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .bill-to, .invoice-info-box {
        background: #f8fafc;
        padding: 1rem;
        border-radius: 6px;
    }

    .bill-to h4, .invoice-info-box h4 { margin: 0 0 0.5rem 0; font-size: 0.95rem; }

    .info-grid { display: flex; gap: 1rem; }
    .info-grid .col { flex: 1; }

    table.invoice-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        font-size: 0.95rem;
    }

    table.invoice-table th, table.invoice-table td {
        padding: 0.9rem 0.6rem;
        border-bottom: 1px solid #f1f5f9;
        text-align: left;
    }

    table.invoice-table th { background: #fbfdff; font-weight: 700; color: #374151; }

    .text-right { text-align: right; }

    .totals { margin-top: 1rem; display: flex; justify-content: flex-end; }
    .totals .box { width: 320px; }
    .totals .box .row { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px dashed #e6e9ee; }
    .totals .box .row.total { font-weight: 800; font-size: 1.1rem; border-top: 2px solid #e6e9ee; padding-top: 0.9rem; }

    .ticket-codes { margin-top: 1.25rem; display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .ticket-code { background: #fff; border: 1px solid #e5e7eb; padding: 0.6rem 0.8rem; border-radius: 6px; font-family: 'Courier New', monospace; font-weight: 700; font-size: 0.85rem; color: #111827; }

    .invoice-actions { display: flex; gap: 0.75rem; justify-content: center; padding: 1.25rem 1.5rem; background: #fafafa; }

    .btn { padding: 0.85rem 1.4rem; border-radius: 8px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.6rem; }
    .btn-primary { background: linear-gradient(90deg,#10b981,#06b6d4); color: white; }
    .btn-secondary { background: white; color: #374151; border: 1px solid #e5e7eb; }

    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(16,185,129,0.14); }
    .btn-secondary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(2,6,23,0.04); }

    @@media print {
        body * { visibility: hidden; }
        .invoice-wrap, .invoice-wrap * { visibility: visible; }
        .invoice-wrap { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; }
        .invoice-actions { display: none; }
    }
</style>

<div class="invoice-wrap">
    <div class="invoice-header">
        <div class="brand">
            <img src="/Content/images/logo.png" alt="Logo" onerror="this.style.display='none'" />
            <div>
                <h1>DAV Cinema</h1>
                <div style="font-size:0.85rem; opacity:0.9;">Hóa đơn thanh toán vé</div>
            </div>
        </div>
        <div class="invoice-id" style="text-align:right;">
            <div style="font-weight:700;">HÓA ĐƠN #@booking.Dat_Ve_id</div>
            <div style="font-size:0.85rem; opacity:0.9;">@(booking.ngay_tao.HasValue ? booking.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</div>
        </div>
    </div>

    <div class="invoice-main">
        <div class="invoice-meta">
            <div class="bill-to col">
                <h4>Khách hàng</h4>
                <div>@booking.Khach_Hang.ho_ten</div>
                <div style="font-size:0.95rem; color:#6b7280;">@booking.Khach_Hang.email</div>
                <div style="font-size:0.95rem; color:#6b7280;">@(booking.Khach_Hang.so_dien_thoai ?? "N/A")</div>
            </div>

            <div class="invoice-info-box col" style="max-width:320px;">
                <h4>Chi tiết đơn</h4>
                <div style="display:flex; justify-content:space-between; padding:0.2rem 0;"><span style="color:#6b7280;">Số vé</span><strong>@(tickets!=null?tickets.Count:0)</strong></div>
                <div style="display:flex; justify-content:space-between; padding:0.2rem 0;"><span style="color:#6b7280;">Tiền vé</span><strong>@(ticketTotal.ToString("N0")) ₫</strong></div>
                <div style="display:flex; justify-content:space-between; padding:0.2rem 0;"><span style="color:#6b7280;">Đồ ăn</span><strong>@(foodTotal.ToString("N0")) ₫</strong></div>
            </div>
        </div>

        <table class="invoice-table">
            <thead>
                <tr>
                    <th>Loại</th>
                    <th>Chi tiết</th>
                    <th class="text-right">Đơn giá</th>
                </tr>
            </thead>
            <tbody>
                @if (tickets != null)
                {
                    foreach (var t in tickets)
                    {
                        <tr>
                            <td>Vé</td>
                            <td>Ghế @t.Ghe.so_ghe</td>
                            <td class="text-right">@(t.gia_ve.ToString("N0")) ₫</td>
                        </tr>
                    }
                }

                @if (foodItems != null && foodItems.Count > 0)
                {
                    foreach (var item in foodItems)
                    {
                        string name = "N/A";
                        int qty = 0;
                        decimal price = 0m;
                        decimal total = 0m;
                        try {
                            var tt = item.GetType();
                            var pName = tt.GetProperty("FoodName");
                            var pQty = tt.GetProperty("Quantity");
                            var pPrice = tt.GetProperty("Price");
                            var pTotal = tt.GetProperty("TotalPrice");
                            if (pName != null) { name = (pName.GetValue(item, null) ?? "N/A").ToString(); }
                            if (pQty != null) { int.TryParse((pQty.GetValue(item, null) ?? 0).ToString(), out qty); }
                            if (pPrice != null) { decimal.TryParse((pPrice.GetValue(item, null) ?? 0).ToString(), out price); }
                            if (pTotal != null) { decimal.TryParse((pTotal.GetValue(item, null) ?? 0).ToString(), out total); }
                        } catch { }

                        <tr>
                            <td>Đồ ăn</td>
                            <td>@name x @qty</td>
                            <td class="text-right">@(total.ToString("N0")) ₫</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="totals">
            <div class="box">
                <div class="row"><span>Tạm tính</span><span>@((ticketTotal + foodTotal).ToString("N0")) ₫</span></div>
                <div class="row"><span>Khuyến mãi</span><span>-0 ₫</span></div>
                <div class="row total"><span>Tổng</span><span>@(grandTotal.ToString("N0")) ₫</span></div>
            </div>
        </div>

        <div>
            <div class="section-title" style="margin-top:1.25rem"><i class="fas fa-barcode"></i> Mã Vé</div>
            <div class="ticket-codes">
                @if (tickets != null)
                {
                    foreach (var t in tickets)
                    {
                        var code = t.ma_qr_code ?? ("CODE-" + t.ve_id);
                        <div class="ticket-code">@code</div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="invoice-actions">
        <button class="btn btn-primary" onclick="window.print()"><i class="fas fa-print"></i> In hóa đơn</button>
        <a href="@Url.Action("Index","Home")" class="btn btn-secondary"><i class="fas fa-home"></i> Về trang chủ</a>
    </div>
</div>

@section scripts {
    <script>
        // no script needed
    </script>
}
