@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

@model WebCinema.Models.Yeu_Cau_Huy_Ve

@{
    ViewBag.Title = "Chi Tiết Hủy Vé";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";

    var booking = Model.Dat_Ve;
    var customer = Model.Khach_Hang;
    var tickets = ViewBag.Tickets as System.Collections.Generic.List<WebCinema.Models.Ve> ?? new System.Collections.Generic.List<WebCinema.Models.Ve>();
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var timeSlot = ViewBag.TimeSlot as WebCinema.Models.Ca_Chieu;  // ✅ LẤY ca chiếu
}

<style>
    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .card-title {
        font-size: 1.5rem;
        color: #2c3e50;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .status-badge {
        display: inline-block;
        padding: 0.6rem 1.2rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .info-section {
        background: white;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-left: 4px solid #3498db;
    }

    .info-section h3 {
        margin-top: 0;
        color: #2c3e50;
        margin-bottom: 1rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .info-item {
        padding: 0;
    }

    .info-label {
        font-weight: 600;
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .info-value {
        color: #333;
        font-size: 1rem;
    }

    .bank-info {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        font-size: 1.1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .bank-label {
        opacity: 0.9;
        margin-bottom: 0.5rem;
    }

    .bank-account {
        font-size: 1.3rem;
        font-weight: 600;
        font-family: monospace;
    }

    .refund-highlight {
        background: linear-gradient(135deg, #f0f8f5 0%, #e8f5e9 100%);
        padding: 1.5rem;
        border-radius: 8px;
        border-left: 4px solid #27ae60;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .refund-amount {
        font-size: 2rem;
        font-weight: 700;
        color: #27ae60;
    }

    .refund-detail {
        font-size: 0.9rem;
        color: #555;
        margin-top: 0.5rem;
    }

    .tickets-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .ticket-box {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .ticket-seat {
        font-weight: 600;
        font-size: 1.1rem;
    }

    .ticket-price {
        font-size: 0.85rem;
        opacity: 0.9;
        margin-top: 0.5rem;
    }

    .btn-container {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-approve {
        background: #27ae60;
        color: white;
        flex: 1;
    }

    .btn-approve:hover {
        background: #229954;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(39, 174, 96, 0.3);
    }

    .btn-reject {
        background: #e74c3c;
        color: white;
        flex: 1;
    }

    .btn-reject:hover {
        background: #c0392b;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(231, 76, 60, 0.3);
    }

    .btn-back {
        background: #95a5a6;
        color: white;
    }

    .btn-back:hover {
        background: #7f8c8d;
    }
</style>

<div class="content-card">
    <div class="content-header">
        <h2 class="card-title">
            <i class="fas fa-trash-alt"></i> Yêu Cầu Hủy Vé #@Model.yeu_cau_id
        </h2>
        <div style="display: flex; gap: 1rem; align-items: center;">
            @if (Model.trang_thai == "Chờ duyệt")
            {
                <span class="status-badge status-pending">⏳ Chờ duyệt</span>
            }
            else if (Model.trang_thai == "Đã Hủy")
            {
                <span class="status-badge status-approved">✅ Đã duyệt</span>
            }
            else
            {
                <span class="status-badge status-rejected">❌ Từ chối</span>
            }
            <a href="@Url.Action("Index")" class="btn-action btn-back">
                <i class="fas fa-arrow-left"></i> Quay Lại
            </a>
        </div>
    </div>

    <!-- Thông tin khách hàng -->
    <div class="info-section">
        <h3><i class="fas fa-user"></i> Thông Tin Khách Hàng</h3>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Họ Tên</div>
                <div class="info-value">@(customer.ho_ten ?? "N/A")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Email</div>
                <div class="info-value">@(customer.email ?? "N/A")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Số Điện Thoại</div>
                <div class="info-value">@(customer.so_dien_thoai ?? "N/A")</div>
            </div>
            @*<div class="info-item">
                <div class="info-label">Phương Tiện Thanh Toán</div>
                <div class="info-value">@(Model.phuong_tien_thanh_toan ?? customer.phuong_tien_thanh_toan ?? "N/A")</div>
            </div>*@
            <div class="info-item">
                <div class="info-label">Điểm Tích Lũy</div>
                <div class="info-value">@(customer.diem_tich_luy ?? 0) ⭐</div>
            </div>
        </div>
    </div>

    <!-- Thông tin ngân hàng -->
    <div class="bank-info">
        <div class="bank-label">
            <i class="fas fa-bank"></i> Tài Khoản Nhận Tiền
        </div>
        <div class="bank-account">
            @(string.IsNullOrEmpty(Model.so_tai_khoan_atm) ? "N/A" : Model.so_tai_khoan_atm.Substring(Math.Max(0, Model.so_tai_khoan_atm.Length - 100)))
        </div>
        <div style="font-size: 0.9rem; margin-top: 0.8rem; opacity: 0.9;">
            ⏳ Khách sẽ nhận tiền trong 1-3 ngày làm việc
        </div>
    </div>

    <!-- Số tiền hoàn lại -->
    <div class="refund-highlight">
        <div style="margin-bottom: 0.8rem; font-weight: 600;">Số Tiền Hoàn Lại</div>
        <div class="refund-amount">@((Model.so_tien_hoan_lai ?? 0).ToString("N0")) ₫</div>
        <div class="refund-detail">
            Gốc: @(booking.tong_tien.ToString("N0") ?? "0") ₫ × 70% = @((Model.so_tien_hoan_lai ?? 0).ToString("N0")) ₫<br/>
            Phí hủy 30%: @(booking.tong_tien != null ? Math.Round(booking.tong_tien * 0.3m, 0).ToString("N0") : "0") ₫
        </div>
    </div>

    <!-- Thông tin đơn đặt -->
    <div class="info-section">
        <h3><i class="fas fa-receipt"></i> Thông Tin Đơn Đặt</h3>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Mã Đơn</div>
                <div class="info-value">@(booking.Dat_Ve_id)</div>
            </div>
            <div class="info-item">
                <div class="info-label">Phim</div>
                <div class="info-value">@(showtime.Phim.ten_phim ?? "N/A")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Ngày Chiếu</div>
                <div class="info-value">@(showtime.ngay_chieu.ToString("dd/MM/yyyy") ?? "N/A")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Ca Chiếu</div>
                <div class="info-value">@(timeSlot.gio_bat_dau.ToString(@"hh\:mm") ?? "N/A")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Rạp / Phòng</div>
                <div class="info-value">@(showtime.Phong_Chieu.Rap.ten_rap ?? "N/A") / @(showtime.Phong_Chieu.ten_phong ?? "N/A")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Tổng Tiền Gốc</div>
                <div class="info-value">@(booking.tong_tien.ToString("N0") ?? "0") ₫</div>
            </div>
            <div class="info-item">
                <div class="info-label">Số Vé</div>
                <div class="info-value">@(tickets.Count) vé</div>
            </div>
        </div>
    </div>

    <!-- Danh sách vé -->
    @if (tickets != null && tickets.Any())
    {
        <div class="info-section">
            <h3><i class="fas fa-couch"></i> Danh Sách Vé (@tickets.Count)</h3>
            <div class="tickets-list">
                @foreach (var ticket in tickets)
                {
                    <div class="ticket-box">
                        <div class="ticket-seat">Ghế @ticket.Ghe.so_ghe</div>
                        <div class="ticket-price">@ticket.gia_ve.ToString("N0") ₫</div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Lý do hủy -->
    @if (!string.IsNullOrEmpty(Model.ly_do_huy))
    {
        <div class="info-section">
            <h3><i class="fas fa-comment"></i> Lý Do Hủy</h3>
            <div style="background: white; padding: 1rem; border-radius: 6px; line-height: 1.6;">
                @Model.ly_do_huy
            </div>
        </div>
    }

    <!-- Lịch sử -->
    <div class="info-section">
        <h3><i class="fas fa-history"></i> Lịch Sử</h3>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Ngày Gửi Yêu Cầu</div>
                <div class="info-value">
                    @{
                        string formattedDate = "-"; // fallback nếu null hoặc không parse được
                        DateTime temp;
                        if (DateTime.TryParse(Model.ngay_tao.ToString(), out temp))
                        {
                            formattedDate = temp.ToString("dd/MM/yyyy HH:mm");
                        }
                    }
                    @formattedDate
                </div>
            </div>

            @if (Model.ngay_duyet.HasValue)
            {
                <div class="info-item">
                    <div class="info-label">Ngày Duyệt</div>
                    <div class="info-value">@Model.ngay_duyet.Value.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            }
        </div>
    </div>

    <!-- Ghi chú -->
    @if (!string.IsNullOrEmpty(Model.ghi_chu))
    {
        <div class="info-section">
            <h3><i class="fas fa-note-sticky"></i> Ghi Chú</h3>
            <div style="background: white; padding: 1rem; border-radius: 6px;">
                @Model.ghi_chu
            </div>
        </div>
    }

    <!-- Nút hành động -->
    @if (Model.trang_thai == "Chờ duyệt")
    {
        <div class="btn-container">
            <button class="btn-action btn-approve" onclick="approveCancel(@Model.yeu_cau_id)">
                <i class="fas fa-check"></i> Duyệt & Hoàn Tiền
            </button>
            <button class="btn-action btn-reject" onclick="rejectCancel(@Model.yeu_cau_id)">
                <i class="fas fa-times"></i> Từ Chối
            </button>
        </div>
    }
</div>

@section scripts {
    <script>
        function approveCancel(requestId) {
            let reason = prompt("Ghi chú khi duyệt (tùy chọn):", "Đã chuyển khoản");
            if (reason === null) return;

            $.ajax({
                url: '@Url.Action("ApproveCancel")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val(),
                    id: requestId,
                    note: reason
                },
                success: function(response) {
                    if (response.success) {
                        alert('✅ ' + response.message);
                        location.reload();
                    } else {
                        alert('❌ ' + response.message);
                    }
                },
                error: function() {
                    alert('❌ Có lỗi xảy ra!');
                }
            });
        }

        function rejectCancel(requestId) {
            let reason = prompt("Lý do từ chối:");
            if (reason === null) return;

            $.ajax({
                url: '@Url.Action("RejectCancel")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val(),
                    id: requestId,
                    reason: reason
                },
                success: function(response) {
                    if (response.success) {
                        alert('✅ ' + response.message);
                        location.reload();
                    } else {
                        alert('❌ ' + response.message);
                    }
                },
                error: function() {
                    alert('❌ Có lỗi xảy ra!');
                }
            });
        }
    </script>
}
