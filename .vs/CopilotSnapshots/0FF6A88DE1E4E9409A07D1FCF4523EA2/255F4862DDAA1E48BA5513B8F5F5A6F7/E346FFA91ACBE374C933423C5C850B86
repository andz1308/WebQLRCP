using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Web;
using WebCinema.Models;

namespace WebCinema.Services
{
    public class InvoiceService
    {
        private readonly string _invoiceFolder = "Content/hoadon";

        public InvoiceService()
        {
            // Tạo folder nếu không tồn tại
            string folderPath = Path.Combine(HttpContext.Current?.Server.MapPath("~") ?? AppDomain.CurrentDomain.BaseDirectory, _invoiceFolder);
            if (!Directory.Exists(folderPath))
            {
                Directory.CreateDirectory(folderPath);
            }
        }

        /// <summary>
        /// Tạo file hóa đơn HTML từ thông tin booking
        /// </summary>
        public string GenerateInvoiceHtml(Dat_Ve booking)
        {
            try
            {
                if (booking == null) return "";

                var tickets = booking.Ves.ToList();
                var firstTicket = tickets.FirstOrDefault();
                var showtime = firstTicket?.Suat_Chieu;

                // Tính toán thông tin
                decimal ticketTotal = tickets.Sum(t => t.gia_ve);
                decimal foodTotal = 0;
                var foodItems = new List<string>();

                foreach (var foodOrder in booking.DonHang_DoAns != null ? booking.DonHang_DoAns.ToList() : new List<DonHang_DoAn>())
                {
                    var food = foodOrder.Do_An;
                    if (food == null) continue;

                    decimal unitPrice = food.gia ?? 0m;
                    decimal itemTotal = unitPrice * foodOrder.so_luong;
                    foodTotal += itemTotal;

                    foodItems.Add($@"
                        <tr>
                            <td>{food.ten_san_pham}</td>
                            <td style='text-align: center;'>{foodOrder.so_luong}</td>
                            <td style='text-align: right;'>{unitPrice:N0} ₫</td>
                            <td style='text-align: right;'>{itemTotal:N0} ₫</td>
                        </tr>
                    ");
                }

                // Tạo danh sách vé
                var ticketRows = tickets.Select((t, index) => $@"
                    <tr>
                        <td>{index + 1}</td>
                        <td>{t.Ghe?.so_ghe ?? "N/A"}</td>
                        <td>{t.Ghe?.Loai_Ghe?.ten_loai ?? "N/A"}</td>
                        <td style='text-align: right;'>{t.gia_ve:N0} ₫</td>
                    </tr>
                ").ToList();

                string ticketRowsHtml = string.Join("", ticketRows);
                string foodRowsHtml = string.IsNullOrEmpty(string.Join("", foodItems)) ? @"
                    <tr>
                        <td colspan='4' style='text-align: center; color: #999;'>Không có đồ ăn</td>
                    </tr>
                " : string.Join("", foodItems);

                string html = $@"
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset='utf-8'>
                        <style>
                            * {{ margin: 0; padding: 0; box-sizing: border-box; }}
                            body {{ font-family: 'Times New Roman', Times, serif; color: #333; }}
                            .invoice-container {{ max-width: 800px; margin: 0 auto; padding: 30px; border: 1px solid #999; }}
                            .header {{ text-align: center; border-bottom: 2px solid #333; padding-bottom: 20px; margin-bottom: 20px; }}
                            .header h1 {{ font-size: 28px; color: #d32f2f; margin-bottom: 5px; }}
                            .header p {{ font-size: 14px; color: #666; }}
                            .invoice-info {{ display: flex; justify-content: space-between; margin-bottom: 20px; }}
                            .info-section {{ flex: 1; }}
                            .info-section h3 {{ font-size: 12px; font-weight: bold; text-transform: uppercase; margin-bottom: 5px; }}
                            .info-section p {{ font-size: 12px; margin-bottom: 3px; }}
                            .info-section strong {{ display: block; font-size: 14px; margin-bottom: 8px; }}
                            table {{ width: 100%; border-collapse: collapse; margin-bottom: 20px; }}
                            table th {{ background-color: #f5f5f5; border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 12px; font-weight: bold; }}
                            table td {{ border: 1px solid #ddd; padding: 10px; font-size: 12px; }}
                            table tr:nth-child(even) {{ background-color: #fafafa; }}
                            .section-title {{ font-size: 13px; font-weight: bold; margin-top: 20px; margin-bottom: 10px; text-transform: uppercase; border-bottom: 1px solid #ddd; padding-bottom: 5px; }}
                            .total-section {{ margin-top: 20px; border-top: 2px solid #333; padding-top: 15px; }}
                            .total-row {{ display: flex; justify-content: flex-end; margin-bottom: 8px; }}
                            .total-row span:first-child {{ width: 200px; text-align: right; }}
                            .total-row span:last-child {{ width: 100px; text-align: right; font-weight: bold; }}
                            .grand-total {{ display: flex; justify-content: flex-end; margin-top: 15px; padding-top: 10px; border-top: 1px solid #ddd; }}
                            .grand-total span:first-child {{ width: 200px; text-align: right; font-size: 14px; font-weight: bold; }}
                            .grand-total span:last-child {{ width: 100px; text-align: right; font-size: 16px; font-weight: bold; color: #d32f2f; }}
                            .footer {{ text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 11px; color: #999; }}
                            .qr-code-section {{ text-align: center; margin-top: 20px; }}
                            .qr-code-section img {{ max-width: 150px; }}
                        </style>
                    </head>
                    <body>
                        <div class='invoice-container'>
                            <div class='header'>
                                <h1>🎬 HÓA ĐƠN MUA VÉ</h1>
                                <p>WebCinema - Hệ Thống Đặt Vé Xem Phim Online</p>
                            </div>

                            <div class='invoice-info'>
                                <div class='info-section'>
                                    <h3>Mã Hóa Đơn</h3>
                                    <strong>BK{booking.Dat_Ve_id:D6}</strong>
                                    <p><small>Ngày lập: {booking.ngay_tao:dd/MM/yyyy HH:mm:ss}</small></p>
                                </div>
                                <div class='info-section'>
                                    <h3>Thông Tin Khách Hàng</h3>
                                    <p><strong>{booking.Khach_Hang?.ho_ten ?? "N/A"}</strong></p>
                                    <p>Email: {booking.Khach_Hang?.email ?? "N/A"}</p>
                                    <p>Điện thoại: {booking.Khach_Hang?.so_dien_thoai ?? "N/A"}</p>
                                </div>
                                <div class='info-section'>
                                    <h3>Trạng Thái</h3>
                                    <p style='color: #4caf50; font-weight: bold;'>{booking.trang_thai_Dat_Ve}</p>
                                </div>
                            </div>

                            <div class='section-title'>🎥 Thông Tin Suất Chiếu</div>
                            {(showtime != null ? $@"
                                <div style='background-color: #f5f5f5; padding: 15px; margin-bottom: 20px; border-radius: 5px;'>
                                    <p><strong>Phim:</strong> {showtime.Phim?.ten_phim ?? "N/A"}</p>
                                    <p><strong>Rạp:</strong> {showtime.Phong_Chieu?.Rap?.ten_rap ?? "N/A"}</p>
                                    <p><strong>Phòng:</strong> {showtime.Phong_Chieu?.ten_phong ?? "N/A"}</p>
                                    <p><strong>Ngày chiếu:</strong> {showtime.ngay_chieu:dd/MM/yyyy} - <strong>Giờ:</strong> {showtime.Ca_Chieu?.gio_bat_dau:hh\\:mm}</p>
                                </div>
                            " : "<p style='color: #999;'>Không có thông tin suất chiếu</p>")}

                            <div class='section-title'>🎟️ Danh Sách Vé</div>
                            <table>
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Ghế</th>
                                        <th>Loại Ghế</th>
                                        <th>Giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {ticketRowsHtml}
                                </tbody>
                            </table>

                            {(foodItems.Count > 0 ? $@"
                                <div class='section-title'>🍿 Đồ Ăn / Đồ Uống</div>
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Tên Sản Phẩm</th>
                                            <th>Số Lượng</th>
                                            <th>Đơn Giá</th>
                                            <th>Thành Tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {foodRowsHtml}
                                    </tbody>
                                </table>
                            " : "")}

                            <div class='total-section'>
                                <div class='total-row'>
                                    <span>Tổng Tiền Vé:</span>
                                    <span>{ticketTotal:N0} ₫</span>
                                </div>
                                {(foodTotal > 0 ? $@"
                                    <div class='total-row'>
                                        <span>Tổng Tiền Đồ Ăn:</span>
                                        <span>{foodTotal:N0} ₫</span>
                                    </div>
                                " : "")}
                                <div class='grand-total'>
                                    <span>TỔNG CỘNG:</span>
                                    <span>{booking.tong_tien:N0} ₫</span>
                                </div>
                            </div>

                            <div class='footer'>
                                <p>✅ Cảm ơn quý khách đã mua vé tại WebCinema</p>
                                <p>Vui lòng giữ hóa đơn này để kiểm tra vé tại rạp</p>
                                <p style='margin-top: 10px; border-top: 1px solid #ddd; padding-top: 10px;'>
                                    © 2024 WebCinema. Địa chỉ: 123 Đường Lê Lợi, TP.HCM | Hotline: 1900-xxxx
                                </p>
                            </div>
                        </div>
                    </body>
                    </html>
                ";

                return html;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error generating invoice HTML");
                return "";
            }
        }

        /// <summary>
        /// Lưu hóa đơn HTML vào file
        /// </summary>
        public string SaveInvoiceToFile(Dat_Ve booking)
        {
            try
            {
                string html = GenerateInvoiceHtml(booking);
                if (string.IsNullOrEmpty(html))
                    return "";

                string fileName = $"Invoice_BK{booking.Dat_Ve_id:D6}_{DateTime.Now:yyyyMMdd_HHmmss}.html";
                string folderPath = Path.Combine(HttpContext.Current?.Server.MapPath("~") ?? AppDomain.CurrentDomain.BaseDirectory, _invoiceFolder);
                string filePath = Path.Combine(folderPath, fileName);

                // Ghi file
                File.WriteAllText(filePath, html, Encoding.UTF8);

                LoggingHelper.LogInfo($"✅ Hóa đơn được lưu: {filePath}");
                return fileName;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error saving invoice to file");
                return "";
            }
        }

        /// <summary>
        /// Tạo file hóa đơn và gửi email cho khách hàng
        /// </summary>
        public bool GenerateAndSendInvoiceEmail(int bookingId)
        {
            try
            {
                var db = new CSDLDataContext();
                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null)
                    return false;

                var customer = booking.Khach_Hang;
                if (customer == null)
                    return false;

                // Kiểm tra email
                if (string.IsNullOrWhiteSpace(customer.email))
                {
                    LoggingHelper.LogError(new Exception($"Customer {customer.khach_hang_id} không có email"));
                    return false;
                }

                // Tạo file hóa đơn
                string invoiceFileName = SaveInvoiceToFile(booking);
                if (string.IsNullOrEmpty(invoiceFileName))
                    return false;

                // Gửi email
                var emailService = new EmailService();
                bool emailSent = emailService.SendInvoiceEmail(customer.email, customer.ho_ten, invoiceFileName);

                if (emailSent)
                {
                    LoggingHelper.LogInfo($"✅ Hóa đơn được gửi qua email: Booking {bookingId} -> {customer.email}");
                }

                return emailSent;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"Error in GenerateAndSendInvoiceEmail for booking {bookingId}");
                return false;
            }
        }
    }
}