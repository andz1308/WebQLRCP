using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Configuration;
using MailKit.Net.Smtp;
using MailKit.Security;
using MimeKit;
using System.IO;

namespace WebCinema.Services
{
    public class EmailService
    {
        private readonly string _smtpServer;
        private readonly int _smtpPort;
        private readonly string _senderEmail;
        private readonly string _senderPassword;
        private readonly bool _enableSSL;
        private readonly string _invoiceFolder;

        public EmailService()
        {
            _smtpServer = WebConfigurationManager.AppSettings["Email:SmtpServer"] ?? "smtp.gmail.com";
            _smtpPort = int.TryParse(WebConfigurationManager.AppSettings["Email:SmtpPort"], out var port) ? port : 587;
            _senderEmail = WebConfigurationManager.AppSettings["Email:SenderEmail"] ?? "your_email@gmail.com";
            _senderPassword = WebConfigurationManager.AppSettings["Email:SenderPassword"] ?? "your_app_password";
            _enableSSL = bool.TryParse(WebConfigurationManager.AppSettings["Email:EnableSSL"], out var ssl) ? ssl : true;
            _invoiceFolder = WebConfigurationManager.AppSettings["Email:InvoiceFolder"] ?? "Content/hoadon";
        }

        /// <summary>
        /// Gửi email hóa đơn cho khách hàng
        /// </summary>
        public bool SendInvoiceEmail(string recipientEmail, string customerName, string invoiceFileName)
        {
            try
            {
                // Kiểm tra email hợp lệ
                if (string.IsNullOrWhiteSpace(recipientEmail))
                {
                    LoggingHelper.LogError(new Exception("Recipient email is empty"));
                    return false;
                }

                // Kiểm tra file hóa đơn tồn tại
                string invoiceFilePath = Path.Combine(HttpContext.Current.Server.MapPath("~"), _invoiceFolder, invoiceFileName);
                if (!File.Exists(invoiceFilePath))
                {
                    LoggingHelper.LogError(new Exception($"Invoice file not found: {invoiceFilePath}"));
                    return false;
                }

                // Tạo email message
                var message = new MimeMessage();
                message.From.Add(new MailboxAddress("WebCinema", _senderEmail));
                message.To.Add(new MailboxAddress(customerName, recipientEmail));
                message.Subject = "Hóa Đơn Mua Vé Xem Phim - WebCinema";

                // Tạo body email
                var bodyBuilder = new BodyBuilder();
                bodyBuilder.HtmlBody = $@"
                    <html>
                    <head>
                        <meta charset='utf-8'>
                        <style>
                            body {{ font-family: Arial, sans-serif; color: #333; }}
                            .container {{ max-width: 600px; margin: 0 auto; padding: 20px; }}
                            .header {{ background-color: #f44336; color: white; padding: 15px; text-align: center; }}
                            .content {{ padding: 20px; border: 1px solid #ddd; }}
                            .footer {{ margin-top: 20px; text-align: center; font-size: 12px; color: #999; }}
                        </style>
                    </head>
                    <body>
                        <div class='container'>
                            <div class='header'>
                                <h1>🎬 WebCinema - Hóa Đơn Mua Vé</h1>
                            </div>
                            <div class='content'>
                                <p>Xin chào <strong>{customerName}</strong>,</p>
                                <p>Cảm ơn bạn đã mua vé tại WebCinema. Hóa đơn của bạn được đính kèm trong email này.</p>
                                <p>📎 <strong>Tên file hóa đơn:</strong> {invoiceFileName}</p>
                                <p style='color: #f44336;'><strong>Lưu ý:</strong> Vui lòng giữ file hóa đơn này cho việc kiểm tra vé tại rạp.</p>
                            </div>
                            <div class='footer'>
                                <p>© 2024 WebCinema. All rights reserved.</p>
                                <p>Nếu bạn có bất kỳ câu hỏi, vui lòng liên hệ: support@webcinema.com</p>
                            </div>
                        </div>
                    </body>
                    </html>
                ";

                // Đính kèm file hóa đơn
                bodyBuilder.Attachments.Add(invoiceFilePath);

                message.Body = bodyBuilder.ToMessageBody();

                // Gửi email qua SMTP
                using (var client = new SmtpClient())
                {
                    client.Connect(_smtpServer, _smtpPort, _enableSSL ? SecureSocketOptions.StartTls : SecureSocketOptions.None);
                    client.Authenticate(_senderEmail, _senderPassword);
                    client.Send(message);
                    client.Disconnect(true);
                }

                LoggingHelper.LogInfo($"✅ Email hóa đơn gửi thành công: {recipientEmail} - File: {invoiceFileName}");
                return true;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"Lỗi khi gửi email hóa đơn: {recipientEmail}");
                return false;
            }
        }

        /// <summary>
        /// Gửi email hóa đơn với nội dung HTML (không cần file)
        /// </summary>
        public bool SendInvoiceEmailWithHtml(string recipientEmail, string customerName, string invoiceHtml, string invoiceFileName = "")
        {
            try
            {
                if (string.IsNullOrWhiteSpace(recipientEmail))
                {
                    LoggingHelper.LogError(new Exception("Recipient email is empty"));
                    return false;
                }

                var message = new MimeMessage();
                message.From.Add(new MailboxAddress("WebCinema", _senderEmail));
                message.To.Add(new MailboxAddress(customerName, recipientEmail));
                message.Subject = "Hóa Đơn Mua Vé Xem Phim - WebCinema";

                var bodyBuilder = new BodyBuilder();
                bodyBuilder.HtmlBody = $@"
                    <html>
                    <head>
                        <meta charset='utf-8'>
                        <style>
                            body {{ font-family: Arial, sans-serif; color: #333; }}
                            .container {{ max-width: 600px; margin: 0 auto; padding: 20px; }}
                            .header {{ background-color: #f44336; color: white; padding: 15px; text-align: center; }}
                            .content {{ padding: 20px; border: 1px solid #ddd; }}
                            .footer {{ margin-top: 20px; text-align: center; font-size: 12px; color: #999; }}
                        </style>
                    </head>
                    <body>
                        <div class='container'>
                            <div class='header'>
                                <h1>🎬 WebCinema - Hóa Đơn Mua Vé</h1>
                            </div>
                            <div class='content'>
                                <p>Xin chào <strong>{customerName}</strong>,</p>
                                {invoiceHtml}
                                <p style='color: #f44336;'><strong>Lưu ý:</strong> Vui lòng giữ file hóa đơn này cho việc kiểm tra vé tại rạp.</p>
                            </div>
                            <div class='footer'>
                                <p>© 2024 WebCinema. All rights reserved.</p>
                                <p>Nếu bạn có bất kỳ câu hỏi, vui lòng liên hệ: support@webcinema.com</p>
                            </div>
                        </div>
                    </body>
                    </html>
                ";

                // Nếu có file hóa đơn, đính kèm
                if (!string.IsNullOrWhiteSpace(invoiceFileName))
                {
                    string invoiceFilePath = Path.Combine(HttpContext.Current.Server.MapPath("~"), _invoiceFolder, invoiceFileName);
                    if (File.Exists(invoiceFilePath))
                    {
                        bodyBuilder.Attachments.Add(invoiceFilePath);
                    }
                }

                message.Body = bodyBuilder.ToMessageBody();

                using (var client = new SmtpClient())
                {
                    client.Connect(_smtpServer, _smtpPort, _enableSSL ? SecureSocketOptions.StartTls : SecureSocketOptions.None);
                    client.Authenticate(_senderEmail, _senderPassword);
                    client.Send(message);
                    client.Disconnect(true);
                }

                LoggingHelper.LogInfo($"✅ Email hóa đơn HTML gửi thành công: {recipientEmail}");
                return true;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"Lỗi khi gửi email hóa đơn HTML: {recipientEmail}");
                return false;
            }
        }

