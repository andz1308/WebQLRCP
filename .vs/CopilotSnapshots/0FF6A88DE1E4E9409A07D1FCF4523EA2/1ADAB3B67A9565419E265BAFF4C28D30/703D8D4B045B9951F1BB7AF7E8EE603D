        /// <summary>
        /// Lưu HTML thành file
        /// </summary>
        public string SaveInvoiceToFile(Dat_Ve booking)
        {
            try
            {
                string html = GenerateInvoiceHtml(booking);
                if (string.IsNullOrEmpty(html))
                    return "";

                string fileName = $"Invoice_BK{booking.Dat_Ve_id:D6}_{DateTime.Now:yyyyMMdd_HHmmss}.html";
                string folderPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, _invoiceFolder);
                string filePath = Path.Combine(folderPath, fileName);

                // Ghi file
                File.WriteAllText(filePath, html, System.Text.Encoding.UTF8);

                LoggingHelper.LogInfo($"✅ Hóa đơn được lưu: {filePath}");
                return fileName;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error saving invoice to file");
                return "";
            }
        }

        /// <summary>
        /// Lưu HTML thành PDF
        /// </summary>
        public string SaveInvoiceToPdf(string htmlContent, int bookingId)
        {
            try
            {
                string fileName = $"Invoice_BK{bookingId}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
                string folderPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, _invoiceFolder);
                string filePath = Path.Combine(folderPath, fileName);

                // Dùng FileStream thay vì PdfDocument trực tiếp
                using (var fs = new FileStream(filePath, FileMode.Create, FileAccess.Write))
                {
                    iText.Html2pdf.HtmlConverter.ConvertToPdf(htmlContent, fs);
                }

                return fileName;
            }
            catch (Exception ex)
            {
                // logging nếu muốn
                return "";
            }
        }

        /// <summary>
        /// Tạo file hóa đơn và gửi email cho khách hàng
        /// </summary>
        public bool GenerateAndSendInvoiceEmail(int bookingId)
        {
            try
            {
                using (var db = new CSDLDataContext())
                {
                    // Lấy thông tin booking
                    var booking = db.Dat_Ves
                                    .Where(b => b.Dat_Ve_id == bookingId)
                                    .FirstOrDefault();

                    if (booking == null) return false;

                    // Kiểm tra email khách hàng
                    if (booking.Khach_Hang == null || string.IsNullOrWhiteSpace(booking.Khach_Hang.email))
                    {
                        LoggingHelper.LogError(new Exception($"Customer {booking.khach_hang_id} has no email"));
                        return false;
                    }

                    // Tạo file hóa đơn
                    string invoiceFileName = SaveInvoiceToFile(booking);
                    if (string.IsNullOrEmpty(invoiceFileName))
                        return false;

                    // Gửi email
                    var emailService = new EmailService();
                    bool emailSent = emailService.SendInvoiceEmail(
                        booking.Khach_Hang.email,
                        booking.Khach_Hang.ho_ten,
                        invoiceFileName
                    );

                    if (emailSent)
                    {
                        LoggingHelper.LogInfo($"✅ Hóa đơn được gửi qua email: Booking {bookingId} -> {booking.Khach_Hang.email}");
                    }

                    return emailSent;
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"❌ Lỗi GenerateAndSendInvoiceEmail: {ex.Message}");
                return false;
            }
        }
    }
}
