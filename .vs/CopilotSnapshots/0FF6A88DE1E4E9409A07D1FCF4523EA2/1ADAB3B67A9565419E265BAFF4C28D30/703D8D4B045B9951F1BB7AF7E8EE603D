using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using WebCinema.Models;
using WebCinema.Infrastructure;
using iText.Html2pdf;
using iText.Kernel.Pdf;

namespace WebCinema.Services
{
    public class InvoiceService
    {
        private readonly string _invoiceFolder = "Content/hoadon";

        public InvoiceService()
        {
            string folderPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, _invoiceFolder);
            if (!Directory.Exists(folderPath))
            {
                Directory.CreateDirectory(folderPath);
            }
        }

        /// <summary>
        /// Tạo HTML hóa đơn từ Dat_Ve
        /// </summary>
        public string GenerateInvoiceHtml(Dat_Ve booking)
        {
            try
            {
                if (booking == null) return "";

                // Lấy thông tin từ database
                using (var db = new CSDLDataContext())
                {
                    // Lấy danh sách vé
                    var tickets = db.Ves.Where(v => v.Dat_Ve_id == booking.Dat_Ve_id).ToList();

                    // Lấy showtime từ vé đầu tiên
                    var firstTicket = tickets.FirstOrDefault();
                    var showtime = firstTicket?.Suat_Chieu;

                    // Tính tổng tiền vé
                    decimal ticketTotal = tickets.Sum(t => t.gia_ve);

                    // Lấy danh sách đồ ăn
                    var foodItems = db.DonHang_DoAns
                        .Where(f => f.Dat_Ve_id == booking.Dat_Ve_id)
                        .Select(f => new
                        {
                            FoodName = f.Do_An.ten_san_pham,
                            Quantity = f.so_luong,
                            Price = f.Do_An.gia ?? 0m,
                            TotalPrice = (f.so_luong * (f.Do_An.gia ?? 0m))
                        })
                        .ToList<dynamic>();

                    decimal foodTotal = foodItems.Sum(f => f.TotalPrice ?? 0m);

                    // Tạo HTML
                    return GenerateInvoiceHtml(booking, showtime, tickets, foodItems, ticketTotal, foodTotal, "");
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error in GenerateInvoiceHtml(Dat_Ve)");
                return "";
            }
        }

