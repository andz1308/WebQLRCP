        // Helper controller used for rendering view to string
        private class EmptyController : System.Web.Mvc.Controller { }

        private string RenderViewToString(string viewName, System.Web.Mvc.Controller controller)
        {
            var httpContext = System.Web.HttpContext.Current;
            if (httpContext == null)
                throw new InvalidOperationException("No current HttpContext available for rendering views.");

            var routeData = new RouteData();
            routeData.Values["controller"] = controller.RouteData.Values["controller"] ?? "Invoice";

            var controllerContext = new ControllerContext(new HttpContextWrapper(httpContext), routeData, controller);

            var viewResult = ViewEngines.Engines.FindView(controllerContext, viewName, null);
            if (viewResult.View == null)
            {
                throw new FileNotFoundException($"View '{viewName}' was not found. Searched locations: {string.Join(",", viewResult.SearchedLocations ?? new string[0])}");
            }

            using (var sw = new StringWriter())
            {
                var viewContext = new ViewContext(controllerContext, viewResult.View, controller.ViewData, controller.TempData, sw);
                viewResult.View.Render(viewContext, sw);
                return sw.GetStringBuilder().ToString();
            }
        }

        /// <summary>
        /// Render the PaymentSuccess Razor view to HTML using current HttpContext and booking data.
        /// Falls back to inline HTML generator if rendering fails.
        /// </summary>
        public string RenderPaymentSuccessViewToHtml(Dat_Ve booking)
        {
            try
            {
                if (booking == null) return "";

                var tickets = new List<Ve>();
                Suat_Chieu showtime = null;
                List<dynamic> foodItems = new List<dynamic>();
                decimal ticketTotal = 0m;
                decimal foodTotal = 0m;
                decimal grandTotal = booking.tong_tien;

                using (var db = new CSDLDataContext())
                {
                    tickets = db.Ves.Where(v => v.Dat_Ve_id == booking.Dat_Ve_id).ToList();
                    showtime = tickets.FirstOrDefault()?.Suat_Chieu;
                    ticketTotal = tickets.Sum(t => t.gia_ve);

                    foodItems = db.DonHang_DoAns
                        .Where(f => f.Dat_Ve_id == booking.Dat_Ve_id)
                        .Select(f => new
                        {
                            FoodName = f.Do_An.ten_san_pham,
                            Quantity = (int)f.so_luong,
                            Price = (decimal)(f.Do_An.gia ?? 0m),
                            TotalPrice = (decimal)(f.so_luong * (f.Do_An.gia ?? 0m))
                        })
                        .ToList<dynamic>();

                    foodTotal = foodItems.Sum(f => (decimal)f.TotalPrice);
                }

                // Prepare controller and set ViewBag values used by PaymentSuccess.cshtml
                var controller = new EmptyController();
                controller.ViewData = new ViewDataDictionary();

                controller.ViewBag.Booking = booking;
                controller.ViewBag.Showtime = showtime;
                controller.ViewBag.Tickets = tickets;
                controller.ViewBag.FoodItems = foodItems;
                controller.ViewBag.TicketTotal = ticketTotal;
                controller.ViewBag.FoodTotal = foodTotal;
                controller.ViewBag.GrandTotal = grandTotal;
                controller.ViewBag.QRCodeUrl = string.Empty;

                // Render view (Invoice controller's PaymentSuccess view)
                try
                {
                    // viewName should be the view file name without extension and located under Views/Invoice
                    string html = RenderViewToString("PaymentSuccess", controller);
                    return html;
                }
                catch (Exception renderEx)
                {
                    LoggingHelper.LogError(renderEx, "RenderPaymentSuccessViewToHtml failed, falling back to inline generator");
                    // fallback to existing inline generator
                    return GenerateInvoiceHtml(booking, showtime, tickets, foodItems, ticketTotal, foodTotal, "");
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error in RenderPaymentSuccessViewToHtml");
                return "";
            }
        }
