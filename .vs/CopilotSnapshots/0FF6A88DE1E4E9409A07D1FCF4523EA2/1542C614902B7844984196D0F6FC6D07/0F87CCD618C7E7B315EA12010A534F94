        /// <summary>
        /// Tạo HTML hóa đơn từ Dat_Ve
        /// </summary>
        public string GenerateInvoiceHtml(Dat_Ve booking)
        {
            try
            {
                if (booking == null) return "";

                // Lấy thông tin từ database
                using (var db = new CSDLDataContext())
                {
                    // Lấy danh sách vé
                    var tickets = db.Ves.Where(v => v.Dat_Ve_id == booking.Dat_Ve_id).ToList();

                    // Lấy showtime từ vé đầu tiên
                    var firstTicket = tickets.FirstOrDefault();
                    var showtime = firstTicket?.Suat_Chieu;

                    // Tính tổng tiền vé
                    decimal ticketTotal = tickets.Sum(t => t.gia_ve);

                    // Lấy danh sách đồ ăn
                    var foodItems = db.DonHang_DoAns
                        .Where(f => f.Dat_Ve_id == booking.Dat_Ve_id)
                        .Select(f => new
                        {
                            FoodName = f.Do_An.ten_san_pham,
                            Quantity = (int)f.so_luong,
                            Price = (decimal)(f.Do_An.gia ?? 0m),
                            TotalPrice = (decimal)(f.so_luong * (f.Do_An.gia ?? 0m))
                        })
                        .ToList<dynamic>();

                    decimal foodTotal = foodItems.Sum(f => (decimal)f.TotalPrice);

                    // Tạo HTML
                    return GenerateInvoiceHtml(booking, showtime, tickets, foodItems, ticketTotal, foodTotal, "");
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error in GenerateInvoiceHtml(Dat_Ve)");
                return "";
            }
        }

