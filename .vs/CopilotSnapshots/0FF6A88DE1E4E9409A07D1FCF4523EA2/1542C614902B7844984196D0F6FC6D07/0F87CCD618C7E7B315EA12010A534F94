        /// <summary>
        /// Tạo HTML đầy đủ từ PaymentSuccess.cshtml template
        /// </summary>
        public string GenerateFullInvoiceHtml(Dat_Ve booking)
        {
            try
            {
                LoggingHelper.LogInfo($"🔄 GenerateFullInvoiceHtml: Starting for booking {booking?.Dat_Ve_id}");

                if (booking == null)
                {
                    LoggingHelper.LogError(new Exception("Booking is null"));
                    return "";
                }

                using (var db = new CSDLDataContext())
                {
                    // Lấy thông tin tickets
                    var tickets = db.Ves.Where(v => v.Dat_Ve_id == booking.Dat_Ve_id).ToList();
                    var showtime = tickets.FirstOrDefault()?.Suat_Chieu;

                    LoggingHelper.LogInfo($"✅ Found {tickets.Count} tickets, showtime: {showtime?.suat_chieu_id}");

                    // Tính toán totals
                    decimal ticketTotal = tickets.Sum(t => t.gia_ve);
                    var foodItems = db.DonHang_DoAns
                        .Where(f => f.Dat_Ve_id == booking.Dat_Ve_id)
                        .Select(f => new
                        {
                            FoodName = f.Do_An.ten_san_pham,
                            Quantity = (int)f.so_luong,
                            Price = (decimal)(f.Do_An.gia ?? 0m),
                            TotalPrice = (decimal)(f.so_luong * (f.Do_An.gia ?? 0m))
                        })
                        .ToList<dynamic>();
                    decimal foodTotal = foodItems.Sum(f => (decimal)f.TotalPrice);
                    decimal grandTotal = booking.tong_tien;

                    LoggingHelper.LogInfo($"✅ Totals: tickets={ticketTotal}, food={foodTotal}, grand={grandTotal}, foodItems={foodItems.Count}");

                    // Tạo HTML đầy đủ từ template
                    string html = GenerateInvoiceHtml(booking, showtime, tickets, foodItems, ticketTotal, foodTotal, "");

                    LoggingHelper.LogInfo($"✅ Generated HTML, length: {html?.Length ?? 0}");

                    return html;
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, "Error in GenerateFullInvoiceHtml");
                return "";
            }
        }

        /// <summary>
        /// Tạo PDF từ booking ID và gửi email (fallback to HTML nếu PDF lỗi)
        /// </summary>
        public bool GenerateAndSendFullInvoicePdf(int bookingId)
        {
            try
            {
                LoggingHelper.LogInfo($"🔄 GenerateAndSendFullInvoicePdf: Starting for booking {bookingId}");

                using (var db = new CSDLDataContext())
                {
                    var booking = db.Dat_Ve
                                    .Where(b => b.Dat_Ve_id == bookingId)
                                    .FirstOrDefault();

                    if (booking == null)
                    {
                        LoggingHelper.LogError(new Exception($"Booking {bookingId} not found"));
                        return false;
                    }

                    LoggingHelper.LogInfo($"✅ Found booking {bookingId}, customer ID: {booking.khach_hang_id}");

                    if (booking.Khach_Hang == null || string.IsNullOrWhiteSpace(booking.Khach_Hang.email))
                    {
                        LoggingHelper.LogError(new Exception($"Customer {booking.khach_hang_id} has no email"));
                        return false;
                    }

                    LoggingHelper.LogInfo($"✅ Customer has email: {booking.Khach_Hang.email}");

                    // Tạo HTML đầy đủ từ template
                    string htmlContent = GenerateFullInvoiceHtml(booking);

                    // Try render PaymentSuccess view HTML (prefer Razor view) - will fallback to generated HTML
                    string renderedHtml = RenderPaymentSuccessViewToHtml(booking);
                    if (!string.IsNullOrEmpty(renderedHtml)) htmlContent = renderedHtml;

                    if (string.IsNullOrEmpty(htmlContent))
                    {
                        LoggingHelper.LogError(new Exception("GenerateFullInvoiceHtml returned empty string"));
                        return false;
                    }

                    LoggingHelper.LogInfo($"✅ Generated HTML content, length: {htmlContent.Length}");

                    // Thử tạo PDF trước
                    string pdfFileName = "";
                    string fileToSend = "";

                    try
                    {
                        pdfFileName = SaveInvoiceToPdfFromHtml(htmlContent, bookingId);
                    }
                    catch (Exception pdfEx)
                    {
                        LoggingHelper.LogError(pdfEx, "PDF creation threw exception");
                        pdfFileName = "";
                    }

                    if (string.IsNullOrWhiteSpace(pdfFileName))
                    {
                        LoggingHelper.LogInfo($"⚠️ PDF generation failed or returned empty filename for booking {bookingId}, falling back to HTML");

                        // Fallback: Tạo HTML file thay vì PDF
                        var htmlFileName = SaveInvoiceToFile(booking);
                        if (string.IsNullOrWhiteSpace(htmlFileName))
                        {
                            LoggingHelper.LogError(new Exception("Both PDF and HTML file creation failed"));
                            return false;
                        }

                        fileToSend = htmlFileName;
                        LoggingHelper.LogInfo($"✅ Fallback: HTML file created: {fileToSend}");
                    }
                    else
                    {
                        fileToSend = pdfFileName;
                        LoggingHelper.LogInfo($"✅ PDF created successfully: {fileToSend}");
                    }

                    // Gửi email với file đính kèm (PDF hoặc HTML)
                    var emailService = new Services.EmailService();
                    bool emailSent = emailService.SendInvoiceEmail(
                        booking.Khach_Hang.email,
                        booking.Khach_Hang.ho_ten,
                        fileToSend
                    );

                    if (emailSent)
                    {
                        LoggingHelper.LogInfo($"✅ Invoice sent successfully: Booking {bookingId} -> {booking.Khach_Hang.email}");
                        return true;
                    }
                    else
                    {
                        LoggingHelper.LogError(new Exception("SendInvoiceEmail returned false"));
                        return false;
                    }
                }
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"❌ Lỗi GenerateAndSendFullInvoicePdf: {ex.Message}");
                return false;
            }
        }

