using System;
using System.Linq;
using System.Web.Mvc;
using WebCinema.Models;
using WebCinema.Infrastructure;
using WebCinema.Services;

namespace WebCinema.Areas.Admin.Controllers
{
    [RoleAuthorize(Roles = "Staff")]
    public class StaffOfflineBookingController : Controller
    {
        private CSDLDataContext db = new CSDLDataContext();

        // GET: Admin/StaffOfflineBooking
        public ActionResult Index()
        {
            var showtimes = db.Suat_Chieus
                .Where(s => s.ngay_chieu >= DateTime.Now.Date)
                .OrderBy(s => s.ngay_chieu)
                .ThenBy(s => s.Ca_Chieu.gio_bat_dau)
                .ToList();

            return View(showtimes);
        }

        // GET: Admin/StaffOfflineBooking/SelectSeats/{showtimeId}
        public ActionResult SelectSeats(int id)
        {
            var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == id);
            if (showtime == null)
                return HttpNotFound();

            var room = showtime.Phong_Chieu;
            // Only treat seats as booked when their associated booking is paid
            var bookedSeats = showtime.Ves
                .Where(v => v.Dat_Ve_id != null && v.Dat_Ve != null && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán")
                .Select(v => v.ghe_id)
                .ToList();
            var foods = db.Do_Ans.ToList();

            ViewBag.ShowtimeId = id;
            ViewBag.MovieName = showtime.Phim.ten_phim;
            ViewBag.ShowDate = showtime.ngay_chieu.ToString("dd/MM/yyyy");
            ViewBag.ShowTime = showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm");
            ViewBag.RoomName = room.ten_phong;
            ViewBag.BookedSeats = string.Join(",", bookedSeats);
            ViewBag.TicketPrice = showtime.gia_ve;
            ViewBag.Foods = foods;

            return View(room);
        }

        // POST: Admin/StaffOfflineBooking/CreateOfflineBooking
        [HttpPost]
        public ActionResult CreateOfflineBooking(int showtimeId, string selectedSeats, string customerPhone, string customerName, string foodOrders)
        {
            try
            {
                if (string.IsNullOrEmpty(selectedSeats))
                    return Json(new { success = false, message = "Vui lòng chọn ít nhất 1 ghế" });

                var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == showtimeId);
                if (showtime == null)
                    return Json(new { success = false, message = "Suất chiếu không tồn tại" });

                var seatIds = selectedSeats.Split(',').Select(int.Parse).ToList();

                // Kiểm tra ghế còn trống => only consider seats as taken when booking is paid
                var bookedSeats = showtime.Ves
                    .Where(v => v.Dat_Ve_id != null && v.Dat_Ve != null && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán")
                    .Select(v => v.ghe_id)
                    .ToList();

                var conflictSeats = seatIds.Where(s => bookedSeats.Contains(s)).ToList();
                if (conflictSeats.Any())
                    return Json(new { success = false, message = $"Ghế {string.Join(", ", conflictSeats)} đã được đặt" });

                // Tính tổng tiền vé (use existing ticket price if available)
                decimal ticketTotal = 0m;
                foreach (var seatId in seatIds)
                {
                    var existingTicket = db.Ves.FirstOrDefault(v => v.suat_chieu_id == showtimeId && v.ghe_id == seatId);
                    if (existingTicket != null)
                    {
                        ticketTotal += existingTicket.gia_ve;
                    }
                    else
                    {
                        ticketTotal += showtime.gia_ve;
                    }
                }

                decimal foodTotal = 0m;

                // Tạo đơn đặt vé
                var booking = new Dat_Ve
                {
                    ngay_tao = DateTime.Now,
                    trang_thai_Dat_Ve = "Đã Thanh toán",
                    tong_tien = ticketTotal // will add food total later
                };

                db.Dat_Ves.InsertOnSubmit(booking);
                db.SubmitChanges();

                // Tạo / cập nhật vé: prefer updating existing Ve records
                foreach (var seatId in seatIds)
                {
                    var existingTicket = db.Ves.FirstOrDefault(v => v.suat_chieu_id == showtimeId && v.ghe_id == seatId);
                    var qrCode = Guid.NewGuid().ToString();

                    if (existingTicket != null)
                    {
                        existingTicket.Dat_Ve_id = booking.Dat_Ve_id;
                        existingTicket.gia_ve = existingTicket.gia_ve; // keep existing price
                        existingTicket.trang_thai_ve = "Chưa sử dụng";
                        // Some DB schemas may have a payment status column; update if exists
                        try { existingTicket.GetType().GetProperty("trang_thai_thanh_toan")?.SetValue(existingTicket, "Đã thanh toán"); } catch { }
                        existingTicket.ma_qr_code = qrCode;
                    }
                    else
                    {
                        // fallback: insert a new ticket if it does not exist
                        var ticket = new Ve
                        {
                            suat_chieu_id = showtimeId,
                            ghe_id = seatId,
                            Dat_Ve_id = booking.Dat_Ve_id,
                            gia_ve = showtime.gia_ve,
                            trang_thai_ve = "Chưa sử dụng",
                            ma_qr_code = qrCode
                        };

                        db.Ves.InsertOnSubmit(ticket);
                    }
                }

                // Xử lý đồ ăn nếu có
                if (!string.IsNullOrEmpty(foodOrders))
                {
                    var foodItems = System.Xml.Linq.XDocument.Parse(foodOrders)
                        .Descendants("item")
                        .ToList();

                    foreach (var foodItem in foodItems)
                    {
                        int foodId = int.Parse(foodItem.Element("id")?.Value ?? "0");
                        int quantity = int.Parse(foodItem.Element("quantity")?.Value ?? "0");

                        if (foodId > 0 && quantity > 0)
                        {
                            var food = db.Do_Ans.FirstOrDefault(d => d.Do_An_id == foodId);
                            if (food != null)
                            {
                                var donHangFood = new DonHang_DoAn
                                {
                                    Dat_Ve_id = booking.Dat_Ve_id,
                                    Do_An_id = foodId,
                                    so_luong = quantity
                                };

                                db.DonHang_DoAns.InsertOnSubmit(donHangFood);
                                foodTotal += (food.gia ?? 0m) * quantity;
                            }
                        }
                    }
                }

                booking.tong_tien = ticketTotal + foodTotal;
                db.SubmitChanges();

                return Json(new
                {
                    success = true,
                    message = "Đặt vé thành công",
                    bookingId = booking.Dat_Ve_id,
                    totalSeats = seatIds.Count,
                    totalPrice = booking.tong_tien
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        // GET: Admin/StaffOfflineBooking/TicketVerification
        public ActionResult TicketVerification()
        {
            return View();
        }

        // POST: Admin/StaffOfflineBooking/VerifyTicket
        [HttpPost]
        public ActionResult VerifyTicket(string qrCode)
        {
            try
            {
                if (string.IsNullOrEmpty(qrCode))
                    return Json(new { success = false, message = "Vui lòng nhập mã QR" });

                var ticket = db.Ves.FirstOrDefault(v => v.ma_qr_code == qrCode.Trim());
                if (ticket == null)
                    return Json(new { success = false, message = "Mã QR không tồn tại" });

                var showtime = ticket.Suat_Chieu;
                var booking = ticket.Dat_Ve;
                var seat = ticket.Ghe;
                var movie = showtime.Phim;
                var room = showtime.Phong_Chieu;

                // Cập nhật trạng thái vé
                ticket.trang_thai_ve = "Đã sử dụng";
                db.SubmitChanges();

                return Json(new
                {
                    success = true,
                    message = "Vé hợp lệ",
                    data = new
                    {
                        movieName = movie.ten_phim,
                        customerName = booking.Khach_Hang != null ? booking.Khach_Hang.ho_ten : "Khách lẻ",
                        customerPhone = booking.Khach_Hang != null ? booking.Khach_Hang.so_dien_thoai : "N/A",
                        showDate = showtime.ngay_chieu.ToString("dd/MM/yyyy"),
                        showTime = showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm"),
                        roomName = room.ten_phong,
                        seatNumber = seat.so_ghe,
                        ticketPrice = ticket.gia_ve,
                        ticketStatus = ticket.trang_thai_ve,
                        qrCode = qrCode
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        // POST: Admin/StaffOfflineBooking/CheckSeatStatus
        [HttpPost]
        public ActionResult CheckSeatStatus(int showtimeId)
        {
            try
            {
                var showtime = db.Suat_Chieus.FirstOrDefault(s => s.suat_chieu_id == showtimeId);
                if (showtime == null)
                    return Json(new { success = false, message = "Suất chiếu không tồn tại" });

                // Only report seats that are actually paid
                var bookedSeats = showtime.Ves
                    .Where(v => v.Dat_Ve_id != null && v.Dat_Ve != null && v.Dat_Ve.trang_thai_Dat_Ve == "Đã Thanh toán")
                    .Select(v => new { v.ghe_id, so_ghe = v.Ghe.so_ghe })
                    .ToList();

                var totalSeats = showtime.Phong_Chieu.Ghes.Count();
                var availableSeats = totalSeats - bookedSeats.Count();

                return Json(new
                {
                    success = true,
                    totalSeats = totalSeats,
                    bookedSeats = bookedSeats,
                    availableSeats = availableSeats,
                    occupancyRate = Math.Round((double)bookedSeats.Count() / (totalSeats == 0 ? 1 : totalSeats) * 100, 2)
                });
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = "Lỗi: " + ex.Message });
            }
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
                db.Dispose();
            base.Dispose(disposing);
        }
    }
}
