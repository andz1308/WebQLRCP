<!--  Cart Overlay -->
<div class="cart-overlay" id="cartOverlay"></div>

<!--  Shopping Cart Modal -->
<div class="cart-modal" id="cartModal">
    <div class="cart-header">
        <span>🛒 Giỏ Hàng</span>
        <span class="cart-close" onclick="toggleCart()">✕</span>
    </div>
    <div class="cart-items" id="cartItems">
        <div class="cart-empty">Đang tải...</div>
    </div>
    <div class="cart-footer">
        <div class="cart-total">
            <span>Tổng cộng:</span>
            <span class="cart-total-price" id="cartTotal">0 ₫</span>
        </div>
        <button class="cart-checkout" onclick="goToCheckout()">Thanh Toán</button>
    </div>
</div>

<script>
    // Load cart data when page loads
    $(document).ready(function() {
        loadCartData();
    });

    function loadCartData() {
        $.ajax({
            url: '@Url.Action("GetCartData", "Cart")',
            type: 'GET',
            success: function(response) {
                if (response.success) {
                    updateCartDisplay(response);
                }
            },
            error: function() {
                $('#cartItems').html('<div class="cart-empty">Không thể tải giỏ hàng</div>');
            }
        });
    }

    function updateCartDisplay(data) {
        $('#cartCount').text(data.count);
        
        if (data.items.length === 0) {
            $('#cartItems').html('<div class="cart-empty">Giỏ hàng trống</div>');
            $('#cartTotal').text('0 ₫');
            return;
        }

        var html = '';
        data.items.forEach(function(item) {
            html += '<div class="cart-item">';
            html += '  <div class="cart-item-name">' + item.movieName + '</div>';
            html += '  <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.3rem;">';
            html += '    <i class="fas fa-building"></i> ' + item.cinemaName + ' - ' + item.roomName;
            html += '  </div>';
            html += '  <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.3rem;">';
            html += '    <i class="fas fa-calendar"></i> ' + item.showDate + ' ' + item.showTime;
            html += '  </div>';
            html += '  <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem;">';
            html += '    <i class="fas fa-couch"></i> ' + item.seats;
            html += '  </div>';
            html += '  <div class="cart-item-price">' + item.totalPrice.toLocaleString('vi-VN') + ' ₫</div>';
            html += '  <button class="qty-btn" style="width: 100%; margin-top: 0.5rem; background: #e74c3c;" onclick="removeFromCart(\'' + item.cartItemId + '\')">Xóa</button>';
            html += '</div>';
        });

        $('#cartItems').html(html);
        $('#cartTotal').text(data.total.toLocaleString('vi-VN') + ' ₫');
    }

    function removeFromCart(cartItemId) {
        if (!confirm('Bạn có chắc muốn xóa vé này?')) {
            return;
        }

        $.ajax({
            url: '@Url.Action("Remove", "Cart")',
            type: 'POST',
            data: { cartItemId: cartItemId },
            success: function(response) {
                if (response.success) {
                    loadCartData();
                } else {
                    alert('Có lỗi xảy ra');
                }
            }
        });
    }

    function goToCheckout() {
        window.location.href = '@Url.Action("Checkout", "Cart")';
    }
</script>

