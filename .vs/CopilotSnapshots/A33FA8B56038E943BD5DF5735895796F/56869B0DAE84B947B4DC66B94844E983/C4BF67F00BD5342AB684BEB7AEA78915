@using WebCinema.Areas.Admin.Controllers
@model ManagerDashboardViewModel

@{
    ViewBag.Title = "Quản Lý Nhập & Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<style>
    /* Orange Theme Styles */
    .content-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 2px solid #ff9966;
    }

        .content-header h1 {
            color: #ff6b35;
            font-weight: 700;
            margin: 0;
        }

            .content-header h1 i {
                margin-right: 0.5rem;
            }

    /* Tab Navigation */
    .tab-navigation {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 2rem;
        border-bottom: 3px solid #ffe8dc;
        padding-bottom: 0;
    }

    .tab-link {
        padding: 1rem 2rem;
        background: white;
        border: 2px solid #ffe8dc;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
        text-decoration: none;
        color: #666;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .tab-link:hover {
            background: #fff5f0;
            color: #ff6b35;
            border-color: #ff9966;
        }

        .tab-link.active {
            background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
            color: white;
            border-color: #ff6b35;
            transform: translateY(3px);
        }

            .tab-link.active i {
                animation: pulse 2s infinite;
            }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }
    }

    /* Filter Card */
    .filter-card {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
    }

    /* Content Card */
    .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.5rem;
        border-bottom: none;
    }

        .card-header h3 {
            color: white;
            margin: 0;
            font-weight: 700;
        }

            .card-header h3 i {
                margin-right: 0.5rem;
            }

    /* Table Styles */
    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background: #fff5f0;
            color: #ff6b35;
            font-weight: 600;
            border-bottom: 2px solid #ff9966;
        }

        .table tbody tr:hover {
            background: #fff5f0;
        }

    /* Status Badges */
    .badge-status {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .badge-pending {
        background: #fff3cd;
        color: #856404;
    }

    .badge-approved {
        background: #d4edda;
        color: #155724;
    }

    .badge-completed {
        background: #d1ecf1;
        color: #0c5460;
    }

    .badge-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    /* Action Buttons */
    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-view {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
    }

        .btn-view:hover {
            background: linear-gradient(135deg, #ff6b35 0%, #ff5722 100%);
            transform: translateY(-2px);
            color: white;
        }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        padding: 1.5rem;
        flex-wrap: wrap;
    }

        .pagination a,
        .pagination span {
            padding: 0.5rem 1rem;
            border: 2px solid #ffe8dc;
            border-radius: 6px;
            text-decoration: none;
            color: #333;
            font-weight: 500;
            transition: all 0.3s ease;
            display: inline-block;
            min-width: 40px;
            text-align: center;
        }

            .pagination a:hover {
                background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
                color: white;
                border-color: #ff6b35;
                transform: translateY(-2px);
            }

        .pagination .active {
            background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
            color: white;
            border-color: #ff6b35;
            font-weight: 700;
        }

        .pagination .disabled {
            opacity: 0.5;
            cursor: not-allowed;
            pointer-events: none;
        }

    .pagination-info {
        text-align: center;
        color: #ff6b35;
        margin-top: 1rem;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .form-control {
        border: 2px solid #ffe8dc;
        border-radius: 8px;
    }

        .form-control:focus {
            border-color: #ff9966;
            box-shadow: 0 0 0 3px rgba(255, 153, 102, 0.1);
        }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #999;
    }

        .empty-state i {
            font-size: 4rem;
            color: #ffe8dc;
            margin-bottom: 1rem;
        }
</style>

<div class="content-header">
    <h1><i class="fas fa-tasks"></i> Quản Lý Nhập & Khuyến Mãi @(isAdmin ? "(Toàn Hệ Thống)" : "")</h1>
</div>

<!-- Tab Navigation -->
<div class="tab-navigation">
    <a href="@Url.Action("Index", "ManagerPurchaseOrder")" class="tab-link active">
        <i class="fas fa-box-open"></i> Yêu Cầu Nhập Kho
    </a>
    <a href="@Url.Action("Promotions", "ManagerPurchaseOrder")" class="tab-link">
        <i class="fas fa-tags"></i> Đề Xuất Khuyến Mãi
    </a>
</div>

<!-- Filter -->
<div class="filter-card">
    @using (Html.BeginForm("Index", "ManagerPurchaseOrder", FormMethod.Get))
    {
        <div class="row align-items-center">
            <div class="col-md-4">
                <label style="color: #ff6b35; font-weight: 600;">
                    <i class="fas fa-filter"></i> Lọc Trạng Thái:
                </label>
                <select name="status" class="form-control" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                    <option value="Chờ duyệt" @(ViewBag.SelectedStatus == "Chờ duyệt" ? "selected" : "")>Chờ duyệt</option>
                    <option value="Đã duyệt" @(ViewBag.SelectedStatus == "Đã duyệt" ? "selected" : "")>Đã duyệt</option>
                    <option value="Đã nhập" @(ViewBag.SelectedStatus == "Đã nhập" ? "selected" : "")>Hoàn thành / Đã nhập</option>
                    <option value="Đã hủy" @(ViewBag.SelectedStatus == "Đã hủy" ? "selected" : "")>Đã hủy / Từ chối</option>
                </select>
            </div>
            <div class="col-md-8 text-right">
                <span class="text-muted"><i class="fas fa-info-circle"></i> Bộ lọc áp dụng cho danh sách bên dưới</span>
            </div>
        </div>
    }
</div>

<!-- Content -->
<div class="content-card">
    <div class="card-header">
        <h3><i class="fas fa-box-open"></i> Yêu Cầu Nhập Kho</h3>
    </div>
    <div style="overflow-x: auto;">
        @if (Model.DSNhapKho != null && Model.DSNhapKho.Any())
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã</th>
                        @if (isAdmin)
                        {
                            <th>Rạp</th>
                        }
                        <th>Ngày</th>
                        <th>Lý Do</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DSNhapKho)
                    {
                        <tr>
                            <td><strong>#@item.phieu_nhap_id</strong></td>
                            @if (isAdmin)
                            {
                                <td>@(item.Rap != null ? item.Rap.ten_rap : "N/A")</td>
                            }
                            <td>@item.ngay_nhap.ToString("dd/MM/yyyy")</td>
                            <td>@(item.ly_do ?? "Không rõ")</td>
                            <td>
                                @if (item.trang_thai == "Chờ duyệt")
                                {
                                    <span class="badge-status badge-pending">⏳ Chờ duyệt</span>
                                }
                                else if (item.trang_thai == "Đã duyệt")
                                {
                                    <span class="badge-status badge-approved">✅ Đã duyệt</span>
                                }
                                else if (item.trang_thai == "Đã nhập")
                                {
                                    <span class="badge-status badge-completed">📦 Đã nhập</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-cancelled">❌ Đã hủy</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = item.phieu_nhap_id })" class="btn-action btn-view">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="pagination">
                    @if (currentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, page = 1 })">
                            <i class="fas fa-angle-double-left"></i>
                        </a>
                    }
                    else
                    {
                        <span class="disabled"><i class="fas fa-angle-double-left"></i></span>
                    }

                    @if (currentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, page = currentPage - 1 })">
                            <i class="fas fa-angle-left"></i>
                        </a>
                    }
                    else
                    {
                        <span class="disabled"><i class="fas fa-angle-left"></i></span>
                    }

                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);

                        if (startPage > 1)
                        {
                            <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, page = 1 })">1</a>
                            if (startPage > 2)
                            {
                                <span>...</span>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == currentPage)
                            {
                                <span class="active">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, page = i })">@i</a>
                            }
                        }

                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <span>...</span>
                            }
                            <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, page = totalPages })">@totalPages</a>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, page = currentPage + 1 })">
                            <i class="fas fa-angle-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="disabled"><i class="fas fa-angle-right"></i></span>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.SelectedStatus, page = totalPages })">
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="disabled"><i class="fas fa-angle-double-right"></i></span>
                    }
                </div>

                <div class="pagination-info">
                    Hiển thị @((currentPage - 1) * 10 + 1) - @Math.Min(currentPage * 10, totalItems) trong tổng số @totalItems phiếu
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>Chưa có yêu cầu nhập kho nào</p>
            </div>
        }
    </div>
</div>