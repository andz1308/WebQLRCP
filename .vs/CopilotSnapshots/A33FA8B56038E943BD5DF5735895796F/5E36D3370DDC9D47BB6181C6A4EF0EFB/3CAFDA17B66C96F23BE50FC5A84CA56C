@model IEnumerable<WebCinema.Areas.Admin.Controllers.DetailImportViewModel>

@{
    ViewBag.Title = "Chi Tiết Phiếu Nhập";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    var phieu = ViewBag.PhieuInfo as WebCinema.Models.Phieu_Nhap;
}

<div class="content-header">
    <h1><i class="fas fa-file-invoice"></i> Chi Tiết Phiếu Nhập #PN-@phieu.phieu_nhap_id</h1>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="content-card">
            <div class="card-header">
                <h3>Thông Tin Chung</h3>
            </div>
            <div style="padding: 15px;">
                <p><strong>Ngày tạo:</strong> @phieu.ngay_nhap.Value.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Nhân viên yêu cầu:</strong> @(phieu.Nhan_Vien != null ? phieu.Nhan_Vien.ho_ten : "N/A")</p>
                <p>
                    <strong>Trạng thái:</strong>
                    <span style="font-weight:bold; color: @(phieu.trang_thai=="Chờ duyệt"?"orange": (phieu.trang_thai=="Đã nhập"?"green":"blue"))">
                        @phieu.trang_thai
                    </span>
                </p>
                <p><strong>Ghi chú:</strong> @phieu.ghi_chu</p>

                @if (phieu.trang_thai == "Chờ duyệt")
                {
                    <hr />
                    <div style="display:flex; gap:10px;">
                        <button onclick="approveOrder(@phieu.phieu_nhap_id)" class="btn btn-success btn-block">
                            <i class="fas fa-check"></i> Duyệt Ngay
                        </button>
                        <button onclick="rejectOrder(@phieu.phieu_nhap_id)" class="btn btn-danger btn-block">
                            <i class="fas fa-times"></i> Hủy
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="content-card">
            <div class="card-header">
                <h3>Danh Sách Hàng Hóa</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Tên Món</th>
                        <th>Loại</th>
                        <th class="text-center">Số Lượng Yêu Cầu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.TenMon</strong></td>
                            <td><span class="badge badge-info">@item.Loai</span></td>
                            <td class="text-center" style="font-size: 1.1em; font-weight: bold;">@item.SoLuong</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function approveOrder(id) {
        if (confirm('Xác nhận DUYỆT phiếu nhập hàng này?')) {
            $.post('@Url.Action("Approve")', { id: id }, function (res) {
                if (res.success) {
                    alert(res.message);
                    window.location.href = '@Url.Action("Index")';
                } else {
                    alert(res.message);
                }
            });
        }
    }

    function rejectOrder(id) {
        var reason = prompt("Nhập lý do từ chối:");
        if (reason != null) {
            $.post('@Url.Action("Reject")', { id: id, reason: reason }, function (res) {
                if (res.success) {
                    alert(res.message);
                    window.location.href = '@Url.Action("Index")';
                } else {
                    alert(res.message);
                }
            });
        }
    }
</script>