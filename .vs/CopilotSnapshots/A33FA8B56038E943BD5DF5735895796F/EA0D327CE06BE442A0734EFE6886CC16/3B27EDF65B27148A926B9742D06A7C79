@model IEnumerable<WebCinema.Areas.Admin.Controllers.DetailImportViewModel>

@{
    ViewBag.Title = "Chi Tiết Phiếu Nhập";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    var phieu = ViewBag.PhieuInfo as WebCinema.Models.Phieu_Nhap;
}

<style>
    /* Orange Theme Styles */
    .page-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 2px solid #ff9966;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .page-header h1 {
            color: #ff6b35;
            font-weight: 700;
            margin: 0;
        }

            .page-header h1 i {
                margin-right: 0.5rem;
            }

    .back-btn {
        background: white;
        color: #ff6b35;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: 2px solid #ffe8dc;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .back-btn:hover {
            background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
            color: white;
            border-color: #ff6b35;
            text-decoration: none;
            transform: translateX(-5px);
        }

    .detail-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.5rem;
        border-bottom: none;
    }

        .card-header h3 {
            color: white;
            margin: 0;
            font-weight: 700;
            font-size: 1.3rem;
        }

            .card-header h3 i {
                margin-right: 0.5rem;
            }

    .card-body {
        padding: 2rem;
    }

    .info-group {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: #fff5f0;
        border-radius: 8px;
        border-left: 4px solid #ff6b35;
    }

        .info-group label {
            color: #666;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
        }

        .info-group .value {
            color: #333;
            font-size: 1.1rem;
            font-weight: 600;
        }

    .status-badge {
        padding: 0.6rem 1.2rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
        display: inline-block;
        margin-top: 0.5rem;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-completed {
        background: #d1ecf1;
        color: #0c5460;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    .table thead th {
        background: #fff5f0;
        color: #ff6b35;
        font-weight: 600;
        border-bottom: 2px solid #ff9966;
        padding: 1rem;
    }

    .table tbody td {
        padding: 1rem;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #fff5f0;
    }

    .badge-info {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .btn-approve {
        flex: 1;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 1rem;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-approve:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(40, 167, 69, 0.3);
        }

    .btn-reject {
        flex: 1;
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 1rem;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-reject:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.3);
        }

    .quantity-cell {
        text-align: center;
        font-size: 1.3rem;
        font-weight: 700;
        color: #ff6b35;
    }

    .timeline-section {
        margin-top: 2rem;
        padding: 1.5rem;
        background: #fff5f0;
        border-radius: 10px;
        border-left: 4px solid #ff6b35;
    }

        .timeline-section h4 {
            color: #ff6b35;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .timeline-section .timeline-item {
            padding: 0.75rem 0;
            border-bottom: 1px solid #ffe8dc;
        }

            .timeline-section .timeline-item:last-child {
                border-bottom: none;
            }
</style>

<div class="page-header">
    <h1><i class="fas fa-file-invoice"></i> Chi Tiết Phiếu Nhập #PN-@phieu.phieu_nhap_id</h1>
    <a href="@Url.Action("Index")" class="back-btn">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="detail-card">
            <div class="card-header">
                <h3><i class="fas fa-info-circle"></i> Thông Tin Chung</h3>
            </div>
            <div class="card-body">
                <div class="info-group">
                    <label><i class="fas fa-calendar"></i> Ngày tạo</label>
                    <div class="value">@phieu.ngay_nhap.Value.ToString("dd/MM/yyyy HH:mm")</div>
                </div>

                <div class="info-group">
                    <label><i class="fas fa-user"></i> Nhân viên yêu cầu</label>
                    <div class="value">@(phieu.Nhan_Vien != null ? phieu.Nhan_Vien.ho_ten : "N/A")</div>
                </div>

                <div class="info-group">
                    <label><i class="fas fa-warehouse"></i> Rạp</label>
                    <div class="value">@(phieu.Rap != null ? phieu.Rap.ten_rap : "N/A")</div>
                </div>

                <div class="info-group">
                    <label><i class="fas fa-flag"></i> Trạng thái</label>
                    @if (phieu.trang_thai == "Chờ duyệt")
                    {
                        <span class="status-badge status-pending">⏳ Chờ duyệt</span>
                    }
                    else if (phieu.trang_thai == "Đã duyệt")
                    {
                        <span class="status-badge status-approved">✅ Đã duyệt</span>
                    }
                    else if (phieu.trang_thai == "Đã nhập")
                    {
                        <span class="status-badge status-completed">📦 Đã nhập</span>
                    }
                    else
                    {
                        <span class="status-badge status-cancelled">❌ Đã hủy</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(phieu.ghi_chu))
                {
                    <div class="info-group">
                        <label><i class="fas fa-comment"></i> Ghi chú</label>
                        <div class="value" style="font-size: 1rem;">@phieu.ghi_chu</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(phieu.ly_do))
                {
                    <div class="info-group">
                        <label><i class="fas fa-clipboard"></i> Lý do nhập</label>
                        <div class="value" style="font-size: 1rem;">@phieu.ly_do</div>
                    </div>
                }

                @if (phieu.trang_thai == "Chờ duyệt")
                {
                    <div class="action-buttons">
                        <button onclick="approveOrder(@phieu.phieu_nhap_id)" class="btn-approve">
                            <i class="fas fa-check"></i> Duyệt Ngay
                        </button>
                        <button onclick="rejectOrder(@phieu.phieu_nhap_id)" class="btn-reject">
                            <i class="fas fa-times"></i> Hủy
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="detail-card">
            <div class="card-header">
                <h3><i class="fas fa-box"></i> Danh Sách Hàng Hóa</h3>
            </div>
            <div style="overflow-x: auto;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th><i class="fas fa-tag"></i> Tên Món</th>
                            <th><i class="fas fa-layer-group"></i> Loại</th>
                            <th class="text-center"><i class="fas fa-sort-numeric-up"></i> Số Lượng Yêu Cầu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.TenMon</strong></td>
                                <td><span class="badge-info">@item.Loai</span></td>
                                <td class="quantity-cell">@item.SoLuong</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (phieu.trang_thai != "Chờ duyệt")
            {
                <div class="timeline-section">
                    <h4><i class="fas fa-history"></i> Lịch sử xử lý</h4>
                    <div class="timeline-item">
                        <strong>Ngày tạo:</strong> @phieu.ngay_nhap.Value.ToString("dd/MM/yyyy HH:mm")
                    </div>
                    @if (phieu.trang_thai == "Đã duyệt" || phieu.trang_thai == "Đã nhập")
                    {
                        <div class="timeline-item">
                            <strong>Đã duyệt:</strong> @(phieu.trang_thai == "Đã duyệt" || phieu.trang_thai == "Đã nhập" ? "✅ Đã được duyệt" : "")
                        </div>
                    }
                    @if (phieu.trang_thai == "Đã nhập")
                    {
                        <div class="timeline-item">
                            <strong>Đã nhập kho:</strong> ✅ Hoàn tất
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        function approveOrder(id) {
            if (confirm('✅ Xác nhận DUYỆT phiếu nhập hàng này?\n\nPhiếu sẽ được chuyển sang trạng thái "Đã duyệt" và chờ nhân viên nhập kho.')) {
                $.post('@Url.Action("Approve")', { id: id }, function (res) {
                    if (res.success) {
                        alert('✅ ' + res.message);
                        window.location.href = '@Url.Action("Index")';
                    } else {
                        alert('❌ ' + res.message);
                    }
                }).fail(function() {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại.');
                });
            }
        }

        function rejectOrder(id) {
            var reason = prompt("❌ Nhập lý do từ chối phiếu nhập:");
            if (reason != null && reason.trim() != '') {
                $.post('@Url.Action("Reject")', { id: id, reason: reason }, function (res) {
                    if (res.success) {
                        alert('✅ ' + res.message);
                        window.location.href = '@Url.Action("Index")';
                    } else {
                        alert('❌ ' + res.message);
                    }
                }).fail(function() {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại.');
                });
            }
        }
    </script>
}