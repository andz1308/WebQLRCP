@model WebCinema.Models.Phieu_De_Xuat_Khuyen_Mai
@using WebCinema.Areas.Admin.Controllers

@{
    ViewBag.Title = "Chi Tiết Đề Xuất Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    var details = ViewBag.Details as IEnumerable<PromotionDetailViewModel>;
}

<style>
    /* Copy styles from Details.cshtml */
    .page-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 2px solid #ff9966;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .page-header h1 {
            color: #ff6b35;
            font-weight: 700;
            margin: 0;
        }

    .back-btn {
        background: white;
        color: #ff6b35;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: 2px solid #ffe8dc;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .back-btn:hover {
            background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
            color: white;
            border-color: #ff6b35;
            text-decoration: none;
            transform: translateX(-5px);
        }

    .detail-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
        border: 2px solid #ffe8dc;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .card-header {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        padding: 1.5rem;
    }

        .card-header h3 {
            color: white;
            margin: 0;
            font-weight: 700;
            font-size: 1.3rem;
        }

    .card-body {
        padding: 2rem;
    }

    .info-group {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: #fff5f0;
        border-radius: 8px;
        border-left: 4px solid #ff6b35;
    }

        .info-group label {
            color: #666;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
        }

        .info-group .value {
            color: #333;
            font-size: 1.1rem;
            font-weight: 600;
        }

    .status-badge {
        padding: 0.6rem 1.2rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
        display: inline-block;
        margin-top: 0.5rem;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .table thead th {
        background: #fff5f0;
        color: #ff6b35;
        font-weight: 600;
        border-bottom: 2px solid #ff9966;
        padding: 1rem;
    }

    .table tbody td {
        padding: 1rem;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #fff5f0;
    }

    .badge-info {
        background: linear-gradient(135deg, #ff9966 0%, #ff6b35 100%);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .btn-approve {
        flex: 1;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 1rem;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-approve:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(40, 167, 69, 0.3);
        }

    .btn-reject {
        flex: 1;
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 1rem;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-reject:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.3);
        }

    .discount-highlight {
        background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
        color: white;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
    }

        .discount-highlight .value {
            font-size: 2rem;
            font-weight: 800;
        }

        .discount-highlight .label {
            font-size: 0.9rem;
            opacity: 0.9;
        }
</style>

<div class="page-header">
    <h1><i class="fas fa-file-contract"></i> Chi Tiết Đề Xuất #DX-@Model.de_xuat_id</h1>
    <a href="@Url.Action("Promotions")" class="back-btn">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="detail-card">
            <div class="card-header">
                <h3><i class="fas fa-info-circle"></i> Thông Tin Đề Xuất</h3>
            </div>
            <div class="card-body">
                <div class="info-group">
                    <label><i class="fas fa-calendar"></i> Ngày tạo</label>
                    <div class="value">@Model.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm")</div>
                </div>

                <div class="info-group">
                    <label><i class="fas fa-user"></i> Người tạo</label>
                    <div class="value">@(Model.Nhan_Vien != null ? Model.Nhan_Vien.ho_ten : "N/A")</div>
                </div>

                <div class="info-group">
                    <label><i class="fas fa-warehouse"></i> Rạp</label>
                    <div class="value">@(Model.Rap != null ? Model.Rap.ten_rap : "N/A")</div>
                </div>

                <div class="info-group discount-highlight">
                    <div class="label">Mức Giảm Đề Xuất</div>
                    <div class="value">-@Model.muc_giam_gia%</div>
                </div>

                @if ((Model.so_luong_ton ?? 0) > 0)
                {
                    <div class="info-group">
                        <label><i class="fas fa-filter"></i> Điều kiện</label>
                        <div class="value" style="font-size: 1rem;">Áp dụng cho món có tồn kho > @Model.so_luong_ton</div>
                    </div>
                }

                <div class="info-group">
                    <label><i class="fas fa-clipboard"></i> Lý do</label>
                    <div class="value" style="font-size: 1rem;">@Model.ly_do</div>
                </div>

                <div class="info-group">
                    <label><i class="fas fa-flag"></i> Trạng thái</label>
                    @if (Model.trang_thai == "Chờ duyệt")
                    {
                        <span class="status-badge status-pending">⏳ Chờ duyệt</span>
                    }
                    else if (Model.trang_thai == "Đã duyệt")
                    {
                        <span class="status-badge status-approved">✅ Đã duyệt</span>
                    }
                    else
                    {
                        <span class="status-badge status-rejected">❌ Từ chối</span>
                    }
                </div>

                @if (Model.trang_thai == "Chờ duyệt")
                {
                    <div class="action-buttons">
                        <button onclick="approvePromo(@Model.de_xuat_id)" class="btn-approve">
                            <i class="fas fa-check"></i> Duyệt & Tạo Mã
                        </button>
                        <button onclick="rejectPromo(@Model.de_xuat_id)" class="btn-reject">
                            <i class="fas fa-times"></i> Từ Chối
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="detail-card">
            <div class="card-header">
                <h3><i class="fas fa-box"></i> Danh Sách Sản Phẩm Áp Dụng</h3>
            </div>
            <div style="overflow-x: auto;">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th><i class="fas fa-tag"></i> Tên Món Ăn</th>
                            <th><i class="fas fa-layer-group"></i> Loại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (details != null && details.Any())
                        {
                            int i = 1;
                            foreach (var item in details)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(i++)</td>
                                    <td><strong>@item.da.ten_san_pham</strong></td>
                                    <td><span class="badge-info">@item.da.loai</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center p-5">Không có sản phẩm nào được chỉ định.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function approvePromo(id) {
            if (confirm('✅ Duyệt đề xuất này và chuyển sang trang tạo mã khuyến mãi?')) {
                $.post('@Url.Action("ApprovePromotion")', { id: id }, function (res) {
                    if (res.success) {
                        alert('✅ ' + res.message);
                        if (res.isRedirect) {
                            window.location.href = res.redirectUrl;
                        } else {
                            location.href = '@Url.Action("Promotions")';
                        }
                    } else {
                        alert('❌ ' + res.message);
                    }
                }).fail(function() {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại.');
                });
            }
        }

        function rejectPromo(id) {
            var reason = prompt("❌ Nhập lý do từ chối đề xuất:");
            if (reason != null && reason.trim() != '') {
                $.post('@Url.Action("RejectPromotion")', { id: id, reason: reason }, function (res) {
                    if (res.success) {
                        alert('✅ ' + res.message);
                        location.href = '@Url.Action("Promotions")';
                    } else {
                        alert('❌ ' + res.message);
                    }
                }).fail(function() {
                    alert('❌ Có lỗi xảy ra. Vui lòng thử lại.');
                });
            }
        }
    </script>
}