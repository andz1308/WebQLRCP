@using WebCinema.Areas.Admin.Controllers
@model ManagerDashboardViewModel

@{
    ViewBag.Title = "Bảng Điều Khiển Nhập Xuất";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div class="content-header">
    <h1><i class="fas fa-tasks"></i> Quản Lý Nhập & Khuyến Mãi @(isAdmin ? "(Toàn Hệ Thống)" : "")</h1>
</div>

<div class="content-card mb-3 p-3">
    @using (Html.BeginForm("Index", "ManagerPurchaseOrder", FormMethod.Get))
    {
        <div class="row align-items-center">
            <div class="col-md-3">
                <label>Lọc Trạng Thái:</label>
                <select name="status" class="form-control" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                    <option value="Chờ duyệt" @(ViewBag.SelectedStatus == "Chờ duyệt" ? "selected" : "")>Chờ duyệt</option>
                    <option value="Đã duyệt" @(ViewBag.SelectedStatus == "Đã duyệt" ? "selected" : "")>Đã duyệt</option>
                    <option value="Đã nhập" @(ViewBag.SelectedStatus == "Đã nhập" ? "selected" : "")>Hoàn thành / Đã nhập</option>
                    <option value="Đã hủy" @(ViewBag.SelectedStatus == "Đã hủy" ? "selected" : "")>Đã hủy / Từ chối</option>
                </select>
            </div>
            <div class="col-md-9 text-right">
                <span class="text-muted"><i class="fas fa-info-circle"></i> Bộ lọc áp dụng cho cả 2 danh sách bên dưới</span>
            </div>
        </div>
    }
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title" style="color:white"><i class="fas fa-box-open"></i> Yêu Cầu Nhập Kho</h3>
            </div>
            <div style="overflow-x: auto;">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            @if (isAdmin)
                            {
                                <th>Rạp</th>
                            }
                            <th>Ngày</th>
                            <th>Lý Do</th>
                            <th>Trạng Thái</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DSNhapKho)
                        {
                            <tr>
                                <td><small>#PN-@item.phieu_nhap_id</small></td>
                                @if (isAdmin)
                                {
                                    <td><small>@item.Rap.ten_rap</small></td>
                                }
                                <td><small>@item.ngay_nhap.Value.ToString("dd/MM HH:mm")</small></td>
                                <td><small title="@item.ghi_chu">@(item.ghi_chu.Length > 20 ? item.ghi_chu.Substring(0, 20)+"..." : item.ghi_chu)</small></td>

                                <td>
                                    @if (item.trang_thai == "Chờ duyệt")
                                    {<span class="badge badge-warning">Chờ</span> }
                                    else if (item.trang_thai == "Đã duyệt")
                                    { <span class="badge badge-info">Duyệt</span> }
                                    else if (item.trang_thai == "Đã nhập")
                                    { <span class="badge badge-success">Xong</span> }
                                    else
                                    { <span class="badge badge-danger">Hủy</span>}
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = item.phieu_nhap_id })" class="btn btn-xs btn-primary"><i class="fas fa-eye"></i></a>
                                    @if (item.trang_thai == "Chờ duyệt")
                                    {
                                        <button onclick="approveOrder(@item.phieu_nhap_id)" class="btn btn-xs btn-success"><i class="fas fa-check"></i></button>
                                        <button onclick="rejectOrder(@item.phieu_nhap_id)" class="btn btn-xs btn-danger"><i class="fas fa-times"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="content-card">
            <div class="card-header bg-success text-white">
                <h3 class="card-title" style="color:white"><i class="fas fa-tags"></i> Đề Xuất Giảm Giá</h3>
            </div>
            <div style="overflow-x: auto;">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            @if (isAdmin)
                            {
                                <th>Rạp</th>
                            }
                            <th>Ngày</th>
                            <th>Lý Do</th>
                            <th>Trạng Thái</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DSDeXuat)
                        {
                            <tr>
                                <td><small>#DX-@item.de_xuat_id</small></td>
                                @if (isAdmin)
                                {
                                    <td><small>@item.Rap.ten_rap</small></td>
                                }
                                <td><small>@item.ngay_tao.Value.ToString("dd/MM HH:mm")</small></td>
                                <td><small title="@item.ly_do">@(item.ly_do.Length > 20 ? item.ly_do.Substring(0, 20)+"..." : item.ly_do)</small></td>

                                <td>
                                    @if (item.trang_thai == "Chờ duyệt")
                                    {<span class="badge badge-warning">Chờ</span> }
                                    else if (item.trang_thai == "Đã duyệt")
                                    { <span class="badge badge-success">Duyệt</span> }
                                    else
                                    { <span class="badge badge-danger">Từ chối</span>}
                                </td>
                                <td>
                                    <a href="@Url.Action("PromotionDetails", new { id = item.de_xuat_id })" class="btn btn-xs btn-info"><i class="fas fa-eye"></i></a>
                                    @if (item.trang_thai == "Chờ duyệt")
                                    {
                                        <button onclick="approvePromo(@item.de_xuat_id)" class="btn btn-xs btn-success"><i class="fas fa-check"></i></button>
                                        <button onclick="rejectPromo(@item.de_xuat_id)" class="btn btn-xs btn-danger"><i class="fas fa-times"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // --- XỬ LÝ NHẬP KHO (Cột Trái) ---
        function approveOrder(id) {
            if (confirm('Duyệt phiếu NHẬP KHO này?')) {
                $.post('@Url.Action("Approve")', { id: id }, function (res) {
                    if (res.success) { location.reload(); } else { alert(res.message); }
                });
            }
        }
        function rejectOrder(id) {
            var r = prompt("Lý do từ chối nhập kho:");
            if (r) {
                $.post('@Url.Action("Reject")', { id: id, reason: r }, function (res) {
                    if (res.success) { location.reload(); } else { alert(res.message); }
                });
            }
        }

        // --- XỬ LÝ KHUYẾN MÃI (Cột Phải) ---
        function approvePromo(id) {
            if (confirm('Duyệt đề xuất này và tạo mã khuyến mãi ngay?')) {
                $.post('@Url.Action("ApprovePromotion")', { id: id }, function (res) {
                    if (res.success) {
                        alert(res.message);
                        if (res.isRedirect) {
                            window.location.href = res.redirectUrl; // Chuyển sang trang tạo mã
                        } else {
                            location.reload();
                        }
                    }
                    else alert(res.message);
                });
            }
        }
        function rejectPromo(id) {
            var r = prompt("Lý do từ chối khuyến mãi:");
            if (r) {
                $.post('@Url.Action("RejectPromotion")', { id: id, reason: r }, function (res) {
                    if (res.success) { location.reload(); } else { alert(res.message); }
                });
            }
        }
    </script>
}

<style>
    /* CSS để bảng nhỏ gọn hơn khi chia đôi màn hình */
    .btn-xs {
        padding: 0.2rem 0.4rem;
        font-size: 0.75rem;
        border-radius: 3px;
    }

    .table td, .table th {
        padding: 0.5rem;
        vertical-align: middle;
    }

    .badge-warning {
        background-color: #ffc107;
        color: #212529;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .badge-success {
        background-color: #28a745;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .badge-danger {
        background-color: #dc3545;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .badge-info {
        background-color: #17a2b8;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
    }
</style>