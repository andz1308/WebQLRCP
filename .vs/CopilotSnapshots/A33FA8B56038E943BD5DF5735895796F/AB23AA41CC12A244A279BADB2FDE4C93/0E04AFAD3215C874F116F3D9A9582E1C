@model IEnumerable<WebCinema.Models.Khach_Hang>

@{
    ViewBag.Title = "Quản Lý Người Dùng";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<style>
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .pagination a,
    .pagination span {
        padding: 0.5rem 1rem;
        border: 2px solid #ddd;
        border-radius: 6px;
        text-decoration: none;
        color: #333;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-block;
        min-width: 40px;
        text-align: center;
    }

    .pagination a:hover {
        background: #667eea;
        color: white;
        border-color: #667eea;
        transform: translateY(-2px);
    }

    .pagination .active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-color: #667eea;
        font-weight: 700;
    }

    .pagination .disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .pagination-info {
        text-align: center;
        color: #666;
        margin-top: 1rem;
        font-size: 0.9rem;
    }
</style>

<div class="content-card">
    <div class="card-header">
        <h2 class="card-title"><i class="fas fa-users"></i> Quản Lý Người Dùng</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Người Dùng
        </a>
    </div>

    <!-- Search Form -->
    <div style="margin-bottom: 2rem;">
        @using (Html.BeginForm("Index", "UserManagement", FormMethod.Get))
        {
            <div style="display: flex; gap: 1rem;">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Tìm theo tên, email, SĐT..." class="form-control" style="flex: 1;" />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Tìm Kiếm
                </button>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>Số Điện Thoại</th>
                        <th>Ngày Đăng Ký</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><strong>@user.khach_hang_id</strong></td>
                            <td>@user.ho_ten</td>
                            <td>@user.email</td>
                            <td>@(user.so_dien_thoai ?? "")</td>
                            <td>@(user.ngay_dang_ky.HasValue ? user.ngay_dang_ky.Value.ToString("dd/MM/yyyy") : "")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = user.khach_hang_id })" class="btn btn-secondary" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                                <a href="@Url.Action("Edit", new { id = user.khach_hang_id })" class="btn btn-secondary" style="padding: 0.5rem 1rem; margin-right: 0.5rem;">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <button onclick="deleteUser(@user.khach_hang_id)" class="btn btn-danger" style="padding: 0.5rem 1rem;">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <!-- First Page -->
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = 1 })">
                        <i class="fas fa-angle-double-left"></i>
                    </a>
                }
                else
                {
                    <span class="disabled"><i class="fas fa-angle-double-left"></i></span>
                }

                <!-- Previous Page -->
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = currentPage - 1 })">
                        <i class="fas fa-angle-left"></i>
                    </a>
                }
                else
                {
                    <span class="disabled"><i class="fas fa-angle-left"></i></span>
                }

                <!-- Page Numbers -->
                @{
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);

                    if (startPage > 1)
                    {
                        <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = 1 })">1</a>
                        if (startPage > 2)
                        {
                            <span>...</span>
                        }
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="active">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                        }
                    }

                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <span>...</span>
                        }
                        <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = totalPages })">@totalPages</a>
                    }
                }

                <!-- Next Page -->
                @if (currentPage < totalPages)
                {
                    <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = currentPage + 1 })">
                        <i class="fas fa-angle-right"></i>
                    </a>
                }
                else
                {
                    <span class="disabled"><i class="fas fa-angle-right"></i></span>
                }

                <!-- Last Page -->
                @if (currentPage < totalPages)
                {
                    <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = totalPages })">
                        <i class="fas fa-angle-double-right"></i>
                    </a>
                }
                else
                {
                    <span class="disabled"><i class="fas fa-angle-double-right"></i></span>
                }
            </div>

            <div class="pagination-info">
                Hiển thị @((currentPage - 1) * 10 + 1) - @Math.Min(currentPage * 10, totalItems) trong tổng số @totalItems người dùng
            </div>
        }
    }
    else
    {
        <p style="text-align: center; color: #999; padding: 2rem;">Không có người dùng nào.</p>
    }
</div>

@section scripts {
    <script>
        function deleteUser(id) {
            if (confirmDelete('Bạn có chắc chắn muốn xóa người dùng này?')) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra.');
                    }
                });
            }
        }
    </script>
}


