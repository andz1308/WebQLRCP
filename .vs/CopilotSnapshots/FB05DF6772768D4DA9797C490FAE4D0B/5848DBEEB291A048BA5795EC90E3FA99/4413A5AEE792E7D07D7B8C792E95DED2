using System;
using System.IO;
using System.Net;
using System.Net.Mail;
using System.Threading.Tasks;
using WebCinema.Infrastructure;
using MailKit.Net.Smtp;
using MailKit.Security;
using MimeKit;

namespace WebCinema.Services
{
    /// <summary>
    /// Service gửi email bằng MailKit
    /// </summary>
    public class EmailServiceMailKit
    {
        private string _smtpServer;
        private int _smtpPort;
        private string _senderEmail;
        private string _senderPassword;
        private string _senderName;

        public EmailServiceMailKit()
        {
            // ✅ Đọc config từ Web.config
            _smtpServer = System.Configuration.ConfigurationManager.AppSettings["SmtpServer"] ?? "smtp.gmail.com";
            _smtpPort = int.Parse(System.Configuration.ConfigurationManager.AppSettings["SmtpPort"] ?? "587");
            _senderEmail = System.Configuration.ConfigurationManager.AppSettings["SenderEmail"] ?? "your-email@gmail.com";
            _senderPassword = System.Configuration.ConfigurationManager.AppSettings["SenderPassword"] ?? "your-app-password";
            _senderName = System.Configuration.ConfigurationManager.AppSettings["SenderName"] ?? "DAV Cinema";
        }

        /// <summary>
        /// Gửi email chứa hóa đơn HTML được đính kèm
        /// </summary>
        public bool SendInvoiceEmail(string recipientEmail, string recipientName, string htmlFileName, string htmlFilePath, string message = "")
        {
            try
            {
                // ✅ Kiểm tra file tồn tại
                if (!File.Exists(htmlFilePath))
                {
                    LoggingHelper.LogError(new Exception($"File không tồn tại: {htmlFilePath}"));
                    return false;
                }

                // ✅ Đọc nội dung HTML
                string htmlContent = File.ReadAllText(htmlFilePath, System.Text.Encoding.UTF8);

                // ✅ Tạo email
                var mimeMessage = new MimeMessage();
                mimeMessage.From.Add(new MailboxAddress(_senderName, _senderEmail));
                mimeMessage.To.Add(new MailboxAddress(recipientName, recipientEmail));
                mimeMessage.Subject = "Hóa đơn thanh toán - DAV Cinema";

                // ✅ Tạo body email
                var bodyBuilder = new BodyBuilder();
                bodyBuilder.HtmlBody = GetInvoiceEmailTemplate(recipientName, message);

                // ✅ Thêm file HTML đính kèm
                bodyBuilder.Attachments.Add(htmlFileName, new MemoryStream(System.Text.Encoding.UTF8.GetBytes(htmlContent)));

                mimeMessage.Body = bodyBuilder.ToMessageBody();

                // ✅ Gửi email
                using (var client = new SmtpClient())
                {
                    // Kết nối tới SMTP server
                    client.Connect(_smtpServer, _smtpPort, SecureSocketOptions.StartTls);
                    
                    // Xác thực
                    client.Authenticate(_senderEmail, _senderPassword);
                    
                    // Gửi
                    client.Send(mimeMessage);
                    client.Disconnect(true);
                }

                LoggingHelper.LogInfo($"✅ Gửi email hóa đơn thành công tới: {recipientEmail}");
                return true;
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex, $"❌ Lỗi gửi email tới {recipientEmail}");
                return false;
            }
        }

