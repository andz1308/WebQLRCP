@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

@model IEnumerable<WebCinema.Models.HuyVe>

@{
    ViewBag.Title = "Quản Lý Hủy Vé";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="content-card">
    <!-- Error Message Display -->
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div style="padding: 1rem; background: #f8d7da; color: #721c24; border-radius: 4px; margin-bottom: 1rem; border: 1px solid #f5c6cb;">
            <i class="fas fa-exclamation-triangle"></i> @ViewBag.ErrorMessage
        </div>
    }

    <!-- Header -->
    <div class="card-header">
        <h2 class="card-title">
            <i class="fas fa-trash-alt"></i> Quản Lý Hủy Vé
        </h2>
    </div>

    <!-- Info Box -->
    <div style="padding: 1rem; background: #d1ecf1; color: #0c5460; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #17a2b8;">
        <i class="fas fa-info-circle"></i> <strong>Thông tin:</strong> Vé được hủy ngay khi khách hàng yêu cầu. Admin chỉ cần xác nhận đã chuyển khoản hoàn lại.
    </div>

    <!-- Filter Section -->
    <div style="margin-bottom: 2rem; padding: 1.5rem; background: #f8f9fa; border-radius: 8px; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
        <a href="@Url.Action("Index", new { status = "" })" class="btn @(string.IsNullOrEmpty(ViewBag.Status) ? "btn-primary" : "btn-secondary")">
            📋 Tất Cả
        </a>
        <a href="@Url.Action("Index", new { status = "Chờ xác nhận" })" class="btn @(ViewBag.Status == "Chờ xác nhận" ? "btn-primary" : "btn-secondary")">
            ⏳ Chờ Xác Nhận
        </a>
        <a href="@Url.Action("Index", new { status = "Đã xác nhận" })" class="btn @(ViewBag.Status == "Đã xác nhận" ? "btn-primary" : "btn-secondary")">
            ✅ Đã Xác Nhận
        </a>
        <span style="color: #999; margin-left: auto;">Tổng: <strong>@ViewBag.TotalItems</strong> yêu cầu</span>
    </div>

    <!-- Requests Table -->
    @if (Model != null && Model.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Khách Hàng</th>
                        <th>Phim</th>
                        <th>Ngày Chiếu</th>
                        <th>Hoàn Lại</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Gửi</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        var booking = request != null ? request.Dat_Ve : null;
                        var customer = booking != null ? booking.Khach_Hang : null;
                        var firstTicket = (booking != null && booking.Ves != null && booking.Ves.Count > 0) ? booking.Ves.FirstOrDefault() : null;
                        var showtime = firstTicket != null ? firstTicket.Suat_Chieu : null;

                        <tr>
                            <td>
                                <strong>@(customer != null ? (customer.ho_ten ?? "N/A") : "N/A")</strong><br />
                                <small style="color: #999;">@(customer != null ? (customer.so_dien_thoai ?? "N/A") : "N/A")</small>
                            </td>
                            <td>
                                @((showtime != null && showtime.Phim != null) ? showtime.Phim.ten_phim : "N/A")
                            </td>
                            <td>
                                @((showtime != null && showtime.ngay_chieu != null) ? showtime.ngay_chieu.ToString("dd/MM/yyyy") : "N/A")
                            </td>
                            <td>
                                <strong style="color: #27ae60; font-size: 1.05rem;">@((request.so_tien_hoan_lai ?? 0).ToString("N0")) ₫</strong>
                            </td>
                            <td>
                                @if (request.trang_thai == "Chờ xác nhận")
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #fff3cd; color: #856404; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">⏳ Chờ xác nhận</span>
                                }
                                else if (request.trang_thai == "Đã xác nhận")
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #d4edda; color: #155724; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">✅ Đã xác nhận</span>
                                }
                                else
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #e2e3e5; color: #383d41; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">❓ @request.trang_thai</span>
                                }
                            </td>
                            <td>
                                @{
                                    string formattedDate = "-";
                                    DateTime temp;
                                    if (request != null && request.ngay_tao != null && DateTime.TryParse(request.ngay_tao.ToString(), out temp))
                                    {
                                        formattedDate = temp.ToString("dd/MM/yyyy HH:mm");
                                    }
                                }
                                @formattedDate
                            </td>

                            <td>
                                <a href="@Url.Action("Details", new { id = request.yeu_cau_id })" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        if (ViewBag.TotalPages > 1)
        {
            <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 2rem; flex-wrap: wrap;">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = ViewBag.CurrentPage - 1 })" class="btn btn-secondary" style="padding: 0.5rem 1rem;">
                        ← Trước
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span style="padding: 0.5rem 1rem; background: #ff6b35; color: white; border-radius: 4px; font-weight: 600;">@i</span>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) <= 2 || i == 1 || i == ViewBag.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.Status, page = i })" class="btn btn-secondary" style="padding: 0.5rem 0.8rem;">@i</a>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = ViewBag.CurrentPage + 1 })" class="btn btn-secondary" style="padding: 0.5rem 1rem;">
                        Sau →
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 3rem; color: #999;">
            <i class="fas fa-inbox" style="font-size: 3rem; opacity: 0.5; display: block; margin-bottom: 1rem;"></i>
            <h3>Không có yêu cầu hủy vé</h3>
            <p>@(ViewBag.Status == "Chờ xác nhận" ? "Hiện không có yêu cầu chờ xác nhận chuyển tiền" : "Danh sách trống")</p>
        </div>
    }
</div>

@section scripts {
    <script>
        function approveCancel(requestId) {
            if (!confirm("Bạn chắc muốn xác nhận đã chuyển khoản hoàn lại cho khách hàng?\n\nNhắc nhở: Kiểm tra số tiền trước khi xác nhận")) {
                return;
            }

            $.ajax({
                url: '@Url.Action("ApproveCancel", new { area = "Admin" })',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val(),
                    id: requestId,
                    note: "Đã xác nhận chuyển khoản"
                },
                success: function(response) {
                    if (response.success) {
                        alert('✅ ' + response.message);
                        location.reload();
                    } else {
                        alert('❌ ' + response.message);
                    }
                },
                error: function() {
                    alert('❌ Có lỗi xảy ra!');
                }
            });
        }
    </script>
}
