        /// <summary>
        /// POST: api/customer/check-promo
        /// Kiểm tra mã khuyến mãi và lấy thông tin chi tiết
        /// ✅ Yêu cầu xác thực
        /// </summary>
        [HttpPost]
        [Route("check-promo")]
        [Authorize]
        public IHttpActionResult CheckPromo([FromBody] JObject data)
        {
            try
            {
                string promoCode = data["promo_code"]?.Value<string>() ?? "";
                var foodItemsJson = data["food_items"]?.ToString() ?? "[]";

                if (string.IsNullOrEmpty(promoCode))
                    return BadRequest("Mã khuyến mãi không được để trống");

                // Tìm khuyến mãi theo mã
                var promo = db.Khuyen_Mais.FirstOrDefault(k => k.ma_khuyen.ToLower() == promoCode.ToLower() && k.trang_thai == "Active");

                if (promo == null)
                {
                    return Ok(new
                    {
                        success = false,
                        message = "Mã khuyến mãi không tồn tại hoặc đã hết hạn",
                        data = (object)null
                    });
                }

                // Kiểm tra ngày sử dụng
                if (DateTime.Now < promo.ngay_bat_dau || DateTime.Now > promo.ngay_ket_thuc)
                {
                    return Ok(new
                    {
                        success = false,
                        message = "Mã khuyến mãi đã hết hạn",
                        data = (object)null
                    });
                }

                // Kiểm tra điều kiện áp dụng (nếu có)
                var discount = promo.phan_tram_giam ?? 0;

                return Ok(new
                {
                    success = true,
                    message = "Mã khuyến mãi hợp lệ",
                    data = new
                    {
                        maKhuyen = promo.ma_khuyen,
                        moTa = promo.mo_ta,
                        phanTramGiam = discount,
                        ngayBatDau = promo.ngay_bat_dau.ToString("yyyy-MM-dd"),
                        ngayKetThuc = promo.ngay_ket_thuc.ToString("yyyy-MM-dd")
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// POST: api/customer/available-promos
        /// Lấy danh sách khuyến mãi có sẵn cho khách hàng
        /// ✅ Yêu cầu xác thực
        /// </summary>
        [HttpPost]
        [Route("available-promos")]
        [Authorize]
        public IHttpActionResult GetAvailablePromos([FromBody] JObject data)
        {
            try
            {
                int customerId = data["customer_id"]?.Value<int>() ?? 0;

                if (customerId <= 0)
                    return BadRequest("Customer ID không hợp lệ");

                // Lấy danh sách khuyến mãi có sẵn (Active và chưa hết hạn)
                var today = DateTime.Today;
                var availablePromos = db.Khuyen_Mais
                    .Where(k => k.trang_thai == "Active"
                        && k.ngay_bat_dau <= today
                        && k.ngay_ket_thuc >= today)
                    .Select(k => new
                    {
                        maKhuyen = k.ma_khuyen,
                        moTa = k.mo_ta,
                        phanTramGiam = k.phan_tram_giam ?? 0,
                        ngayBatDau = k.ngay_bat_dau.ToString("yyyy-MM-dd"),
                        ngayKetThuc = k.ngay_ket_thuc.ToString("yyyy-MM-dd"),
                        isApplicable = true,
                        reason = ""
                    })
                    .ToList();

                LoggingHelper.LogInfo($"✅ Lấy {availablePromos.Count} khuyến mãi có sẵn cho customer {customerId}");

                return Ok(new
                {
                    success = true,
                    message = $"Có {availablePromos.Count} mã khuyến mãi có sẵn",
                    data = availablePromos
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// POST: api/customer/booking/{bookingId}/apply-promo
        /// Áp dụng mã khuyến mãi cho đơn đặt vé
        /// ✅ Yêu cầu xác thực
        /// </summary>
        [HttpPost]
        [Route("booking/{bookingId}/apply-promo")]
        [Authorize]
        public IHttpActionResult ApplyPromoToBooking(int bookingId, [FromBody] JObject data)
        {
            try
            {
                string promoCode = data["promo_code"]?.Value<string>() ?? "";

                if (string.IsNullOrEmpty(promoCode))
                    return BadRequest("Mã khuyến mãi không được để trống");

                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == bookingId);
                if (booking == null)
                    return NotFound();

                // Tìm khuyến mãi
                var promo = db.Khuyen_Mais.FirstOrDefault(k => k.ma_khuyen.ToLower() == promoCode.ToLower() && k.trang_thai == "Active");

                if (promo == null)
                {
                    return Ok(new
                    {
                        success = false,
                        message = "Mã khuyến mãi không tồn tại",
                        data = (object)null
                    });
                }

                // Kiểm tra ngày sử dụng
                if (DateTime.Now < promo.ngay_bat_dau || DateTime.Now > promo.ngay_ket_thuc)
                {
                    return Ok(new
                    {
                        success = false,
                        message = "Mã khuyến mãi đã hết hạn",
                        data = (object)null
                    });
                }

                // Áp dụng giảm giá
                decimal originalTotal = booking.tong_tien ?? 0;
                decimal discountPercent = promo.phan_tram_giam ?? 0;
                decimal discountAmount = (originalTotal * discountPercent) / 100;
                decimal finalTotal = originalTotal - discountAmount;

                // Cập nhật booking với khuyến mãi
                booking.ma_khuyen = promoCode;
                booking.tong_tien = finalTotal;
                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Áp dụng khuyến mãi {promoCode} cho booking {bookingId}: {originalTotal} → {finalTotal}đ");

                return Ok(new
                {
                    success = true,
                    message = $"Áp dụng khuyến mãi thành công. Tiết kiệm {discountAmount:F0}đ",
                    data = new
                    {
                        originalTotal = originalTotal,
                        discountPercent = discountPercent,
                        discountAmount = discountAmount,
                        finalTotal = finalTotal,
                        promoCode = promoCode
                    }
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

