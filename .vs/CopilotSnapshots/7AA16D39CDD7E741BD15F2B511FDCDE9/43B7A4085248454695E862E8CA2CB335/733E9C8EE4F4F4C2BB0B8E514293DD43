@model IEnumerable<WebCinema.Models.Dat_Ve>

@{
    ViewBag.Title = "Vé Của Tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .tickets-container {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .tickets-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .tickets-header h1 {
        font-size: 2rem;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .ticket-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border-left: 4px solid #ff6b35;
        transition: all 0.3s ease;
    }

    .ticket-card:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .ticket-info {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 1rem;
        align-items: center;
    }

    .ticket-movie {
        font-weight: 600;
        color: #333;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .ticket-detail {
        color: #666;
        font-size: 0.9rem;
        margin: 0.3rem 0;
    }

    .ticket-status {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: #fff3cd;
        color: #856404;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .ticket-status.used {
        background: #d1ecf1;
        color: #0c5460;
    }

    .ticket-status.cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    .btn-action {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-view {
        background: #3498db;
        color: white;
    }

    .btn-view:hover {
        background: #2980b9;
        transform: translateY(-2px);
    }

    .btn-cancel {
        background: #e74c3c;
        color: white;
    }

    .btn-cancel:hover {
        background: #c0392b;
        transform: translateY(-2px);
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #999;
    }

    .empty-state-icon {
        font-size: 3rem;
        opacity: 0.5;
        margin-bottom: 1rem;
    }
</style>

<div class="tickets-container">
    <div class="tickets-header">
        <h1><i class="fas fa-ticket-alt"></i> Vé Của Tôi</h1>
        <p style="color: #666;">Quản lý vé của bạn và yêu cầu hủy</p>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var booking in Model)
        {
            var firstTicket = booking.Ves.FirstOrDefault();
            
            // ✅ Kiểm tra null trước khi truy cập
            if (firstTicket == null || firstTicket.Suat_Chieu == null)
            {
                continue;
            }
            
            var showtime = firstTicket.Suat_Chieu;
            var isShowtimePassed = showtime.ngay_chieu.Date < DateTime.Now.Date;
            
            // Kiểm tra vé đã sử dụng hay hủy
            var hasUsedTickets = booking.Ves.Any(v => v.trang_thai_ve == "Đã sử dụng");
            var hasCancelledTickets = booking.Ves.Any(v => v.trang_thai_ve == "Đã Hủy");

            <div class="ticket-card">
                <div class="ticket-info">
                    <div>
                        <div class="ticket-movie">
                            🎬 @(showtime.Phim?.ten_phim ?? "N/A")
                        </div>
                        <div class="ticket-detail">
                            📅 @showtime.ngay_chieu.ToString("dd/MM/yyyy") lúc @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")
                        </div>
                        <div class="ticket-detail">
                            🎪 @(showtime.Phong_Chieu?.Rap.ten_rap ?? "N/A") - Phòng @(showtime.Phong_Chieu?.ten_phong ?? "N/A")
                        </div>
                        <div class="ticket-detail">
                            🪑 @booking.Ves.Count vé | 💰 @booking.tong_tien.ToString("N0") ₫
                        </div>
                    </div>

                    <div>
                        @if (hasUsedTickets)
                        {
                            <span class="ticket-status used">✓ Đã sử dụng</span>
                        }
                        else if (hasCancelledTickets)
                        {
                            <span class="ticket-status cancelled">✗ Đã hủy</span>
                        }
                        else if (isShowtimePassed)
                        {
                            <span class="ticket-status cancelled">✗ Quá hạn</span>
                        }
                        else
                        {
                            <span class="ticket-status">⏳ Chưa sử dụng</span>
                        }
                    </div>

                    <div style="display: flex; gap: 0.5rem; flex-direction: column;">
                        <a href="@Url.Action("Details", new { id = booking.Dat_Ve_id })" class="btn-action btn-view">
                            <i class="fas fa-eye"></i> Xem Chi Tiết
                        </a>
                        @if (!hasUsedTickets && !hasCancelledTickets && !isShowtimePassed)
                        {
                            <button class="btn-action btn-cancel" onclick="requestCancel(@booking.Dat_Ve_id)">
                                <i class="fas fa-trash"></i> Hủy Vé
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🎬</div>
            <h3>Bạn chưa có vé nào</h3>
            <p>Đặt vé xem phim ngay hôm nay!</p>
            <a href="@Url.Action("Index", "Home")" class="btn-action btn-view" style="margin-top: 1rem;">
                <i class="fas fa-film"></i> Xem Phim
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        function requestCancel(bookingId) {
            window.location.href = '@Url.Action("Details", new { id = 0 })'.replace('/0', '/' + bookingId);
        }
    </script>
}
