using System;
using System.Linq;
using System.Web.Mvc;
using WebCinema.Models;
using WebCinema.Infrastructure;

namespace WebCinema.Areas.Admin.Controllers
{
    [RoleAuthorize(Roles = "Admin")]
    public class TicketRefundManagementController : Controller
    {
        private CSDLDataContext db = new CSDLDataContext();

        // GET: Admin/TicketRefundManagement - Danh sách yêu cầu hủy vé
        public ActionResult Index(string status = "", int? page = null)
        {
            int pageSize = 10;
            int currentPage = page ?? 1;

            var query = db.Yeu_Cau_Huy_Ves.AsQueryable();

            // Filter by status
            if (!string.IsNullOrEmpty(status))
            {
                query = query.Where(y => y.trang_thai == status);
            }

            var totalItems = query.Count();
            var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

            var requests = query
                .OrderByDescending(y => y.ngay_tao)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();

            ViewBag.CurrentPage = currentPage;
            ViewBag.TotalPages = totalPages;
            ViewBag.Status = status;
            ViewBag.TotalItems = totalItems;

            return View(requests);
        }

        // GET: Admin/TicketRefundManagement/Details/{id} - Xem chi tiết yêu cầu hủy
        [HttpGet]
        public ActionResult Details(int id)
        {
            var cancelRequest = db.Yeu_Cau_Huy_Ves.FirstOrDefault(y => y.yeu_cau_id == id);
            if (cancelRequest == null)
                return HttpNotFound();

            var booking = cancelRequest.Dat_Ve;
            var customer = cancelRequest.Khach_Hang;
            var tickets = booking.Ves.ToList();
            var showtime = tickets.FirstOrDefault()?.Suat_Chieu;

            ViewBag.Booking = booking;
            ViewBag.Customer = customer;
            ViewBag.Tickets = tickets;
            ViewBag.Showtime = showtime;

            return View(cancelRequest);
        }

        // ✅ POST: Admin/TicketRefundManagement/ApproveCancel - Duyệt hủy vé
        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult ApproveCancel(int id, string note = "")
        {
            try
            {
                int? adminId = Session["EmployeeId"] as int?;
                if (!adminId.HasValue)
                    return Json(new { success = false, message = "❌ Admin không xác thực" });

                var cancelRequest = db.Yeu_Cau_Huy_Ves.FirstOrDefault(y => y.yeu_cau_id == id);
                if (cancelRequest == null)
                    return Json(new { success = false, message = "❌ Yêu cầu không tồn tại" });

                if (cancelRequest.trang_thai != "Chờ duyệt")
                    return Json(new { success = false, message = "❌ Yêu cầu này không ở trạng thái 'Chờ duyệt'" });

                var booking = db.Dat_Ves.FirstOrDefault(b => b.Dat_Ve_id == cancelRequest.dat_ve_id);
                if (booking == null)
                    return Json(new { success = false, message = "❌ Không tìm thấy đơn đặt" });

                // ✅ CẬP NHẬT: Trạng thái yêu cầu → "Đã Hủy"
                cancelRequest.trang_thai = "Đã Hủy";
                cancelRequest.ngay_duyet = DateTime.Now;
                cancelRequest.admin_duyet_id = adminId.Value;
                cancelRequest.ghi_chu = note;

                // ✅ CẬP NHẬT: Trạng thái đơn đặt → "Đã Hủy"
                booking.trang_thai_Dat_Ve = "Đã Hủy";

                // ✅ GIẢI PHÓNG: Tất cả vé của đơn này
                var allTickets = booking.Ves.ToList();
                foreach (var ticket in allTickets)
                {
                    ticket.trang_thai_ve = "Đã Hủy";
                    ticket.Dat_Ve_id = null;  // Giải phóng khỏi đơn đặt
                    ticket.ma_qr_code = null;
                }

                // ✅ XÓA: Tất cả đồ ăn liên quan
                var foodOrders = db.DonHang_DoAns.Where(f => f.Dat_Ve_id == booking.Dat_Ve_id).ToList();
                foreach (var food in foodOrders)
                {
                    db.DonHang_DoAns.DeleteOnSubmit(food);
                }

                // ✅ HOÀN LẠI: Điểm tích lũy (nếu khách có điểm từ đơn này)
                var customer = booking.Khach_Hang;
                if (customer != null)
                {
                    int ticketsInOrder = allTickets.Count;
                    if (customer.diem_tich_luy.HasValue && customer.diem_tich_luy >= ticketsInOrder)
                    {
                        customer.diem_tich_luy -= ticketsInOrder;
                        LoggingHelper.LogInfo($"✅ Hoàn lại {ticketsInOrder} điểm cho khách {customer.khach_hang_id}");
                    }
                }

                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Admin {adminId} duyệt hủy vé: Yêu cầu {id}, Booking {booking.Dat_Ve_id}, Hoàn: {cancelRequest.so_tien_hoan_lai}₫");

                return Json(new 
                { 
                    success = true, 
                    message = $"✅ Duyệt hủy vé thành công!\n\n💰 Số tiền hoàn lại: {cancelRequest.so_tien_hoan_lai.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} ₫\n🏦 Tài khoản: ****{cancelRequest.so_tai_khoan_atm.Substring(cancelRequest.so_tai_khoan_atm.Length - 4)}\n\n⏳ Khách hàng sẽ nhận tiền trong 1-3 ngày làm việc"
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "❌ Lỗi: " + ex.Message });
            }
        }

        // ✅ POST: Admin/TicketRefundManagement/RejectCancel - Từ chối hủy vé
        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult RejectCancel(int id, string reason = "")
        {
            try
            {
                int? adminId = Session["EmployeeId"] as int?;
                if (!adminId.HasValue)
                    return Json(new { success = false, message = "❌ Admin không xác thực" });

                var cancelRequest = db.Yeu_Cau_Huy_Ves.FirstOrDefault(y => y.yeu_cau_id == id);
                if (cancelRequest == null)
                    return Json(new { success = false, message = "❌ Yêu cầu không tồn tại" });

                if (cancelRequest.trang_thai != "Chờ duyệt")
                    return Json(new { success = false, message = "❌ Yêu cầu này không ở trạng thái 'Chờ duyệt'" });

                // ✅ CẬP NHẬT: Trạng thái yêu cầu → "Từ chối"
                cancelRequest.trang_thai = "Từ chối";
                cancelRequest.ngay_duyet = DateTime.Now;
                cancelRequest.admin_duyet_id = adminId.Value;
                cancelRequest.ghi_chu = "Từ chối: " + (reason ?? "Không cung cấp lý do");

                db.SubmitChanges();

                LoggingHelper.LogInfo($"✅ Admin {adminId} từ chối hủy vé: Yêu cầu {id}");

                return Json(new 
                { 
                    success = true, 
                    message = "✅ Từ chối yêu cầu hủy vé thành công!\n\n📧 Khách hàng sẽ nhận được thông báo từ chối."
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return Json(new { success = false, message = "❌ Lỗi: " + ex.Message });
            }
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
                db.Dispose();
            base.Dispose(disposing);
        }
    }
}
