@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

@model IEnumerable<WebCinema.Models.Yeu_Cau_Huy_Ve>

@{
    ViewBag.Title = "Quản Lý Hủy Vé";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<style>
    .management-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .header-title {
        font-size: 1.8rem;
        font-weight: 600;
        color: #333;
    }

    .filter-section {
        background: white;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .filter-buttons {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 0.6rem 1.2rem;
        border: 2px solid #e0e0e0;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
    }

    .filter-btn:hover {
        border-color: #ff6b35;
    }

    .filter-btn.active {
        background: #ff6b35;
        color: white;
        border-color: #ff6b35;
    }

    .request-card {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-left: 4px solid #ff6b35;
    }

    .request-header {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
    }

    .request-info h4 {
        margin: 0 0 0.5rem 0;
        color: #333;
    }

    .request-detail {
        color: #666;
        font-size: 0.9rem;
        margin: 0.3rem 0;
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .refund-amount {
        font-size: 1.2rem;
        font-weight: 600;
        color: #27ae60;
    }

    .btn-action {
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-view {
        background: #3498db;
        color: white;
    }

    .btn-view:hover {
        background: #2980b9;
    }

    .btn-approve {
        background: #27ae60;
        color: white;
    }

    .btn-approve:hover {
        background: #229954;
    }

    .btn-reject {
        background: #e74c3c;
        color: white;
    }

    .btn-reject:hover {
        background: #c0392b;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #999;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .page-btn {
        padding: 0.5rem 0.8rem;
        border: 1px solid #e0e0e0;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        color: #333;
    }

    .page-btn.active {
        background: #ff6b35;
        color: white;
        border-color: #ff6b35;
    }

    .page-btn:hover {
        border-color: #ff6b35;
    }
</style>

<div class="management-container">
    <div class="header-section">
        <div class="header-title">
            <i class="fas fa-trash-alt"></i> Quản Lý Hủy Vé
        </div>
        <div style="color: #666;">
            Tổng: <strong>@ViewBag.TotalItems</strong> yêu cầu
        </div>
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="filter-buttons">
            <a href="@Url.Action("Index", new { status = "" })" class="filter-btn @(string.IsNullOrEmpty(ViewBag.Status) ? "active" : "")">
                📋 Tất Cả (@(ViewBag.TotalItems ?? 0))
            </a>
            <a href="@Url.Action("Index", new { status = "Chờ duyệt" })" class="filter-btn @(ViewBag.Status == "Chờ duyệt" ? "active" : "")">
                ⏳ Chờ Duyệt
            </a>
            <a href="@Url.Action("Index", new { status = "Đã Hủy" })" class="filter-btn @(ViewBag.Status == "Đã Hủy" ? "active" : "")">
                ✅ Đã Duyệt
            </a>
            <a href="@Url.Action("Index", new { status = "Từ chối" })" class="filter-btn @(ViewBag.Status == "Từ chối" ? "active" : "")">
                ❌ Từ Chối
            </a>
        </div>
    </div>

    <!-- Requests List -->
    @if (Model != null && Model.Any())
    {
        foreach (var request in Model)
        {
            var booking = request.Dat_Ve;
            var customer = request.Khach_Hang;
            var firstTicket = booking.Ves.FirstOrDefault();
            var showtime = firstTicket.Suat_Chieu;

            <div class="request-card">
                <div class="request-header">
                    <div class="request-info">
                        <h4><i class="fas fa-user"></i> @customer.ho_ten</h4>
                        <div class="request-detail">
                            📞 @customer.so_dien_thoai | 📧 @(customer.email ?? "N/A")
                        </div>
                        <div class="request-detail">
                            🎬 @(showtime.Phim.ten_phim ?? "N/A") - @(showtime.ngay_chieu.ToString("dd/MM/yyyy") ?? "N/A")
                        </div>
                    </div>

                    <div style="text-align: center;">
                        <div class="refund-amount">@request.so_tien_hoan_lai?.ToString("N0") ₫</div>
                        <div style="font-size: 0.85rem; color: #666;">Hoàn 70%</div>
                    </div>

                    <div>
                        @if (request.trang_thai == "Chờ duyệt")
                        {
                            <span class="status-badge status-pending">⏳ Chờ duyệt</span>
                        }
                        else if (request.trang_thai == "Đã Hủy")
                        {
                            <span class="status-badge status-approved">✅ Đã duyệt</span>
                        }
                        else
                        {
                            <span class="status-badge status-rejected">❌ Từ chối</span>
                        }
                        <div style="font-size: 0.85rem; color: #666; margin-top: 0.5rem;">
                            Ngày: @request.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <a href="@Url.Action("Details", new { id = request.yeu_cau_id })" class="btn-action btn-view">
                            <i class="fas fa-eye"></i> Xem
                        </a>
                        @if (request.trang_thai == "Chờ duyệt")
                        {
                            <button class="btn-action btn-approve" onclick="approveCancel(@request.yeu_cau_id)">
                                <i class="fas fa-check"></i> Duyệt
                            </button>
                        }
                    </div>
                </div>

                <!-- Thông tin chi tiết -->
                <div style="padding-top: 1rem; border-top: 1px solid #f0f0f0;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; font-size: 0.9rem;">
                        <div>
                            <strong>🏦 Tài Khoản:</strong> ****@request.so_tai_khoan_atm.Substring(request.so_tai_khoan_atm.Length - 4)
                        </div>
                        <div>
                            <strong>🎫 Vé:</strong> @booking.Ves.Count vé
                        </div>
                        <div>
                            <strong>💰 Tổng:</strong> @booking.tong_tien.ToString("N0") ₫
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(request.ly_do_huy))
                    {
                        <div style="margin-top: 0.8rem; padding: 0.8rem; background: #f9f9f9; border-radius: 6px; font-size: 0.9rem;">
                            <strong>Lý do:</strong> @request.ly_do_huy
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Pagination -->
        if (ViewBag.TotalPages > 1)
        {
            <div class="pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = ViewBag.CurrentPage - 1 })" class="page-btn">
                        ← Trước
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="page-btn active">@i</span>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) <= 2 || i == 1 || i == ViewBag.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.Status, page = i })" class="page-btn">@i</a>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = ViewBag.CurrentPage + 1 })" class="page-btn">
                        Sau →</a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox" style="font-size: 3rem; opacity: 0.5;"></i>
            <h3>Không có yêu cầu hủy vé</h3>
            <p>@(ViewBag.Status == "Chờ duyệt" ? "Hiện không có yêu cầu chờ duyệt" : "Danh sách trống")</p>
        </div>
    }
</div>

@section scripts {
    <script>
        function approveCancel(requestId) {
            if (!confirm("Bạn chắc muốn duyệt hủy vé này?\n\nNhắc nhở: Kiểm tra số tài khoản trước khi duyệt")) {
                return;
            }

            $.ajax({
                url: '@Url.Action("ApproveCancel", new { area = "Admin" })',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val(),
                    id: requestId,
                    note: "Đã chuyển khoản"
                },
                success: function(response) {
                    if (response.success) {
                        alert('✅ ' + response.message);
                        location.reload();
                    } else {
                        alert('❌ ' + response.message);
                    }
                },
                error: function() {
                    alert('❌ Có lỗi xảy ra!');
                }
            });
        }
    </script>
}
