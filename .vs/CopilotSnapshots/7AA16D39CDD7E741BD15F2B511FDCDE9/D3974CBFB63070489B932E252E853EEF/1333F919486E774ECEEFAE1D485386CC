@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

@model IEnumerable<WebCinema.Models.Yeu_Cau_Huy_Ve>

@{
    ViewBag.Title = "Quản Lý Hủy Vé";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<div class="content-card">
    <!-- Header -->
    <div class="card-header">
        <h2 class="card-title">
            <i class="fas fa-trash-alt"></i> Quản Lý Hủy Vé
        </h2>
    </div>

    <!-- Filter Section -->
    <div style="margin-bottom: 2rem; padding: 1.5rem; background: #f8f9fa; border-radius: 8px; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
        <a href="@Url.Action("Index", new { status = "" })" class="btn @(string.IsNullOrEmpty(ViewBag.Status) ? "btn-primary" : "btn-secondary")">
            📋 Tất Cả
        </a>
        <a href="@Url.Action("Index", new { status = "Chờ duyệt" })" class="btn @(ViewBag.Status == "Chờ duyệt" ? "btn-primary" : "btn-secondary")">
            ⏳ Chờ Duyệt
        </a>
        <a href="@Url.Action("Index", new { status = "Đã Hủy" })" class="btn @(ViewBag.Status == "Đã Hủy" ? "btn-primary" : "btn-secondary")">
            ✅ Đã Duyệt
        </a>
        <a href="@Url.Action("Index", new { status = "Từ chối" })" class="btn @(ViewBag.Status == "Từ chối" ? "btn-primary" : "btn-secondary")">
            ❌ Từ Chối
        </a>
        <span style="color: #999; margin-left: auto;">Tổng: <strong>@ViewBag.TotalItems</strong> yêu cầu</span>
    </div>

    <!-- Requests Table -->
    @if (Model != null && Model.Any())
    {
        <div style="overflow-x: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Khách Hàng</th>
                        <th>Phim</th>
                        <th>Ngày Chiếu</th>
                        <th>Hoàn Lại</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Gửi</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        var booking = request.Dat_Ve;
                        var customer = request.Khach_Hang;
                        var firstTicket = booking.Ves.FirstOrDefault();
                        var showtime = firstTicket?.Suat_Chieu;

                        <tr>
                            <td>
                                <strong>@customer.ho_ten</strong><br/>
                                <small style="color: #999;">@(customer.so_dien_thoai ?? "N/A")</small>
                            </td>
                            <td>
                                @(showtime?.Phim.ten_phim ?? "N/A")
                            </td>
                            <td>
                                @(showtime?.ngay_chieu.ToString("dd/MM/yyyy") ?? "N/A")
                            </td>
                            <td>
                                <strong style="color: #27ae60; font-size: 1.05rem;">@((request.so_tien_hoan_lai ?? 0).ToString("N0")) ₫</strong>
                            </td>
                            <td>
                                @if (request.trang_thai == "Chờ duyệt")
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #fff3cd; color: #856404; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">⏳ Chờ duyệt</span>
                                }
                                else if (request.trang_thai == "Đã Hủy")
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #d4edda; color: #155724; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">✅ Đã duyệt</span>
                                }
                                else
                                {
                                    <span style="padding: 0.3rem 0.8rem; background: #f8d7da; color: #721c24; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">❌ Từ chối</span>
                                }
                            </td>
                            <td>
                                <small>@request.ngay_tao?.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = request.yeu_cau_id })" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 2rem; flex-wrap: wrap;">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = ViewBag.CurrentPage - 1 })" class="btn btn-secondary" style="padding: 0.5rem 1rem;">
                        ← Trước
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span style="padding: 0.5rem 1rem; background: #ff6b35; color: white; border-radius: 4px; font-weight: 600;">@i</span>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) <= 2 || i == 1 || i == ViewBag.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { status = ViewBag.Status, page = i })" class="btn btn-secondary" style="padding: 0.5rem 0.8rem;">@i</a>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, page = ViewBag.CurrentPage + 1 })" class="btn btn-secondary" style="padding: 0.5rem 1rem;">
                        Sau →
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 3rem; color: #999;">
            <i class="fas fa-inbox" style="font-size: 3rem; opacity: 0.5; display: block; margin-bottom: 1rem;"></i>
            <h3>Không có yêu cầu hủy vé</h3>
            <p>@(ViewBag.Status == "Chờ duyệt" ? "Hiện không có yêu cầu chờ duyệt" : "Danh sách trống")</p>
        </div>
    }
</div>

@section scripts {
    <script>
        function approveCancel(requestId) {
            if (!confirm("Bạn chắc muốn duyệt hủy vé này?\n\nNhắc nhở: Kiểm tra số tài khoản trước khi duyệt")) {
                return;
            }

            $.ajax({
                url: '@Url.Action("ApproveCancel", new { area = "Admin" })',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val(),
                    id: requestId,
                    note: "Đã chuyển khoản"
                },
                success: function(response) {
                    if (response.success) {
                        alert('✅ ' + response.message);
                        location.reload();
                    } else {
                        alert('❌ ' + response.message);
                    }
                },
                error: function() {
                    alert('❌ Có lỗi xảy ra!');
                }
            });
        }
    </script>
}
