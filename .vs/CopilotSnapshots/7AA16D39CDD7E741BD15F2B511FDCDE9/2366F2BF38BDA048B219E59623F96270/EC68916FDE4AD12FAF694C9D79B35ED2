using System;
using System.Data.Linq.Mapping;

namespace WebCinema.Models
{
    [Table(Name = "dbo.Yeu_Cau_Huy_Ve")]
    public class Yeu_Cau_Huy_Ve
    {
        [Column(IsPrimaryKey = true, IsDbGenerated = true)]
        public int yeu_cau_id { get; set; }

        [Column]
        public int dat_ve_id { get; set; }

        [Column]
        public int khach_hang_id { get; set; }

        [Column]
        public string so_tai_khoan_atm { get; set; }

        [Column]
        public string ly_do_huy { get; set; }

        [Column]
        public decimal so_tien_hoan_lai { get; set; }

        [Column]
        public decimal phan_tram_hoan_30 { get; set; }

        [Column]
        public string trang_thai { get; set; }

        [Column]
        public DateTime? ngay_tao { get; set; }

        [Column]
        public DateTime? ngay_duyet { get; set; }

        [Column]
        public int? admin_duyet_id { get; set; }

        [Column]
        public string ghi_chu { get; set; }

        // Navigation
        [Association(Storage = "_Dat_Ve", ThisKey = "dat_ve_id", OtherKey = "Dat_Ve_id", IsForeignKey = true)]
        public Dat_Ve Dat_Ve { get; set; }
        private Dat_Ve _Dat_Ve;

        [Association(Storage = "_Khach_Hang", ThisKey = "khach_hang_id", OtherKey = "khach_hang_id", IsForeignKey = true)]
        public Khach_Hang Khach_Hang { get; set; }
        private Khach_Hang _Khach_Hang;

        [Association(Storage = "_Admin_Duyet", ThisKey = "admin_duyet_id", OtherKey = "nhanvien_id", IsForeignKey = true)]
        public Nhan_Vien Admin_Duyet { get; set; }
        private Nhan_Vien _Admin_Duyet;
    }
}
