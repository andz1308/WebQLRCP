@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

@model WebCinema.Models.Dat_Ve

@{
    ViewBag.Title = "Chi Tiết Vé - DAV Cinema";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tickets = ViewBag.Tickets as System.Collections.Generic.List<WebCinema.Models.Ve>;
    var showtime = ViewBag.Showtime as WebCinema.Models.Suat_Chieu;
    var isShowtimePassed = (bool)ViewBag.IsShowtimePassed;
    var cancelRequest = ViewBag.CancelRequest as WebCinema.Models.HuyVe;
    
    var hasUsedTickets = tickets.Any(t => t.trang_thai_ve == "Đã sử dụng");
    var hasCancelledTickets = tickets.Any(t => t.trang_thai_ve == "Đã Hủy");
    var canCancel = !isShowtimePassed && !hasUsedTickets && !hasCancelledTickets && (cancelRequest == null || cancelRequest.trang_thai == "Từ chối");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>

<style>
    .details-page {
        background: #f5f5f5;
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    .details-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 1.5rem;
        background: white;
        color: #666;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }

    .back-button:hover {
        border-color: #ff6b35;
        color: #ff6b35;
        transform: translateX(-5px);
    }

    .ticket-detail-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }

    .card-header {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        padding: 2rem;
        text-align: center;
        position: relative;
    }

    .card-header::before {
        content: '';
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 40px;
        background: white;
        border-radius: 50%;
    }

    .booking-id {
        font-size: 1.2rem;
        font-weight: 700;
        opacity: 0.95;
    }

    .booking-status {
        display: inline-block;
        padding: 0.6rem 1.5rem;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        margin-top: 1rem;
        font-weight: 600;
    }

    .card-body {
        padding: 3rem 2rem 2rem;
    }

    .movie-section {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 2rem;
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 2px dashed #e0e0e0;
    }

    .movie-poster {
        width: 100%;
        height: 280px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .movie-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .movie-info h2 {
        font-size: 2rem;
        color: #333;
        margin: 0 0 1.5rem 0;
        font-weight: 700;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 1rem 0;
        font-size: 1.05rem;
    }

    .info-row i {
        width: 30px;
        color: #ff6b35;
        font-size: 1.2rem;
    }

    .info-row .label {
        color: #999;
        min-width: 100px;
    }

    .info-row .value {
        color: #333;
        font-weight: 600;
    }

    .price-highlight {
        background: linear-gradient(135deg, #fff3f0 0%, #ffe8e0 100%);
        padding: 1.5rem;
        border-radius: 12px;
        margin: 2rem 0;
        text-align: center;
        border: 2px dashed #ff6b35;
    }

    .price-label {
        color: #666;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
    }

    .price-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #ff6b35;
    }

    .section-title {
        font-size: 1.5rem;
        color: #333;
        margin: 2rem 0 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .section-title i {
        color: #ff6b35;
    }

    .tickets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin: 2rem 0;
    }

    .qr-ticket-card {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
    }

    .qr-ticket-card:hover {
        border-color: #ff6b35;
        box-shadow: 0 8px 25px rgba(255, 107, 53, 0.15);
        transform: translateY(-5px);
    }

    .qr-code-container {
        background: #f9f9f9;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .seat-info {
        font-size: 1.3rem;
        font-weight: 700;
        color: #333;
        margin: 1rem 0 0.5rem;
    }

    .ticket-price {
        color: #ff6b35;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .ticket-status-label {
        display: inline-block;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: 0.5rem;
    }

    .status-available {
        background: #d4edda;
        color: #155724;
    }

    .status-used {
        background: #d1ecf1;
        color: #0c5460;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    .alert-box {
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 1rem;
        line-height: 1.6;
    }

    .alert-info {
        background: #d1ecf1;
        border-left: 4px solid #17a2b8;
        color: #0c5460;
    }

    .alert-success {
        background: #d4edda;
        border-left: 4px solid #28a745;
        color: #155724;
    }

    .alert-warning {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        color: #856404;
    }

    .alert-danger {
        background: #f8d7da;
        border-left: 4px solid #dc3545;
        color: #721c24;
    }

    .alert-box i {
        font-size: 1.5rem;
    }

    .cancel-section {
        background: linear-gradient(135deg, #fff9f0 0%, #fff3e0 100%);
        border-radius: 16px;
        padding: 2.5rem;
        margin-top: 3rem;
        border: 2px solid #ffc107;
    }

    .cancel-title {
        font-size: 1.5rem;
        color: #333;
        margin: 0 0 1rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .refund-info-box {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        margin: 1.5rem 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .refund-calculation {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1rem;
    }

    .refund-item {
        text-align: center;
        padding: 1rem;
        background: #f9f9f9;
        border-radius: 8px;
    }

    .refund-label {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .refund-value {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .refund-value.original {
        color: #666;
    }

    .refund-value.fee {
        color: #e74c3c;
    }

    .refund-value.final {
        color: #27ae60;
    }

    .form-group {
        margin: 1.5rem 0;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.8rem;
        font-size: 1.05rem;
    }

    .form-textarea {
        width: 100%;
        padding: 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 1rem;
        font-family: inherit;
        resize: vertical;
        min-height: 120px;
        transition: all 0.3s ease;
    }

    .form-textarea:focus {
        outline: none;
        border-color: #ff6b35;
        box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.1);
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 1rem 2.5rem;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1.05rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        text-decoration: none;
    }

    .btn-danger {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    .btn-danger:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(231, 76, 60, 0.4);
    }

    .btn-primary {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(52, 152, 219, 0.4);
    }

    @@media (max-width: 768px) {
        .movie-section {
            grid-template-columns: 1fr;
        }

        .movie-poster {
            height: 200px;
        }

        .tickets-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="details-page">
    <div class="details-container">
        <a href="@Url.Action("MyTickets")" class="back-button">
            <i class="fas fa-arrow-left"></i>
            Quay lại danh sách vé
        </a>

        <div class="ticket-detail-card">
            <div class="card-header">
                <div class="booking-id">
                    <i class="fas fa-ticket-alt"></i>
                    Mã đơn: #@Model.Dat_Ve_id
                </div>
                <div class="booking-status">
                    @if (hasUsedTickets)
                    {
                        <text>✓ Đã sử dụng</text>
                    }
                    else if (hasCancelledTickets)
                    {
                        <text>✗ Đã hủy</text>
                    }
                    else
                    {
                        <text>⏳ Chưa sử dụng</text>
                    }
                </div>
            </div>

            <div class="card-body">
                <!-- Status Alerts -->
                @if (cancelRequest != null)
                {
                    if (cancelRequest.trang_thai == "Chờ xác nhận")
                    {
                        <div class="alert-box alert-info">
                            <i class="fas fa-hourglass-half"></i>
                            <div>
                                <strong>Yêu cầu hủy đang chờ xác nhận chuyển tiền</strong><br />
                                Ngày gửi: @cancelRequest.ngay_tao.Value.ToString("dd/MM/yyyy HH:mm")<br />
                                Admin sẽ xác nhận chuyển khoản hoàn tiền cho bạn trong 1-3 ngày làm việc
                            </div>
                        </div>
                    }
                    else if (cancelRequest.trang_thai == "Đã Hủy")
                    {
                        <div class="alert-box alert-success">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <strong>Vé đã hủy thành công!</strong><br />
                                Số tiền hoàn lại: <strong>@cancelRequest.so_tien_hoan_lai?.ToString("N0") ₫</strong><br />
                                Ngày duyệt: @cancelRequest.ngay_duyet?.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    }
                    else if (cancelRequest.trang_thai == "Từ chối")
                    {
                        <div class="alert-box alert-danger">
                            <i class="fas fa-times-circle"></i>
                            <div>
                                <strong>Yêu cầu hủy bị từ chối</strong><br />
                                Lý do: @cancelRequest.ghi_chu
                            </div>
                        </div>
                    }
                }

                @if (isShowtimePassed && !hasUsedTickets && !hasCancelledTickets)
                {
                    <div class="alert-box alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>
                            <strong>Suất chiếu đã qua</strong><br />
                            Vé này đã hết hạn sử dụng. Bạn không thể hủy vé sau khi suất chiếu diễn ra.
                        </div>
                    </div>
                }

                <!-- Movie Info -->
                @if (showtime != null)
                {
                    <div class="movie-section">
                        <div class="movie-poster">
                            @if (!string.IsNullOrEmpty(showtime.Phim.anh_poster))
                            {
                                <img src="@Url.Content(showtime.Phim.anh_poster)" alt="@showtime.Phim.ten_phim" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/Content/images/no-poster.png")" alt="No Poster" />
                            }
                        </div>

                        <div class="movie-info">
                            <h2>@showtime.Phim.ten_phim</h2>

                            <div class="info-row">
                                <i class="fas fa-calendar-alt"></i>
                                <span class="label">Ngày chiếu:</span>
                                <span class="value">@showtime.ngay_chieu.ToString("dddd, dd/MM/yyyy")</span>
                            </div>

                            <div class="info-row">
                                <i class="fas fa-clock"></i>
                                <span class="label">Giờ chiếu:</span>
                                <span class="value">@showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</span>
                            </div>

                            <div class="info-row">
                                <i class="fas fa-map-marker-alt"></i>
                                <span class="label">Rạp:</span>
                                <span class="value">@showtime.Phong_Chieu.Rap.ten_rap</span>
                            </div>

                            <div class="info-row">
                                <i class="fas fa-door-open"></i>
                                <span class="label">Phòng:</span>
                                <span class="value">@showtime.Phong_Chieu.ten_phong</span>
                            </div>

                            <div class="info-row">
                                <i class="fas fa-couch"></i>
                                <span class="label">Số vé:</span>
                                <span class="value">@tickets.Count vé</span>
                            </div>

                            <div class="info-row">
                                <i class="fas fa-calendar-plus"></i>
                                <span class="label">Đặt lúc:</span>
                                <span class="value">@Model.ngay_tao.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <div class="price-highlight">
                        <div class="price-label">Tổng thanh toán</div>
                        <div class="price-value">@Model.tong_tien.ToString("N0") ₫</div>
                    </div>
                }

                <!-- QR Codes -->
                <h3 class="section-title">
                    <i class="fas fa-qrcode"></i>
                    Mã QR Vé
                </h3>

                <div class="tickets-grid">
                    @foreach (var ticket in tickets.OrderBy(t => t.Ghe.so_ghe))
                    {
                        var statusClass = ticket.trang_thai_ve == "Đã sử dụng" ? "status-used" : 
                                        (ticket.trang_thai_ve == "Đã Hủy" ? "status-cancelled" : "status-available");
                        var statusText = ticket.trang_thai_ve == "Đã sử dụng" ? "✓ Đã sử dụng" : 
                                       (ticket.trang_thai_ve == "Đã Hủy" ? "✗ Đã hủy" : "⏳ Chưa sử dụng");

                        <div class="qr-ticket-card">
                            <div class="qr-code-container">
                                <canvas id="qr-@ticket.ve_id" style="width: 100%; height: auto;"></canvas>
                            </div>
                            <div class="seat-info">Ghế @ticket.Ghe.so_ghe</div>
                            <div class="ticket-price">@ticket.gia_ve.ToString("N0") ₫</div>
                            <div class="ticket-status-label @statusClass">@statusText</div>
                        </div>

                        <script>
                            QRCode.toCanvas(document.getElementById('qr-@ticket.ve_id'), '@ticket.ma_qr_code', {
                                width: 200,
                                margin: 2,
                                color: {
                                    dark: '#000000',
                                    light: '#ffffff'
                                }
                            });
                        </script>
                    }
                </div>

                <!-- Cancel Form -->
                @if (canCancel)
                {
                    <div class="cancel-section">
                        <h3 class="cancel-title">
                            <i class="fas fa-exclamation-triangle"></i>
                            Hủy Vé
                        </h3>
                        <p style="color: #666; margin-bottom: 1.5rem; line-height: 1.6;">
                            Bạn sẽ nhận lại <strong>70%</strong> giá trị vé. Phí hủy <strong>30%</strong> sẽ được khấu trừ.
                        </p>

                        <div class="refund-info-box">
                            <div class="refund-calculation">
                                <div class="refund-item">
                                    <div class="refund-label">Tổng tiền gốc</div>
                                    <div class="refund-value original">@Model.tong_tien.ToString("N0") ₫</div>
                                </div>
                                <div class="refund-item">
                                    <div class="refund-label">Phí hủy (30%)</div>
                                    <div class="refund-value fee">-@(Math.Round(Model.tong_tien * 0.3m, 0).ToString("N0")) ₫</div>
                                </div>
                                <div class="refund-item">
                                    <div class="refund-label">Số tiền hoàn lại</div>
                                    <div class="refund-value final">@(Math.Round(Model.tong_tien * 0.7m, 0).ToString("N0")) ₫</div>
                                </div>
                            </div>
                        </div>

                        <form id="cancelForm" onsubmit="return submitCancelRequest();">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-comment"></i>
                                    Lý do hủy (tùy chọn)
                                </label>
                                <textarea id="reason" name="reason" class="form-textarea"
                                          placeholder="Vui lòng cho chúng tôi biết lý do bạn muốn hủy vé..."></textarea>
                            </div>

                            <div class="action-buttons">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-times-circle"></i>
                                    Xác nhận hủy vé
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    function submitCancelRequest() {
        const reason = document.getElementById('reason').value.trim();
        const refundAmount = '@(Math.Round(Model.tong_tien * 0.7m, 0).ToString("N0"))';

        if (!confirm("⚠️ XÁC NHẬN HỦY VÉ\n\n" +
                     "💰 Số tiền hoàn lại: " + refundAmount + " ₫ (70%)\n" +
                     "💳 Phí hủy: @(Math.Round(Model.tong_tien * 0.3m, 0).ToString("N0")) ₫ (30%)\n\n" +
                     "Bạn có chắc chắn muốn hủy vé này không?")) {
            return false;
        }

        $.ajax({
            url: '@Url.Action("RequestCancel", "TicketRefund")',
            type: 'POST',
            data: {
                __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val(),
                bookingId: @Model.Dat_Ve_id,
                reason: reason || "Không cung cấp lý do"
            },
            success: function(response) {
                if (response.success) {
                    alert('✅ ' + response.message);
                    location.reload();
                } else {
                    alert('❌ ' + response.message);
                }
            },
            error: function(xhr) {
                alert('❌ Có lỗi xảy ra khi hủy vé. Vui lòng thử lại!');
            }
        });

        return false;
    }
</script>
}
