@model WebCinema.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng Nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAV Cinema - Đăng Nhập</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: #000;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    /* ✅ Background với hình thật từ Unsplash */
    .auth-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    .auth-background img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.3);
    }

    .auth-background::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%);
    }

    /* ✅ Logo đẹp như Netflix */
    .brand-logo {
        position: fixed;
        top: 2rem;
        left: 2rem;
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        text-decoration: none;
    }

    .brand-logo-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #E50914 0%, #B20710 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(229, 9, 20, 0.4);
        transition: all 0.3s ease;
    }

    .brand-logo:hover .brand-logo-icon {
        transform: scale(1.05);
        box-shadow: 0 12px 35px rgba(229, 9, 20, 0.6);
    }

    .brand-logo-icon i {
        font-size: 1.8rem;
        color: white;
    }

    .brand-logo-text {
        color: white;
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -1px;
    }

    /* ✅ Container chính */
    .auth-container {
        max-width: 480px;
        width: 100%;
        padding: 0 2rem;
        position: relative;
        z-index: 1;
    }

    .auth-card {
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 4rem 3rem 3rem;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        animation: slideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .auth-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .auth-title {
        font-size: 2.8rem;
        color: white;
        margin-bottom: 0.8rem;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .auth-subtitle {
        color: rgba(255, 255, 255, 0.7);
        font-size: 1rem;
        font-weight: 300;
    }

    /* ✅ Form inputs như Netflix */
    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1.8rem;
    }

    .form-group {
        position: relative;
    }

    .form-input {
        width: 100%;
        padding: 1.3rem 1.2rem 0.8rem;
        background: #333;
        border: 1px solid #555;
        border-radius: 8px;
        font-size: 1rem;
        color: white;
        transition: all 0.3s ease;
        font-family: 'Poppins', sans-serif;
    }

    .form-input:focus {
        outline: none;
        border-color: #E50914;
        background: #454545;
        box-shadow: 0 0 0 2px rgba(229, 9, 20, 0.2);
    }

    .form-input::placeholder {
        color: transparent;
    }

    .form-label {
        position: absolute;
        left: 1.2rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.5);
        font-size: 1rem;
        transition: all 0.3s ease;
        pointer-events: none;
        font-weight: 400;
    }

    .form-input:focus + .form-label,
    .form-input:not(:placeholder-shown) + .form-label {
        top: 0.6rem;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .password-wrapper {
        position: relative;
    }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: rgba(255, 255, 255, 0.6);
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border-radius: 6px;
    }

    .password-toggle:hover {
        color: white;
        background: rgba(255, 255, 255, 0.1);
    }

    .password-toggle i {
        font-size: 1.1rem;
    }

    /* ✅ Button đỏ Netflix */
    .btn-submit {
        padding: 1.2rem;
        background: #E50914;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
        letter-spacing: 0.5px;
        font-family: 'Poppins', sans-serif;
    }

    .btn-submit:hover {
        background: #B20710;
        transform: translateY(-2px);
        box-shadow: 0 15px 40px rgba(229, 9, 20, 0.4);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    /* ✅ Links và footer */
    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: -0.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .form-checkbox {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #E50914;
    }

    .form-checkbox-label {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
        cursor: pointer;
        font-weight: 400;
    }

    .forgot-link {
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .forgot-link:hover {
        color: white;
        text-decoration: underline;
    }

    .auth-footer {
        text-align: center;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        font-weight: 400;
    }

    .auth-footer a {
        color: white;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .auth-footer a:hover {
        color: #E50914;
        text-decoration: underline;
    }

    /* ✅ Alert messages */
    .success-message,
    .alert-error {
        padding: 1rem 1.2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        text-align: center;
        animation: slideUp 0.5s ease-out;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-weight: 500;
    }

    .success-message {
        background: rgba(22, 163, 74, 0.2);
        border: 1px solid #16a34a;
        color: #86efac;
    }

    .alert-error {
        background: rgba(229, 9, 20, 0.2);
        border: 1px solid #E50914;
        color: #fca5a5;
    }

    .success-message::before {
        content: '✓';
        font-size: 1.3rem;
        font-weight: bold;
    }

    .alert-error::before {
        content: '!';
        font-size: 1.3rem;
        font-weight: bold;
    }

    /* ✅ Responsive */
    @@media (max-width: 768px) {
        .brand-logo {
            top: 1.5rem;
            left: 1.5rem;
        }

        .brand-logo-text {
            display: none;
        }

        .auth-card {
            padding: 3rem 2rem 2.5rem;
        }

        .auth-title {
            font-size: 2.2rem;
        }

        .form-options {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 480px) {
        .auth-container {
            padding: 0 1rem;
        }

        .auth-card {
            padding: 2.5rem 1.5rem 2rem;
        }

        .auth-title {
            font-size: 1.8rem;
        }
    }
</style>

<body>
    <!-- ✅ Background Image -->
    <div class="auth-background">
        <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1920&q=80" 
             alt="Cinema Background"
             loading="eager" />
    </div>

    <!-- ✅ Logo -->
    <a href="@Url.Action("Index", "Home")" class="brand-logo">
        <div class="brand-logo-icon">
            <i class="fas fa-film"></i>
        </div>
        <span class="brand-logo-text">DAV Cinema</span>
    </a>

    <!-- ✅ Auth Card -->
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Đăng Nhập</h1>
                <p class="auth-subtitle">Chào mừng quay trở lại</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert-error">
                    @ViewBag.ErrorMessage
                </div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    @Html.TextBoxFor(m => m.Email, new { 
                        @class = "form-input", 
                        placeholder = " ",
                        type = "email",
                        autocomplete = "email"
                    })
                    <label class="form-label">Email hoặc số điện thoại</label>
                </div>

                <div class="form-group">
                    <div class="password-wrapper">
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-input",
                            placeholder = " ",
                            id = "password",
                            autocomplete = "current-password"
                        })
                        <label class="form-label">Mật khẩu</label>
                        <button type="button" id="togglePassword" class="password-toggle">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    Đăng nhập
                </button>

                <div class="form-options">
                    <div class="remember-me">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-checkbox", id = "remember" })
                        <label class="form-checkbox-label" for="remember">Ghi nhớ đăng nhập</label>
                    </div>
                    <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-link">Quên mật khẩu?</a>
                </div>
            }

            <div class="auth-footer">
                Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ✅ Password toggle
            const togglePassword = document.getElementById('togglePassword');
            const passwordField = document.getElementById('password');
            
            if (togglePassword && passwordField) {
                togglePassword.addEventListener('click', function () {
                    const type = passwordField.type === 'password' ? 'text' : 'password';
                    passwordField.type = type;
                    
                    const icon = this.querySelector('i');
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                });
            }

            // ✅ Form inputs auto-fill detection
            const inputs = document.querySelectorAll('.form-input');
            inputs.forEach(input => {
                if (input.value) {
                    input.setAttribute('placeholder', ' ');
                }
            });
        });
    </script>
</body>
</html>
