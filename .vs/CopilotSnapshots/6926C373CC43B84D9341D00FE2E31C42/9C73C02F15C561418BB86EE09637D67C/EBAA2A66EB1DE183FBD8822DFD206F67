</style>

<div class="tickets-page">
    <div class="tickets-container">
        <!-- Hero Section -->
        <div class="tickets-hero">
            <div class="tickets-hero-content">
                <h1>
                    <i class="fas fa-ticket-alt"></i>
                    Vé Của Tôi
                </h1>
            </div>
        </div>

        <!-- Stats Section - CHỈ ĐƠN ĐÃ THANH TOÁN -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card-value">@totalTickets</div>
                <div class="stat-card-label">Tổng số vé đã đặt</div>
            </div>

            <div class="stat-card">
                <div class="stat-card-value">@paidBookings.Count</div>
                <div class="stat-card-label">Tổng số đơn đặt</div>
            </div>

            <div class="stat-card">
                <div class="stat-card-value">@totalSpent.ToString("N0") ₫</div>
                <div class="stat-card-label">Tổng chi tiêu</div>
            </div>

            <div class="stat-card">
                <div class="stat-card-value">@upcomingBookings.Count</div>
                <div class="stat-card-label">Vé sắp tới</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tickets-tabs">
            <button class="tab-button @(status == "all" ? "active" : "")" onclick="location.href='@Url.Action("MyTickets", new { status = "all", page = 1, sortBy })'">
                <i class="fas fa-list"></i> Tất cả
                <span class="tab-badge">@allBookings.Count</span>
            </button>
            <button class="tab-button @(status == "upcoming" ? "active" : "")" onclick="location.href='@Url.Action("MyTickets", new { status = "upcoming", page = 1, sortBy })'">
                <i class="fas fa-clock"></i> Sắp tới
                <span class="tab-badge">@upcomingBookings.Count</span>
            </button>
            <button class="tab-button @(status == "past" ? "active" : "")" onclick="location.href='@Url.Action("MyTickets", new { status = "past", page = 1, sortBy })'">
                <i class="fas fa-history"></i> Đã xem
                <span class="tab-badge">@pastBookings.Count</span>
            </button>
            <button class="tab-button @(status == "used" ? "active" : "")" onclick="location.href='@Url.Action("MyTickets", new { status = "used", page = 1, sortBy })'">
                <i class="fas fa-check-circle"></i> Đã sử dụng
                <span class="tab-badge">@allBookings.Count(b => b.Ves.Any(v => v.trang_thai_ve == "Đã sử dụng"))</span>
            </button>
            <button class="tab-button @(status == "cancelled" ? "active" : "")" onclick="location.href='@Url.Action("MyTickets", new { status = "cancelled", page = 1, sortBy })'">
                <i class="fas fa-times-circle"></i> Đã hủy
                <span class="tab-badge">@allBookings.Count(b => b.Ves.Any(v => v.trang_thai_ve == "Đã Hủy"))</span>
            </button>
        </div>

        <!-- ✅ Filter Bar -->
        <div class="filter-bar">
            <div class="filter-left">
                <span class="filter-label">
                    <i class="fas fa-filter"></i> Sắp xếp theo:
                </span>
                <select class="filter-select" onchange="location.href='@Url.Action("MyTickets", new { status, page = 1 })' + '&sortBy=' + this.value">
                    <option value="date_desc" @(sortBy == "date_desc" ? "selected" : "")>Mới nhất</option>
                    <option value="date_asc" @(sortBy == "date_asc" ? "selected" : "")>Cũ nhất</option>
                    <option value="price_desc" @(sortBy == "price_desc" ? "selected" : "")>Giá cao nhất</option>
                    <option value="price_asc" @(sortBy == "price_asc" ? "selected" : "")>Giá thấp nhất</option>
                    <option value="showtime_desc" @(sortBy == "showtime_desc" ? "selected" : "")>Thời gian chiếu: Mới nhất</option>
                    <option value="showtime_asc" @(sortBy == "showtime_asc" ? "selected" : "")>Thời gian chiếu: Cũ nhất</option>
                </select>
            </div>
            
            <div class="filter-right">
                <span class="result-count">
                    Hiển thị <strong>@pagedBookings.Count</strong> / <strong>@totalItems</strong> đơn đặt
                </span>
            </div>
        </div>

        <!-- Tickets List -->
        <div class="tickets-list">
            @if (pagedBookings.Any())
            {
                foreach (var booking in pagedBookings)
                {
                    @Html.Partial("_TicketCard", booking)
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🎬</div>
                    <h3>Không tìm thấy vé nào</h3>
                    <p>Không có vé phù hợp với bộ lọc của bạn</p>
                    <a href="@Url.Action("MyTickets")" class="btn-ticket btn-primary">
                        <i class="fas fa-redo"></i> Xem tất cả
                    </a>
                </div>
            }
        </div>

        <!-- ✅ Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination-container">
                <div class="pagination">
                    <!-- Previous -->
                    @if (page > 1)
                    {
                        <a href="@Url.Action("MyTickets", new { status, page = page - 1, sortBy })" class="page-btn">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    else
                    {
                        <span class="page-btn disabled">
                            <i class="fas fa-chevron-left"></i>
                        </span>
                    }

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, page - 2);
                        int endPage = Math.Min(totalPages, page + 2);
                        
                        if (startPage > 1)
                        {
                            <a href="@Url.Action("MyTickets", new { status, page = 1, sortBy })" class="page-number">1</a>
                            if (startPage > 2)
                            {
                                <span class="page-dots">...</span>
                            }
                        }
                        
                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == page)
                            {
                                <span class="page-number active">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("MyTickets", new { status, page = i, sortBy })" class="page-number">@i</a>
                            }
                        }
                        
                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <span class="page-dots">...</span>
                            }
                            <a href="@Url.Action("MyTickets", new { status, page = totalPages, sortBy })" class="page-number">@totalPages</a>
                        }
                    }

                    <!-- Next -->
                    @if (page < totalPages)
                    {
                        <a href="@Url.Action("MyTickets", new { status, page = page + 1, sortBy })" class="page-btn">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="page-btn disabled">
                            <i class="fas fa-chevron-right"></i>
                        </span>
                    }
                </div>
                
                <div class="page-info">
                    Trang <strong>@page</strong> / <strong>@totalPages</strong>
                </div>
            </div>
        }
    </div>
</div>
