@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
}

@model IEnumerable<WebCinema.Models.Dat_Ve>

@{
    ViewBag.Title = "Vé Của Tôi - DAV Cinema";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // ✅ Lấy parameters từ URL
    int page = Request.QueryString["page"] != null ? int.Parse(Request.QueryString["page"]) : 1;
    string status = Request.QueryString["status"] ?? "all";
    string sortBy = Request.QueryString["sortBy"] ?? "date_desc";
    string searchName = Request.QueryString["searchName"] ?? "";
    string searchDate = Request.QueryString["searchDate"] ?? "";
    string searchStatus = Request.QueryString["searchStatus"] ?? "";
    
    // ✅ CHỈ LẤY CÁC ĐƠN ĐÃ THANH TOÁN - QUAN TRỌNG!
    var paidBookings = Model != null ? Model.Where(b => b.trang_thai_Dat_Ve == "Đã Thanh toán").ToList() : new List<WebCinema.Models.Dat_Ve>();
    
    // ✅ Thống kê
    var totalSpent = paidBookings.Sum(b => b.tong_tien);
    var totalTickets = paidBookings.SelectMany(b => b.Ves).Count();
    var upcomingBookings = paidBookings.Where(b => b.Ves.Any() && b.Ves.First().Suat_Chieu != null && b.Ves.First().Suat_Chieu.ngay_chieu >= DateTime.Now).ToList();
    var pastBookings = paidBookings.Where(b => b.Ves.Any() && b.Ves.First().Suat_Chieu != null && b.Ves.First().Suat_Chieu.ngay_chieu < DateTime.Now).ToList();
    
    // ✅ Lọc theo tab (CHỈ VÉ ĐÃ THANH TOÁN)
    IEnumerable<WebCinema.Models.Dat_Ve> filteredBookings = paidBookings;
    switch (status)
    {
        case "upcoming":
            filteredBookings = upcomingBookings;
            break;
        case "past":
            filteredBookings = pastBookings;
            break;
        case "used":
            filteredBookings = paidBookings.Where(b => b.Ves.Any(v => v.trang_thai_ve == "Đã sử dụng"));
            break;
        case "cancelled":
            filteredBookings = paidBookings.Where(b => b.Ves.Any(v => v.trang_thai_ve == "Đã Hủy"));
            break;
        default: // "all"
            filteredBookings = paidBookings;
            break;
    }
    
    // ✅ Lọc theo tên phim
    if (!string.IsNullOrEmpty(searchName))
    {
        filteredBookings = filteredBookings.Where(b => 
            b.Ves.Any() && 
            b.Ves.First().Suat_Chieu != null && 
            b.Ves.First().Suat_Chieu.Phim != null &&
            b.Ves.First().Suat_Chieu.Phim.ten_phim.ToLower().Contains(searchName.ToLower())
        );
    }
    
    // ✅ Lọc theo ngày
    if (!string.IsNullOrEmpty(searchDate))
    {
        DateTime filterDate;
        if (DateTime.TryParse(searchDate, out filterDate))
        {
            filteredBookings = filteredBookings.Where(b => 
                b.Ves.Any() && 
                b.Ves.First().Suat_Chieu != null &&
                b.Ves.First().Suat_Chieu.ngay_chieu.Date == filterDate.Date
            );
        }
    }
    
    // ✅ Lọc theo trạng thái vé
    if (!string.IsNullOrEmpty(searchStatus))
    {
        filteredBookings = filteredBookings.Where(b => 
            b.Ves.Any(v => v.trang_thai_ve == searchStatus)
        );
    }
    
    // ✅ Sắp xếp
    switch (sortBy)
    {
        case "date_asc":
            filteredBookings = filteredBookings.OrderBy(b => b.ngay_tao);
            break;
        case "date_desc":
            filteredBookings = filteredBookings.OrderByDescending(b => b.ngay_tao);
            break;
        case "price_asc":
            filteredBookings = filteredBookings.OrderBy(b => b.tong_tien);
            break;
        case "price_desc":
            filteredBookings = filteredBookings.OrderByDescending(b => b.tong_tien);
            break;
        case "showtime_asc":
            filteredBookings = filteredBookings.OrderBy(b => b.Ves.Any() && b.Ves.First().Suat_Chieu != null ? b.Ves.First().Suat_Chieu.ngay_chieu : DateTime.MaxValue);
            break;
        case "showtime_desc":
            filteredBookings = filteredBookings.OrderByDescending(b => b.Ves.Any() && b.Ves.First().Suat_Chieu != null ? b.Ves.First().Suat_Chieu.ngay_chieu : DateTime.MinValue);
            break;
        default:
            filteredBookings = filteredBookings.OrderByDescending(b => b.ngay_tao);
            break;
    }
    
    // ✅ Phân trang
    int pageSize = 10;
    int totalItems = filteredBookings.Count();
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    page = Math.Max(1, Math.Min(page, totalPages == 0 ? 1 : totalPages));
    
    var pagedBookings = filteredBookings.Skip((page - 1) * pageSize).Take(pageSize).ToList();
}

<style>
