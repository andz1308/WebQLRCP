@model WebCinema.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng Nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAV Cinema - Đăng Nhập</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8d6 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    /* ✅ Background với hình cinema tươi sáng */
    .auth-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    .auth-background img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(1.1) contrast(1.05) saturate(1.3);
        opacity: 0.25;
    }

    .auth-background::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at top right, rgba(255, 107, 53, 0.08) 0%, transparent 70%);
    }

    /* ✅ Decorative circles */
    .deco-circle {
        position: absolute;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(255, 107, 53, 0.1), rgba(255, 152, 0, 0.1));
        animation: float 20s ease-in-out infinite;
    }

    .deco-circle:nth-child(1) {
        width: 400px;
        height: 400px;
        top: -200px;
        right: -100px;
        animation-delay: 0s;
    }

    .deco-circle:nth-child(2) {
        width: 300px;
        height: 300px;
        bottom: -150px;
        left: -100px;
        animation-delay: 2s;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0) translateX(0); }
        50% { transform: translateY(-30px) translateX(30px); }
    }

    /* ✅ Logo cam rực rỡ */
    .brand-logo {
        position: fixed;
        top: 2.5rem;
        left: 2.5rem;
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
    }

    .brand-logo-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 
            0 10px 30px rgba(255, 107, 53, 0.3),
            0 0 0 3px rgba(255, 255, 255, 0.5);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .brand-logo:hover .brand-logo-icon {
        transform: scale(1.1) rotate(-5deg);
        box-shadow: 
            0 15px 40px rgba(255, 107, 53, 0.5),
            0 0 0 3px rgba(255, 107, 53, 0.3);
    }

    .brand-logo-icon i {
        font-size: 2.2rem;
        color: white;
    }

    .brand-logo-text {
        color: #ff6b35;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -1px;
    }

    /* ✅ Container sáng */
    .auth-container {
        max-width: 1100px;
        width: 100%;
        padding: 0 2rem;
        position: relative;
        z-index: 2;
        display: flex;
        gap: 0;
        align-items: center;
    }

    /* ✅ Left Image Section */
    .auth-image-section {
        flex: 1;
        height: 700px;
        border-radius: 32px 0 0 32px;
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
    }

    .auth-image-section img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.9);
    }

    .auth-image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(255, 107, 53, 0.4) 0%, rgba(255, 133, 85, 0.6) 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        color: white;
        text-align: center;
    }

    .auth-image-overlay h2 {
        font-size: 3rem;
        font-weight: 900;
        margin-bottom: 1rem;
        line-height: 1.2;
        text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
    }

    .auth-image-overlay p {
        font-size: 1.2rem;
        font-weight: 400;
        opacity: 0.95;
        max-width: 400px;
        line-height: 1.6;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .auth-image-overlay .cinema-icon {
        font-size: 5rem;
        margin-bottom: 2rem;
        opacity: 0.9;
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.9; }
        50% { transform: scale(1.05); opacity: 1; }
    }

    /* ✅ Right Form Section */
    .auth-form-section {
        flex: 1;
    }

    .auth-card {
        background: white;
        border-radius: 0 32px 32px 0;
        padding: 5rem 4rem 4rem;
        box-shadow: 
            0 20px 60px rgba(255, 107, 53, 0.15),
            0 0 0 1px rgba(255, 107, 53, 0.05);
        border: 2px solid rgba(255, 107, 53, 0.1);
        border-left: none;
        animation: slideUp 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        height: 700px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, 
            #ff6b35 0%, 
            #ff8555 25%, 
            #ff9966 50%, 
            #ff8555 75%, 
            #ff6b35 100%);
        background-size: 200% 100%;
        animation: borderSlide 3s linear infinite;
    }

    @@keyframes borderSlide {
        0% { background-position: 0% 0%; }
        100% { background-position: 200% 0%; }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .auth-header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .auth-title {
        font-size: 3.2rem;
        color: #ff6b35;
        margin-bottom: 1rem;
        font-weight: 900;
        letter-spacing: -2px;
        line-height: 1;
    }

    .auth-subtitle {
        color: #999;
        font-size: 1.1rem;
        font-weight: 400;
    }

    /* ✅ Form inputs sáng */
    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .form-group {
        position: relative;
    }

    .form-input {
        width: 100%;
        padding: 1.5rem 1.5rem 1rem;
        background: #fafafa;
        border: 2px solid #f0f0f0;
        border-radius: 14px;
        font-size: 1.05rem;
        color: #333;
        transition: all 0.3s ease;
        font-family: 'Poppins', sans-serif;
    }

    .form-input:focus {
        outline: none;
        border-color: #ff6b35;
        background: white;
        box-shadow: 
            0 0 0 4px rgba(255, 107, 53, 0.1),
            0 8px 24px rgba(255, 107, 53, 0.15);
    }

    .form-input::placeholder {
        color: transparent;
    }

    .form-label {
        position: absolute;
        left: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
        font-size: 1.05rem;
        transition: all 0.3s ease;
        pointer-events: none;
        font-weight: 500;
    }

    .form-input:focus + .form-label,
    .form-input:not(:placeholder-shown) + .form-label {
        top: 0.8rem;
        font-size: 0.8rem;
        color: #ff6b35;
        font-weight: 700;
    }

    .password-wrapper {
        position: relative;
    }

    .password-toggle {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        background: white;
        border: 2px solid #f0f0f0;
        cursor: pointer;
        color: #999;
        padding: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border-radius: 10px;
    }

    .password-toggle:hover {
        color: #ff6b35;
        border-color: #ff6b35;
        background: #fff5f0;
    }

    .password-toggle i {
        font-size: 1.1rem;
    }

    /* ✅ Button cam rực */
    .btn-submit {
        padding: 1.4rem;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
        border: none;
        border-radius: 14px;
        font-size: 1.15rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 1rem;
        letter-spacing: 1px;
        font-family: 'Poppins', sans-serif;
        text-transform: uppercase;
        box-shadow: 
            0 8px 24px rgba(255, 107, 53, 0.3),
            0 0 0 3px rgba(255, 107, 53, 0.1);
        position: relative;
        overflow: hidden;
    }

    .btn-submit::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
        transition: left 0.6s;
    }

    .btn-submit:hover::before {
        left: 100%;
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 
            0 15px 40px rgba(255, 107, 53, 0.4),
            0 0 0 3px rgba(255, 107, 53, 0.2);
    }

    .btn-submit:active {
        transform: translateY(-1px);
    }

    /* ✅ Form options */
    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: -0.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }

    .form-checkbox {
        width: 22px;
        height: 22px;
        cursor: pointer;
        accent-color: #ff6b35;
    }

    .form-checkbox-label {
        color: #666;
        font-size: 1rem;
        cursor: pointer;
        font-weight: 500;
    }

    .forgot-link {
        color: #ff6b35;
        text-decoration: none;
        font-size: 1rem;
        transition: all 0.3s ease;
        font-weight: 700;
    }

    .forgot-link:hover {
        color: #ff8555;
        text-decoration: underline;
    }

    .auth-footer {
        text-align: center;
        margin-top: 3.5rem;
        padding-top: 2.5rem;
        border-top: 2px solid #f5f5f5;
        color: #666;
        font-weight: 500;
        font-size: 1.05rem;
    }

    .auth-footer a {
        color: #ff6b35;
        text-decoration: none;
        font-weight: 800;
        transition: all 0.3s ease;
    }

    .auth-footer a:hover {
        color: #ff8555;
        text-decoration: underline;
    }

    /* ✅ Alert messages */
    .success-message,
    .alert-error {
        padding: 1.3rem 1.8rem;
        border-radius: 16px;
        margin-bottom: 2.5rem;
        text-align: center;
        animation: slideUp 0.6s ease-out;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        font-weight: 700;
    }

    .success-message {
        background: #d1f4e0;
        border: 2px solid #10b981;
        color: #047857;
    }

    .alert-error {
        background: #ffe8d6;
        border: 2px solid #ff6b35;
        color: #dc2626;
    }

    .success-message::before {
        content: '✓';
        font-size: 1.6rem;
        font-weight: bold;
    }

    .alert-error::before {
        content: '!';
        font-size: 1.6rem;
        font-weight: bold;
    }

    /* ✅ Responsive */
    @@media (max-width: 1024px) {
        .auth-container {
            flex-direction: column;
            max-width: 520px;
        }

        .auth-image-section {
            display: none;
        }

        .auth-form-section {
            width: 100%;
        }

        .auth-card {
            border-radius: 32px;
            border: 2px solid rgba(255, 107, 53, 0.1);
            height: auto;
        }
    }

    @@media (max-width: 768px) {
        .brand-logo {
            top: 2rem;
            left: 2rem;
        }

        .brand-logo-text {
            display: none;
        }

        .auth-card {
            padding: 4rem 3rem 3.5rem;
        }

        .auth-title {
            font-size: 2.6rem;
        }

        .form-options {
            flex-direction: column;
            align-items: flex-start;
        }

        .deco-circle {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .auth-container {
            padding: 0 1rem;
        }

        .auth-card {
            padding: 3.5rem 2rem 3rem;
        }

        .auth-title {
            font-size: 2.2rem;
        }
    }
</style>

<body>
    <!-- ✅ Background Image - Cinema tươi sáng -->
    <div class="auth-background">
        <div class="deco-circle"></div>
        <div class="deco-circle"></div>
        <img src="https://images.unsplash.com/photo-1505686994434-e3cc5abf1330?w=1920&q=85" 
             alt="Cinema Background"
             loading="eager" />
    </div>

    <!-- ✅ Logo -->
    <a href="@Url.Action("Index", "Home")" class="brand-logo">
        <div class="brand-logo-icon">
            <i class="fas fa-film"></i>
        </div>
        <span class="brand-logo-text">DAV Cinema</span>
    </a>

    <!-- ✅ Auth Card -->
    <div class="auth-container">
        <!-- ✅ Left Image Section -->
        <div class="auth-image-section">
            <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800&q=85" 
                 alt="Cinema Experience"
                 loading="eager" />
            <div class="auth-image-overlay">
                <div class="cinema-icon">
                    <i class="fas fa-film"></i>
                </div>
                <h2>Chào Mừng Đến Với<br/>DAV Cinema</h2>
                <p>Trải nghiệm điện ảnh đẳng cấp với công nghệ hiện đại và dịch vụ tốt nhất</p>
            </div>
        </div>

        <!-- ✅ Right Form Section -->
        <div class="auth-form-section">
            <div class="auth-card">
                <div class="auth-header">
                    <h1 class="auth-title">Đăng Nhập</h1>
                    <p class="auth-subtitle">Khám phá thế giới điện ảnh</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="success-message">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="alert-error">
                        @ViewBag.ErrorMessage
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        @Html.TextBoxFor(m => m.us, new { @class = "form-input", placeholder = " " })
                        @Html.LabelFor(m => m.Username, "Tên đăng nhập", new { @class = "form-label" })
                    </div>

                    <div class="form-group password-wrapper">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-input", placeholder = " " })
                        @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "form-label" })

                        <div class="password-toggle">
                            <i class="fas fa-eye-slash"></i>
                        </div>
                    </div>

                    <div class="form-options">
                        <div class="remember-me">
                            <input type="checkbox" id="rememberMe" class="form-checkbox" />
                            <label for="rememberMe" class="form-checkbox-label">Nhớ tài khoản</label>
                        </div>

                        <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-link">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-submit">
                        Đăng Nhập
                    </button>
                }

                <div class="auth-footer">
                    Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
