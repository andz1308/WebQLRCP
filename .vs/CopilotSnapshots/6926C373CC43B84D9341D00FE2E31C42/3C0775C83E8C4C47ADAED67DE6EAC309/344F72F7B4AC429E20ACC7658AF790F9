@model WebCinema.Models.Dat_Ve

@{
    var firstTicket = Model.Ves.FirstOrDefault();
    if (firstTicket == null || firstTicket.Suat_Chieu == null)
    {
        return;
    }

    var showtime = firstTicket.Suat_Chieu;
    var movie = showtime.Phim;
    var cinema = showtime.Phong_Chieu.Rap;
    var room = showtime.Phong_Chieu;
    
    var hasUsedTickets = Model.Ves.Any(v => v.trang_thai_ve == "Đã sử dụng");
    var hasCancelledTickets = Model.Ves.Any(v => v.trang_thai_ve == "Đã Hủy");
    var isUpcoming = showtime.ngay_chieu >= DateTime.Now;
    
    string statusClass = hasUsedTickets ? "status-used" : (hasCancelledTickets ? "status-cancelled" : "status-paid");
    string statusText = hasUsedTickets ? "✓ Đã sử dụng" : (hasCancelledTickets ? "✗ Đã hủy" : "⏳ Chưa sử dụng");
    string statusIcon = hasUsedTickets ? "fa-check-circle" : (hasCancelledTickets ? "fa-times-circle" : "fa-clock");
    
    // Lấy thông tin đồ ăn
    var foodOrders = Model.DonHang_DoAns != null ? Model.DonHang_DoAns.ToList() : new List<WebCinema.Models.DonHang_DoAn>();
    
    // ✅ Kiểm tra đã đánh giá chưa
    var db = new WebCinema.Models.CSDLDataContext();
    var customerId = System.Web.HttpContext.Current.Session["CustomerId"] != null ? (int)System.Web.HttpContext.Current.Session["CustomerId"] : 0;
    var hasReviewed = db.Danh_Gias.Any(dg => 
        dg.phim_id == movie.phim_id && 
        dg.khach_hang_id == customerId &&
        Model.Ves.Select(v => v.ve_id).Contains(dg.ve_id));
}

<style>
    .review-section {
        background: #f0f8ff;
        border: 2px solid #3498db;
        border-radius: 12px;
        padding: 1.5rem;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .review-header {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1rem;
        color: #2c3e50;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .review-header i {
        color: #3498db;
        font-size: 1.3rem;
    }

    .rating-stars {
        display: flex;
        flex-direction: row;
        justify-content: flex-start;
        gap: 0.8rem;
        margin: 1rem 0;
        align-items: center;
    }

    .rating-stars input[type="radio"] {
        display: none;
    }

    .rating-stars label {
        font-size: 2.5rem;
        color: #ddd;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-block;
        line-height: 1;
    }

    .rating-stars label i {
        display: inline-block;
    }

    /* ✅ Hover effect - sao được hover và tất cả sao sau nó sẽ vàng */
    .rating-stars input[type="radio"]:hover ~ label,
    .rating-stars label:hover,
    .rating-stars label:hover ~ label {
        color: #ffc107;
        transform: scale(1.15);
    }

    /* ✅ Selected state - sao được chọn và tất cả sau nó sẽ vàng */
    .rating-stars input[type="radio"]:checked ~ label,
    .rating-stars input[type="radio"]:checked + label {
        color: #ffc107;
    }

    .review-textarea {
        width: 100%;
        padding: 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 0.95rem;
        font-family: inherit;
        resize: vertical;
        min-height: 100px;
        transition: all 0.3s ease;
    }

    .review-textarea:focus {
        outline: none;
        border-color: #3498db;
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
    }

    .char-count {
        text-align: right;
        font-size: 0.85rem;
        color: #999;
        margin-top: 0.5rem;
    }

    .char-count.warning {
        color: #e74c3c;
        font-weight: 600;
    }

    .btn-submit-review {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        padding: 0.8rem 2rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit-review:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
    }

    .btn-submit-review:disabled {
        background: #95a5a6;
        cursor: not-allowed;
        transform: none;
    }

    .review-success {
        background: #d4edda;
        border: 2px solid #28a745;
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .review-success i {
        font-size: 1.2rem;
    }
</style>

<div class="ticket-card">
    <div class="ticket-card-header">
        <div class="ticket-booking-id">
            Mã đơn: <span>#@Model.Dat_Ve_id</span>
        </div>
        <div class="ticket-status-badge @statusClass">
            <i class="fas @statusIcon"></i>
            @statusText
        </div>
    </div>

    <div class="ticket-card-body">
        <div class="ticket-main-info">
            <!-- Poster - SMALLER -->
            <div class="ticket-poster">
                @if (!string.IsNullOrEmpty(movie.hinh_anh))
                {
                    <img src="@Url.Content(movie.hinh_anh)" alt="@movie.ten_phim" />
                }
                else
                {
                    <img src="@Url.Content("~/Content/images/no-poster.png")" alt="No Poster" />
                }
            </div>

            <!-- Details - COMPACT -->
            <div class="ticket-details">
                <h3>@movie.ten_phim</h3>

                <div class="ticket-info-row">
                    <i class="fas fa-calendar-alt"></i>
                    <span>
                        <strong>@showtime.ngay_chieu.ToString("dd/MM/yyyy")</strong>
                        lúc <strong>@showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")</strong>
                    </span>
                </div>

                <div class="ticket-info-row">
                    <i class="fas fa-map-marker-alt"></i>
                    <span><strong>@cinema.ten_rap</strong> - Phòng <strong>@room.ten_phong</strong></span>
                </div>

                <div class="ticket-info-row">
                    <i class="fas fa-couch"></i>
                    <span><strong>@Model.Ves.Count vé</strong> - Ghế: @string.Join(", ", Model.Ves.OrderBy(v => v.Ghe.so_ghe).Select(v => v.Ghe.so_ghe).Take(3))@(Model.Ves.Count > 3 ? "..." : "")</span>
                </div>

                @if (foodOrders.Any())
                {
                    <div class="ticket-info-row">
                        <i class="fas fa-utensils"></i>
                        <span><strong>@foodOrders.Sum(f => f.so_luong)</strong> món đồ ăn</span>
                    </div>
                }
            </div>

            <!-- Price -->
            <div class="ticket-price-section">
                <div class="ticket-total-label">Tổng tiền</div>
                <div class="ticket-total-price">@Model.tong_tien.ToString("N0") ₫</div>
            </div>
        </div>

        <!-- ✅ ĐÁNH GIÁ PHIM - CHỈ HIỂN thị cho vé ĐÃ SỬ DỤNG -->
        @if (hasUsedTickets && !hasReviewed)
        {
            <div style="margin-top: 1rem;">
                <!-- Button toggle -->
                <button 
                    onclick="toggleReviewForm(@Model.Dat_Ve_id)" 
                    style="width: 100%; padding: 1rem; background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); border: 2px solid #2196f3; border-radius: 12px; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: space-between; font-size: 0.95rem;">
                    <div style="display: flex; align-items: center; gap: 0.8rem;">
                        <i class="fas fa-star" style="color: #2196f3; font-size: 1.3rem;"></i>
                        <div style="text-align: left;">
                            <strong style="color: #1565c0; font-size: 1rem; display: block;">Đánh giá phim này</strong>
                        </div>
                    </div>
                    <i class="fas fa-chevron-down" id="reviewIcon-@Model.Dat_Ve_id" style="color: #2196f3; transition: transform 0.3s ease;"></i>
                </button>

                <!-- Form đánh giá (ẩn mặc định) -->
                <div class="review-section" id="review-section-@Model.Dat_Ve_id" style="display: none; margin-top: 1rem; animation: slideDown 0.3s ease;">
                    <div class="review-header">
                        <i class="fas fa-star"></i>
                        Đánh giá của bạn
                    </div>

                    <form id="review-form-@Model.Dat_Ve_id" onsubmit="return submitReview(@Model.Dat_Ve_id, @movie.phim_id, @firstTicket.ve_id);">
                        <!-- Đánh giá sao -->
                        <div style="margin: 1rem 0;">
                            <label style="font-weight: 600; margin-bottom: 0.8rem; display: block; color: #333;">
                                <i class="fas fa-star" style="color: #ffc107;"></i> Chọn số sao
                            </label>
                            <div class="rating-stars" id="rating-@Model.Dat_Ve_id">
                                <label for="star1-@Model.Dat_Ve_id" data-rating="1" title="1 sao - Rất tệ">
                                    <i class="fas fa-star"></i>
                                </label>
                                <input type="radio" name="rating-@Model.Dat_Ve_id" id="star1-@Model.Dat_Ve_id" value="1" />
                                
                                <label for="star2-@Model.Dat_Ve_id" data-rating="2" title="2 sao - Tệ">
                                    <i class="fas fa-star"></i>
                                </label>
                                <input type="radio" name="rating-@Model.Dat_Ve_id" id="star2-@Model.Dat_Ve_id" value="2" />
                                
                                <label for="star3-@Model.Dat_Ve_id" data-rating="3" title="3 sao - Bình thường">
                                    <i class="fas fa-star"></i>
                                </label>
                                <input type="radio" name="rating-@Model.Dat_Ve_id" id="star3-@Model.Dat_Ve_id" value="3" />
                                
                                <label for="star4-@Model.Dat_Ve_id" data-rating="4" title="4 sao - Tốt">
                                    <i class="fas fa-star"></i>
                                </label>
                                <input type="radio" name="rating-@Model.Dat_Ve_id" id="star4-@Model.Dat_Ve_id" value="4" />
                                
                                <label for="star5-@Model.Dat_Ve_id" data-rating="5" title="5 sao - Rất tốt">
                                    <i class="fas fa-star"></i>
                                </label>
                                <input type="radio" name="rating-@Model.Dat_Ve_id" id="star5-@Model.Dat_Ve_id" value="5" />
                            </div>
                            <p id="ratingText-@Model.Dat_Ve_id" style="color: #666; font-size: 0.9rem; margin-top: 0.5rem;">Chưa chọn đánh giá</p>
                        </div>

                        <!-- Nội dung đánh giá -->
                        <div style="margin: 1rem 0;">
                            <label style="font-weight: 600; margin-bottom: 0.5rem; display: block; color: #333;">
                                <i class="fas fa-comment"></i> Nhận xét của bạn
                            </label>
                            <textarea 
                                id="review-content-@Model.Dat_Ve_id" 
                                class="review-textarea" 
                                placeholder="Chia sẻ cảm nhận của bạn về bộ phim... (tối đa 500 ký tự)"
                                maxlength="500"
                                onkeyup="updateCharCount(@Model.Dat_Ve_id)"></textarea>
                            
                            <div class="char-count" id="char-count-@Model.Dat_Ve_id">0/500 ký tự</div>
                        </div>

                        <button type="submit" class="btn-submit-review">
                            <i class="fas fa-paper-plane"></i> Gửi đánh giá
                        </button>
                    </form>
                </div>
            </div>
        }
        else if (hasUsedTickets && hasReviewed)
        {
            <div class="review-success" style="margin-top: 1rem;">
                <i class="fas fa-check-circle"></i>
                Bạn đã đánh giá phim này rồi. Cảm ơn bạn!
            </div>
        }

        <br />
        <!-- Actions - COMPACT -->
        <div class="ticket-actions">
            <a href="@Url.Action("Details", "TicketRefund", new { id = Model.Dat_Ve_id })" class="btn-ticket btn-primary">
                <i class="fas fa-eye"></i> Chi tiết
            </a>

            @if (!hasUsedTickets && !hasCancelledTickets && isUpcoming)
            {
                <a href="@Url.Action("Details", "TicketRefund", new { id = Model.Dat_Ve_id })" class="btn-ticket btn-danger">
                    <i class="fas fa-times-circle"></i> Hủy
                </a>
            }

            @if (!hasCancelledTickets)
            {
                <a href="@Url.Action("Details", "TicketRefund", new { id = Model.Dat_Ve_id })" class="btn-ticket btn-secondary">
                    <i class="fas fa-qrcode"></i> QR
                </a>
            }
        </div>
    </div>
</div>

<script>
// ✅ Toggle form đánh giá
function toggleReviewForm(bookingId) {
    const form = document.getElementById('review-section-' + bookingId);
    const icon = document.getElementById('reviewIcon-' + bookingId);
    
    if (form.style.display === 'none' || form.style.display === '') {
        form.style.display = 'block';
        icon.style.transform = 'rotate(180deg)';
    } else {
        form.style.display = 'none';
        icon.style.transform = 'rotate(0deg)';
    }
}

// ✅ Xử lý chọn sao - Chạy ngay khi script load
(function() {
    const bookingId = '@Model.Dat_Ve_id';
    const ratingContainer = document.getElementById('rating-' + bookingId);
    
    if (ratingContainer) {
        // Gắn event cho tất cả radio buttons
        const radios = ratingContainer.querySelectorAll('input[type="radio"]');
        radios.forEach(function(radio) {
            radio.addEventListener('change', function() {
                const rating = this.value;
                const ratingText = document.getElementById('ratingText-' + bookingId);
                const ratingTexts = {
                    '1': 'Rất tệ 😞',
                    '2': 'Tệ 😐',
                    '3': 'Bình thường 😊',
                    '4': 'Tốt 😄',
                    '5': 'Rất tốt 🤩'
                };
                
                if (ratingText) {
                    ratingText.textContent = 'Đánh giá: ' + ratingTexts[rating] + ' (' + rating + '/5)';
                    ratingText.style.color = '#ffc107';
                    ratingText.style.fontWeight = '600';
                }
            });
        });
        
        // Thêm hover effect cho labels
        const labels = ratingContainer.querySelectorAll('label');
        labels.forEach(function(label) {
            label.addEventListener('mouseenter', function() {
                // Highlight this star and all previous stars
                let currentLabel = this;
                while (currentLabel) {
                    currentLabel.style.color = '#ffc107';
                    currentLabel = currentLabel.previousElementSibling;
                    if (currentLabel && currentLabel.tagName === 'INPUT') {
                        currentLabel = currentLabel.previousElementSibling;
                    }
                }
            });
        });
        
        ratingContainer.addEventListener('mouseleave', function() {
            // Reset colors based on checked state
            const checked = this.querySelector('input[type="radio"]:checked');
            labels.forEach(function(label) {
                label.style.color = '#ddd';
            });
            
            if (checked) {
                let currentLabel = checked.nextElementSibling;
                while (currentLabel) {
                    if (currentLabel.tagName === 'LABEL') {
                        currentLabel.style.color = '#ffc107';
                    }
                    currentLabel = currentLabel.nextElementSibling;
                }
            }
        });
    }
})();

function updateCharCount(bookingId) {
    const textarea = document.getElementById('review-content-' + bookingId);
    const charCount = document.getElementById('char-count-' + bookingId);
    const count = textarea.value.length;
    
    charCount.textContent = count + '/500 ký tự';
    
    if (count > 450) {
        charCount.classList.add('warning');
    } else {
        charCount.classList.remove('warning');
    }
}

function submitReview(bookingId, movieId, ticketId) {
    event.preventDefault();
    
    const rating = document.querySelector('input[name="rating-' + bookingId + '"]:checked');
    const content = document.getElementById('review-content-' + bookingId).value.trim();
    
    if (!rating) {
        alert('⭐ Vui lòng chọn số sao đánh giá!');
        return false;
    }
    
    if (!content) {
        alert('📝 Vui lòng nhập nội dung đánh giá!');
        return false;
    }
    
    if (content.length > 500) {
        alert('⚠️ Nội dung đánh giá không được quá 500 ký tự!');
        return false;
    }
    
    $.ajax({
        url: '@Url.Action("SubmitReview", "TicketRefund")',
        type: 'POST',
        data: {
            movieId: movieId,
            ticketId: ticketId,
            rating: rating.value,
            content: content
        },
        success: function(response) {
            if (response.success) {
                alert('✅ ' + response.message);
                location.reload();
            } else {
                alert('❌ ' + response.message);
            }
        },
        error: function() {
            alert('❌ Có lỗi xảy ra khi gửi đánh giá!');
        }
    });
    
    return false;
}
</script>
