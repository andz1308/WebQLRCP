                return Ok(new
                {
                    success = true,
                    message = "Lấy danh sách đánh giá thành công",
                    data = reviews
                });
            }
            catch (Exception ex)
            {
                LoggingHelper.LogError(ex);
                return InternalServerError(ex);
            }
        }

        /// <summary>
        /// GET: api/customer/profile/{customerId}
        /// Lấy thông tin hồ sơ khách hàng
