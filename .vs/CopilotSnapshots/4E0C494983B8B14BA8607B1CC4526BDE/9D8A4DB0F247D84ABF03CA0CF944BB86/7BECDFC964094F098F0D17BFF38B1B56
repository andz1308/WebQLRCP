@{
    ViewBag.Title = "Tạo Phiếu Đề Xuất";
    Layout = "~/Areas/Admin/Views/Shared/LayoutStaff.cshtml";
    var slowItems = ViewBag.SlowItems as List<WebCinema.Services.SlowItemViewModel>;
    var allFoods = ViewBag.AllFoods as List<WebCinema.Models.Do_An>;
}

<div class="content-header">
    <h1><i class="fas fa-bullhorn"></i> Đề Xuất Khuyến Mãi (Giải Cứu Kho)</h1>
</div>

@if (slowItems != null && slowItems.Any())
{
    <div class="alert alert-warning">
        <h5><i class="fas fa-exclamation-triangle"></i> Gợi ý: Các món bán chậm cần giải cứu</h5>
        <div style="max-height:150px; overflow-y:auto;">
            <table class="table table-sm table-bordered bg-white mb-0">
                <thead><tr><th>Món</th><th>Tồn</th><th>Bán(30d)</th><th>Thao tác</th></tr></thead>
                <tbody>
                    @foreach (var item in slowItems)
                    {
                        <tr>
                            <td>@item.DoAn.ten_san_pham</td>
                            <td class="text-danger font-weight-bold">@item.SoLuongTon</td>
                            <td>@item.DaBan30Ngay</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" onclick="addToList(@item.DoAn.Do_An_id, '@item.DoAn.ten_san_pham', 20)">
                                    + Thêm (Giảm 20%)
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="content-card p-3">
    <div class="row bg-light p-3 mb-3 rounded">
        <div class="col-md-5">
            <label>Thêm thủ công:</label>
            <select id="ddlFood" class="form-control">
                @foreach (var item in allFoods)
                {
                    <option value="@item.Do_An_id" data-name="@item.ten_san_pham">@item.ten_san_pham</option>
}
            </select>
        </div>
        <div class="col-md-3">
            <label>Giảm (%):</label>
            <input type="number" id="numPercent" class="form-control" value="10" min="1" max="100" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button class="btn btn-success" onclick="addManual()">+ Thêm vào phiếu</button>
        </div>
    </div>

    <h4>Danh sách trong phiếu:</h4>
    <table class="table table-bordered" id="tblProposal">
        <thead><tr><th>Tên Món</th><th>Giảm Giá (%)</th><th>Xóa</th></tr></thead>
        <tbody></tbody>
    </table>

    <textarea id="txtReason" class="form-control mt-3" rows="3" placeholder="Lý do chung cho đợt đề xuất này..."></textarea>

    <div class="text-right mt-3">
        <button class="btn btn-primary btn-lg" onclick="submitProposal()">Gửi Đề Xuất</button>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var list = [];
    function addToList(id, name, pct) {
        if(list.find(x => x.Id == id)) { alert("Món này đã có!"); return; }
        list.push({ Id: id, Name: name, Percent: pct });
        render();
    }
    function addManual() {
        addToList($('#ddlFood').val(), $('#ddlFood option:selected').data('name'), $('#numPercent').val());
    }
    function remove(i) { list.splice(i, 1); render(); }

    function render() {
        var html = '';
        list.forEach((item, i) => {
            html += `<tr><td>${item.Name}</td><td>${item.Percent}%</td><td><button class="btn btn-danger btn-sm" onclick="remove(${i})">X</button></td></tr>`;
        });
        $('#tblProposal tbody').html(html);
    }

    function submitProposal() {
        if(list.length === 0 || !$('#txtReason').val()) { alert("Vui lòng nhập đủ thông tin."); return; }
        if(confirm("Gửi phiếu này?")) {
            $.ajax({
                url: '@Url.Action("Create")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ items: list, reason: $('#txtReason').val() }),
                success: function(res) {
                    if(res.success) { alert("Thành công!"); location.href='@Url.Action("Index")'; }
                    else alert("Lỗi");
                }
            });
        }
    }
</script>