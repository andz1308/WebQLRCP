<script>
    function toggleBookingSection() {
        const bookingSection = document.getElementById('bookingSection');
        bookingSection.classList.toggle('active');
        if (bookingSection.classList.contains('active')) {
            bookingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function selectRegion(region) {
        const tabs = document.querySelectorAll('.booking-tab');
        tabs.forEach(tab => tab.classList.remove('active'));
        event.target.classList.add('active');

        const contents = document.querySelectorAll('.booking-content');
        contents.forEach(content => content.classList.remove('active'));
        document.getElementById('content-' + region).classList.add('active');
    }

    // Select a date and filter time slots to show only that date's showtimes
    function selectDate(date) {
        // Remove active state from all date items
        const dateItems = document.querySelectorAll('.date-item');
        dateItems.forEach(item => item.classList.remove('active'));

        // Add active to the clicked date-item (find by data-date)
        const el = document.querySelector('.date-item[data-date="' + date + '"]');
        if (el) el.classList.add('active');

        // Filter time slots
        filterShowtimesByDate(date);
    }

    function filterShowtimesByDate(selectedDate) {
        const timeSlots = document.querySelectorAll('.time-slot');
        timeSlots.forEach(slot => {
            const slotDate = slot.getAttribute('data-showtime-date');
            if (!slotDate) {
                slot.style.display = 'none';
                return;
            }

            if (!selectedDate || slotDate === selectedDate) {
                slot.style.display = 'block';
            } else {
                slot.style.display = 'none';
            }
        });

        // Optionally hide entire cinema groups that have no visible time-slots
        document.querySelectorAll('.cinema-item').forEach(cinema => {
            const slots = cinema.querySelectorAll('.time-slot');
            const anyVisible = Array.from(slots).some(s => s.style.display !== 'none');
            cinema.style.display = anyVisible ? 'block' : 'none';
        });

        // If a province tab has no visible cinemas, hide its content container
        document.querySelectorAll('.booking-content').forEach(content => {
            const anyCinemaVisible = Array.from(content.querySelectorAll('.cinema-item')).some(c => c.style.display !== 'none');
            content.style.display = anyCinemaVisible ? 'block' : 'none';
        });
    }

    function bookShowtime(showtimeId) {
        @if (Session["CustomerId"] == null)
        {
            <text>
            // Show alert without redirecting
            alert('Vui lòng đăng nhập để đặt vé!');
            return;
            </text>
        }
        else
        {
            <text>
            window.location.href = '@Url.Action("SelectSeats", "Booking")' + '/' + showtimeId;
            </text>
        }
    }

    function showTrailer() {
        const modal = document.getElementById('trailerModal');
        const wrapper = document.getElementById('trailerWrapper');
        const trailerUrl = '@Html.Raw(trailer ?? "")';
        
        if (!trailerUrl) {
            alert('Trailer chưa có sẵn!');
            return;
        }
        
        if (trailerUrl.includes('youtube.com') || trailerUrl.includes('youtu.be')) {
            let videoId = '';
            if (trailerUrl.includes('youtube.com/watch')) {
                videoId = trailerUrl.split('v=')[1];
                const ampersandPosition = videoId.indexOf('&');
                if (ampersandPosition !== -1) {
                    videoId = videoId.substring(0, ampersandPosition);
                }
            } else if (trailerUrl.includes('youtu.be/')) {
                videoId = trailerUrl.split('youtu.be/')[1];
            }
            
            wrapper.innerHTML = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1" 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen></iframe>`;
        } else {
            wrapper.innerHTML = `<video controls autoplay>
                                    <source src="${trailerUrl}" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>`;
        }
        
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeTrailer() {
        const modal = document.getElementById('trailerModal');
        const wrapper = document.getElementById('trailerWrapper');
        
        modal.classList.remove('active');
        wrapper.innerHTML = '';
        document.body.style.overflow = 'auto';
    }

    window.onclick = function(event) {
        const modal = document.getElementById('trailerModal');
        if (event.target === modal) {
            closeTrailer();
        }
    }

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeTrailer();
        }
    });

    // ✅ Khởi tạo: Lọc suất chiếu theo ngày đầu tiên khi trang load
    document.addEventListener('DOMContentLoaded', function() {
        const firstDateItem = document.querySelector('.date-item.active') || document.querySelector('.date-item');
        if (firstDateItem) {
            const firstDate = firstDateItem.getAttribute('data-date');
            if (firstDate) {
                // Ensure region tab visibility: show all tabs first
                document.querySelectorAll('.booking-content').forEach(c => c.style.display = 'block');
                // Apply filtering
                filterShowtimesByDate(firstDate);
            }
        }
    });
</script>

@if (Session["CustomerId"] != null)
{
    <script>
    // Wait for jQuery to be available
    function initializeReviewForm() {
        if (typeof jQuery === 'undefined') {
            // jQuery not loaded yet, try again
            setTimeout(initializeReviewForm, 100);
            return;
        }

        var $ = jQuery;
        var selectedRating = 0;
        var movieId = @Model.Movie.phim_id;

        // Check if user has already reviewed
        $.ajax({
            url: '@Url.Action("CheckUserReview", "Evaluate")',
            type: 'POST',
            data: { phim_id: movieId },
            success: function(response) {
                if (response.hasReviewed) {
                    $('#reviewFormContent').hide();
                    $('#reviewFormMessage').show();
                    $('#messageText').text('Bạn đã đánh giá phim này rồi!');
                }
            },
            error: function() {
                console.log('Error checking review');
            }
        });

        // Star button click handlers
        $('.star-button').on('click', function(e) {
            e.preventDefault();
            selectedRating = parseInt($(this).data('rating'));
            $('#selectedRating').val(selectedRating);

            // Update button styling
            $('.star-button').removeClass('selected');
            $('.star-button').each(function() {
                var rating = parseInt($(this).data('rating'));
                if (rating <= selectedRating) {
                    $(this).addClass('selected');
                } else {
                    $(this).removeClass('selected');
                }
            });

            // Update rating text
            var ratingTexts = ['', 'Rất tệ 😞', 'Tệ 😐', 'Bình thường 😊', 'Tốt 😄', 'Rất tốt 🤩'];
            $('#ratingText').text('Đánh giá: ' + ratingTexts[selectedRating] + ' (' + selectedRating + '/5)');
        });

        // Star button hover effect
        $('.star-button').on('mouseenter', function() {
            var hoverRating = parseInt($(this).data('rating'));
            $('.star-button').each(function() {
                var rating = parseInt($(this).data('rating'));
                if (rating <= hoverRating) {
                    $(this).css('color', '#ffc107').css('opacity', '1');
                } else {
                    $(this).css('color', '#ddd').css('opacity', '0.5');
                }
            });
        });

        // Reset on mouse leave
        $('#starRating').on('mouseleave', function() {
            $('.star-button').each(function() {
                var rating = parseInt($(this).data('rating'));
                if (rating <= selectedRating) {
                    $(this).css('color', 'white').css('opacity', '1');
                } else {
                    $(this).css('color', '#ddd').css('opacity', '1');
                }
            });
        });

        // Submit review
        $('#submitReviewBtn').click(function() {
            var rating = $('#selectedRating').val();
            var content = $('#reviewContent').val().trim();

            if (rating == 0 || rating == '') {
                alert('Vui lòng chọn số sao đánh giá!');
                return;
            }

            if (content == '') {
                alert('Vui lòng nhập nhận xét của bạn!');
                return;
            }

            $.ajax({
                url: '@Url.Action("SubmitReview", "Evaluate")',
                type: 'POST',
                data: {
                    phim_id: movieId,
                    diem_rating: rating,
                    noi_dung: content
                },
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra. Vui lòng thử lại!');
                }
            });
        });
    }

    // Initialize when document is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeReviewForm);
    } else {
        initializeReviewForm();
    }
    </script>
}




