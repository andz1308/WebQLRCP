                        <textarea id="reviewContent" class="form-control" rows="4" placeholder="Chia sẻ cảm nhận của bạn về bộ phim..." style="width: 100%; padding: 1rem; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1rem;"></textarea>
                    </div>
                    <button id="submitReviewBtn" class="btn btn-primary" style="background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%); color: white; border: none; padding: 1rem 2rem; border-radius: 8px; font-weight: 600; cursor: pointer;">
                        <i class="fas fa-paper-plane"></i> Gửi Đánh Giá
