        }
        else
        {
            <div style="background: #fff3cd; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border: 1px solid #ffc107;">
                <i class="fas fa-info-circle" style="color: #856404;"></i>
                <span style="color: #856404; font-weight: 600;">
                    Vui lòng đăng nhập để đánh giá phim này.
                </span>
            </div>
        }

        @{
            var allReviews = movie.Danh_Gias.ToList();
            
            // Function to check if a review is an admin reply
            Func<WebCinema.Models.Danh_Gia, bool> isAdminReply = r => 
                r.noi_dung != null && 
                (r.noi_dung.Contains("[AdminReply]") || 
                 r.noi_dung.Contains("[Phản hồi từ Admin]") || 
                 r.noi_dung.Contains("[ReplyTo:"));

            // Function to extract parent ID from reply
            Func<WebCinema.Models.Danh_Gia, int?> getParentId = r =>
            {
                if (r.noi_dung == null) return null;
                
                // Try to extract ParentID from [ParentID:123] format
                var match = System.Text.RegularExpressions.Regex.Match(r.noi_dung, @"\[ParentID:(\d+)\]");
                int parentId = 0;
                if (match.Success && int.TryParse(match.Groups[1].Value, out parentId))
                {
                    return parentId;
                }
                
                // Try old format [ReplyTo:123]
                match = System.Text.RegularExpressions.Regex.Match(r.noi_dung, @"\[ReplyTo:(\d+)\]");
                if (match.Success && int.TryParse(match.Groups[1].Value, out parentId))
                {
                    return parentId;
                }
                
                return null;
            };

            // Function to clean reply content
            Func<string, string> cleanReplyContent = content =>
            {
                if (string.IsNullOrEmpty(content)) return "";
                return System.Text.RegularExpressions.Regex.Replace(content, 
                    @"\[AdminReply\]|\[ParentID:\d+\]|\[Phản hồi từ Admin\]|\[ReplyTo:\d+\]", "").Trim();
            };

            // Build parent-child relationship map
            var repliesMap = new Dictionary<int, List<WebCinema.Models.Danh_Gia>>();
            var parentReviews = allReviews.Where(r => !isAdminReply(r)).ToList();

            foreach (var reply in allReviews.Where(r => isAdminReply(r)))
            {
                var parentId = getParentId(reply);
                if (parentId.HasValue && parentReviews.Any(p => p.Danh_Gia_id == parentId.Value))
                {
                    if (!repliesMap.ContainsKey(parentId.Value))
                    {
                        repliesMap[parentId.Value] = new List<WebCinema.Models.Danh_Gia>();
                    }
                    repliesMap[parentId.Value].Add(reply);
                }
            }

            parentReviews = parentReviews.OrderByDescending(p => p.ngay_Danh_Gia).ToList();
        }

        @if (parentReviews != null && parentReviews.Any())
        {
            <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-top: 2rem;">
                @foreach (var review in parentReviews)
                {
                    var stars = review.diem_rating ?? 0;
                    var replies = repliesMap.ContainsKey(review.Danh_Gia_id) 
                        ? repliesMap[review.Danh_Gia_id].OrderBy(r => r.ngay_Danh_Gia).ToList() 
                        : new List<WebCinema.Models.Danh_Gia>();

                    <div style="border: 2px solid #e0e0e0; border-radius: 12px; padding: 1.5rem; background: white; transition: all 0.3s ease;">
                        <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                            <div style="width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.2rem;">
                                @if (review.Khach_Hang != null)
                                {
                                    @review.Khach_Hang.ho_ten.Substring(0, 1).ToUpper()
                                }
                                else
                                {
                                    <text>?</text>
                                }
                            </div>
                            <div style="flex: 1;">
                                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                                    <div>
                                        <strong style="color: #2c3e50; font-size: 1.1rem;">
                                            @(review.Khach_Hang != null ? review.Khach_Hang.ho_ten : "Khách hàng")
                                        </strong>
                                        <div style="color: #999; font-size: 0.9rem; margin-top: 0.25rem;">
                                            @(review.ngay_Danh_Gia.HasValue ? review.ngay_Danh_Gia.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                        </div>
                                    </div>
                                    @if (review.diem_rating.HasValue)
                                    {
                                        <div style="color: #ffc107; font-size: 1.1rem;">
                                            @for (int i = 0; i < review.diem_rating.Value; i++)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            @for (int i = review.diem_rating.Value; i < 5; i++)
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        </div>
                                    }
                                </div>
                                
                                <p style="color: #555; margin: 0; line-height: 1.6; padding: 1rem; background: #f9f9f9; border-radius: 8px;">
                                    @review.noi_dung
                                </p>

                                @if (replies != null && replies.Any())
                                {
                                    <div style="margin-top: 1rem; padding-left: 2rem; border-left: 3px solid #ff6b35; display: flex; flex-direction: column; gap: 1rem;">
                                        @foreach (var reply in replies)
                                        {
                                            var cleanContent = cleanReplyContent(reply.noi_dung);
                                            <div style="padding: 1rem; background: #f0f8ff; border-left: 3px solid #3498db; border-radius: 8px;">
                                                <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem;">
                                                    <i class="fas fa-shield-alt" style="color: #3498db; font-size: 1.1rem;"></i>
                                                    <strong style="color: #3498db;">Phản Hồi Từ Quản Trị Viên</strong>
                                                    <span style="color: #999; font-size: 0.85rem; margin-left: auto;">@(reply.ngay_Danh_Gia.HasValue ? reply.ngay_Danh_Gia.Value.ToString("dd/MM/yyyy HH:mm") : "")</span>
                                                </div>
                                                <p style="color: #2c3e50; margin: 0; line-height: 1.6;">@cleanContent</p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="text-align: center; color: #999; padding: 2rem;">
                Chưa có đánh giá nào cho phim này.
            </p>
        }
    </div>
</div>

