@model WebCinema.Models.Dat_Ve

@{
    ViewBag.Title = "Đặt Vé Thành Công";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var tickets = ViewBag.Tickets as List<WebCinema.Models.Ve>;
    var foods = ViewBag.Foods as List<WebCinema.Models.DonHang_DoAn>;
    var firstTicket = tickets.FirstOrDefault();
}

<style>
    .success-container {
        max-width: 1000px;
        margin: 3rem auto;
        padding: 0 2rem;
    }

    .success-header {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        padding: 3rem 2rem;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 2rem;
        box-shadow: 0 8px 30px rgba(39, 174, 96, 0.3);
    }

    .success-header i {
        font-size: 4rem;
        margin-bottom: 1rem;
        animation: checkmark 0.6s ease-in-out;
    }

    @@keyframes checkmark {
        0% { transform: scale(0); opacity: 0; }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); opacity: 1; }
    }

    .success-header h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.5rem;
    }

    .bookings-section {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .booking-card {
        background: #f9f9f9;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .booking-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .booking-id {
        font-size: 1.3rem;
        font-weight: bold;
        color: #333;
    }

    .booking-status {
        padding: 0.5rem 1rem;
        background: #27ae60;
        color: white;
        border-radius: 6px;
        font-weight: 600;
    }

    .booking-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .detail-item {
        display: flex;
        gap: 0.5rem;
        color: #666;
        align-items: flex-start;
    }

    .detail-item i {
        color: #ff6b35;
        margin-top: 0.2rem;
    }

    .booking-total {
        text-align: right;
        font-size: 1.5rem;
        font-weight: bold;
        color: #27ae60;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 2px solid #e0e0e0;
    }

    .actions-section {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 1rem 2rem;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8555 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
    }

    .btn-secondary {
        background: #ecf0f1;
        color: #333;
    }

    .btn-secondary:hover {
        background: #bdc3c7;
    }

    .info-notice {
        background: #fff3cd;
        border: 2px solid #ffc107;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 2rem;
        color: #856404;
    }

    @@media print {
        .actions-section, .info-notice {
            display: none;
        }
    }
</style>

<div class="success-container">
    <div class="success-header">
        <i class="fas fa-check-circle"></i>
        <h1>Đặt Vé Thành Công!</h1>
        <p style="font-size: 1.2rem; opacity: 0.95;">
            Cảm ơn bạn đã đặt vé tại DAV Cinema. Thông tin vé đã được gửi vào email của bạn.
        </p>
    </div>

    @if (Model != null && !string.IsNullOrEmpty(Model.trang_thai_Dat_Ve) && Model.trang_thai_Dat_Ve == "Chờ xác nhận")
    {
        <div class="info-notice">
            <i class="fas fa-info-circle"></i>
            <strong>Lưu ý:</strong> Vé thanh toán bằng tiền mặt cần được xác nhận tại quầy trước giờ chiếu 15 phút.
        </div>
    }

    <div class="bookings-section">
        <h3><i class="fas fa-receipt"></i> Thông Tin Đơn Hàng</h3>
        
        @if (Model != null)
        {
            var showtime = firstTicket.Suat_Chieu;

            <div class="booking-card">
                <div class="booking-header">
                    <div class="booking-id">
                        <i class="fas fa-ticket-alt"></i> Mã đơn: #@Model.Dat_Ve_id
                    </div>
                    <div class="booking-status">@(Model.trang_thai_Dat_Ve ?? "N/A")</div>
                </div>

                @if (showtime != null)
                {
                    <div class="booking-details">
                        <div class="detail-item">
                            <i class="fas fa-film"></i>
                            <div>
                                <strong>Phim:</strong><br />
                                @showtime.Phim.ten_phim
                            </div>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-building"></i>
                            <div>
                                <strong>Rạp:</strong><br />
                                @showtime.Phong_Chieu.Rap.ten_rap - @showtime.Phong_Chieu.ten_phong
                            </div>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-calendar"></i>
                            <div>
                                <strong>Ngày chiếu:</strong><br />
                                @showtime.ngay_chieu.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-clock"></i>
                            <div>
                                <strong>Giờ chiếu:</strong><br />
                                @showtime.Ca_Chieu.gio_bat_dau.ToString(@"hh\:mm")
                            </div>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-couch"></i>
                            <div>
                                <strong>Ghế:</strong><br />
                                @string.Join(", ", tickets.Select(t => t.Ghe.so_ghe))
                            </div>
                        </div>
                        <div class="detail-item">
                            <i class="fas fa-qrcode"></i>
                            <div>
                                <strong>Mã QR:</strong><br />
                                @string.Join(", ", tickets.Select(t => t.ma_qr_code).Distinct().Take(1))
                            </div>
                        </div>
                    </div>

                    <!-- ✅ Hiển thị ảnh QR Code -->
                    <div style="margin-top: 1.5rem; padding: 1rem; background: white; border-radius: 8px; border: 2px dashed #ff6b35;">
                        <strong><i class="fas fa-qrcode"></i> Mã QR Vé (Dùng để kiểm tra):</strong>
                        <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem;">
                            @foreach (var ticket in tickets)
                            {
                                if (!string.IsNullOrEmpty(ticket.ma_qr_code))
                                {
                                    var qrService = new WebCinema.Infrastructure.QRCodeTicketService();
                                    var qrImagePath = qrService.GetQRCodePath(ticket.ma_qr_code);
                                    
                                    <div style="text-align: center; padding: 1rem; background: #f9f9f9; border-radius: 8px;">
                                        @if (!string.IsNullOrEmpty(qrImagePath))
                                        {
                                            <img src="@qrImagePath" alt="QR Code - @ticket.Ghe.so_ghe" style="width: 150px; height: 150px; border: 2px solid #ff6b35; border-radius: 6px;" />
                                        }
                                        <div style="margin-top: 0.5rem; font-size: 0.9rem; color: #666;">
                                            <strong>Ghế: @ticket.Ghe.so_ghe</strong><br />
                                            Giá: @ticket.gia_ve.ToString("N0") ₫
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    if (foods != null && foods.Any())
                    {
                        <div style="margin-top: 1rem; padding: 1rem; background: white; border-radius: 8px;">
                            <strong><i class="fas fa-utensils"></i> Đồ ăn & thức uống:</strong>
                            <ul style="margin: 0.5rem 0 0 1.5rem; color: #666;">
                                @foreach (var food in foods)
                                {
                                    <li>@food.Do_An.ten_san_pham x @food.so_luong</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- ✅ THÊM: Hiển thị Mã Khuyến Mãi Áp Dụng -->
                    if (!string.IsNullOrEmpty(Model.phuong_thuc_thanh_toan))
                    {
                        <div style="margin-top: 1rem; padding: 1.5rem; background: #f0f8ff; border: 2px solid #3498db; border-radius: 8px;">
                            <strong style="color: #2c3e50;"><i class="fas fa-tag"></i> Mã Khuyến Mãi Áp Dụng:</strong>
                            <span style="color: #27ae60; font-weight: 700; font-size: 1.1rem; margin-left: 0.5rem;">@Model.phuong_thuc_thanh_toan</span>
                        </div>
                    }

                    <!-- ✅ CHI TIẾT GIÁ TRỊ THANH TOÁN -->
                    @{
                        var ticketTotal = tickets.Sum(t => t.gia_ve);
                        var foodTotal = foods != null ? foods.Sum(f => (f.Do_An.gia ?? 0m) * f.so_luong) : 0m;
                        var originalTotal = ticketTotal + foodTotal;
                        var discount = originalTotal - Model.tong_tien;
                    }
                    
                    <div style="margin-top: 1.5rem; padding: 1.5rem; background: #f9f9f9; border: 2px solid #e0e0e0; border-radius: 8px;">
                        <strong style="color: #333;"><i class="fas fa-receipt"></i> Chi Tiết Thanh Toán</strong>
                        <table style="width: 100%; margin-top: 1rem; color: #666;">
                            <tr style="border-bottom: 1px solid #e0e0e0;">
                                <td style="padding: 0.5rem 0;">Tiền vé (@tickets.Count vé)</td>
                                <td style="text-align: right; padding: 0.5rem 0;">@ticketTotal.ToString("N0") ₫</td>
                            </tr>
                            @if (foodTotal > 0)
                            {
                                <tr style="border-bottom: 1px solid #e0e0e0;">
                                    <td style="padding: 0.5rem 0;">Đồ ăn & thức uống</td>
                                    <td style="text-align: right; padding: 0.5rem 0;">@foodTotal.ToString("N0") ₫</td>
                                </tr>
                            }
                            <tr style="border-bottom: 2px solid #e0e0e0;">
                                <td style="padding: 0.5rem 0; font-weight: 600;">Tổng Tiền Gốc</td>
                                <td style="text-align: right; padding: 0.5rem 0; font-weight: 600;">@originalTotal.ToString("N0") ₫</td>
                            </tr>
                            @if (discount > 0)
                            {
                                <tr style="background: #e8f8f5; border-bottom: 1px solid #d5f4e6;">
                                    <td style="padding: 0.5rem 0; color: #27ae60; font-weight: 600;"><i class="fas fa-check-circle"></i> Giảm Giá</td>
                                    <td style="text-align: right; padding: 0.5rem 0; color: #27ae60; font-weight: 600;">-@discount.ToString("N0") ₫</td>
                                </tr>
                            }
                            <tr style="background: linear-gradient(135deg, #fff5f2 0%, #ffe0d6 100%); font-size: 1.2rem;">
                                <td style="padding: 1rem 0.5rem; font-weight: 700; color: #ff6b35;">TỔNG THANH TOÁN</td>
                                <td style="text-align: right; padding: 1rem 0.5rem; font-weight: 700; color: #ff6b35;">@Model.tong_tien.ToString("N0") ₫</td>
                            </tr>
                        </table>
                    </div>
                }

                <div class="booking-total">
                    Tổng tiền: @Model.tong_tien.ToString("N0") ₫
                </div>
            </div>
        }
    </div>

    <div class="actions-section">
        <a href="@Url.Action("Index", "Home")" class="action-btn btn-primary">
            <i class="fas fa-home"></i> Về Trang Chủ
        </a>
        <button onclick="window.print()" class="action-btn btn-secondary">
            <i class="fas fa-print"></i> In Vé
        </button>
        <a href="@Url.Action("Profile", "Account")" class="action-btn btn-secondary">
            <i class="fas fa-user"></i> Xem Lịch Sử
        </a>
    </div>
</div>
